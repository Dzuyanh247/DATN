@model List<SearchKeyword>
@{
    ViewData["Title"] = "Từ khóa tìm kiếm";
}

<style>
    .admin-search-keywords {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .admin-search-keywords .ask-card {
        padding: 16px;
        overflow: visible;
    }

    .admin-search-keywords .ask-table-card {
        position: relative;
        z-index: 1;
    }

    .admin-search-keywords .ask-filter-form {
        display: grid;
        grid-template-columns: minmax(240px, 1fr) auto;
        gap: 10px;
        align-items: end;
    }

    .admin-search-keywords .ask-create-form {
        display: grid;
        grid-template-columns: minmax(260px, 1fr) minmax(104px, auto) minmax(90px, auto) auto;
        gap: 12px;
        align-items: end;
    }

    .admin-search-keywords .form-label {
        margin-bottom: 6px;
        font-weight: 700;
        color: #64748b !important;
    }

    .admin-search-keywords .form-control {
        min-height: 40px;
        border-radius: 10px;
    }

    .admin-search-keywords .ask-btn {
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        white-space: nowrap;
    }

    .admin-search-keywords .ask-check-field {
        min-height: 40px;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 9px 10px;
        border: 1px solid rgba(148, 163, 184, .28);
        border-radius: 10px;
        background: rgba(255, 255, 255, .55);
    }

    .admin-search-keywords .form-check-input {
        width: 18px;
        height: 18px;
        margin: 0;
        flex: 0 0 18px;
        border: 1.5px solid #94a3b8;
        background-color: #fff;
        cursor: pointer;
    }

    .admin-search-keywords .form-check-input:checked {
        background-color: #2563eb;
        border-color: #2563eb;
    }

    .admin-search-keywords .form-check-label {
        margin: 0;
        color: #334155;
        font-weight: 700;
        cursor: pointer;
    }

    .admin-search-keywords .ask-table-wrap {
        width: 100%;
        overflow: visible;
        padding-bottom: 0;
    }

    .admin-search-keywords .ask-table {
        width: 100%;
        min-width: 0;
        table-layout: fixed;
        margin-bottom: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

    .admin-search-keywords .ask-table thead th {
        background: #f8fafc;
        color: #475569;
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .02em;
        text-transform: uppercase;
        border-bottom: 1px solid #e2e8f0;
        padding: 12px 14px;
    }

    .admin-search-keywords .ask-table tbody td {
        padding: 10px 14px;
        border-bottom: 1px solid #eef2f7;
    }

    .admin-search-keywords .ask-table tbody tr {
        transition: none;
    }

    .admin-search-keywords .ask-table tbody tr:hover {
        background: #fbfdff;
    }

    .admin-search-keywords .ask-col-keyword { width: 42%; }
    .admin-search-keywords .ask-col-count { width: 92px; text-align: center; }
    .admin-search-keywords .ask-col-date { width: 166px; }
    .admin-search-keywords .ask-col-check { width: 78px; text-align: center; }
    .admin-search-keywords .ask-col-actions { width: 224px; }

    .admin-search-keywords .ask-keyword-input {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        text-overflow: ellipsis;
        background: #fff;
        transition: none !important;
        box-shadow: none !important;
    }

    .admin-search-keywords .ask-keyword-input:hover,
    .admin-search-keywords .ask-keyword-input:focus {
        background: #fff !important;
        border-color: #ced4da !important;
        box-shadow: none !important;
        transform: none !important;
    }

    .admin-search-keywords .ask-count-input {
        max-width: 86px;
        margin: 0 auto;
        text-align: center;
    }

    .admin-search-keywords .ask-date-text {
        display: block;
        white-space: nowrap;
        color: #475569;
    }

    .admin-search-keywords .ask-check-cell {
        text-align: center;
    }

    .admin-search-keywords .ask-check-cell .form-check-input {
        vertical-align: middle;
    }

    .admin-search-keywords .ask-actions {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
        min-width: 0;
        padding-right: 4px;
    }

    .admin-search-keywords .ask-action-dropdown {
        position: relative;
        display: inline-flex;
    }

    .admin-search-keywords .ask-actions .btn {
        min-height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        border-radius: 9px;
        font-weight: 700;
    }

    .admin-search-keywords .ask-actions .btn-primary {
        background: #16a34a;
        border-color: #16a34a;
        box-shadow: 0 6px 14px rgba(22, 163, 74, .13);
    }

    .admin-search-keywords .ask-actions .btn-primary:hover,
    .admin-search-keywords .ask-actions .btn-primary:focus {
        background: #15803d;
        border-color: #15803d;
    }

    .admin-search-keywords .ask-actions .ask-action-toggle {
        color: #334155;
        background: #f8fafc;
        border-color: #cbd5e1;
    }

    .admin-search-keywords .ask-actions .ask-action-toggle:hover,
    .admin-search-keywords .ask-actions .ask-action-toggle:focus,
    .admin-search-keywords .ask-actions .ask-action-toggle[aria-expanded="true"] {
        color: #0f172a;
        background: #e2e8f0;
        border-color: #94a3b8;
    }

    .admin-search-keywords .ask-action-menu {
        position: fixed;
        z-index: 3000;
        display: none;
        min-width: 168px;
        padding: 6px;
        border: 1px solid rgba(148, 163, 184, .25);
        border-radius: 12px;
        background: #fff;
        box-shadow: 0 16px 36px rgba(15, 23, 42, .16);
        transform: none;
        transition: none;
    }

    .admin-search-keywords .ask-action-menu.is-open {
        display: block;
    }

    .admin-search-keywords .ask-action-menu .dropdown-item {
        border: 0;
        border-radius: 9px;
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        padding: 8px 10px;
        color: #334155;
        font-weight: 600;
        text-align: left;
    }

    .admin-search-keywords .ask-action-menu .dropdown-item:hover,
    .admin-search-keywords .ask-action-menu .dropdown-item:focus {
        background: #f1f5f9;
        color: #0f172a;
    }

    .admin-search-keywords .ask-actions form {
        margin: 0;
    }

    @@media (max-width: 767.98px) {
        .admin-search-keywords .ask-card {
            padding: 14px;
        }

        .admin-search-keywords .ask-filter-form,
        .admin-search-keywords .ask-create-form {
            grid-template-columns: 1fr;
        }

        .admin-search-keywords .ask-btn,
        .admin-search-keywords .ask-create-form .btn {
            width: 100%;
        }
    }

    @@media (max-width: 1199.98px) {
        .admin-search-keywords .ask-table-wrap {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .admin-search-keywords .ask-table {
            min-width: 980px;
        }
    }
</style>

<div class="admin-search-keywords">
    <section class="admin-card ask-card">
        <form method="get" class="ask-filter-form">
            <div>
                <label class="form-label small" for="keywordFilter">Tìm từ khóa</label>
                <input id="keywordFilter" name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Nhập từ khóa cần lọc" />
            </div>
            <button class="btn btn-danger ask-btn" type="submit"><i class="bi bi-search"></i> Lọc</button>
        </form>
    </section>

    <section class="admin-card ask-card">
        <h5 class="mb-3">Thêm từ khóa thủ công</h5>
        <form asp-action="Create" method="post" class="ask-create-form">
            @Html.AntiForgeryToken()
            <div>
                <label class="form-label small" for="createKeyword">Từ khóa</label>
                <input id="createKeyword" name="keyword" class="form-control" maxlength="120" required />
            </div>
            <div class="ask-check-field">
                <input class="form-check-input" type="checkbox" name="isVisible" value="true" checked id="createVisible">
                <label class="form-check-label" for="createVisible">Hiển thị</label>
            </div>
            <div class="ask-check-field">
                <input class="form-check-input" type="checkbox" name="isPinned" value="true" id="createPinned">
                <label class="form-check-label" for="createPinned">Ghim</label>
            </div>
            <button class="btn btn-danger ask-btn" type="submit"><i class="bi bi-plus-circle"></i> Thêm</button>
        </form>
    </section>

    <section class="admin-card ask-card ask-table-card">
        <div class="ask-table-wrap">
            <table class="table align-middle ask-table">
                <thead>
                    <tr>
                        <th class="ask-col-keyword">Từ khóa</th>
                        <th class="ask-col-count text-center">Lượt tìm</th>
                        <th class="ask-col-date">Lần tìm gần nhất</th>
                        <th class="ask-col-check">Hiển thị</th>
                        <th class="ask-col-check">Ghim</th>
                        <th class="ask-col-actions text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Chưa có từ khóa tìm kiếm thật.</td></tr>
                }
                @foreach (var item in Model)
                {
                    var formId = $"keyword-edit-{item.Id}";
                    <tr>
                        <td>
                            <form id="@formId" asp-action="Edit" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <input name="keyword" value="@item.Keyword" class="form-control ask-keyword-input" maxlength="120" required title="@item.Keyword" />
                            </form>
                        </td>
                        <td class="text-center"><input form="@formId" name="searchCount" value="@item.SearchCount" type="number" min="0" class="form-control ask-count-input" /></td>
                        <td><span class="ask-date-text">@item.LastSearchedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></td>
                        <td class="ask-check-cell"><input form="@formId" class="form-check-input" type="checkbox" name="isVisible" value="true" checked="@item.IsVisible" aria-label="Hiển thị @item.Keyword" /></td>
                        <td class="ask-check-cell"><input form="@formId" class="form-check-input" type="checkbox" name="isPinned" value="true" checked="@item.IsPinned" aria-label="Ghim @item.Keyword" /></td>
                        <td>
                            <div class="ask-actions">
                                <button form="@formId" class="btn btn-sm btn-primary" type="submit"><i class="bi bi-save"></i> Lưu</button>
                                <div class="ask-action-dropdown">
                                    <button class="btn btn-sm ask-action-toggle dropdown-toggle" type="button" aria-expanded="false">Thao tác</button>
                                    <div class="ask-action-menu" role="menu">
                                        <form asp-action="ToggleVisible" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><button class="dropdown-item" type="submit"><i class="bi bi-eye-slash"></i>@(item.IsVisible ? "Ẩn" : "Hiện")</button></form>
                                        <form asp-action="TogglePinned" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><button class="dropdown-item" type="submit"><i class="bi bi-pin-angle"></i>@(item.IsPinned ? "Bỏ ghim" : "Ghim")</button></form>
                                        <form asp-action="ResetCount" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><button class="dropdown-item" type="submit"><i class="bi bi-arrow-counterclockwise"></i>Reset</button></form>
                                        <form asp-action="Delete" method="post" data-confirm-message="Bạn có chắc muốn xóa từ khóa này không?" data-confirm-title="Xóa từ khóa" data-confirm-text="Xóa" data-cancel-text="Hủy" data-confirm-type="danger">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><button class="dropdown-item text-danger" type="submit"><i class="bi bi-trash"></i>Xóa</button></form>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</div>


<script>
(() => {
    const root = document.querySelector('.admin-search-keywords');
    if (!root) return;

    const dropdowns = Array.from(root.querySelectorAll('.ask-action-dropdown'));
    let activeDropdown = null;

    const closeDropdown = (dropdown = activeDropdown) => {
        if (!dropdown) return;
        const toggle = dropdown.querySelector('.ask-action-toggle');
        const menu = dropdown.querySelector('.ask-action-menu');
        toggle?.setAttribute('aria-expanded', 'false');
        menu?.classList.remove('is-open');
        if (activeDropdown === dropdown) activeDropdown = null;
    };

    const positionMenu = (dropdown) => {
        const toggle = dropdown.querySelector('.ask-action-toggle');
        const menu = dropdown.querySelector('.ask-action-menu');
        if (!toggle || !menu) return;

        const gap = 6;
        const edge = 12;
        const toggleRect = toggle.getBoundingClientRect();
        const menuRect = menu.getBoundingClientRect();
        const menuWidth = menuRect.width || 168;
        const menuHeight = menuRect.height || 170;

        let left = toggleRect.left;
        if (left + menuWidth > window.innerWidth - edge) {
            left = toggleRect.right - menuWidth;
        }
        left = Math.max(edge, Math.min(left, window.innerWidth - menuWidth - edge));

        let top = toggleRect.bottom + gap;
        if (top + menuHeight > window.innerHeight - edge && toggleRect.top > menuHeight + gap + edge) {
            top = toggleRect.top - menuHeight - gap;
        }
        top = Math.max(edge, top);

        menu.style.left = `${left}px`;
        menu.style.top = `${top}px`;
    };

    const openDropdown = (dropdown) => {
        if (activeDropdown && activeDropdown !== dropdown) closeDropdown(activeDropdown);
        activeDropdown = dropdown;
        const toggle = dropdown.querySelector('.ask-action-toggle');
        const menu = dropdown.querySelector('.ask-action-menu');
        toggle?.setAttribute('aria-expanded', 'true');
        menu?.classList.add('is-open');
        positionMenu(dropdown);
    };

    dropdowns.forEach((dropdown) => {
        const toggle = dropdown.querySelector('.ask-action-toggle');
        const menu = dropdown.querySelector('.ask-action-menu');
        if (!toggle || !menu) return;

        toggle.addEventListener('click', (event) => {
            event.preventDefault();
            event.stopPropagation();
            activeDropdown === dropdown ? closeDropdown(dropdown) : openDropdown(dropdown);
        });

        menu.addEventListener('click', (event) => {
            event.stopPropagation();
        });
    });

    document.addEventListener('click', (event) => {
        if (activeDropdown && !activeDropdown.contains(event.target)) closeDropdown(activeDropdown);
    });
    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeDropdown();
    });
    window.addEventListener('resize', () => activeDropdown && positionMenu(activeDropdown));
    window.addEventListener('scroll', () => activeDropdown && positionMenu(activeDropdown), true);
})();
</script>
