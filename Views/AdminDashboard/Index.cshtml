@model Datn.PcStore.ViewModels.AdminDashboardVm
@{
    ViewData["Title"] = "Dashboard quản trị";
}

<h3 class="mb-3">Tổng quan quản trị</h3>
<div class="row g-3 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="admin-stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="admin-stat-label">Sản phẩm</div>
                    <div class="admin-stat-value">@Model.ProductCount</div>
                </div>
                <div class="admin-stat-icon bg-primary-subtle text-primary"><i class="bi bi-box-seam"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="admin-stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="admin-stat-label">Đơn hàng</div>
                    <div class="admin-stat-value">@Model.OrderCount</div>
                </div>
                <div class="admin-stat-icon bg-success-subtle text-success"><i class="bi bi-receipt"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="admin-stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="admin-stat-label">Người dùng</div>
                    <div class="admin-stat-value">@Model.UserCount</div>
                </div>
                <div class="admin-stat-icon bg-warning-subtle text-warning"><i class="bi bi-people"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="admin-stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="admin-stat-label">Yêu cầu bảo hành</div>
                    <div class="admin-stat-value">@Model.WarrantyRequestCount</div>
                </div>
                <div class="admin-stat-icon bg-danger-subtle text-danger"><i class="bi bi-shield-check"></i></div>
            </div>
        </div>
    </div>
</div>

<div class="list-group">
    <a class="list-group-item list-group-item-action" asp-controller="AdminCategories" asp-action="Index">Quản lý danh mục</a>
    <a class="list-group-item list-group-item-action" asp-controller="AdminProducts" asp-action="Index">Quản lý sản phẩm</a>
    <a class="list-group-item list-group-item-action" asp-controller="AdminUsers" asp-action="Index">Quản lý tài khoản</a>
    <a class="list-group-item list-group-item-action" asp-controller="AdminOrders" asp-action="Index">Quản lý đơn hàng</a>
    <a class="list-group-item list-group-item-action" asp-controller="AdminBanners" asp-action="Index">Quản lý banner</a>
    <a class="list-group-item list-group-item-action" asp-controller="AdminWarranty" asp-action="Index">Yêu cầu bảo hành</a>
    <a class="list-group-item list-group-item-action" asp-controller="Articles" asp-action="Index">Tin tức / khuyến mãi</a>
    <a class="list-group-item list-group-item-action" asp-controller="Contact" asp-action="Manage">Feedback liên hệ</a>
    <a class="list-group-item list-group-item-action" asp-controller="AdminChat" asp-action="Index">Hỗ trợ khách hàng</a>
</div>
