@model CompareIndexVm
@{
    ViewData["Title"] = "So sánh sản phẩm";
    var culture = new System.Globalization.CultureInfo("vi-VN");
}

<div class="compare-page pb-5">
    <div class="compare-hero text-center mb-4">
        <div class="small text-uppercase text-danger fw-bold">PC Store</div>
        <h1 class="compare-title mb-2">So sánh sản phẩm</h1>
        <p class="text-muted mb-0">Chọn tối đa 2 sản phẩm, xem danh sách đang so sánh và đối chiếu thông số kỹ thuật cạnh nhau.</p>
    </div>

    @if (!Model.Products.Any())
    {
        <div class="compare-empty-state card border-0 shadow-sm mx-auto">
            <div class="card-body text-center p-5">
                <i class="bi bi-columns-gap display-4 text-danger"></i>
                <h4 class="mt-3">Bạn chưa chọn sản phẩm nào để so sánh.</h4>
                <p class="text-muted">Hãy quay lại danh sách sản phẩm và bấm nút So sánh nhỏ trên card sản phẩm.</p>
                <a asp-controller="Products" asp-action="Index" class="btn btn-primary">Tiếp tục mua sắm</a>
            </div>
        </div>
    }
    else
    {
        <div class="compare-selected-grid mb-4">
            @for (var i = 0; i < 2; i++)
            {
                var product = Model.Products.ElementAtOrDefault(i);
                <div class="compare-selected-card card border-0 shadow-sm h-100">
                    <div class="card-body">
                        @if (product != null)
                        {
                            <div class="d-flex gap-3 align-items-start">
                                <img src="@product.ImageUrl" alt="@product.Name" onerror="this.onerror=null;this.src='/images/no-image.png';" />
                                <div class="min-w-0 flex-grow-1">
                                    <a asp-controller="Products" asp-action="Detail" asp-route-id="@product.Id" class="compare-selected-name">@product.Name</a>
                                    <div class="compare-price">@product.Price.ToString("N0", culture) đ</div>
                                    @if (product.Price < product.OriginalPrice)
                                    {
                                        <div class="compare-old-price">@product.OriginalPrice.ToString("N0", culture) đ</div>
                                    }
                                    <form method="post" asp-controller="Compare" asp-action="Remove" class="mt-3">
                                        <input type="hidden" name="productId" value="@product.Id" />
                                        <input type="hidden" name="returnUrl" value="/Compare" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-x-circle"></i> Xóa sản phẩm</button>
                                    </form>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="compare-pick-more text-center h-100">
                                <i class="bi bi-plus-circle display-6 text-muted"></i>
                                <h5>Chọn thêm sản phẩm để so sánh</h5>
                                <p class="text-muted mb-3">Bạn cần đủ 2 sản phẩm để bật bảng so sánh chi tiết.</p>
                                <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary">Quay lại danh sách sản phẩm</a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @if (!Model.HasEnoughProducts)
        {
            <div class="alert alert-warning d-flex align-items-center gap-2">
                <i class="bi bi-info-circle"></i>
                <span>Vui lòng chọn thêm 1 sản phẩm để so sánh.</span>
            </div>
        }
        else
        {
            <div class="compare-table-card card border-0 shadow-sm">
                <div class="card-header bg-white border-0 pt-3">
                    <h5 class="mb-0 fw-bold">Bảng thông số kỹ thuật</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive compare-table-responsive">
                        <table class="table compare-table mb-0 align-middle">
                            <thead class="compare-sticky-head">
                                <tr>
                                    <th class="compare-spec-col">Thông số</th>
                                    @foreach (var product in Model.Products.Take(2))
                                    {
                                        <th class="compare-product-col">
                                            <div class="compare-product-head">
                                                <img src="@product.ImageUrl" alt="@product.Name" onerror="this.onerror=null;this.src='/images/no-image.png';" />
                                                <div>
                                                    <a asp-controller="Products" asp-action="Detail" asp-route-id="@product.Id" class="compare-product-name">@product.Name</a>
                                                    <div class="compare-price">@product.Price.ToString("N0", culture) đ</div>
                                                </div>
                                            </div>
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="compare-mobile-info-row">
                                    <th>Giá</th>
                                    <td>@(Model.Products.ElementAtOrDefault(0) is { } productA ? $"{productA.Price.ToString("N0", culture)} đ" : "-")</td>
                                    <td>@(Model.Products.ElementAtOrDefault(1) is { } productB ? $"{productB.Price.ToString("N0", culture)} đ" : "-")</td>
                                </tr>
                                @if (Model.Rows.Any())
                                {
                                    @foreach (var row in Model.Rows)
                                    {
                                        <tr>
                                            <th class="compare-spec-label">@row.Label</th>
                                            <td class="compare-spec-value">@row.ProductAValue</td>
                                            <td class="compare-spec-value">@row.ProductBValue</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-4">Chưa có thông số kỹ thuật để hiển thị.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <div class="d-flex flex-wrap gap-2 justify-content-center mt-4">
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary">Tiếp tục mua sắm</a>
            <a asp-controller="Compare" asp-action="Clear" asp-route-returnUrl="/Compare" class="btn btn-outline-secondary">Xóa tất cả</a>
        </div>
    }
</div>
