@model List<Category>
<div class="d-flex justify-content-between mb-3">
    <h3>Danh mục</h3>
    <a class="btn btn-primary" asp-action="Create">Thêm danh mục</a>
</div>
@if (TempData["Err"] != null)
{
    <div class="alert alert-warning">@TempData["Err"]</div>
}
<table class="table table-striped align-middle">
    <thead><tr><th>Tên</th><th>Icon</th><th class="text-end">Tác vụ</th></tr></thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.Name</td>
            <td><i class="@c.IconClass me-2"></i>@c.IconClass</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id">Sửa</a>
                <form method="post" asp-action="Delete" class="d-inline">
                    <input type="hidden" name="id" value="@c.Id" />
                    <button class="btn btn-sm btn-outline-danger">Xóa</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
