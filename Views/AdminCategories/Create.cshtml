@model Category
<h3>Tạo danh mục</h3>
<form method="post" class="admin-form-grid admin-form-card">
    <div class="admin-field-medium"><label class="form-label">Tên</label><input asp-for="Name" class="form-control" /></div>
    <div class="admin-field-short"><label class="form-label">Icon bootstrap</label><input asp-for="IconClass" class="form-control" placeholder="bi bi-cpu" /></div>
    <div class="admin-field-full"><button class="btn btn-primary">Lưu</button></div>
</form>
