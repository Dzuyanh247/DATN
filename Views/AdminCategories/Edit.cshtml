@model Category
<h3>Sửa danh mục</h3>
<form method="post" class="admin-form-grid admin-form-card">
    <input type="hidden" asp-for="Id" />
    <div class="admin-field-md"><label class="form-label">Tên danh mục</label><input asp-for="Name" class="form-control" /></div>
    <div class="admin-field-sm"><label class="form-label">Icon class</label><input asp-for="IconClass" class="form-control" placeholder="bi bi-cpu" /></div>
    <div class="admin-field-full"><button class="btn btn-primary">Lưu</button></div>
</form>
