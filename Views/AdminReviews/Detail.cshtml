@model ProductReview
@{
    ViewData["Title"] = "Chi tiết đánh giá";
    var image = ImageUrlHelper.ResolveImageUrl(Model.Product?.ThumbnailImage, "/images/placeholders/product-placeholder.png");
}
<div class="admin-page-heading">
    <div><span class="admin-eyebrow">Đánh giá #@Model.Id</span><h2>Chi tiết đánh giá sản phẩm</h2><p>Thông tin mua hàng, nội dung khách gửi và lịch sử xử lý.</p></div>
    <span class="badge @ReviewStatusHelper.BadgeClass(Model.Status) fs-6">@ReviewStatusHelper.Label(Model.Status)</span>
</div>
<div class="row g-4">
    <div class="col-xl-7">
        <section class="admin-card mb-4">
            <h3 class="h5 mb-3"><i class="bi bi-box-seam text-primary"></i> Thông tin sản phẩm</h3>
            <div class="d-flex gap-3 align-items-center">
                <img src="@image" alt="@Model.Product?.Name" class="rounded border" style="width:110px;height:110px;object-fit:contain"/>
                <div><h4 class="h5">@Model.Product?.Name</h4><p class="text-muted mb-2">Mã sản phẩm: @(Model.Product?.ProductCode ?? "—")</p><a asp-controller="Products" asp-action="Detail" asp-route-id="@Model.ProductId" target="_blank">Xem sản phẩm <i class="bi bi-box-arrow-up-right"></i></a></div>
            </div>
        </section>
        <section class="admin-card mb-4">
            <h3 class="h5 mb-3"><i class="bi bi-person-check text-success"></i> Thông tin khách hàng</h3>
            <div class="row g-3"><div class="col-md-6"><small class="text-muted d-block">Khách hàng</small><strong>@Model.User?.FullName</strong></div><div class="col-md-6"><small class="text-muted d-block">Đơn hàng</small><a asp-controller="AdminOrders" asp-action="Detail" asp-route-id="@Model.OrderId">DH@Model.OrderId.ToString("D6")</a></div><div class="col-md-6"><small class="text-muted d-block">Ngày mua</small><strong>@DateTimeHelper.FormatVietnam(Model.Order?.CreatedAt,"dd/MM/yyyy HH:mm")</strong></div><div class="col-md-6"><small class="text-muted d-block">Xác thực</small><span class="badge text-bg-success">Đã mua hàng</span></div></div>
        </section>
        <section class="admin-card">
            <h3 class="h5 mb-3"><i class="bi bi-chat-quote text-warning"></i> Nội dung đánh giá</h3>
            <div class="text-warning fs-4 mb-2">@for(var i=1;i<=5;i++){<i class="bi @(i<=Model.Rating?"bi-star-fill":"bi-star")"></i>}</div>
            <p class="p-3 bg-light rounded-3 mb-3" style="white-space:pre-wrap">@Model.Comment</p>
            <div class="d-flex justify-content-between"><span>Ngày đánh giá: <strong>@DateTimeHelper.FormatVietnam(Model.CreatedAt,"dd/MM/yyyy HH:mm")</strong></span><span class="badge @ReviewStatusHelper.BadgeClass(Model.Status)">@ReviewStatusHelper.Label(Model.Status)</span></div>
        </section>
    </div>
    <div class="col-xl-5">
        <section class="admin-card position-sticky" style="top:1rem">
            <h3 class="h5 mb-3"><i class="bi bi-shield-check text-primary"></i> Xử lý của quản trị viên</h3>
            <form asp-action="Update" method="post">
                <input type="hidden" name="id" value="@Model.Id"/>
                <label class="form-label fw-semibold">Trạng thái</label>
                <select class="form-select mb-3" name="status">@foreach(var s in Enum.GetValues<ReviewStatus>()){<option value="@s" selected="@(Model.Status==s)">@ReviewStatusHelper.Label(s)</option>}</select>
                <label class="form-label fw-semibold">Phản hồi của shop</label>
                <textarea class="form-control mb-3" name="adminReply" maxlength="1000" rows="8" placeholder="Nhập phản hồi công khai tới khách hàng...">@Model.AdminReply</textarea>
                <div class="p-3 bg-light rounded-3 mb-3">
                    <div><small class="text-muted">Người xử lý</small><strong class="d-block">@(Model.HandledByStaffName ?? "Chưa phân công")</strong></div>
                    @if(Model.HandledAt.HasValue){<div class="mt-2"><small class="text-muted">Thời gian xử lý</small><strong class="d-block">@DateTimeHelper.FormatVietnam(Model.HandledAt,"dd/MM/yyyy HH:mm")</strong></div>}
                    @if(Model.AdminRepliedAt.HasValue){<div class="mt-2"><small class="text-muted">Thời gian phản hồi</small><strong class="d-block">@DateTimeHelper.FormatVietnam(Model.AdminRepliedAt,"dd/MM/yyyy HH:mm")</strong></div>}
                </div>
                <div class="d-grid gap-2"><button class="btn btn-primary"><i class="bi bi-save"></i> Lưu cập nhật</button><a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> Quay lại danh sách</a></div>
            </form>
        </section>
    </div>
</div>
