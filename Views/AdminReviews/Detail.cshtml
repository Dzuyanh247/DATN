@model ProductReview
@{ViewData["Title"]="Chi tiết đánh giá";}
<div class="row g-4"><div class="col-lg-8"><section class="admin-card"><h3>@Model.Product?.Name</h3><p><span class="badge text-bg-success">Đã mua hàng</span> @Model.User?.FullName · Đơn @($"DH{Model.OrderId:D6}")</p><div class="text-warning fs-5">@for(var i=1;i<=5;i++){<i class="bi @(i<=Model.Rating?"bi-star-fill":"bi-star")"></i>}</div><p class="mt-3" style="white-space:pre-wrap">@Model.Comment</p><small>@DateTimeHelper.FormatVietnam(Model.CreatedAt,"dd/MM/yyyy HH:mm")</small></section></div><div class="col-lg-4"><section class="admin-card"><form asp-action="Update" method="post"><input type="hidden" name="id" value="@Model.Id"/><label class="form-label">Trạng thái</label><select class="form-select mb-3" name="status">@foreach(var s in Enum.GetValues<ReviewStatus>()){<option value="@s" selected="@(Model.Status==s)">@s</option>}</select><label class="form-label">Phản hồi của shop</label><textarea class="form-control mb-3" name="adminReply" maxlength="1000" rows="7">@Model.AdminReply</textarea><button class="btn btn-primary w-100">Lưu cập nhật</button></form></section></div></div>
