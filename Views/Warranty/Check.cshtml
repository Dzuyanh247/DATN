@model WarrantyCheckVm
@{
    ViewData["Title"] = "Kiểm tra bảo hành";
}
<link rel="stylesheet" href="~/css/warranty.css" asp-append-version="true" />

<div class="warranty-page">
    <section class="warranty-hero">
        <div class="warranty-hero__icon"><i class="bi bi-shield-check"></i></div>
        <div>
            <span class="warranty-eyebrow">Dịch vụ sau bán hàng</span>
            <h1>Kiểm tra bảo hành</h1>
            <p>Tra cứu nhanh thời hạn và gửi yêu cầu hỗ trợ cho sản phẩm đã mua tại KKSHOP.</p>
        </div>
    </section>

    <section class="warranty-search-card">
        <form method="get" asp-action="Check" class="warranty-search-form">
            <div class="flex-grow-1">
                <label asp-for="Query" class="form-label fw-semibold"></label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input asp-for="Query" class="form-control" placeholder="Ví dụ: DH000123, BH-DH000123-CT000456 hoặc 0912345678" required />
                </div>
                <div class="form-text">Mã đơn hàng nằm trong trang chi tiết đơn; mã bảo hành hiển thị bên dưới sau khi tra cứu.</div>
            </div>
            <button class="btn btn-danger btn-lg" type="submit"><i class="bi bi-shield-check me-2"></i>Kiểm tra ngay</button>
        </form>
        <div class="warranty-quick-links">
            <a asp-action="MyRequests"><i class="bi bi-clock-history"></i> Theo dõi yêu cầu đã gửi</a>
            <span><i class="bi bi-headset"></i> Cần hỗ trợ? Liên hệ shop qua khung chat</span>
        </div>
    </section>

    @if (Model.HasSearched)
    {
        <section class="mt-4">
            <div class="warranty-section-title">
                <div><span>Kết quả tra cứu</span><h2>@Model.Products.Count sản phẩm được tìm thấy</h2></div>
            </div>
            @if (!Model.Products.Any())
            {
                <div class="warranty-empty"><i class="bi bi-search"></i><h3>Chưa tìm thấy thông tin</h3><p>Vui lòng kiểm tra lại mã đơn hàng, mã bảo hành hoặc số điện thoại đã nhập.</p></div>
            }
            else
            {
                <div class="warranty-product-list">
                @foreach (var item in Model.Products)
                {
                    var image = ImageUrlHelper.ResolveImageUrl(item.ProductImage, "/images/placeholders/product-placeholder.png");
                    var canRequest = item.IsEligibleOrder && item.IsInWarranty && !item.HasActiveRequest;
                    <article class="warranty-product-card">
                        <img src="@image" alt="@item.ProductName" onerror="this.onerror=null;this.src='/images/placeholders/product-placeholder.png';" />
                        <div class="warranty-product-card__body">
                            <div class="d-flex flex-wrap align-items-start justify-content-between gap-2">
                                <div><div class="warranty-code">@item.WarrantyCode</div><h3>@item.ProductName</h3><span class="text-muted">Đơn hàng DH@(item.OrderId.ToString("D6"))</span></div>
                                <span class="warranty-availability @(item.IsInWarranty ? "is-active" : "is-expired")"><i class="bi @(item.IsInWarranty ? "bi-check-circle" : "bi-exclamation-circle")"></i> @(item.IsInWarranty ? "Còn bảo hành" : "Hết bảo hành")</span>
                            </div>
                            <div class="warranty-meta-grid">
                                <div><span>Ngày mua</span><strong>@DateTimeHelper.FormatVietnam(item.PurchaseDate, "dd/MM/yyyy")</strong></div>
                                <div><span>Thời hạn</span><strong>@item.WarrantyMonths tháng</strong></div>
                                <div><span>Ngày hết hạn</span><strong>@DateTimeHelper.FormatVietnam(item.ExpiresAt, "dd/MM/yyyy")</strong></div>
                            </div>
                            <div class="warranty-card-action">
                                @if (canRequest)
                                { <a class="btn btn-danger" asp-action="Create" asp-route-orderDetailId="@item.OrderDetailId" asp-route-phone="@Model.Query"><i class="bi bi-tools me-2"></i>Yêu cầu bảo hành</a> }
                                else if (item.HasActiveRequest)
                                { <a class="btn btn-outline-primary" asp-action="MyRequests"><i class="bi bi-clock-history me-2"></i>Đang có yêu cầu xử lý</a> }
                                else if (!item.IsInWarranty)
                                { <p class="warranty-note mb-0"><i class="bi bi-info-circle"></i> Sản phẩm đã hết thời hạn bảo hành, vui lòng liên hệ shop để được hỗ trợ thêm.</p> }
                                else
                                { <p class="warranty-note mb-0"><i class="bi bi-info-circle"></i> Đơn hàng cần hoàn tất hoặc được xác nhận thanh toán/giao hàng trước khi yêu cầu bảo hành.</p> }
                            </div>
                        </div>
                    </article>
                }
                </div>
            }
        </section>
    }
</div>
