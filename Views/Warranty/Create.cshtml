@model WarrantyCreateVm
@{
    ViewData["Title"] = "Gửi yêu cầu bảo hành";
    var image = ImageUrlHelper.ResolveImageUrl(Model.ProductImage, "/images/placeholders/product-placeholder.png");
}
<link rel="stylesheet" href="~/css/warranty.css" asp-append-version="true" />
<div class="warranty-page">
    <div class="warranty-breadcrumb"><a asp-action="Check">Kiểm tra bảo hành</a><i class="bi bi-chevron-right"></i><span>Gửi yêu cầu</span></div>
    <div class="warranty-form-layout">
        <aside class="warranty-summary-card">
            <img src="@image" alt="@Model.ProductName" />
            <span class="warranty-code">@Model.WarrantyCode</span>
            <h2>@Model.ProductName</h2>
            <dl><div><dt>Đơn hàng</dt><dd>@Model.OrderCode</dd></div><div><dt>Ngày mua</dt><dd>@DateTimeHelper.FormatVietnam(Model.PurchaseDate, "dd/MM/yyyy")</dd></div><div><dt>Bảo hành đến</dt><dd>@DateTimeHelper.FormatVietnam(Model.ExpiresAt, "dd/MM/yyyy")</dd></div></dl>
        </aside>
        <section class="warranty-form-card">
            <div class="warranty-section-title"><div><span>Thông tin tiếp nhận</span><h1>Yêu cầu bảo hành</h1></div><i class="bi bi-tools"></i></div>
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input asp-for="OrderDetailId" type="hidden" />
                <div class="row g-3">
                    <div class="col-md-6"><label asp-for="CustomerName" class="form-label"></label><input asp-for="CustomerName" class="form-control" /><span asp-validation-for="CustomerName" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /><span asp-validation-for="Phone" class="text-danger"></span></div>
                    <div class="col-12"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" placeholder="Không bắt buộc" /><span asp-validation-for="Email" class="text-danger"></span></div>
                    <div class="col-12"><label asp-for="IssueTitle" class="form-label"></label><input asp-for="IssueTitle" class="form-control" placeholder="Ví dụ: Máy không lên nguồn" /><span asp-validation-for="IssueTitle" class="text-danger"></span></div>
                    <div class="col-12"><label asp-for="IssueDescription" class="form-label"></label><textarea asp-for="IssueDescription" class="form-control" rows="5" placeholder="Mô tả biểu hiện lỗi, thời điểm xảy ra và các bước bạn đã thử..."></textarea><span asp-validation-for="IssueDescription" class="text-danger"></span></div>
                    <div class="col-12"><label asp-for="EvidenceImage" class="form-label"></label><input asp-for="EvidenceImage" class="form-control" accept="image/jpeg,image/png,image/webp" /><div class="form-text">Không bắt buộc. JPG, PNG hoặc WEBP, tối đa 5 MB.</div><span asp-validation-for="EvidenceImage" class="text-danger"></span></div>
                </div>
                <div class="warranty-submit-bar"><a class="btn btn-light" asp-action="Check" asp-route-query="@Model.OrderCode">Quay lại</a><button class="btn btn-danger" type="submit"><i class="bi bi-send me-2"></i>Gửi yêu cầu</button></div>
            </form>
        </section>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
