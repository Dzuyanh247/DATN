@model List<WarrantyRequest>
@{
    var products = ViewBag.Products as List<Product> ?? new();
}
<h3>Yêu cầu bảo hành</h3>
<form method="post" asp-action="Create" class="row g-2 mb-3">
    <div class="col-md-4"><select class="form-select" name="productId">@foreach (var p in products){<option value="@p.Id">@p.Name</option>}</select></div>
    <div class="col-md-6"><input class="form-control" name="issueDescription" placeholder="Mô tả lỗi" /></div>
    <div class="col-md-2"><button class="btn btn-primary w-100">Gửi</button></div>
</form>
<table class="table table-striped"><thead><tr><th>Sản phẩm</th><th>Mô tả lỗi</th><th>Trạng thái</th></tr></thead><tbody>@foreach (var r in Model){<tr><td>@r.Product?.Name</td><td>@r.IssueDescription</td><td>@r.Status</td></tr>}</tbody></table>
