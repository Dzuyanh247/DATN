@using Datn.PcStore.Helpers
@model Product
@{
    ViewData["Title"] = Model.Name;

    var suggestions = ViewBag.UpgradeSuggestions as List<Product> ?? new();
    var galleryImages = Model.ProductImages.OrderBy(x => x.SortOrder).ToList();
    var mainImage = ImageUrlHelper.ResolveImageUrl(galleryImages.FirstOrDefault()?.ImageUrl
        ?? Model.ThumbnailImage, "/images/no-image.png");
    var galleryImageUrls = galleryImages
        .Select(image => ImageUrlHelper.ResolveImageUrl(image.ImageUrl, "/images/no-image.png"))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();
    if (!galleryImageUrls.Any())
    {
        galleryImageUrls.Add(mainImage);
    }

    var culture = new System.Globalization.CultureInfo("vi-VN");
    var finalPrice = (Model.DiscountPrice ?? Model.SalePrice) ?? Model.Price;
    var savings = Model.Price > finalPrice ? Model.Price - finalPrice : 0;
    var inStock = Model.StockQuantity > 0;
    var warrantyText = Model.WarrantyMonths > 0 ? $"{Model.WarrantyMonths} tháng" : Model.WarrantyDuration;

    var componentSpecs = ProductSpecDisplayHelper.TryParseComponentSpecs(Model.TechnicalSpecifications)
        .Where(spec => !string.IsNullOrWhiteSpace(spec.Description))
        .GroupBy(spec => spec.Description.Trim(), StringComparer.OrdinalIgnoreCase)
        .Select(group => group.First())
        .ToList();
    var descriptionLines = ProductSpecDisplayHelper.GetSafeTextLines(Model, 6, 180)
        .Where(line => !componentSpecs.Any(spec => string.Equals(spec.Description.Trim(), line.Trim(), StringComparison.OrdinalIgnoreCase)))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();
    var promotionLines = ProductPromotionHelper.GetPromotionLines(Model);

    // Tạm ẩn lựa chọn nâng cấp cho đến khi có logic tính lại giá theo cấu hình.
    var showUpgradeOptions = false;
    var upgradeGroups = componentSpecs
        .Select(spec => new { Spec = spec, Group = ProductSpecDisplayHelper.GetSpecGroup(spec.Description) })
        .Where(item => item.Group is "CPU" or "RAM" or "SSD")
        .GroupBy(item => item.Group)
        .ToDictionary(group => group.Key, group => group.Select(item => item.Spec.Description).Distinct(StringComparer.OrdinalIgnoreCase).Take(2).ToList());
    var coolingOptions = componentSpecs
        .Where(spec => spec.Description.Contains("tản", StringComparison.OrdinalIgnoreCase)
            || spec.Description.Contains("cool", StringComparison.OrdinalIgnoreCase))
        .Select(spec => spec.Description)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Take(2)
        .ToList();
    if (coolingOptions.Any())
    {
        upgradeGroups["Tản nhiệt"] = coolingOptions;
    }

    var bundleProducts = suggestions.Take(4).ToList();
    var bundleLabels = new[] { "Màn hình", "Bàn phím", "Chuột", "Tai nghe" };
}

<div class="product-detail-page">
    <div class="product-detail-shell">
        <nav class="product-detail-breadcrumb" aria-label="Điều hướng">
            <a asp-controller="Home" asp-action="Index">Trang chủ</a>
            <i class="bi bi-chevron-right" aria-hidden="true"></i>
            <a asp-controller="Products" asp-action="Index">Sản phẩm</a>
            <i class="bi bi-chevron-right" aria-hidden="true"></i>
            <span aria-current="page">@Model.Name</span>
        </nav>

        <section class="product-detail-card" aria-labelledby="product-title">
            <div class="product-detail-grid">
                <div class="product-detail-media">
                    <div class="product-gallery-card">
                        <div class="product-gallery-main">
                            <img id="main-product-image"
                                 src="@mainImage"
                                 alt="@Model.Name"
                                 onerror="this.onerror=null;this.src='/images/no-image.png';" />
                        </div>

                        <div class="product-gallery-thumbs" aria-label="Ảnh sản phẩm">
                            @for (var i = 0; i < galleryImageUrls.Count; i++)
                            {
                                var imageUrl = galleryImageUrls[i];
                                <button type="button"
                                        class="thumb-btn @(i == 0 ? "active" : string.Empty)"
                                        data-src="@imageUrl"
                                        aria-label="Xem ảnh sản phẩm @(i + 1)"
                                        aria-pressed="@(i == 0 ? "true" : "false")">
                                    <img src="@imageUrl"
                                         alt="Ảnh thu nhỏ @(i + 1) của @Model.Name"
                                         onerror="this.onerror=null;this.src='/images/no-image.png';" />
                                </button>
                            }
                        </div>
                    </div>

                    @if (bundleProducts.Any())
                    {
                        <section class="bundle-section" aria-labelledby="bundle-title">
                            <div class="bundle-heading">
                                <h2 id="bundle-title"><i class="bi bi-plus-circle-fill" aria-hidden="true"></i>Sản phẩm mua kèm</h2>
                                <span>Hoàn thiện góc máy của bạn</span>
                            </div>
                            <div class="bundle-grid">
                                @for (var i = 0; i < bundleProducts.Count; i++)
                                {
                                    var product = bundleProducts[i];
                                    var bundlePrice = (product.DiscountPrice ?? product.SalePrice) ?? product.Price;
                                    var bundleType = !string.IsNullOrWhiteSpace(product.ComponentType) && !string.Equals(product.ComponentType, "Khác", StringComparison.OrdinalIgnoreCase)
                                        ? product.ComponentType
                                        : product.Category?.Name ?? bundleLabels[Math.Min(i, bundleLabels.Length - 1)];
                                    var bundleImage = ImageUrlHelper.ResolveImageUrl(product.ProductImages.OrderBy(x => x.SortOrder).FirstOrDefault()?.ImageUrl
                                        ?? product.ThumbnailImage, "/images/no-image.png");
                                    <article class="bundle-card">
                                        <a asp-controller="Products" asp-action="Detail" asp-route-id="@product.Id" class="bundle-image" aria-label="Xem @product.Name">
                                            <img src="@bundleImage" alt="@product.Name" onerror="this.onerror=null;this.src='/images/no-image.png';" />
                                        </a>
                                        <span class="bundle-type">@bundleType</span>
                                        <a asp-controller="Products" asp-action="Detail" asp-route-id="@product.Id" class="bundle-name">@product.Name</a>
                                        <strong>@bundlePrice.ToString("N0", culture) đ</strong>
                                        <a asp-controller="Products" asp-action="Detail" asp-route-id="@product.Id" class="bundle-select-btn">Chọn sản phẩm</a>
                                    </article>
                                }
                            </div>
                            <div class="bundle-subtotal"><span>Tạm tính từ</span><strong>@finalPrice.ToString("N0", culture) đ</strong></div>
                        </section>
                    }
                </div>

                <aside class="product-info-card">
                    <div class="product-detail-heading">
                        <div class="product-heading-meta">
                            @if (!string.IsNullOrWhiteSpace(Model.Brand))
                            {
                                <span class="product-brand">@Model.Brand</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.ProductCode))
                            {
                                <span class="product-code">Mã SP: @Model.ProductCode</span>
                            }
                        </div>
                        <h1 id="product-title" class="product-name">@Model.Name</h1>
                    </div>

                    <div class="price-box">
                        <div class="price-copy">
                            <small>Giá ưu đãi</small>
                            <div class="price-row">
                                <span class="price-current">@finalPrice.ToString("N0", culture) đ</span>
                                @if (finalPrice < Model.Price)
                                {
                                    <span class="price-old">@Model.Price.ToString("N0", culture) đ</span>
                                }
                            </div>
                        </div>
                        @if (savings > 0)
                        {
                            <div class="product-savings"><small>Tiết kiệm</small><strong>@savings.ToString("N0", culture) đ</strong></div>
                        }
                    </div>

                    <div class="product-meta-pills">
                        <span class="product-meta-pill warranty-pill"><i class="bi bi-shield-check" aria-hidden="true"></i>Bảo hành: @warrantyText</span>
                        <span class="product-meta-pill stock-pill @(inStock ? "in-stock" : "out-of-stock")">
                            <i class="bi @(inStock ? "bi-check-circle-fill" : "bi-x-circle-fill")" aria-hidden="true"></i>
                            @(inStock ? $"Còn hàng: {Model.StockQuantity}" : "Hết hàng")
                        </span>
                        <span class="product-meta-pill advice-pill"><i class="bi bi-tools" aria-hidden="true"></i>Tư vấn nâng cấp</span>
                    </div>

                    @if (descriptionLines.Any())
                    {
                        <div class="spec-summary-box">
                            <div class="compact-box-title"><i class="bi bi-card-checklist" aria-hidden="true"></i><span>Mô tả sản phẩm</span></div>
                            <ul>
                                @foreach (var line in descriptionLines)
                                {
                                    <li><i class="bi bi-check" aria-hidden="true"></i><span>@line</span></li>
                                }
                            </ul>
                        </div>
                    }

                    @if (showUpgradeOptions && upgradeGroups.Any())
                    {
                        <div class="upgrade-box">
                            <div class="commerce-box-header"><span><i class="bi bi-gear-fill" aria-hidden="true"></i>UPGRADE</span><small>Tùy chọn cấu hình</small></div>
                            <div class="upgrade-content">
                                @foreach (var group in upgradeGroups)
                                {
                                    <div class="upgrade-row">
                                        <span class="upgrade-label">@group.Key</span>
                                        <div class="upgrade-options">
                                            @for (var i = 0; i < group.Value.Count; i++)
                                            {
                                                <button type="button" class="upgrade-option @(i == 0 ? "active" : string.Empty)" aria-pressed="@(i == 0 ? "true" : "false")">
                                                    @group.Value[i]
                                                    @if (i == 0)
                                                    {
                                                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                                                    }
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="promo-box">
                        <div class="commerce-box-header"><span><i class="bi bi-gift-fill" aria-hidden="true"></i>KHUYẾN MÃI</span><small>Quà tặng kèm</small></div>
                        <ul class="product-promotion-list">
                            @foreach (var promotion in promotionLines)
                            {
                                <li><i class="bi bi-gift" aria-hidden="true"></i><span>@promotion</span></li>
                            }
                        </ul>
                    </div>

                    <form method="post" asp-controller="Cart" asp-action="Add" class="purchase-form">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <div class="purchase-quantity">
                            <label for="product-quantity">Số lượng</label>
                            <div class="quantity-stepper">
                                <button type="button" class="quantity-btn" data-quantity-action="decrease" aria-label="Giảm số lượng">−</button>
                                <input id="product-quantity" type="number" name="quantity" value="1" min="1" max="@(Math.Max(1, Model.StockQuantity))" @(inStock ? string.Empty : "disabled") />
                                <button type="button" class="quantity-btn" data-quantity-action="increase" aria-label="Tăng số lượng">+</button>
                            </div>
                            <span class="stock-note">@(inStock ? $"Sẵn có {Model.StockQuantity} sản phẩm" : "Sản phẩm đang tạm hết hàng")</span>
                        </div>
                        <div class="detail-action-row">
                            <button class="btn product-buy-now" type="submit" name="purchaseMode" value="buy-now" @(inStock ? string.Empty : "disabled")>
                                <i class="bi bi-lightning-charge-fill" aria-hidden="true"></i><span><strong>ĐẶT HÀNG</strong><small>Giao hàng tận nơi</small></span>
                            </button>
                            <button class="btn product-add-cart" type="submit" name="purchaseMode" value="add-cart" @(inStock ? string.Empty : "disabled")>
                                <i class="bi bi-cart-plus" aria-hidden="true"></i><span>THÊM VÀO GIỎ</span>
                            </button>
                        </div>
                    </form>

                    <div class="product-compare-action"><partial name="_CompareButton" model="Model" /></div>
                </aside>
            </div>
        </section>

        @if (componentSpecs.Any() || descriptionLines.Any())
        {
            <section class="product-detail-section product-spec-section" aria-labelledby="product-spec-title">
                <div class="product-section-heading">
                    <div><span class="product-section-kicker">Cấu hình chi tiết</span><h2 id="product-spec-title">THÔNG SỐ KỸ THUẬT</h2></div>
                    <i class="bi bi-cpu" aria-hidden="true"></i>
                </div>
                <div class="table-responsive">
                    <table class="table spec-table mb-0">
                        <thead><tr><th class="text-center spec-order-column">STT</th><th>Mô tả thiết bị</th><th class="text-center spec-quantity-column">SL</th><th class="text-center spec-warranty-column">BH</th></tr></thead>
                        <tbody>
                            @if (componentSpecs.Any())
                            {
                                @for (var i = 0; i < componentSpecs.Count; i++)
                                {
                                    var spec = componentSpecs[i];
                                    <tr><td class="text-center">@(i + 1)</td><td>@spec.Description</td><td class="text-center">@spec.Quantity</td><td class="text-center">@spec.Warranty</td></tr>
                                }
                            }
                            else
                            {
                                @for (var i = 0; i < descriptionLines.Count; i++)
                                {
                                    <tr><td class="text-center">@(i + 1)</td><td>@descriptionLines[i]</td><td class="text-center">1</td><td class="text-center">@warrantyText</td></tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        @if (suggestions.Any())
        {
            <section class="product-detail-section product-related-section" aria-labelledby="related-products-title">
                <div class="product-section-heading">
                    <div><span class="product-section-kicker">Có thể bạn quan tâm</span><h2 id="related-products-title">Sản phẩm liên quan</h2></div>
                    <a asp-controller="Products" asp-action="Index" class="product-view-all">Xem tất cả <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                </div>
                <div class="product-related-grid">
                    @foreach (var product in suggestions)
                    {
                        <partial name="_ProductCard" model="product" />
                    }
                </div>
            </section>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const page = document.querySelector('.product-detail-page');
            if (!page) return;

            page.querySelectorAll('.thumb-btn').forEach(function (button) {
                button.addEventListener('click', function () {
                    const mainImage = page.querySelector('#main-product-image');
                    if (mainImage && this.dataset.src) mainImage.src = this.dataset.src;
                    page.querySelectorAll('.thumb-btn').forEach(function (item) {
                        item.classList.remove('active');
                        item.setAttribute('aria-pressed', 'false');
                    });
                    this.classList.add('active');
                    this.setAttribute('aria-pressed', 'true');
                });
            });

            page.querySelectorAll('.upgrade-option').forEach(function (option) {
                option.addEventListener('click', function () {
                    const options = this.closest('.upgrade-options');
                    options.querySelectorAll('.upgrade-option').forEach(function (item) {
                        item.classList.remove('active');
                        item.setAttribute('aria-pressed', 'false');
                        item.querySelector('.bi-check-lg')?.remove();
                    });
                    this.classList.add('active');
                    this.setAttribute('aria-pressed', 'true');
                    if (!this.querySelector('.bi-check-lg')) {
                        const icon = document.createElement('i');
                        icon.className = 'bi bi-check-lg';
                        icon.setAttribute('aria-hidden', 'true');
                        this.appendChild(icon);
                    }
                });
            });

            const quantity = page.querySelector('#product-quantity');
            page.querySelectorAll('[data-quantity-action]').forEach(function (button) {
                button.addEventListener('click', function () {
                    if (!quantity || quantity.disabled) return;
                    const min = Number(quantity.min) || 1;
                    const max = Number(quantity.max) || Number.MAX_SAFE_INTEGER;
                    const change = this.dataset.quantityAction === 'increase' ? 1 : -1;
                    quantity.value = Math.min(max, Math.max(min, (Number(quantity.value) || min) + change));
                    quantity.dispatchEvent(new Event('change', { bubbles: true }));
                });
            });
        })();
    </script>
}
