@using Datn.PcStore.Helpers
@model ProductDetailViewModel
@{
    var product = Model.Product;
    ViewData["Title"] = product.Name;

    var suggestions = ViewBag.UpgradeSuggestions as List<Product> ?? new();
    var galleryImages = product.ProductImages.OrderBy(x => x.SortOrder).ToList();
    var mainImage = ImageUrlHelper.ResolveImageUrl(galleryImages.FirstOrDefault()?.ImageUrl
        ?? product.ThumbnailImage, "/images/no-image.png");
    var galleryImageUrls = galleryImages
        .Select(image => ImageUrlHelper.ResolveImageUrl(image.ImageUrl, "/images/no-image.png"))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();
    if (!galleryImageUrls.Any())
    {
        galleryImageUrls.Add(mainImage);
    }

    var culture = new System.Globalization.CultureInfo("vi-VN");
    var finalPrice = (product.DiscountPrice ?? product.SalePrice) ?? product.Price;
    var savings = product.Price > finalPrice ? product.Price - finalPrice : 0;
    var inStock = product.StockQuantity > 0;
    var warrantyText = product.WarrantyMonths > 0 ? $"{product.WarrantyMonths} tháng" : product.WarrantyDuration;

    var keyValueSpecs = string.Equals(product.ProductType, ProductKinds.Component, StringComparison.OrdinalIgnoreCase)
        ? ProductSpecificationKeyValueHelper.ParseStored(product.TechnicalSpecifications)
            .Where(spec => !string.IsNullOrWhiteSpace(spec.Name) || !string.IsNullOrWhiteSpace(spec.Value))
            .ToList()
        : new List<Datn.PcStore.ViewModels.ProductSpecificationItemVm>();
    var componentSpecs = ProductSpecDisplayHelper.TryParseComponentSpecs(product.TechnicalSpecifications)
        .Where(spec => !string.IsNullOrWhiteSpace(spec.Description))
        .GroupBy(spec => spec.Description.Trim(), StringComparer.OrdinalIgnoreCase)
        .Select(group => group.First())
        .ToList();
    var fullDescription = ProductSpecDisplayHelper.GetFullDescriptionText(product);
    var descriptionLines = componentSpecs
        .Select(spec => spec.Description.Trim())
        .Concat((fullDescription ?? string.Empty)
            .Replace("\r\n", "\n")
            .Replace('\r', '\n')
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        .Where(line => !string.IsNullOrWhiteSpace(line))
        .Select(line => line.Trim().TrimStart('•', '-', '*', '+').Trim())
        .Where(line => !string.IsNullOrWhiteSpace(line))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Take(8)
        .ToList();
    var promotionLines = ProductPromotionHelper.GetPromotionLines(product);

    var accessorySlots = new[]
    {
        new { Type = Datn.PcStore.Models.ComponentTypes.Monitor, Label = "Màn hình", Products = Model.Monitors, Image = "https://ttgshop.vn/media/category/cat_big_1003486567.png" },
        new { Type = Datn.PcStore.Models.ComponentTypes.Keyboard, Label = "Bàn phím", Products = Model.Keyboards, Image = "https://ttgshop.vn/media/category/cat_big_1003353341.png" },
        new { Type = Datn.PcStore.Models.ComponentTypes.Mouse, Label = "Chuột", Products = Model.Mice, Image = "https://ttgshop.vn/media/category/cat_big_1003353370.png" },
        new { Type = Datn.PcStore.Models.ComponentTypes.Headphone, Label = "Tai nghe", Products = Model.Headsets, Image = "https://ttgshop.vn/media/category/cat_big_1004013226.jpg" }
    };
    var isPcProduct = string.Equals(product.ComponentType, "PC", StringComparison.OrdinalIgnoreCase)
        || (product.Category?.Name?.Contains("PC", StringComparison.OrdinalIgnoreCase) ?? false);
    var reviewSection = ViewBag.ReviewSection as ProductReviewSectionVm ?? new ProductReviewSectionVm { ProductId = product.Id };
}

<div class="product-detail-page">
    <div class="product-detail-page-container product-detail-shell">
        <nav class="product-detail-breadcrumb" aria-label="Điều hướng">
            <a asp-controller="Home" asp-action="Index">Trang chủ</a>
            <i class="bi bi-chevron-right" aria-hidden="true"></i>
            <a asp-controller="Products" asp-action="Index">Sản phẩm</a>
            <i class="bi bi-chevron-right" aria-hidden="true"></i>
            <span aria-current="page">@product.Name</span>
        </nav>

        <section class="product-detail-card" aria-labelledby="product-title">
            <div class="product-detail-grid">
                <div class="product-detail-media">
                    <div class="product-gallery-card">
                        <div class="product-gallery-main">
                            <img id="main-product-image"
                                 src="@mainImage"
                                 alt="@product.Name"
                                 onerror="this.onerror=null;this.src='/images/no-image.png';" />
                        </div>

                        <div class="product-gallery-thumbs" aria-label="Ảnh sản phẩm">
                            @for (var i = 0; i < galleryImageUrls.Count; i++)
                            {
                                var imageUrl = galleryImageUrls[i];
                                <button type="button"
                                        class="thumb-btn @(i == 0 ? "active" : string.Empty)"
                                        data-src="@imageUrl"
                                        aria-label="Xem ảnh sản phẩm @(i + 1)"
                                        aria-pressed="@(i == 0 ? "true" : "false")">
                                    <img src="@imageUrl"
                                         alt="Ảnh thu nhỏ @(i + 1) của @product.Name"
                                         onerror="this.onerror=null;this.src='/images/no-image.png';" />
                                </button>
                            }
                        </div>
                    </div>

                    @if (isPcProduct)
                    {
                    <section class="bundle-section" aria-labelledby="bundle-title" data-accessory-picker data-pc-price="@finalPrice">
                        <div class="bundle-heading">
                            <h2 id="bundle-title"><i class="bi bi-plus-circle-fill" aria-hidden="true"></i>Sản phẩm mua kèm</h2>
                            <span>Chọn màn hình, bàn phím, chuột, tai nghe từ kho linh kiện hiện có</span>
                        </div>
                        <div class="bundle-grid">
                            @foreach (var slot in accessorySlots)
                            {
                                <article class="bundle-card accessory-slot" data-slot-type="@slot.Type" data-slot-label="@slot.Label" data-default-image="@slot.Image" data-default-price-text="Chọn phụ kiện phù hợp">
                                    <div class="bundle-image"><img src="@slot.Image" alt="@slot.Label" onerror="this.onerror=null;this.src='@slot.Image';" /></div>
                                    <span class="bundle-type">@slot.Label</span>
                                    <strong class="bundle-name">Chưa chọn sản phẩm</strong>
                                    <span class="bundle-price">Chọn phụ kiện phù hợp</span>
                                    <div class="bundle-actions">
                                        <button type="button" class="bundle-select-btn" data-open-accessory>Chọn sản phẩm</button>
                                        <button type="button" class="bundle-remove-btn d-none" data-remove-accessory>Xóa lựa chọn</button>
                                    </div>
                                </article>
                            }
                        </div>
                        <div class="bundle-subtotal"><span>Tổng PC + phụ kiện</span><strong id="bundle-total">@finalPrice.ToString("N0", culture) đ</strong></div>
                    </section>
                    }
                </div>

                <aside class="product-info-card">
                    <div class="product-detail-heading">
                        @if (!string.IsNullOrWhiteSpace(product.Brand)
                            && !string.Equals(product.Brand.Trim(), "N/A", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="product-heading-meta">
                                <span class="product-brand">@product.Brand</span>
                            </div>
                        }
                        <h1 id="product-title" class="product-name">@product.Name</h1>
                    </div>

                    <div class="product-price-panel" aria-label="Thông tin giá và bảo hành">
                        <div class="price-box">
                            <span class="price-current">@finalPrice.ToString("N0", culture) đ</span>
                            @if (finalPrice < product.Price)
                            {
                                <span class="price-old">@product.Price.ToString("N0", culture) đ</span>
                            }
                            @if (savings > 0)
                            {
                                <span class="product-savings">Tiết kiệm: @savings.ToString("N0", culture)đ</span>
                            }
                        </div>

                        <div class="product-meta-pills">
                            <span class="product-meta-pill warranty-pill"><i class="bi bi-shield-check" aria-hidden="true"></i>Bảo hành: @warrantyText</span>
                            <span class="product-meta-pill stock-pill @(inStock ? "in-stock" : "out-of-stock")">
                                <i class="bi @(inStock ? "bi-check-circle-fill" : "bi-x-circle-fill")" aria-hidden="true"></i>
                                @(inStock ? $"Còn hàng: {product.StockQuantity}" : "Hết hàng")
                            </span>
                            <span class="product-meta-pill advice-pill"><i class="bi bi-tools" aria-hidden="true"></i>Tư vấn nâng cấp</span>
                        </div>
                    </div>

                    <div class="short-description" aria-labelledby="short-description-title">
                        <h3 id="short-description-title">Mô tả sản phẩm</h3>
                        @if (descriptionLines.Any())
                        {
                            <div class="product-spec-lines">
                                @foreach (var line in descriptionLines)
                                {
                                    <div class="product-spec-line">
                                        <i class="bi bi-check-circle-fill spec-check" aria-hidden="true"></i>
                                        <span class="spec-text">@line</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p>Sản phẩm đang được cập nhật mô tả.</p>
                        }
                    </div>

                    <div class="promo-box">
                        <div class="commerce-box-header"><span><i class="bi bi-gift-fill" aria-hidden="true"></i>KHUYẾN MÃI</span><small>Quà tặng kèm</small></div>
                        <ul class="product-promotion-list">
                            @foreach (var promotion in promotionLines)
                            {
                                <li><i class="bi bi-gift" aria-hidden="true"></i><span>@promotion</span></li>
                            }
                        </ul>
                    </div>

                    <form method="post" asp-controller="Cart" asp-action="AddBundle" class="purchase-form" id="purchase-form">
                        <input type="hidden" name="productId" value="@product.Id" />
                        <div class="purchase-quantity">
                            <label for="product-quantity">Số lượng</label>
                            <div class="quantity-stepper">
                                <button type="button" class="quantity-btn" data-quantity-action="decrease" aria-label="Giảm số lượng">−</button>
                                <input id="product-quantity" type="number" name="quantity" value="1" min="1" max="@(Math.Max(1, product.StockQuantity))" @(inStock ? string.Empty : "disabled") />
                                <button type="button" class="quantity-btn" data-quantity-action="increase" aria-label="Tăng số lượng">+</button>
                            </div>
                            <span class="stock-note">@(inStock ? $"Sẵn có {product.StockQuantity} sản phẩm" : "Sản phẩm đang tạm hết hàng")</span>
                        </div>
                        <div id="selected-accessory-inputs"></div>
                        <div class="detail-action-row">
                            <button class="btn product-buy-now" type="submit" asp-controller="Cart" asp-action="BuyBundle" formmethod="post" disabled="@(!inStock)">
                                <i class="bi bi-lightning-charge-fill" aria-hidden="true"></i><span><strong>ĐẶT HÀNG</strong><small>Giao hàng tận nơi</small></span>
                            </button>
                            <button class="btn product-add-cart" type="submit" asp-controller="Cart" asp-action="AddBundle" formmethod="post" disabled="@(!inStock)">
                                <i class="bi bi-cart-plus" aria-hidden="true"></i><span>THÊM VÀO GIỎ</span>
                            </button>
                        </div>
                    </form>


                    <div class="product-compare-action"><partial name="_CompareButton" model="product" /></div>
                </aside>
            </div>
        </section>

        @if (keyValueSpecs.Any())
        {
            <section class="product-detail-section product-spec-section" aria-labelledby="product-spec-title">
                <div class="product-section-heading">
                    <div><span class="product-section-kicker">Thông tin kỹ thuật</span><h2 id="product-spec-title">THÔNG SỐ KỸ THUẬT</h2></div>
                    <i class="bi bi-cpu" aria-hidden="true"></i>
                </div>
                <div class="table-responsive">
                    <table class="table spec-table mb-0">
                        <thead><tr><th style="width:35%">Tên thông số</th><th>Giá trị</th></tr></thead>
                        <tbody>
                            @foreach (var spec in keyValueSpecs)
                            {
                                <tr><td class="fw-semibold">@spec.Name</td><td>@spec.Value</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
        else if (componentSpecs.Any())
        {
            <section class="product-detail-section product-spec-section" aria-labelledby="product-spec-title">
                <div class="product-section-heading">
                    <div><span class="product-section-kicker">Cấu hình chi tiết</span><h2 id="product-spec-title">THÔNG SỐ KỸ THUẬT</h2></div>
                    <i class="bi bi-cpu" aria-hidden="true"></i>
                </div>
                <div class="table-responsive">
                    <table class="table spec-table mb-0">
                        <thead><tr><th class="text-center spec-order-column">STT</th><th>Mô tả thiết bị</th><th class="text-center spec-quantity-column">SL</th><th class="text-center spec-warranty-column">BH</th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < componentSpecs.Count; i++)
                            {
                                var spec = componentSpecs[i];
                                <tr><td class="text-center">@(i + 1)</td><td>@spec.Description</td><td class="text-center">@spec.Quantity</td><td class="text-center">@spec.Warranty</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        <partial name="_ProductReviews" model="reviewSection" />

        @if (suggestions.Any())
        {
            <section class="product-detail-section product-related-section" aria-labelledby="related-products-title">
                <div class="product-section-heading">
                    <div><span class="product-section-kicker">Có thể bạn quan tâm</span><h2 id="related-products-title">Sản phẩm liên quan</h2></div>
                    <a asp-controller="Products" asp-action="Index" class="product-view-all">Xem tất cả <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                </div>
                <div class="product-related-grid">
                    @foreach (var suggestedProduct in suggestions)
                    {
                        <partial name="_ProductCard" model="suggestedProduct" />
                    }
                </div>
            </section>
        }
    </div>
</div>

<div class="accessory-modal" id="accessory-modal" hidden>
    <div class="accessory-modal-backdrop" data-close-accessory></div>
    <div class="accessory-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="accessory-modal-title">
        <div class="accessory-modal-header">
            <div><span>Sản phẩm được đề xuất</span><h3 id="accessory-modal-title">Chọn sản phẩm mua kèm</h3></div>
            <button type="button" class="accessory-modal-close" data-close-accessory aria-label="Đóng">×</button>
        </div>
        <div class="accessory-filters">
            <input id="accessory-keyword" class="form-control" placeholder="Tìm kiếm sản phẩm" />
            <input id="accessory-min-price" class="form-control" type="number" min="0" placeholder="Giá từ" />
            <input id="accessory-max-price" class="form-control" type="number" min="0" placeholder="Giá đến" />
            <select id="accessory-brand" class="form-select"><option value="">Tất cả thương hiệu</option></select>
            <select id="accessory-category" class="form-select"><option value="">Tất cả danh mục</option></select>
            <select id="accessory-sort" class="form-select"><option value="newest">Mới nhất</option><option value="price_asc">Giá tăng dần</option><option value="price_desc">Giá giảm dần</option></select>
        </div>
        <div id="accessory-loading" class="accessory-state">Đang tải sản phẩm...</div>
        <div id="accessory-empty" class="accessory-state" hidden>Không có sản phẩm phù hợp.</div>
        <div id="accessory-grid" class="accessory-product-grid"></div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const page = document.querySelector('.product-detail-page');
            if (!page) return;

            page.querySelectorAll('.thumb-btn').forEach(function (button) {
                button.addEventListener('click', function () {
                    const mainImage = page.querySelector('#main-product-image');
                    if (mainImage && this.dataset.src) mainImage.src = this.dataset.src;
                    page.querySelectorAll('.thumb-btn').forEach(function (item) {
                        item.classList.remove('active');
                        item.setAttribute('aria-pressed', 'false');
                    });
                    this.classList.add('active');
                    this.setAttribute('aria-pressed', 'true');
                });
            });

            const quantity = page.querySelector('#product-quantity');
            page.querySelectorAll('[data-quantity-action]').forEach(function (button) {
                button.addEventListener('click', function () {
                    if (!quantity || quantity.disabled) return;
                    const min = Number(quantity.min) || 1;
                    const max = Number(quantity.max) || Number.MAX_SAFE_INTEGER;
                    const change = this.dataset.quantityAction === 'increase' ? 1 : -1;
                    quantity.value = Math.min(max, Math.max(min, (Number(quantity.value) || min) + change));
                    quantity.dispatchEvent(new Event('change', { bubbles: true }));
                });
            });


            const modal = document.getElementById('accessory-modal');
            const grid = document.getElementById('accessory-grid');
            const loading = document.getElementById('accessory-loading');
            const empty = document.getElementById('accessory-empty');
            const selectedInputs = document.getElementById('selected-accessory-inputs');
            const bundleSection = page.querySelector('[data-accessory-picker]');
            const bundleTotal = document.getElementById('bundle-total');
            const pcPrice = Number(bundleSection?.dataset.pcPrice || 0);
            const currency = new Intl.NumberFormat('vi-VN');
            const filters = {
                keyword: document.getElementById('accessory-keyword'),
                minPrice: document.getElementById('accessory-min-price'),
                maxPrice: document.getElementById('accessory-max-price'),
                brand: document.getElementById('accessory-brand'),
                category: document.getElementById('accessory-category'),
                sort: document.getElementById('accessory-sort')
            };
            let activeSlot = null;
            let activeType = '';
            const selected = new Map();
            const debounce = (fn, wait) => { let t; return () => { clearTimeout(t); t = setTimeout(fn, wait); }; };

            function openAccessory(slot) {
                activeSlot = slot;
                activeType = slot.dataset.slotType;
                document.getElementById('accessory-modal-title').textContent = 'Chọn ' + slot.dataset.slotLabel;
                modal.hidden = false;
                document.body.classList.add('accessory-modal-open');
                loadAccessories(true);
            }
            function closeAccessory() { modal.hidden = true; document.body.classList.remove('accessory-modal-open'); }
            function renderFacets(facets) {
                const currentBrand = filters.brand.value;
                const currentCategory = filters.category.value;
                filters.brand.innerHTML = '<option value="">Tất cả thương hiệu</option>' + (facets.brands || []).map(x => `<option value="${escapeHtml(x)}">${escapeHtml(x)}</option>`).join('');
                filters.category.innerHTML = '<option value="">Tất cả danh mục</option>' + (facets.categories || []).map(x => `<option value="${x.categoryId}">${escapeHtml(x.name)}</option>`).join('');
                filters.brand.value = currentBrand;
                filters.category.value = currentCategory;
            }
            async function loadAccessories(refreshFacets) {
                loading.hidden = false; empty.hidden = true; grid.innerHTML = '';
                const params = new URLSearchParams({ type: activeType, sort: filters.sort.value });
                if (filters.keyword.value.trim()) params.set('keyword', filters.keyword.value.trim());
                if (filters.minPrice.value) params.set('minPrice', filters.minPrice.value);
                if (filters.maxPrice.value) params.set('maxPrice', filters.maxPrice.value);
                if (filters.brand.value) params.set('brand', filters.brand.value);
                if (filters.category.value) params.set('categoryId', filters.category.value);
                try {
                    const response = await fetch('/api/accessories?' + params.toString(), { headers: { 'Accept': 'application/json' } });
                    const data = await response.json();
                    if (!response.ok) throw new Error(data.message || 'Không thể tải sản phẩm.');
                    if (refreshFacets) renderFacets(data.facets || {});
                    renderProducts(data.products || []);
                } catch (error) {
                    empty.textContent = error.message || 'Không thể tải sản phẩm.'; empty.hidden = false;
                } finally { loading.hidden = true; }
            }
            function renderProducts(products) {
                empty.hidden = products.length > 0;
                grid.innerHTML = products.map(product => `
                    <article class="accessory-product-card">
                        <img src="${escapeHtml(product.image)}" alt="${escapeHtml(product.name)}" onerror="this.onerror=null;this.src='/images/no-image.png';" />
                        <div class="accessory-card-body">
                            <span>${escapeHtml(product.brand || product.categoryName || '')}</span>
                            <h4>${escapeHtml(product.name)}</h4>
                            <div><strong>${currency.format(product.price)} đ</strong>${product.oldPrice > product.price ? `<del>${currency.format(product.oldPrice)} đ</del><em>-${product.discountPercent}%</em>` : ''}</div>
                            <p>${product.stockQuantity > 0 ? 'Còn hàng: ' + product.stockQuantity : 'Hết hàng'}</p>
                        </div>
                        <div class="accessory-card-actions"><a class="btn btn-outline-secondary btn-sm" href="${product.detailUrl}">Chi tiết</a><button class="btn btn-primary btn-sm" type="button" data-choose-accessory='${JSON.stringify(product).replace(/'/g, '&apos;')}'>Chọn</button></div>
                    </article>`).join('');
            }
            function chooseAccessory(product) {
                selected.set(activeType, product);
                activeSlot.querySelector('img').src = product.image;
                activeSlot.querySelector('.bundle-name').textContent = product.name;
                activeSlot.querySelector('.bundle-price').textContent = currency.format(product.price) + ' đ';
                activeSlot.querySelector('[data-open-accessory]').textContent = 'Đổi sản phẩm';
                activeSlot.querySelector('[data-remove-accessory]').classList.remove('d-none');
                refreshAccessoryInputs(); updateBundleTotal(); closeAccessory();
            }
            function refreshAccessoryInputs() {
                selectedInputs.innerHTML = '';
                selected.forEach(product => {
                    const input = document.createElement('input'); input.type = 'hidden'; input.name = 'AccessoryProductIds'; input.value = product.id; selectedInputs.appendChild(input);
                });
            }
            function updateBundleTotal() {
                if (!bundleTotal) return;
                let total = pcPrice;
                selected.forEach(product => { total += Number(product.price || 0); });
                bundleTotal.textContent = currency.format(total) + ' đ';
            }
            function escapeHtml(value) { return String(value || '').replace(/[&<>'"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[c])); }
            page.querySelectorAll('[data-open-accessory]').forEach(btn => btn.addEventListener('click', () => openAccessory(btn.closest('.accessory-slot'))));
            page.querySelectorAll('[data-remove-accessory]').forEach(btn => btn.addEventListener('click', () => { const slot = btn.closest('.accessory-slot'); selected.delete(slot.dataset.slotType); slot.querySelector('img').src = slot.dataset.defaultImage; slot.querySelector('.bundle-name').textContent = 'Chưa chọn sản phẩm'; slot.querySelector('.bundle-price').textContent = slot.dataset.defaultPriceText || 'Chưa có linh kiện phù hợp'; slot.querySelector('[data-open-accessory]').textContent = 'Chọn sản phẩm'; btn.classList.add('d-none'); refreshAccessoryInputs(); updateBundleTotal(); }));
            modal.querySelectorAll('[data-close-accessory]').forEach(btn => btn.addEventListener('click', closeAccessory));
            grid.addEventListener('click', event => { const btn = event.target.closest('[data-choose-accessory]'); if (!btn) return; chooseAccessory(JSON.parse(btn.dataset.chooseAccessory.replace(/&apos;/g, "'"))); });
            Object.values(filters).forEach(control => control.addEventListener(control.tagName === 'INPUT' ? 'input' : 'change', debounce(() => loadAccessories(false), 300)));
        })();
    </script>
}
