@model ProductFilterVm
@{
    ViewData["Title"] = "Danh sách sản phẩm";
    var currentCategory = Model.Categories.FirstOrDefault(category => category.Id == Model.CategoryId);
    var pageTitle = currentCategory?.Name ?? "Tất cả sản phẩm";
    var resultText = $"{Model.Products.Count:N0} sản phẩm";
}

<div class="products-page">
    <header class="products-heading">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb products-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">@pageTitle</li>
            </ol>
        </nav>
        <div class="products-heading-main">
            <h1>@pageTitle</h1>
            <span class="products-count-badge">@resultText</span>
            @if (Model.HasSidebarFilters)
            {
                <span class="products-filter-status"><i class="bi bi-funnel-fill"></i> Đang lọc</span>
            }
        </div>
    </header>

    <div class="products-layout" id="product-filter">
        <aside class="products-filter-sidebar" aria-label="Bộ lọc sản phẩm">
            <form method="get" asp-controller="Products" asp-action="Index" id="product-filter-form">
                <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                <input type="hidden" name="categorySlug" value="@Model.CategorySlug" />
                <input type="hidden" name="keyword" value="@Model.Keyword" />

                <div class="products-filter-header">
                    <div>
                        <i class="bi bi-sliders"></i>
                        <span>Bộ lọc sản phẩm</span>
                    </div>
                    <a asp-controller="Products" asp-action="Index"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-categorySlug="@Model.CategorySlug"
                       class="products-clear-filter" data-preserve-filter-scroll>Xóa lọc</a>
                </div>

                <details class="products-filter-group" open>
                    <summary>Khoảng giá <i class="bi bi-chevron-down"></i></summary>
                    <div class="products-filter-options">
                        @foreach (var option in Model.PriceRangeOptions)
                        {
                            var id = $"price-{option.Value}";
                            <label class="products-filter-option" for="@id">
                                <input id="@id" type="checkbox" name="priceRanges" value="@option.Value"
                                       checked="@(Model.PriceRanges.Contains(option.Value, StringComparer.OrdinalIgnoreCase))" />
                                <span>@option.Label</span>
                                <small>(@option.Count)</small>
                            </label>
                        }
                    </div>
                </details>

                <details class="products-filter-group" open>
                    <summary>Thương hiệu <i class="bi bi-chevron-down"></i></summary>
                    <div class="products-filter-options">
                        @if (Model.BrandOptions.Count == 0)
                        {
                            <div class="products-filter-empty">Chưa có dữ liệu</div>
                        }
                        @foreach (var option in Model.BrandOptions)
                        {
                            var id = $"brand-{option.Value.GetHashCode()}";
                            <label class="products-filter-option" for="@id">
                                <input id="@id" type="checkbox" name="brands" value="@option.Value"
                                       checked="@(Model.Brands.Contains(option.Value, StringComparer.OrdinalIgnoreCase))" />
                                <span>@option.Label</span>
                                <small>(@option.Count)</small>
                            </label>
                        }
                    </div>
                </details>

                <details class="products-filter-group" open>
                    <summary>Dòng CPU <i class="bi bi-chevron-down"></i></summary>
                    <div class="products-filter-options">
                        @if (Model.CpuOptions.Count == 0)
                        {
                            <div class="products-filter-empty">Chưa nhận diện được CPU</div>
                        }
                        @foreach (var option in Model.CpuOptions)
                        {
                            var id = $"cpu-{option.Value.Replace(" ", "-").ToLowerInvariant()}";
                            <label class="products-filter-option" for="@id">
                                <input id="@id" type="checkbox" name="cpu" value="@option.Value"
                                       checked="@(Model.Cpu.Contains(option.Value, StringComparer.OrdinalIgnoreCase))" />
                                <span>@option.Label</span>
                                <small>(@option.Count)</small>
                            </label>
                        }
                    </div>
                </details>

                <details class="products-filter-group" open>
                    <summary>Dung lượng RAM <i class="bi bi-chevron-down"></i></summary>
                    <div class="products-filter-options">
                        @if (Model.RamOptions.Count == 0)
                        {
                            <div class="products-filter-empty">Chưa nhận diện được RAM</div>
                        }
                        @foreach (var option in Model.RamOptions)
                        {
                            var id = $"ram-{option.Value.ToLowerInvariant()}";
                            <label class="products-filter-option" for="@id">
                                <input id="@id" type="checkbox" name="ram" value="@option.Value"
                                       checked="@(Model.Ram.Contains(option.Value, StringComparer.OrdinalIgnoreCase))" />
                                <span>@option.Label</span>
                                <small>(@option.Count)</small>
                            </label>
                        }
                    </div>
                </details>

                <details class="products-filter-group" open>
                    <summary>GPU <i class="bi bi-chevron-down"></i></summary>
                    <div class="products-filter-options">
                        @if (Model.GpuOptions.Count == 0)
                        {
                            <div class="products-filter-empty">Chưa nhận diện được GPU</div>
                        }
                        @foreach (var option in Model.GpuOptions)
                        {
                            var id = $"gpu-{option.Value.Replace(" ", "-").ToLowerInvariant()}";
                            <label class="products-filter-option" for="@id">
                                <input id="@id" type="checkbox" name="gpu" value="@option.Value"
                                       checked="@(Model.Gpu.Contains(option.Value, StringComparer.OrdinalIgnoreCase))" />
                                <span>@option.Label</span>
                                <small>(@option.Count)</small>
                            </label>
                        }
                    </div>
                </details>

                <button class="products-apply-filter" type="submit"><i class="bi bi-check2-circle"></i> Áp dụng bộ lọc</button>
            </form>
        </aside>

        <section class="products-results" aria-live="polite">
            @if (Model.Products.Count == 0)
            {
                <div class="products-empty-state">
                    <i class="bi bi-search"></i>
                    <h2>Không tìm thấy sản phẩm phù hợp</h2>
                    <p>Hãy thử bỏ bớt tiêu chí hoặc xóa bộ lọc để xem thêm sản phẩm.</p>
                    <a asp-controller="Products" asp-action="Index"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-categorySlug="@Model.CategorySlug"
                       class="btn btn-primary" data-preserve-filter-scroll>Xóa bộ lọc</a>
                </div>
            }
            else
            {
                <div class="products-grid">
                    @foreach (var product in Model.Products)
                    {
                        <partial name="_ProductCard" model="product" />
                    }
                </div>
            }
        </section>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const filterForm = document.getElementById('product-filter-form');
            if (!filterForm) return;

            const scrollStorageKey = 'productsFilterScrollY';
            const saveScrollPosition = () => {
                sessionStorage.setItem('productsFilterScrollY', window.scrollY);
            };
            const restoreScrollPosition = () => {
                const savedY = sessionStorage.getItem(scrollStorageKey);
                if (savedY === null) return;

                const scrollY = parseInt(savedY, 10);
                if (Number.isFinite(scrollY)) {
                    window.scrollTo(0, scrollY);
                }
                sessionStorage.removeItem(scrollStorageKey);
            };

            if (document.readyState === 'complete') {
                restoreScrollPosition();
            } else {
                window.addEventListener('load', restoreScrollPosition, { once: true });
            }

            filterForm.addEventListener('submit', saveScrollPosition);
            filterForm.querySelectorAll('input[type="checkbox"]').forEach(checkbox => {
                checkbox.addEventListener('change', () => filterForm.requestSubmit());
            });
            document.querySelectorAll('[data-preserve-filter-scroll]').forEach(link => {
                link.addEventListener('click', saveScrollPosition);
            });
        })();
    </script>
}
