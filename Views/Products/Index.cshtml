@model ProductFilterVm
@{
    ViewData["Title"] = "Danh sách sản phẩm";
    var currentCategory = Model.Categories.FirstOrDefault(category => category.Id == Model.CategoryId);
    var pageTitle = Model.IsComponentListing
        ? (Model.HasScopedComponentType ? Model.ComponentTypeLabel ?? Model.Type ?? "Linh kiện máy tính" : "Linh kiện máy tính")
        : currentCategory?.Name ?? "Tất cả sản phẩm";

    bool ShouldShowSingleChoiceOption(ProductFilterOptionVm option, string[] selectedValues)
    {
        var isSelected = selectedValues.Contains(option.Value, StringComparer.OrdinalIgnoreCase);
        return isSelected || option.Count > 0;
    }

    bool ShouldShowSpecOption(ProductFilterOptionVm option, string groupName)
    {
        var groupPrefix = $"{groupName}::";
        var selectedInGroup = Model.Specs
            .Where(value => value.StartsWith(groupPrefix, StringComparison.OrdinalIgnoreCase))
            .ToArray();
        return ShouldShowSingleChoiceOption(option, selectedInGroup);
    }
}

<script>
    (() => {
        const key = `productsFilterScrollY:${location.pathname}`;
        const savedY = sessionStorage.getItem(key);
        if (savedY === null) return;

        if ('scrollRestoration' in history) {
            history.scrollRestoration = 'manual';
        }

        const style = document.createElement('style');
        style.textContent = 'html,body{scroll-behavior:auto!important;}';
        document.head.appendChild(style);

        const targetY = parseInt(savedY, 10);
        if (!Number.isFinite(targetY)) {
            sessionStorage.removeItem(key);
            style.remove();
            return;
        }

        let attempts = 0;
        const restore = () => {
            window.scrollTo(0, targetY);
            attempts += 1;
            if (attempts < 4 && Math.abs(window.scrollY - targetY) > 2) {
                requestAnimationFrame(restore);
                return;
            }

            sessionStorage.removeItem(key);
            requestAnimationFrame(() => style.remove());
        };

        restore();
    })();
</script>

<div class="products-page">
    <header class="products-heading">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb products-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">@pageTitle</li>
            </ol>
        </nav>
    </header>

    <div class="products-layout" id="product-filter">
        <aside class="products-filter-sidebar" aria-label="Bộ lọc sản phẩm">
            <form method="get" action="@Model.FilterActionUrl" id="product-filter-form">
                <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                <input type="hidden" name="categorySlug" value="@Model.CategorySlug" />
                <input type="hidden" name="keyword" value="@Model.Keyword" />
                <input type="hidden" name="sort" value="@Model.Sort" />

                <div class="products-filter-header">
                    <div>
                        <span>LỌC SẢN PHẨM</span>
                    </div>
                    <a href="@Model.ClearFilterUrl"
                       class="products-clear-filter" data-preserve-filter-scroll>Xóa lọc</a>
                </div>


                @* ComponentSpecFilter: cấp 2 - bộ lọc chuyên biệt theo loại linh kiện đã chọn. *@
                @if (Model.HasScopedComponentType)
                {
                    <div class="products-filter-current-type">@Model.ComponentTypeLabel</div>

                    @if (Model.ComponentFamilyOptions.Count > 0)
                    {
                        <details class="products-filter-group" open>
                            <summary>@Model.ComponentTypeLabel <i class="bi bi-chevron-down"></i></summary>
                            <div class="products-filter-options component-filter-options">
                                @foreach (var option in Model.ComponentFamilyOptions)
                                {
                                    var id = $"component-family-{Math.Abs(option.Value.GetHashCode())}";
                                    var isSelected = Model.ComponentFamilies.Contains(option.Value, StringComparer.OrdinalIgnoreCase);
                                    <label class="products-filter-option" for="@id">
                                        <input id="@id" type="checkbox" name="componentFamilies" value="@option.Value" checked="@(isSelected)" />
                                        <span>» @option.Label</span>
                                        <small>(@option.Count)</small>
                                    </label>
                                }
                            </div>
                        </details>
                    }
                }

                @if (!Model.IsComponentListing || Model.HasScopedComponentType)
                {
                <details class="products-filter-group" open>
                    <summary>KHOẢNG GIÁ <i class="bi bi-chevron-down"></i></summary>
                    <div class="products-filter-options">
                        @foreach (var option in Model.PriceRangeOptions)
                        {
                            var id = $"price-{option.Value}";
                            var isSelected = Model.PriceRanges.Contains(option.Value, StringComparer.OrdinalIgnoreCase);
                            if (!ShouldShowSingleChoiceOption(option, Model.PriceRanges))
                            {
                                continue;
                            }
                            <label class="products-filter-option" for="@id">
                                <input id="@id" type="checkbox" name="priceRanges" value="@option.Value"
                                       checked="@(isSelected)" />
                                <span>@option.Label</span>
                                <small>(@option.Count)</small>
                            </label>
                        }
                    </div>
                </details>
                }

                @* ComponentTypeFilter: cấp 1 - chọn loại linh kiện tại /linh-kien. *@
                @if (Model.ComponentTypeGroups.Count > 0)
                {
                    <details class="products-filter-group" open>
                        <summary>Linh kiện máy tính <i class="bi bi-chevron-down"></i></summary>
                        <div class="products-filter-options component-filter-options">
                            @foreach (var group in Model.ComponentTypeGroups)
                            {
                                <div class="products-filter-subtitle">@group.Title</div>
                                @foreach (var option in group.Options)
                                {
                                    var id = $"component-{option.Value.ToLowerInvariant()}";
                                var isSelected = Model.ComponentTypes.Contains(option.Value, StringComparer.OrdinalIgnoreCase);
                                if (!isSelected && option.Count <= 0)
                                {
                                    continue;
                                }
                                    <a class="products-filter-option products-filter-link @(isSelected ? "is-active" : string.Empty)" href="@option.Url" data-preserve-filter-scroll>
                                        <span>» @option.Label</span>
                                        <small>(@option.Count)</small>
                                    </a>
                                }
                            }
                        </div>
                    </details>
                }

                @if (!Model.IsComponentListing || Model.HasScopedComponentType)
                {
                <details class="products-filter-group" open>
                        <summary>THƯƠNG HIỆU <i class="bi bi-chevron-down"></i></summary>
                        <div class="products-filter-options">
                            @if (Model.BrandOptions.Count == 0)
                            {
                                <div class="products-filter-empty">Chưa có dữ liệu</div>
                            }
                            @foreach (var option in Model.BrandOptions)
                            {
                                var id = $"brand-{option.Value.GetHashCode()}";
                                var isSelected = Model.Brands.Contains(option.Value, StringComparer.OrdinalIgnoreCase);
                                if (!ShouldShowSingleChoiceOption(option, Model.Brands))
                                {
                                    continue;
                                }
                                <label class="products-filter-option" for="@id">
                                    <input id="@id" type="checkbox" name="brands" value="@option.Value"
                                           checked="@(isSelected)" />
                                    <span>@option.Label</span>
                                    <small>(@option.Count)</small>
                                </label>
                            }
                        </div>
                    </details>
                }

                @if (Model.CpuOptions.Count > 0)
                {
                    <details class="products-filter-group" open>
                        <summary>DÒNG CPU <i class="bi bi-chevron-down"></i></summary>
                        <div class="products-filter-options">
                            @foreach (var option in Model.CpuOptions)
                            {
                                var id = $"cpu-{Math.Abs(option.Value.GetHashCode())}";
                                var isSelected = Model.Cpu.Contains(option.Value, StringComparer.OrdinalIgnoreCase);
                                if (!ShouldShowSingleChoiceOption(option, Model.Cpu))
                                {
                                    continue;
                                }
                                <label class="products-filter-option" for="@id">
                                    <input id="@id" type="checkbox" name="cpu" value="@option.Value"
                                           checked="@(isSelected)" />
                                    <span>@option.Label</span>
                                    <small>(@option.Count)</small>
                                </label>
                            }
                        </div>
                    </details>
                }

                @if (Model.RamOptions.Count > 0)
                {
                    <details class="products-filter-group" open>
                        <summary>DUNG LƯỢNG RAM <i class="bi bi-chevron-down"></i></summary>
                        <div class="products-filter-options">
                            @foreach (var option in Model.RamOptions)
                            {
                                var id = $"ram-{Math.Abs(option.Value.GetHashCode())}";
                                var isSelected = Model.Ram.Contains(option.Value, StringComparer.OrdinalIgnoreCase);
                                if (!ShouldShowSingleChoiceOption(option, Model.Ram))
                                {
                                    continue;
                                }
                                <label class="products-filter-option" for="@id">
                                    <input id="@id" type="checkbox" name="ram" value="@option.Value"
                                           checked="@(isSelected)" />
                                    <span>@option.Label</span>
                                    <small>(@option.Count)</small>
                                </label>
                            }
                        </div>
                    </details>
                }

                @if (Model.GpuOptions.Count > 0)
                {
                    <details class="products-filter-group" open>
                        <summary>GPU <i class="bi bi-chevron-down"></i></summary>
                        <div class="products-filter-options">
                            @foreach (var option in Model.GpuOptions)
                            {
                                var id = $"gpu-{Math.Abs(option.Value.GetHashCode())}";
                                var isSelected = Model.Gpu.Contains(option.Value, StringComparer.OrdinalIgnoreCase);
                                if (!ShouldShowSingleChoiceOption(option, Model.Gpu))
                                {
                                    continue;
                                }
                                <label class="products-filter-option" for="@id">
                                    <input id="@id" type="checkbox" name="gpu" value="@option.Value"
                                           checked="@(isSelected)" />
                                    <span>@option.Label</span>
                                    <small>(@option.Count)</small>
                                </label>
                            }
                        </div>
                    </details>
                }


                @if (Model.StorageOptions.Count > 0)
                {
                    <details class="products-filter-group" open>
                        <summary>DUNG LƯỢNG SSD / Ổ CỨNG <i class="bi bi-chevron-down"></i></summary>
                        <div class="products-filter-options">
                            @foreach (var option in Model.StorageOptions)
                            {
                                var id = $"storage-{Math.Abs(option.Value.GetHashCode())}";
                                var isSelected = Model.Storage.Contains(option.Value, StringComparer.OrdinalIgnoreCase);
                                if (!ShouldShowSingleChoiceOption(option, Model.Storage))
                                {
                                    continue;
                                }
                                <label class="products-filter-option" for="@id">
                                    <input id="@id" type="checkbox" name="storage" value="@option.Value" checked="@(isSelected)" />
                                    <span>@option.Label</span>
                                    <small>(@option.Count)</small>
                                </label>
                            }
                        </div>
                    </details>
                }

                @if (Model.MainboardOptions.Count > 0)
                {
                    <details class="products-filter-group" open>
                        <summary>MAINBOARD <i class="bi bi-chevron-down"></i></summary>
                        <div class="products-filter-options">
                            @foreach (var option in Model.MainboardOptions)
                            {
                                var id = $"mainboard-{Math.Abs(option.Value.GetHashCode())}";
                                var isSelected = Model.Mainboard.Contains(option.Value, StringComparer.OrdinalIgnoreCase);
                                if (!ShouldShowSingleChoiceOption(option, Model.Mainboard)) { continue; }
                                <label class="products-filter-option" for="@id">
                                    <input id="@id" type="checkbox" name="mainboard" value="@option.Value" checked="@(isSelected)" />
                                    <span>@option.Label</span><small>(@option.Count)</small>
                                </label>
                            }
                        </div>
                    </details>
                }

                @if (Model.PsuOptions.Count > 0)
                {
                    <details class="products-filter-group" open>
                        <summary>NGUỒN <i class="bi bi-chevron-down"></i></summary>
                        <div class="products-filter-options">
                            @foreach (var option in Model.PsuOptions)
                            {
                                var id = $"psu-{Math.Abs(option.Value.GetHashCode())}";
                                var isSelected = Model.Psu.Contains(option.Value, StringComparer.OrdinalIgnoreCase);
                                if (!ShouldShowSingleChoiceOption(option, Model.Psu)) { continue; }
                                <label class="products-filter-option" for="@id">
                                    <input id="@id" type="checkbox" name="psu" value="@option.Value" checked="@(isSelected)" />
                                    <span>@option.Label</span><small>(@option.Count)</small>
                                </label>
                            }
                        </div>
                    </details>
                }

                @if (Model.CaseOptions.Count > 0)
                {
                    <details class="products-filter-group" open>
                        <summary>VỎ CASE <i class="bi bi-chevron-down"></i></summary>
                        <div class="products-filter-options">
                            @foreach (var option in Model.CaseOptions)
                            {
                                var id = $"case-{Math.Abs(option.Value.GetHashCode())}";
                                var isSelected = Model.Case.Contains(option.Value, StringComparer.OrdinalIgnoreCase);
                                if (!ShouldShowSingleChoiceOption(option, Model.Case)) { continue; }
                                <label class="products-filter-option" for="@id">
                                    <input id="@id" type="checkbox" name="case" value="@option.Value" checked="@(isSelected)" />
                                    <span>@option.Label</span><small>(@option.Count)</small>
                                </label>
                            }
                        </div>
                    </details>
                }

                @if (Model.CoolingOptions.Count > 0)
                {
                    <details class="products-filter-group" open>
                        <summary>TẢN NHIỆT <i class="bi bi-chevron-down"></i></summary>
                        <div class="products-filter-options">
                            @foreach (var option in Model.CoolingOptions)
                            {
                                var id = $"cooling-{Math.Abs(option.Value.GetHashCode())}";
                                var isSelected = Model.Cooling.Contains(option.Value, StringComparer.OrdinalIgnoreCase);
                                if (!ShouldShowSingleChoiceOption(option, Model.Cooling)) { continue; }
                                <label class="products-filter-option" for="@id">
                                    <input id="@id" type="checkbox" name="cooling" value="@option.Value" checked="@(isSelected)" />
                                    <span>@option.Label</span><small>(@option.Count)</small>
                                </label>
                            }
                        </div>
                    </details>
                }

                @foreach (var specGroup in Model.SpecFilterGroups)
                {
                    var specGroupPrefix = $"{specGroup.Name}::";
                    var specGroupHasSelection = Model.Specs.Any(value => value.StartsWith(specGroupPrefix, StringComparison.OrdinalIgnoreCase));
                    <details class="products-filter-group" data-filter-group-key="spec-@specGroup.Name" open="@(specGroupHasSelection)">
                        <summary>@specGroup.Name <i class="bi bi-chevron-down"></i></summary>
                        <div class="products-filter-options">
                            @foreach (var option in specGroup.Options)
                            {
                                var id = $"spec-{Math.Abs(option.Value.GetHashCode())}";
                                var isSelected = Model.Specs.Contains(option.Value, StringComparer.OrdinalIgnoreCase);
                                if (!ShouldShowSpecOption(option, specGroup.Name))
                                {
                                    continue;
                                }
                                <label class="products-filter-option" for="@id">
                                    <input id="@id" type="checkbox" name="specs" value="@option.Value"
                                           checked="@(isSelected)" />
                                    <span>@option.Label</span>
                                    <small>(@option.Count)</small>
                                </label>
                            }
                        </div>
                    </details>
                }

                <button class="products-apply-filter" type="submit"><i class="bi bi-check2-circle"></i> Áp dụng bộ lọc</button>
            </form>
        </aside>

        <section class="products-results" id="product-list" aria-live="polite">
            <div class="products-results-toolbar">
                <h2>Tìm thấy <span>@Model.Products.Count.ToString("N0")</span> sản phẩm</h2>
                <form method="get" action="@Model.FilterActionUrl" class="products-sort-form" id="product-sort-form">
                    <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                    <input type="hidden" name="categorySlug" value="@Model.CategorySlug" />
                    <input type="hidden" name="keyword" value="@Model.Keyword" />
                    @foreach (var value in Model.PriceRanges) { <input type="hidden" name="priceRanges" value="@value" /> }
                    @foreach (var value in Model.Brands) { <input type="hidden" name="brands" value="@value" /> }
                    @foreach (var value in Model.ComponentFamilies) { <input type="hidden" name="componentFamilies" value="@value" /> }
                    
                    @foreach (var value in Model.Specs) { <input type="hidden" name="specs" value="@value" /> }
                    @foreach (var value in Model.Cpu) { <input type="hidden" name="cpu" value="@value" /> }
                    @foreach (var value in Model.Ram) { <input type="hidden" name="ram" value="@value" /> }
                    @foreach (var value in Model.Gpu) { <input type="hidden" name="gpu" value="@value" /> }
                    @foreach (var value in Model.Storage) { <input type="hidden" name="storage" value="@value" /> }
                    @foreach (var value in Model.Mainboard) { <input type="hidden" name="mainboard" value="@value" /> }
                    @foreach (var value in Model.Psu) { <input type="hidden" name="psu" value="@value" /> }
                    @foreach (var value in Model.Case) { <input type="hidden" name="case" value="@value" /> }
                    @foreach (var value in Model.Cooling) { <input type="hidden" name="cooling" value="@value" /> }
                    <select name="sort" class="form-select form-select-sm" aria-label="Sắp xếp sản phẩm">
                        <option value="newest" selected="@(Model.Sort == "newest")">Sắp xếp theo</option>
                        <option value="price_asc" selected="@(Model.Sort == "price_asc")">Giá tăng dần</option>
                        <option value="price_desc" selected="@(Model.Sort == "price_desc")">Giá giảm dần</option>
                        <option value="name_asc" selected="@(Model.Sort == "name_asc")">Tên A-Z</option>
                    </select>
                </form>
            </div>
            @if (Model.IsEquivalentSearch)
            {
                <div class="products-equivalent-notice">
                    <span aria-hidden="true">⇄</span>
                    <strong>Kết quả tương đương cho:</strong> “@Model.Keyword”
                </div>
            }
            @if (Model.Products.Count == 0)
            {
                <div class="products-empty-state">
                    <span class="products-empty-icon" aria-hidden="true">⇄</span>
                    <h2>@(Model.HasKeyword ? "Không tìm thấy sản phẩm khớp hoàn toàn" : "Không tìm thấy sản phẩm phù hợp")</h2>
                    <p>@(Model.HasKeyword
                        ? "Bạn có thể thử tìm theo tên ngắn hơn, hãng, dòng CPU/VGA hoặc khoảng giá."
                        : "Hãy thử bỏ bớt tiêu chí hoặc xóa bộ lọc để xem thêm sản phẩm.")</p>
                    @if (Model.HasKeyword)
                    {
                        <div class="products-search-tips">
                            <span><i class="bi bi-check2"></i> Bỏ bớt từ mô tả</span>
                            <span><i class="bi bi-check2"></i> Thử “RTX 3060”, “Ryzen 5”</span>
                            <span><i class="bi bi-check2"></i> Xóa bớt bộ lọc đang chọn</span>
                        </div>
                    }
                    <a href="@Model.ClearFilterUrl"
                       class="btn btn-primary" data-preserve-filter-scroll>Xóa bộ lọc</a>
                </div>
            }
            else
            {
                <div class="products-grid">
                    @{ ViewData["CompactProductCard"] = true; }
                    @foreach (var product in Model.Products)
                    {
                        <partial name="_ProductCard" model="product" />
                    }
                </div>
            }
        </section>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const filterForm = document.getElementById('product-filter-form');
            const sortForm = document.getElementById('product-sort-form');
            if (!filterForm) return;

            const scrollStorageKey = `productsFilterScrollY:${location.pathname}`;
            if ('scrollRestoration' in history) {
                history.scrollRestoration = 'manual';
            }

            const detailsStorageKey = `productsFilterGroups:${location.pathname}`;
            const readOpenGroups = () => {
                try { return JSON.parse(localStorage.getItem(detailsStorageKey) || '{}'); } catch { return {}; }
            };
            const writeOpenGroups = value => localStorage.setItem(detailsStorageKey, JSON.stringify(value));
            const groupState = readOpenGroups();
            filterForm.querySelectorAll('details.products-filter-group').forEach((details, index) => {
                const summary = details.querySelector('summary')?.textContent?.trim() || `group-${index}`;
                const key = details.dataset.filterGroupKey || summary;
                details.dataset.filterGroupKey = key;
                if (Object.prototype.hasOwnProperty.call(groupState, key)) details.open = groupState[key] === true;
                details.addEventListener('toggle', () => {
                    const latest = readOpenGroups();
                    latest[key] = details.open;
                    writeOpenGroups(latest);
                });
            });

            const saveScrollPosition = () => {
                sessionStorage.setItem(scrollStorageKey, window.scrollY);
            };

            filterForm.addEventListener('submit', saveScrollPosition);
            filterForm.querySelectorAll('input[type="checkbox"]').forEach(checkbox => {
                checkbox.addEventListener('change', () => filterForm.requestSubmit());
            });
            sortForm?.querySelector('select[name="sort"]')?.addEventListener('change', () => {
                saveScrollPosition();
                sortForm.requestSubmit();
            });
            document.querySelectorAll('[data-preserve-filter-scroll]').forEach(link => {
                link.addEventListener('click', saveScrollPosition);
            });
        })();
    </script>
}
