@model List<WarrantyRequest>
<h3>Quản lý bảo hành</h3>
<table class="table table-bordered align-middle">
<thead><tr><th>Khách</th><th>Sản phẩm</th><th>Mô tả</th><th>Trạng thái</th><th></th></tr></thead>
<tbody>
@foreach (var r in Model)
{
    <tr>
        <td>@r.User?.FullName</td><td>@r.Product?.Name</td><td>@r.IssueDescription</td><td>@r.Status</td>
        <td>
            <form method="post" asp-action="UpdateStatus" class="d-flex gap-2">
                <input type="hidden" name="id" value="@r.Id" />
                <select name="status" class="form-select form-select-sm">
                    @foreach (var status in new[] { "Mới tạo", "Đã nhận máy", "Đang xử lý", "Hoàn thành", "Từ chối" })
                    {
                        if (status == r.Status)
                        {
                            <option value="@status" selected>@status</option>
                        }
                        else
                        {
                            <option value="@status">@status</option>
                        }
                    }
                </select>
                <button class="btn btn-sm btn-primary">Lưu</button>
            </form>
        </td>
    </tr>
}
</tbody>
</table>
