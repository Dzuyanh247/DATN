@model WarrantyRequest
@{
    ViewData["Title"] = "Chi tiết bảo hành";
    var expiresAt = WarrantyPolicy.ExpiresAt(Model.PurchaseDate, Model.WarrantyMonths);
    var image = ImageUrlHelper.ResolveImageUrl(Model.OrderDetail?.ProductImage ?? Model.Product?.ThumbnailImage, "/images/placeholders/product-placeholder.png");
    var requestCode = string.IsNullOrWhiteSpace(Model.RequestCode) ? $"YCBH{Model.Id:D6}" : Model.RequestCode;
}
<div class="admin-warranty-detail-header"><div><a asp-action="Index" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Danh sách bảo hành</a><h2>@requestCode</h2><span>@Model.WarrantyCode</span></div><span class="warranty-status @WarrantyStatuses.BadgeClass(Model.Status)">@Model.Status</span></div>
<div class="row g-3">
    <div class="col-lg-8">
        <section class="admin-detail-panel">
            <h3><i class="bi bi-box-seam"></i> Thông tin sản phẩm</h3>
            <div class="admin-warranty-product-detail"><img src="@image" alt="@Model.ProductName" onerror="this.onerror=null;this.src='/images/placeholders/product-placeholder.png';" /><div><small>Sản phẩm</small><strong>@Model.ProductName</strong><span>Mã bảo hành: @Model.WarrantyCode</span><div class="admin-product-facts"><span>Đơn hàng <b>@(Model.OrderId.HasValue ? $"DH{Model.OrderId.Value:D6}" : "—")</b></span><span>Ngày mua <b>@DateTimeHelper.FormatVietnam(Model.PurchaseDate, "dd/MM/yyyy")</b></span><span>Thời hạn <b>@Model.WarrantyMonths tháng</b></span><span>Hết hạn <b>@DateTimeHelper.FormatVietnam(expiresAt, "dd/MM/yyyy")</b></span></div></div></div>
        </section>
        <section class="admin-detail-panel mt-3"><h3><i class="bi bi-tools"></i> Nội dung yêu cầu</h3><div class="admin-issue-title"><small>Tiêu đề lỗi</small><strong>@(string.IsNullOrWhiteSpace(Model.IssueTitle) ? "Yêu cầu kiểm tra sản phẩm" : Model.IssueTitle)</strong></div><h4>Mô tả lỗi</h4><p class="text-preline admin-issue-description">@(string.IsNullOrWhiteSpace(Model.IssueDescription) ? "Khách hàng chưa cung cấp mô tả chi tiết." : Model.IssueDescription)</p>@if (!string.IsNullOrWhiteSpace(Model.EvidencePath)){<h4>Ảnh minh chứng</h4><a href="@Model.EvidencePath" target="_blank"><img class="admin-evidence-image" src="@Model.EvidencePath" alt="Ảnh minh chứng" /></a>}else{<p class="text-muted small mb-0">Khách hàng không gửi ảnh minh chứng.</p>}</section>
        <section class="admin-detail-panel mt-3"><h3><i class="bi bi-person-lines-fill"></i> Thông tin khách hàng</h3><div class="admin-info-grid"><div><span>Khách hàng</span><strong>@(string.IsNullOrWhiteSpace(Model.CustomerName) ? "—" : Model.CustomerName)</strong></div><div><span>Số điện thoại</span><strong>@(string.IsNullOrWhiteSpace(Model.Phone) ? "—" : Model.Phone)</strong></div><div><span>Email</span><strong>@(string.IsNullOrWhiteSpace(Model.Email) ? "—" : Model.Email)</strong></div><div><span>Ngày gửi yêu cầu</span><strong>@DateTimeHelper.FormatVietnam(Model.CreatedAt, "dd/MM/yyyy HH:mm")</strong></div></div></section>
    </div>
    <div class="col-lg-4"><section class="admin-detail-panel admin-update-panel"><h3><i class="bi bi-pencil-square"></i> Cập nhật xử lý</h3><form asp-action="Update" method="post" class="admin-form-grid"><input type="hidden" name="Id" value="@Model.Id" /><div class="admin-field-md mb-3"><label class="form-label">Trạng thái</label><select name="Status" class="form-select">@foreach(var status in WarrantyStatuses.All){<option value="@status" selected="@(Model.Status == status)">@status</option>}</select></div><div class="admin-field-full mb-3"><label class="form-label">Ghi chú cho khách hàng</label><textarea name="AdminNote" class="form-control" rows="8" maxlength="2000" placeholder="Kết quả kiểm tra, lịch hẹn, hướng xử lý...">@Model.AdminNote</textarea></div><div class="admin-field-full"><button class="btn btn-primary w-100"><i class="bi bi-check2-circle me-2"></i>Lưu cập nhật</button></div></form><hr /><small class="text-muted d-block">Tạo lúc: @DateTimeHelper.FormatVietnam(Model.CreatedAt, "dd/MM/yyyy HH:mm")</small><small class="text-muted d-block">Cập nhật: @DateTimeHelper.FormatVietnam(Model.UpdatedAt, "dd/MM/yyyy HH:mm")</small></section></div>
</div>
