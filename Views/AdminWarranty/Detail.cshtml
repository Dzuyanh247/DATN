@model WarrantyRequest
@{
    ViewData["Title"] = "Chi tiết bảo hành";
    var expiresAt = WarrantyPolicy.ExpiresAt(Model.PurchaseDate, Model.WarrantyMonths);
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3"><div><a asp-action="Index" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Danh sách bảo hành</a><h2 class="mt-2 mb-0">@Model.WarrantyCode</h2></div><span class="warranty-status @WarrantyStatuses.BadgeClass(Model.Status)">@Model.Status</span></div>
<div class="row g-3">
    <div class="col-lg-8">
        <section class="admin-detail-panel"><h3><i class="bi bi-tools"></i> Nội dung yêu cầu</h3><div class="admin-warranty-product-box"><div><small>Sản phẩm</small><strong>@Model.ProductName</strong><span>@Model.IssueTitle</span></div><div class="text-end"><small>Đơn hàng</small><strong>@(Model.OrderId.HasValue ? $"DH{Model.OrderId.Value:D6}" : "—")</strong></div></div><h4>Mô tả lỗi</h4><p class="text-preline">@Model.IssueDescription</p>@if (!string.IsNullOrWhiteSpace(Model.EvidencePath)){<h4>Ảnh minh chứng</h4><a href="@Model.EvidencePath" target="_blank"><img class="admin-evidence-image" src="@Model.EvidencePath" alt="Ảnh minh chứng" /></a>}</section>
        <section class="admin-detail-panel mt-3"><h3><i class="bi bi-person-lines-fill"></i> Khách hàng & bảo hành</h3><div class="admin-info-grid"><div><span>Khách hàng</span><strong>@Model.CustomerName</strong></div><div><span>Số điện thoại</span><strong>@Model.Phone</strong></div><div><span>Email</span><strong>@(Model.Email ?? "—")</strong></div><div><span>Ngày mua</span><strong>@DateTimeHelper.FormatVietnam(Model.PurchaseDate, "dd/MM/yyyy")</strong></div><div><span>Thời hạn</span><strong>@Model.WarrantyMonths tháng</strong></div><div><span>Hết hạn</span><strong>@DateTimeHelper.FormatVietnam(expiresAt, "dd/MM/yyyy")</strong></div></div></section>
    </div>
    <div class="col-lg-4"><section class="admin-detail-panel admin-update-panel"><h3><i class="bi bi-pencil-square"></i> Cập nhật xử lý</h3><form asp-action="Update" method="post"><input type="hidden" name="Id" value="@Model.Id" /><div class="mb-3"><label class="form-label">Trạng thái</label><select name="Status" class="form-select">@foreach(var status in WarrantyStatuses.All){<option value="@status" selected="@(Model.Status == status)">@status</option>}</select></div><div class="mb-3"><label class="form-label">Ghi chú cho khách hàng</label><textarea name="AdminNote" class="form-control" rows="7" maxlength="2000" placeholder="Kết quả kiểm tra, lịch hẹn, hướng xử lý...">@Model.AdminNote</textarea></div><button class="btn btn-primary w-100"><i class="bi bi-check2-circle me-2"></i>Lưu cập nhật</button></form><hr /><small class="text-muted d-block">Tạo lúc: @DateTimeHelper.FormatVietnam(Model.CreatedAt, "dd/MM/yyyy HH:mm")</small><small class="text-muted d-block">Cập nhật: @DateTimeHelper.FormatVietnam(Model.UpdatedAt, "dd/MM/yyyy HH:mm")</small></section></div>
</div>
