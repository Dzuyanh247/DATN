@model List<Banner>
@{
    ViewData["Title"] = "Quản lý banner";
    var main = Model.Where(x => x.Position == "MainBanner").OrderBy(x => x.SortOrder).ToList();
    var sub = Model.Where(x => x.Position == "SubBanner").OrderBy(x => x.SortOrder).ToList();
    var other = Model.Where(x => x.Position != "MainBanner" && x.Position != "SubBanner").OrderBy(x => x.SortOrder).ToList();
}
<div class="admin-banner-page">
    <div class="d-flex justify-content-between align-items-center mb-3"><h3 class="mb-0">Quản lý banner</h3><a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-circle me-1"></i>Thêm banner mới</a></div>

    <div class="banner-layout-preview card p-3 mb-4">
        <h5>Preview layout trang chủ</h5>
        <div class="layout-main">@if (main.Any()) { <img src="@main.FirstOrDefault(x=>x.IsActive)?.ImageUrl" onerror="this.style.display='none'"/> } else { <span>Chưa có banner chính đang bật</span> }</div>
        <div class="layout-sub-grid">
            @foreach (var b in sub.Where(x => x.IsActive).Take(3)) { <img src="@b.ImageUrl" alt="@b.Title" onerror="this.style.display='none'" /> }
        </div>
    </div>

    @foreach (var group in new[] { ("Banner chính trang chủ", main), ("Banner phụ trang chủ", sub), ("Banner khác", other) })
    {
        <h5 class="mb-3">@group.Item1</h5>
        <div class="row g-3 mb-4">
            @if (!group.Item2.Any()) { <div class="col-12"><div class="alert alert-light border">Chưa có banner.</div></div> }
            @foreach (var b in group.Item2)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="banner-card card h-100">
                        <img class="card-img-top" src="@b.ImageUrl" alt="@b.Title" onerror="this.src='https://placehold.co/600x220?text=No+Image'"/>
                        <div class="card-body">
                            <h6>@b.Title</h6>
                            <div class="d-flex gap-2 flex-wrap mb-2">
                                <span class="badge @(b.Position=="MainBanner"?"text-bg-danger":b.Position=="SubBanner"?"text-bg-primary":"text-bg-secondary")">@(b.Position=="MainBanner"?"Banner chính":b.Position=="SubBanner"?"Banner phụ":"Banner khác")</span>
                                <span class="badge @(b.IsActive?"text-bg-success":"text-bg-secondary")">@(b.IsActive?"Đang hiển thị":"Đang ẩn")</span>
                            </div>
                            <p class="small mb-1"><b>Thứ tự:</b> @b.SortOrder</p>
                            <p class="small mb-2 text-truncate"><b>Link:</b> @b.LinkUrl</p>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@b.Id">Sửa</a>
                            <form method="post" asp-action="ToggleStatus" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@b.Id" /><button class="btn btn-sm btn-outline-warning">@(b.IsActive?"Tắt":"Bật")</button></form>
                            <form method="post" asp-action="Delete" class="d-inline" onsubmit="return confirm('Xóa banner này?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@b.Id" /><button class="btn btn-sm btn-outline-danger">Xóa</button></form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
