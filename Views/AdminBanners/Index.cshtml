@model List<Banner>
@{
    ViewData["Title"] = "Quản lý banner";
    var main = Model.Where(x => x.Position == "MainBanner").OrderBy(x => x.SortOrder).ToList();
    var sub = Model.Where(x => x.Position == "SubBanner").OrderBy(x => x.SortOrder).ToList();
    var other = Model.Where(x => x.Position != "MainBanner" && x.Position != "SubBanner").OrderBy(x => x.SortOrder).ToList();
    var activeMain = main.FirstOrDefault(x => x.IsActive);
    var activeSubs = sub.Where(x => x.IsActive).Take(3).ToList();
    var activeCount = Model.Count(x => x.IsActive);
}

<div class="admin-banner-page">
    <div class="admin-banner-header">
        <div>
            <span class="admin-banner-eyebrow">Nội dung trang chủ</span>
            <h3>Quản lý banner</h3>
            <p>Quản lý banner chính, banner phụ và trạng thái hiển thị trên trang chủ.</p>
        </div>
        <a class="btn btn-primary admin-banner-create" asp-action="Create"><i class="bi bi-plus-circle me-1"></i>Thêm banner mới</a>
    </div>

    <section class="admin-banner-stats" aria-label="Tổng quan banner">
        <div class="admin-banner-stat"><span><i class="bi bi-images"></i></span><small>Tổng banner</small><strong>@Model.Count</strong></div>
        <div class="admin-banner-stat"><span><i class="bi bi-aspect-ratio"></i></span><small>Banner chính</small><strong>@main.Count</strong></div>
        <div class="admin-banner-stat"><span><i class="bi bi-grid-3x3-gap"></i></span><small>Banner phụ</small><strong>@sub.Count</strong></div>
        <div class="admin-banner-stat"><span><i class="bi bi-eye"></i></span><small>Đang hiển thị</small><strong>@activeCount</strong></div>
    </section>

    <section class="admin-banner-section banner-layout-preview">
        <div class="admin-banner-section-head">
            <div>
                <span class="admin-banner-eyebrow">Mini preview trang chủ</span>
                <h5>Banner đang dùng</h5>
            </div>
            <span class="admin-banner-note">Chỉ hiển thị banner đang bật</span>
        </div>
        <div class="mini-home-preview admin-banner-mini-preview">
            <div class="mini-main-banner">
                @if (activeMain != null)
                {
                    <img src="@activeMain.ImageUrl" alt="@(string.IsNullOrWhiteSpace(activeMain.Title) ? "Banner chính" : activeMain.Title)" onerror="this.style.display='none'" />
                    <span class="mini-label">Banner chính</span>
                }
                else
                {
                    <div class="mini-empty"><i class="bi bi-image"></i><span>Chưa có banner chính đang bật</span></div>
                }
            </div>
            <div class="mini-sub-grid">
                @for (var i = 0; i < 3; i++)
                {
                    var banner = activeSubs.ElementAtOrDefault(i);
                    <div class="mini-sub-item">
                        @if (banner != null)
                        {
                            <img src="@banner.ImageUrl" alt="@(string.IsNullOrWhiteSpace(banner.Title) ? $"Banner phụ {i + 1}" : banner.Title)" onerror="this.style.display='none'" />
                            <span class="mini-label">Phụ @(i + 1)</span>
                        }
                        else
                        {
                            <div class="mini-empty mini-empty-sub"><i class="bi bi-image"></i><span>Ô phụ @(i + 1)</span></div>
                        }
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="admin-banner-section">
        <div class="admin-banner-section-head">
            <div>
                <span class="admin-banner-eyebrow">Danh sách banner</span>
                <h5>Quản lý nhanh</h5>
            </div>
            <div class="admin-banner-tabs" aria-label="Bộ lọc nhanh">
                <span>Tất cả @Model.Count</span><span>Banner chính @main.Count</span><span>Banner phụ @sub.Count</span><span>Đang hiển thị @activeCount</span><span>Đã tắt @(Model.Count - activeCount)</span>
            </div>
        </div>
        <div class="admin-banner-table-wrap">
            <table class="admin-banner-table">
                <thead>
                    <tr><th>Ảnh</th><th>Loại</th><th>Trạng thái</th><th>Thứ tự</th><th>Link đích</th><th>URL ảnh</th><th>Thao tác</th></tr>
                </thead>
                <tbody>
                    @foreach (var b in main.Concat(sub).Concat(other))
                    {
                        @await Html.PartialAsync("_AdminBannerCard", b)
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7"><div class="admin-banner-empty"><i class="bi bi-images"></i><strong>Chưa có banner</strong><span>Thêm banner mới để bắt đầu quản lý khu vực hiển thị trang chủ.</span></div></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

<style>
    .admin-banner-page { --banner-border:#e2e8f0; --banner-muted:#64748b; --banner-soft:#f8fafc; --banner-blue:#1764aa; background:#f5f7fb; margin:-.5rem; padding:1rem; border-radius:18px; }
    .admin-banner-header, .admin-banner-section, .admin-banner-stat { background:#fff; border:1px solid var(--banner-border); border-radius:16px; box-shadow:0 8px 22px rgba(15,23,42,.045); }
    .admin-banner-header { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:1rem 1.1rem; margin-bottom:.75rem; }
    .admin-banner-header h3 { margin:.08rem 0 .2rem; font-size:1.35rem; font-weight:850; color:#172033; }
    .admin-banner-header p { margin:0; color:var(--banner-muted); font-size:.9rem; }
    .admin-banner-eyebrow { display:block; color:var(--banner-blue); font-size:.68rem; font-weight:850; letter-spacing:.08em; text-transform:uppercase; }
    .admin-banner-create { border-radius:999px; padding:.58rem .9rem; font-weight:800; white-space:nowrap; box-shadow:0 8px 16px rgba(23,100,170,.16); }
    .admin-banner-stats { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:.75rem; }
    .admin-banner-stat { display:grid; grid-template-columns:36px 1fr; align-items:center; column-gap:.6rem; padding:.75rem; }
    .admin-banner-stat span { grid-row:1/3; width:36px; height:36px; display:grid; place-items:center; border-radius:12px; background:#eef6ff; color:#1764aa; }
    .admin-banner-stat small { color:#64748b; font-weight:750; line-height:1; }
    .admin-banner-stat strong { color:#172033; font-size:1.28rem; line-height:1.15; }
    .admin-banner-section { padding:.85rem; margin-bottom:.75rem; }
    .admin-banner-section-head { display:flex; align-items:center; justify-content:space-between; gap:.8rem; margin-bottom:.65rem; }
    .admin-banner-section-head h5 { margin:.08rem 0 0; font-weight:850; color:#172033; font-size:1rem; }
    .admin-banner-note { border-radius:999px; padding:.35rem .6rem; background:#f1f5f9; color:#475569; font-size:.72rem; font-weight:750; white-space:nowrap; }
    .mini-home-preview { height:178px; border:1px dashed #cbd5e1; border-radius:14px; background:#fbfdff; padding:.55rem; overflow:hidden; }
    .mini-main-banner, .mini-sub-item { position:relative; overflow:hidden; border-radius:10px; background:#f8fafc; border:1px solid #e2e8f0; }
    .mini-main-banner { height:86px; margin-bottom:.45rem; }
    .mini-sub-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.45rem; }
    .mini-sub-item { height:55px; }
    .admin-banner-mini-preview img, .mini-main-banner img, .mini-sub-item img { width:100%; height:100%; object-fit:contain; display:block; }
    .mini-label { position:absolute; left:.4rem; bottom:.35rem; border-radius:999px; padding:.15rem .42rem; background:rgba(15,23,42,.72); color:#fff; font-size:.62rem; font-weight:800; }
    .mini-empty { height:100%; display:grid; place-items:center; align-content:center; gap:.18rem; color:#94a3b8; text-align:center; font-size:.76rem; }
    .mini-empty i { font-size:1.1rem; }
    .admin-banner-tabs { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:.35rem; }
    .admin-banner-tabs span { border-radius:999px; background:#f1f5f9; color:#475569; padding:.32rem .55rem; font-size:.72rem; font-weight:800; }
    .admin-banner-table-wrap { overflow-x:auto; border:1px solid #e5edf6; border-radius:14px; }
    .admin-banner-table { width:100%; min-width:980px; border-collapse:separate; border-spacing:0; background:#fff; }
    .admin-banner-table th { padding:.65rem .7rem; background:#f8fafc; color:#64748b; font-size:.7rem; text-transform:uppercase; letter-spacing:.05em; white-space:nowrap; }
    .admin-banner-table td { padding:.55rem .7rem; border-top:1px solid #edf2f7; vertical-align:middle; color:#334155; font-size:.82rem; }
    .admin-banner-thumb { width:160px; height:70px; display:block; overflow:hidden; border-radius:10px; border:1px solid #e2e8f0; background:#f8fafc; }
    .admin-banner-thumb.is-sub { width:140px; height:60px; }
    .admin-banner-thumb img { width:100%; height:100%; object-fit:contain; display:block; }
    .banner-badge { display:inline-flex; align-items:center; border-radius:999px; padding:.28rem .5rem; font-size:.68rem; font-weight:850; line-height:1; white-space:nowrap; }
    .banner-badge.is-main { background:#ffedd5; color:#c2410c; } .banner-badge.is-sub { background:#dbeafe; color:#1d4ed8; } .banner-badge.is-other { background:#f1f5f9; color:#475569; } .banner-badge.is-active { background:#dcfce7; color:#15803d; } .banner-badge.is-off { background:#f1f5f9; color:#64748b; }
    .admin-banner-ellipsis { display:block; max-width:230px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .admin-banner-image-url { max-width:260px; color:#64748b; }
    .admin-banner-actions { display:flex; align-items:center; gap:.3rem; flex-wrap:nowrap; }
    .admin-banner-actions form { margin:0; }
    .admin-banner-actions .btn { display:inline-flex; align-items:center; gap:.25rem; border-radius:999px; font-size:.72rem; font-weight:800; padding:.28rem .5rem; white-space:nowrap; }
    .admin-banner-empty { display:grid; place-items:center; gap:.25rem; min-height:110px; border:1px dashed #cbd5e1; border-radius:14px; color:#64748b; text-align:center; background:#f8fafc; padding:1rem; }
    .admin-banner-empty i { font-size:1.6rem; color:#94a3b8; } .admin-banner-empty strong { color:#334155; }
    @@media (max-width: 991.98px) { .admin-banner-stats { grid-template-columns:repeat(2,minmax(0,1fr)); } .admin-banner-header, .admin-banner-section-head { align-items:flex-start; flex-direction:column; } .admin-banner-tabs { justify-content:flex-start; } }
    @@media (max-width: 767.98px) { .admin-banner-page { margin:0; padding:.75rem; border-radius:14px; } .admin-banner-stats, .mini-sub-grid { grid-template-columns:1fr; } .mini-home-preview { height:auto; } .mini-main-banner { height:86px; } .mini-sub-item { height:55px; } .admin-banner-create { width:100%; justify-content:center; } }
</style>
