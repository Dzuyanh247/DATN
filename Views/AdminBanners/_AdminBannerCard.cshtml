@model Banner
@{
    var positionLabel = Model.Position == "MainBanner" ? "Banner chính" : Model.Position == "SubBanner" ? "Banner phụ" : "Banner khác";
    var positionClass = Model.Position == "MainBanner" ? "is-main" : Model.Position == "SubBanner" ? "is-sub" : "is-other";
    var thumbClass = Model.Position == "SubBanner" ? "is-sub" : string.Empty;
    var linkLabel = string.IsNullOrWhiteSpace(Model.LinkUrl) ? "Chưa gắn link" : Model.LinkUrl;
}

<tr class="admin-banner-row">
    <td>
        <span class="admin-banner-thumb @thumbClass">
            <img src="@Model.ImageUrl" alt="@(string.IsNullOrWhiteSpace(Model.Title) ? positionLabel : Model.Title)" onerror="this.src='https://placehold.co/320x140?text=No+Image'" />
        </span>
    </td>
    <td><span class="banner-badge @positionClass">@positionLabel</span></td>
    <td><span class="banner-badge @(Model.IsActive ? "is-active" : "is-off")">@(Model.IsActive ? "Đang hiển thị" : "Đã tắt")</span></td>
    <td><strong>@Model.SortOrder</strong></td>
    <td><span class="admin-banner-ellipsis" title="@Model.LinkUrl">@linkLabel</span></td>
    <td><span class="admin-banner-ellipsis admin-banner-image-url" title="@Model.ImageUrl">@Model.ImageUrl</span></td>
    <td>
        <div class="admin-banner-actions">
            <a class="btn btn-sm btn-success" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil-square"></i>Sửa</a>
            <form method="post" asp-action="ToggleStatus">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button class="btn btn-sm @(Model.IsActive ? "btn-warning" : "btn-secondary")" type="submit"><i class="bi @(Model.IsActive ? "bi-eye-slash" : "bi-eye")"></i>@(Model.IsActive ? "Tắt" : "Bật")</button>
            </form>
            <form method="post" asp-action="Delete" onsubmit="return confirm('Xóa banner này?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button class="btn btn-sm btn-danger" type="submit"><i class="bi bi-trash3"></i>Xóa</button>
            </form>
        </div>
    </td>
</tr>
