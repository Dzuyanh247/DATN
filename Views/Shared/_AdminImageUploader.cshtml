@model dynamic
@{
    string primaryTarget = Model.PrimaryTarget;
    string? galleryTarget = Model.GalleryTarget as string;
    bool multiple = Model.Multiple == true;
    string currentUrl = Model.CurrentUrl ?? string.Empty;
}
<div class="admin-image-uploader" data-admin-image-uploader data-primary-target="@primaryTarget" data-gallery-target="@galleryTarget">
    <div class="admin-upload-drop" data-aiu-drop role="button" tabindex="0">
        <i class="bi bi-image fs-2 text-primary"></i>
        <div class="fw-semibold">Chọn ảnh hoặc kéo thả vào đây</div>
        <div class="small text-muted">JPG, PNG, WEBP, GIF, AVIF</div>
        <input class="d-none" data-aiu-file type="file" accept="image/*" @(multiple ? "multiple" : null) />
    </div>
    <div class="d-flex justify-content-between small text-muted mt-2"><span data-aiu-name>Chưa chọn file</span><span data-aiu-size></span></div>
    <div class="progress mt-2" style="height:6px"><div class="progress-bar" data-aiu-progress style="width:0%"></div></div>
    <div class="small text-muted mt-2" data-aiu-status>Sẵn sàng upload</div>
    <img data-aiu-preview src="@currentUrl" class="admin-upload-preview mt-3 @(string.IsNullOrWhiteSpace(currentUrl) ? "d-none" : null)" alt="Preview ảnh" />
</div>
