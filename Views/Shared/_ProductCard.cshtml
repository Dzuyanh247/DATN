@model Product
@inject Datn.PcStore.Data.ApplicationDbContext ReviewDb
@using Microsoft.EntityFrameworkCore
@{
    var finalPrice = (Model.DiscountPrice ?? Model.SalePrice) ?? Model.Price;
    var discount = finalPrice < Model.Price && Model.Price > 0 ? (int)Math.Round((1 - finalPrice / Model.Price) * 100) : 0;
    var image = ImageUrlHelper.ResolveImageUrl(Model.ProductImages.FirstOrDefault(x => x.IsPrimary)?.ImageUrl
        ?? Model.ProductImages.OrderBy(x => x.SortOrder).FirstOrDefault()?.ImageUrl
        ?? Model.ThumbnailImage, "/images/banners/banner_main1.png");
    var hoverSpecs = ProductSpecDisplayHelper.GetHoverSpecs(Model);
    var hoverSummary = ProductSpecDisplayHelper.GetSummaryText(Model);
    var promotionLines = ProductPromotionHelper.GetPromotionLines(Model);
    var isCompact = ViewData["CompactProductCard"] is true;
    var ratingStats = await ReviewDb.ProductReviews.AsNoTracking()
        .Where(x => x.ProductId == Model.Id && x.Status == ReviewStatus.Approved)
        .GroupBy(_ => 1)
        .Select(g => new { Average = g.Average(x => x.Rating), Count = g.Count() })
        .FirstOrDefaultAsync();
}
<div class="ttg-product-card">
    <a asp-controller="Products" asp-action="Detail" asp-route-id="@Model.Id" class="ttg-product-image-wrap text-decoration-none"
       data-pp-name="@Model.Name"
       data-pp-price="@finalPrice.ToString("N0") VNĐ"
       data-pp-old-price="@(finalPrice < Model.Price ? $"{Model.Price:N0} VNĐ" : string.Empty)"
       data-pp-stock="@(Model.IsInStock ? "Còn hàng" : "Hết hàng")"
       data-pp-warranty="@(string.IsNullOrWhiteSpace(Model.WarrantyDuration) ? (Model.WarrantyMonths > 0 ? $"{Model.WarrantyMonths} tháng" : string.Empty) : Model.WarrantyDuration)"
       data-pp-desc="@hoverSummary"
       data-pp-spec-lines='@string.Join("||", hoverSpecs)'
       data-pp-promo-lines='@string.Join("||", promotionLines)'>
        <img src="@image" class="ttg-product-image" alt="@Model.Name" onerror="this.onerror=null;this.src='/images/banners/banner_main1.png';" />
    </a>
    <h6 class="ttg-product-title">@Model.Name</h6>
    <div class="ttg-product-rating @(ratingStats is null ? "is-empty" : string.Empty)" aria-hidden="@(ratingStats is null ? "true" : "false")">
        @if (ratingStats is not null)
        {
            <i class="bi bi-star-fill"></i>
            <strong>@ratingStats.Average.ToString("0.0")</strong>
            <span>(@ratingStats.Count đánh giá)</span>
        }
    </div>
    <div class="ttg-price-row">
        <div class="ttg-price-stack">
            <div class="ttg-price">@finalPrice.ToString("N0") VNĐ</div>
            <div class="ttg-old-price">@(finalPrice < Model.Price ? $"{Model.Price:N0} VNĐ" : "")</div>
        </div>
        @if (discount > 0)
        {
            <span class="ttg-price-discount">-@discount%</span>
        }
    </div>
    @if (!isCompact)
    {
        <span class="ttg-stock ttg-card-stock">@(Model.IsInStock ? "Còn hàng" : "Hết hàng")</span>
        <div class="ttg-product-promotion" title="@(string.Join("; ", promotionLines))">
            <span aria-hidden="true">🎁</span>
            <span>@promotionLines[0]@(promotionLines.Count > 1 ? $" (+{promotionLines.Count - 1})" : string.Empty)</span>
        </div>
    }
    <div class="ttg-card-actions">
        @if (Model.IsInStock)
        {
            <form method="post" asp-controller="Cart" asp-action="Add">
                <input type="hidden" name="productId" value="@Model.Id" />
                <button class="ttg-add-btn"><i class="bi bi-cart-plus"></i> Thêm vào giỏ</button>
            </form>
        }
        else
        {
            <button class="ttg-add-btn" disabled>Thêm vào giỏ</button>
        }
        @if (isCompact)
        {
            <div class="ttg-secondary-actions">
                <partial name="_CompareButton" model="Model" />
                <span class="ttg-action-stock @(Model.IsInStock ? string.Empty : "is-out-of-stock")">@(Model.IsInStock ? "Còn hàng" : "Hết hàng")</span>
            </div>
        }
    </div>
    @if (!isCompact)
    {
        <div class="ttg-compare-slot">
            <partial name="_CompareButton" model="Model" />
        </div>
    }
</div>
