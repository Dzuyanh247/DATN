@model Tuple<string, List<Product>, string?>
@{
    var sectionTitle = Model.Item1;
    ViewData["CompactProductCard"] = true;
}
<section class="ttg-section standard-product-section">
    <div class="ttg-section-head">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h4 class="ttg-section-title">@sectionTitle.ToUpperInvariant()</h4>
        </div>
        <a class="ttg-view-all" asp-controller="Products" asp-action="Index">Xem tất cả &gt;&gt;</a>
    </div>
    <div class="ttg-products-grid">
        @if (Model.Item2 != null && Model.Item2.Any())
        {
            @foreach (var p in Model.Item2)
            {
                <partial name="_ProductCard" model="p" />
            }
        }
        else
        {
            <div class="ttg-empty-state">Danh mục đang được cập nhật sản phẩm. Vui lòng quay lại sau.</div>
        }
    </div>
</section>
