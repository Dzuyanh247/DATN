@model Tuple<string, List<Product>, string?>
@{
    var sectionTitle = Model.Item1;
    var isDeal = sectionTitle == "Sản phẩm nổi bật" || sectionTitle == "Khuyến mãi hot";
    var defaultBg = sectionTitle == "Sản phẩm nổi bật" ? "/images/defaults/deal-bg.jpg" : "/images/defaults/hot-promotion-bg.jpg";
    var sectionBackground = ImageUrlHelper.ResolveImageUrl(Model.Item3, defaultBg);
    var sectionStyle = $"background-image:url('{sectionBackground}')";
}
<section class="ttg-section @(isDeal ? "promo-section" : string.Empty)" style="@(isDeal ? sectionStyle : string.Empty)">
    <div class="ttg-section-head">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h4 class="ttg-section-title">@(sectionTitle == "Sản phẩm nổi bật" ? "DEAL HOT MỖI NGÀY - KHUYẾN MÃI LIỀN TAY" : sectionTitle)</h4>
            @if (isDeal)
            {
                <span class="ttg-hot-badge">HOT SALE</span>
            }
            else
            {
                <div class="ttg-tabs">
                    <a href="#" class="ttg-tab">PC Gaming giá rẻ</a>
                    <a href="#" class="ttg-tab">PC Stream Game</a>
                    <a href="#" class="ttg-tab">PC Core Ultra</a>
                    <a href="#" class="ttg-tab">PC Gaming cao cấp</a>
                </div>
            }
        </div>
        <a class="ttg-view-all" asp-controller="Products" asp-action="Index">Xem tất cả</a>
    </div>
    <div class="ttg-products-grid @(isDeal ? "promo-product-grid" : string.Empty)">
        @if (Model.Item2 != null && Model.Item2.Any())
        {
            @foreach (var p in Model.Item2)
            {
                <partial name="_ProductCard" model="p" />
            }
        }
        else
        {
            <div class="ttg-empty-state">Danh mục đang được cập nhật sản phẩm. Vui lòng quay lại sau.</div>
        }
    </div>
</section>
