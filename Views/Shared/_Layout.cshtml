@using Microsoft.EntityFrameworkCore
@using Datn.PcStore.Data
@inject ApplicationDbContext DbContext
@inject ICompareService CompareService
@inject ISearchSuggestionService SearchSuggestionService
@inject IShowroomService ShowroomService
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var menuCategories = await DbContext.Categories.OrderBy(c => c.CreatedAt).ToListAsync();
    var categoryIdByName = menuCategories.ToDictionary(c => c.Name, c => c.Id, StringComparer.OrdinalIgnoreCase);
    var siteLogoUrl = ImageUrlHelper.ResolveImageUrl(await DbContext.SiteSettings.OrderBy(x => x.Id).Select(x => x.LogoUrl).FirstOrDefaultAsync(), string.Empty);
    var configuredZaloUrl = Configuration["ShopContact:ZaloUrl"];
    var configuredZaloPhone = Configuration["ShopContact:ZaloPhone"];
    var onlineSalesZaloUrl = !string.IsNullOrWhiteSpace(configuredZaloUrl)
        ? configuredZaloUrl.Trim()
        : $"https://zalo.me/{(string.IsNullOrWhiteSpace(configuredZaloPhone) ? "0375570025" : configuredZaloPhone.Trim())}";
    var compareProducts = await CompareService.GetProductsAsync();
    var headerShowrooms = await ShowroomService.GetHeaderShowroomsAsync();
    var searchSuggestionData = await SearchSuggestionService.GetHeaderSuggestionsAsync();
    var compareCount = compareProducts.Count;
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var actionName = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var selectedHeaderCategoryId = Context.Request.Query["categoryId"].FirstOrDefault();
    var currentHeaderKeyword = Context.Request.Query["keyword"].FirstOrDefault();
    var selectedHeaderCategory = int.TryParse(selectedHeaderCategoryId, out var parsedHeaderCategoryId)
        ? menuCategories.FirstOrDefault(c => c.Id == parsedHeaderCategoryId)
        : null;
    var isAdminPage = controllerName.StartsWith("Admin") ||
                      controllerName == "AdminArticles" ||
                      (controllerName == "Articles" && (actionName == "Create" || actionName == "Edit"));
    var isComparePage = controllerName == "Compare";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KKSHOP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home-redesign.css" />
    <link rel="stylesheet" href="~/css/admin.css" />
    @if (controllerName == "AdminOrders")
    {
        <link rel="stylesheet" href="~/css/admin-orders.css" asp-append-version="true" />
    }
    @if (controllerName == "Products")
    {
        <link rel="stylesheet" href="~/css/products.css" asp-append-version="true" />
    }
    @if (controllerName == "Orders" && actionName == "BankTransfer")
    {
        <link rel="stylesheet" href="~/css/bank-transfer.css" asp-append-version="true" />
    }
    @if (controllerName == "Orders" && actionName == "Success")
    {
        <link rel="stylesheet" href="~/css/order-success.css" asp-append-version="true" />
    }
    @if (controllerName == "Orders" && (actionName == "Tracking" || actionName == "Detail"))
    {
        <link rel="stylesheet" href="~/css/order-tracking.css" asp-append-version="true" />
    }
    @if (!isAdminPage)
    {
        <link rel="stylesheet" href="~/css/chatbox.css" asp-append-version="true" />
    }
    @if (controllerName == "AdminChat")
    {
        <link rel="stylesheet" href="~/css/admin-chat.css" asp-append-version="true" />
    }
</head>
<body class="@(isAdminPage ? "admin-page" : (!isComparePage && compareCount > 0 ? "has-compare-tray" : string.Empty))">
@if (isAdminPage)
{
