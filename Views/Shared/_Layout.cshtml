@using Microsoft.EntityFrameworkCore
@using Datn.PcStore.Data
@inject ApplicationDbContext DbContext
@inject ICompareService CompareService
@{
    var menuCategories = await DbContext.Categories.OrderBy(c => c.CreatedAt).ToListAsync();
    var categoryIdByName = menuCategories.ToDictionary(c => c.Name, c => c.Id, StringComparer.OrdinalIgnoreCase);
    var siteLogoUrl = ImageUrlHelper.ResolveImageUrl(await DbContext.SiteSettings.OrderBy(x => x.Id).Select(x => x.LogoUrl).FirstOrDefaultAsync(), string.Empty);
    var compareProducts = await CompareService.GetProductsAsync();
    var compareCount = compareProducts.Count;
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var actionName = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var selectedHeaderCategoryId = Context.Request.Query["categoryId"].FirstOrDefault();
    var currentHeaderKeyword = Context.Request.Query["keyword"].FirstOrDefault();
    var selectedHeaderCategory = int.TryParse(selectedHeaderCategoryId, out var parsedHeaderCategoryId)
        ? menuCategories.FirstOrDefault(c => c.Id == parsedHeaderCategoryId)
        : null;
    var isAdminPage = controllerName.StartsWith("Admin") ||
                      controllerName == "Contact" && actionName == "Manage" ||
                      controllerName == "Articles" && (actionName == "Create" || actionName == "Edit");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KKSHOP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home-redesign.css" />
    <link rel="stylesheet" href="~/css/admin.css" />
    @if (controllerName == "AdminOrders")
    {
        <link rel="stylesheet" href="~/css/admin-orders.css" asp-append-version="true" />
    }
    @if (controllerName == "Products")
    {
        <link rel="stylesheet" href="~/css/products.css" asp-append-version="true" />
    }
    @if (controllerName == "Orders" && actionName == "BankTransfer")
    {
        <link rel="stylesheet" href="~/css/bank-transfer.css" asp-append-version="true" />
    }
    @if (controllerName == "Orders" && (actionName == "Tracking" || actionName == "Detail"))
    {
        <link rel="stylesheet" href="~/css/order-tracking.css" asp-append-version="true" />
    }
    @if (!isAdminPage)
    {
        <link rel="stylesheet" href="~/css/chatbox.css" asp-append-version="true" />
    }
    @if (controllerName == "AdminChat")
    {
        <link rel="stylesheet" href="~/css/admin-chat.css" asp-append-version="true" />
    }
</head>
<body class="@(compareCount > 0 ? "has-compare-tray" : string.Empty)">
@if (isAdminPage)
{
    <div class="admin-shell">
        <aside class="admin-sidebar">
            <a class="admin-brand" asp-controller="@(User.IsInRole("Admin") ? "AdminDashboard" : "AdminChat")" asp-action="Index">
                <i class="bi bi-grid-1x2-fill"></i><span>KKSHOP Admin</span>
            </a>
            <nav class="admin-nav">
                @if (User.IsInRole("Admin"))
                {
                <a class="@(controllerName == "AdminDashboard" ? "active" : "")" asp-controller="AdminDashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a>
                <a class="@(controllerName == "AdminProducts" ? "active" : "")" asp-controller="AdminProducts" asp-action="Index"><i class="bi bi-box-seam"></i> Sản phẩm</a>
                <a class="@(controllerName == "AdminCategories" ? "active" : "")" asp-controller="AdminCategories" asp-action="Index"><i class="bi bi-tags"></i> Danh mục</a>
                <a class="@(controllerName == "AdminOrders" ? "active" : "")" asp-controller="AdminOrders" asp-action="Index"><i class="bi bi-receipt"></i> Đơn hàng</a>
                <a class="@(controllerName == "AdminWarranty" ? "active" : "")" asp-controller="AdminWarranty" asp-action="Index"><i class="bi bi-shield-check"></i> Bảo hành</a>
                <a class="@(controllerName == "AdminUsers" ? "active" : "")" asp-controller="AdminUsers" asp-action="Index"><i class="bi bi-people"></i> Người dùng</a>
                <a class="@(controllerName == "AdminBanners" ? "active" : "")" asp-controller="AdminBanners" asp-action="Index"><i class="bi bi-image"></i> Banner</a>
                }
                <a class="@(controllerName == "AdminChat" ? "active" : "")" asp-controller="AdminChat" asp-action="Index"><i class="bi bi-chat-dots"></i> Hỗ trợ khách hàng</a>
                @if (User.IsInRole("Admin"))
                {
                <a class="@(controllerName == "AdminSettings" ? "active" : "")" asp-controller="AdminSettings" asp-action="Index"><i class="bi bi-gear"></i> Cài đặt</a>
                }
            </nav>
        </aside>

        <div class="admin-main">
            <header class="admin-topbar">
                <h1>@(ViewData["Title"] ?? "Quản trị hệ thống")</h1>
                <div class="admin-topbar-actions">
                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Về trang chủ</a>
                    <form method="post" asp-controller="Account" asp-action="Logout" class="d-inline">
                        <button class="btn btn-sm btn-danger"><i class="bi bi-box-arrow-right"></i> Đăng xuất</button>
                    </form>
                </div>
            </header>
            <main class="admin-content">@RenderBody()</main>
        </div>
    </div>
}
else
{
<div class="ttg-topbar text-light py-2 small">
    <div class="container ttg-shell ttg-topbar-inner">
        <div class="ttg-topbar-left">
            <a href="#" class="ttg-pill"><i class="bi bi-geo-alt"></i> Hệ thống showroom</a>
            <a href="#" class="ttg-pill"><i class="bi bi-telephone"></i> Bán hàng trực tuyến</a>
            <a asp-controller="Articles" asp-action="Index" class="ttg-pill">Trang tin công nghệ</a>
            <a asp-controller="BuildPc" asp-action="Index" class="ttg-pill"><i class="bi bi-cpu"></i> Tư vấn build PC</a>
            <a href="#" class="ttg-pill">Phần mềm hay</a>
        </div>
        <div class="ttg-topbar-right">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="text-light text-decoration-none" asp-controller="Account" asp-action="Profile">Thông tin tài khoản</a>
                <a class="text-light text-decoration-none" asp-controller="Orders" asp-action="MyOrders">Đơn hàng</a>
                @if (User.IsInRole("Admin") || User.IsInRole("SupportStaff") || User.IsInRole("CustomerSupport"))
                {
                    <a class="text-light text-decoration-none" asp-controller="@(User.IsInRole("Admin") ? "AdminDashboard" : "AdminChat")" asp-action="Index">Quản trị</a>
                }
                <form method="post" asp-controller="Account" asp-action="Logout" class="d-inline"><button class="btn btn-sm btn-outline-light py-0">Đăng xuất</button></form>
            }
            else
            {
                <a class="text-light text-decoration-none" asp-controller="Account" asp-action="Register">Đăng ký</a>
                <a class="text-light text-decoration-none" asp-controller="Account" asp-action="Login">Đăng nhập</a>
            }
        </div>
    </div>
</div>
<header class="ttg-main-header shadow-sm sticky-top">
    <div class="container ttg-shell ttg-main-header-row">
        <a asp-controller="Home" asp-action="Index" class="site-logo" aria-label="KKSHOP">
            @if (!string.IsNullOrWhiteSpace(siteLogoUrl))
            {
                <img src="@siteLogoUrl"
                     class="site-logo-image"
                     alt="KKSHOP"
                     loading="eager"
                     decoding="async" />
            }
        </a>
        <form class="ttg-search" asp-controller="Products" asp-action="Index" method="get" data-header-search>
            <input type="hidden" name="categoryId" value="@selectedHeaderCategory?.Id" data-search-category-id />
            <div class="ttg-search-group">
                <div class="dropdown ttg-search-category">
                    <button class="ttg-search-category-toggle dropdown-toggle"
                            type="button"
                            id="headerSearchCategory"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        <span data-search-category-label>@(selectedHeaderCategory?.Name ?? "Tất cả danh mục")</span>
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="headerSearchCategory">
                        <li>
                            <button class="dropdown-item @(selectedHeaderCategory is null ? "active" : "")"
                                    type="button"
                                    data-category-id=""
                                    data-category-name="Tất cả danh mục">Tất cả danh mục</button>
                        </li>
                        @foreach (var category in menuCategories)
                        {
                            <li>
                                <button class="dropdown-item @(selectedHeaderCategory?.Id == category.Id ? "active" : "")"
                                        type="button"
                                        data-category-id="@category.Id"
                                        data-category-name="@category.Name">@category.Name</button>
                            </li>
                        }
                    </ul>
                </div>
                <input class="form-control" name="keyword" value="@currentHeaderKeyword" placeholder="Tìm kiếm sản phẩm..." aria-label="Tìm kiếm sản phẩm" />
                <button class="ttg-search-submit" type="submit" aria-label="Tìm kiếm"><i class="bi bi-search"></i></button>
            </div>
        </form>
        <div class="ttg-header-actions">
            <a class="ttg-cta d-inline-flex align-items-center gap-2" href="tel:19006868"><span class="icon"><i class="bi bi-telephone"></i></span><span>Hotline<br><b>1900 6868</b></span></a>
            <a class="ttg-cta d-inline-flex align-items-center gap-2" asp-controller="BuildPc" asp-action="Index"><span class="icon"><i class="bi bi-tools"></i></span><span>Xây dựng<br><b>Cấu hình PC</b></span></a>
            <a class="ttg-cta d-inline-flex align-items-center gap-2" asp-controller="Warranty" asp-action="Check"><span class="icon"><i class="bi bi-shield-check"></i></span><span>Kiểm tra<br><b>Bảo hành</b></span></a>
            <a class="ttg-cta d-inline-flex align-items-center gap-2 position-relative" asp-controller="Compare" asp-action="Index"><span class="icon"><i class="bi bi-columns-gap"></i></span><span>So sánh<br><b>(@compareCount)</b></span></a>
            <a class="ttg-cta d-inline-flex align-items-center gap-2 position-relative" asp-controller="Cart" asp-action="Index"><span class="icon"><i class="bi bi-cart3"></i></span><span>Giỏ hàng</span><span id="cart-count-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill text-bg-danger">@await Component.InvokeAsync("CartCount")</span></a>
        </div>
    </div>
    <div class="ttg-cat-nav-wrap">
        <div class="container ttg-shell ttg-cat-row">
            <div class="ttg-all-categories">
                <button class="ttg-cat-btn"
                        type="button"
                        aria-expanded="false"
                        aria-controls="headerCategoryMenu"
                        data-category-menu-toggle>
                    <i class="bi bi-list" aria-hidden="true"></i>
                    <span>DANH MỤC SẢN PHẨM</span>
                    <i class="bi bi-chevron-down ttg-cat-chevron" aria-hidden="true"></i>
                </button>
                <div id="headerCategoryMenu" class="ttg-category-menu" hidden data-category-menu>
                    @foreach (var category in menuCategories)
                    {
                        <a asp-controller="Products" asp-action="Index" asp-route-categoryId="@category.Id">
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            <span>@category.Name</span>
                        </a>
                    }
                </div>
            </div>
            <div class="ttg-cat-nav" aria-label="Danh mục nổi bật">
                <a class="ttg-cat-link" asp-controller="Products" asp-action="Index" asp-route-categoryId="@(categoryIdByName.GetValueOrDefault("PC Gaming"))" asp-route-categorySlug="pc-gaming"><i class="bi bi-pc-display"></i>PC Gaming</a>
                <a class="ttg-cat-link" asp-controller="Products" asp-action="Index" asp-route-categoryId="@(categoryIdByName.GetValueOrDefault("Workstation"))" asp-route-categorySlug="workstation"><i class="bi bi-cpu"></i>Workstation</a>
                <a class="ttg-cat-link" asp-controller="Products" asp-action="Index" asp-route-categoryId="@(categoryIdByName.GetValueOrDefault("AMD Gaming"))" asp-route-categorySlug="amd-gaming"><i class="bi bi-gpu-card"></i>AMD Gaming</a>
                <a class="ttg-cat-link" asp-controller="Products" asp-action="Index" asp-route-categoryId="@(categoryIdByName.GetValueOrDefault("PC Mini"))" asp-route-categorySlug="pc-mini"><i class="bi bi-device-ssd"></i>PC Mini</a>
                <a class="ttg-cat-link" asp-controller="Products" asp-action="Index" asp-route-categoryId="@(categoryIdByName.GetValueOrDefault("PC Văn Phòng"))" asp-route-categorySlug="pc-van-phong"><i class="bi bi-briefcase"></i>PC Văn Phòng</a>
                <a class="ttg-cat-link" asp-controller="Products" asp-action="Index" asp-route-categoryId="@(categoryIdByName.GetValueOrDefault("Linh kiện"))" asp-route-categorySlug="linh-kien"><i class="bi bi-memory"></i>Linh kiện</a>
            </div>
        </div>
    </div>
</header>

<div class="container ttg-shell py-3">
    @if (TempData["Success"] != null || TempData["SuccessMessage"] != null)
    {
        <script>
            window.__successToastMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((TempData["Success"] ?? TempData["SuccessMessage"])?.ToString()));
        </script>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <script>
            window.__infoToastMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["InfoMessage"]?.ToString()));
        </script>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @await Html.PartialAsync("_GlobalNotifications")
    @RenderBody()
</div>
@await Html.PartialAsync("_CompareTray", compareProducts)
@await Html.PartialAsync("_SupportChatBox")
<div id="ttg-product-preview" class="product-hover-card" aria-hidden="true"></div>
}

<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1090;">
    <div id="globalToast" class="toast align-items-center text-white border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="globalToastMessage"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function(){
const toastEl=document.getElementById('globalToast');
const toastMsg=document.getElementById('globalToastMessage');
const toastInstance=toastEl?new bootstrap.Toast(toastEl,{delay:2500}):null;
window.showToast=function(message,type){
    if(!toastEl||!toastMsg||!toastInstance||!message) return;
    const tone=(type||'success').toLowerCase();
    toastEl.classList.remove('bg-success','bg-danger','bg-warning','bg-info');
    if(tone==='danger'||tone==='error') toastEl.classList.add('bg-danger');
    else if(tone==='warning') toastEl.classList.add('bg-warning');
    else if(tone==='info') toastEl.classList.add('bg-info');
    else toastEl.classList.add('bg-success');
    toastMsg.textContent=message;
    toastInstance.show();
};
window.showGlobalToast=function(message,type){window.showToast(message,type||'success');};
function u(c){const b=document.getElementById('cart-count-badge');if(!b)return;b.textContent=c;}
document.querySelectorAll('form[action*="/Cart/Add"]').forEach(function(f){f.addEventListener('submit',async function(e){e.preventDefault();const d=new FormData(f);try{const r=await fetch(f.action,{method:'POST',headers:{'X-Requested-With':'XMLHttpRequest','Accept':'application/json'},body:d});const j=await r.json();if(!r.ok||!j.success){window.showGlobalToast((j&&j.message)||'Có lỗi khi thêm vào giỏ.','danger');return;}window.showGlobalToast(j.message||'Đã thêm sản phẩm vào giỏ hàng!','success');u(j.cartCount??0);}catch{window.showGlobalToast('Không thể kết nối máy chủ.','danger');}});});
if(window.__successToastMessage){window.showGlobalToast(window.__successToastMessage,'success');}
if(window.__infoToastMessage){window.showGlobalToast(window.__infoToastMessage,'info');}
document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function(el){new bootstrap.Tooltip(el);});
const productHoverPopup=document.getElementById('ttg-product-preview');
const esc=(s)=>(s||'').toString().replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
const hasRawJson=(s)=>{const value=(s||'').toString().trim();return value.startsWith('[')||value.startsWith('{')||/"(description|stt|quantity)"/i.test(value);};
const splitSpecs=(s)=>(s||'').split('||').map(x=>x.trim()).filter(x=>x&&!hasRawJson(x)).slice(0,6);
const hideProductHover=()=>{if(productHoverPopup){productHoverPopup.classList.remove('show');productHoverPopup.setAttribute('aria-hidden','true');}};
const placeProductHover=(card)=>{
    const rect=card.getBoundingClientRect();
    const ppRect=productHoverPopup.getBoundingClientRect();
    const gap=10;
    let left=rect.right+gap;
    if(left+ppRect.width>window.innerWidth-10) left=rect.left-ppRect.width-gap;
    left=Math.max(10, Math.min(left, window.innerWidth-ppRect.width-10));
    let top=rect.top;
    if(top+ppRect.height>window.innerHeight-10) top=Math.max(10, window.innerHeight-ppRect.height-10);
    productHoverPopup.style.left=`${left+window.scrollX}px`;
    productHoverPopup.style.top=`${top+window.scrollY}px`;
};
const showProductHover=(card)=>{
    if(!productHoverPopup||window.innerWidth<768) return;
    const d=card.dataset;
    const specs=splitSpecs(d.ppSpecLines);
    const desc=(!hasRawJson(d.ppDesc)&&d.ppDesc)?d.ppDesc:'';
    const promotions=splitSpecs(d.ppPromoLines);
    const specHtml=specs.length?`<div class="product-hover-label">Mô tả tóm tắt:</div><ul class="product-hover-spec-list">${specs.map(x=>`<li><i class="bi bi-check-circle-fill"></i><span>${esc(x)}</span></li>`).join('')}</ul>`:(desc?`<div class="product-hover-label">Mô tả tóm tắt:</div><div class="product-hover-desc">${esc(desc)}</div>`:'');
    const promoHtml=promotions.length?`<div class="product-hover-promo"><div class="product-hover-label">Khuyến mại:</div><ul class="product-hover-promo-list">${promotions.map(x=>`<li><span aria-hidden="true">🎁</span><span>${esc(x)}</span></li>`).join('')}</ul></div>`:'';
    productHoverPopup.innerHTML=`<div class="product-hover-header">${esc(d.ppName||'Sản phẩm')}</div><div class="product-hover-body"><div class="product-hover-price"><span>Giá bán:</span> <strong>${esc(d.ppPrice||'Liên hệ')}</strong></div>${d.ppOldPrice?`<div class="product-hover-old-price">${esc(d.ppOldPrice)}</div>`:''}${d.ppWarranty?`<div class="product-hover-warranty"><b>Bảo hành:</b> ${esc(d.ppWarranty)}</div>`:''}${specHtml}${promoHtml}</div>`;
    productHoverPopup.classList.add('show');
    productHoverPopup.setAttribute('aria-hidden','false');
    placeProductHover(card);
};
document.querySelectorAll('.ttg-product-card').forEach(function(card){
    const previewSource=card.querySelector('.ttg-product-image-wrap[data-pp-name]');
    if(!previewSource) return;
    card.addEventListener('mouseenter',()=>showProductHover(previewSource));
    card.addEventListener('mouseleave',hideProductHover);
    card.addEventListener('focusin',()=>showProductHover(previewSource));
    card.addEventListener('focusout',(event)=>{if(!card.contains(event.relatedTarget)) hideProductHover();});
});
window.addEventListener('scroll',hideProductHover,{passive:true});
window.addEventListener('resize',hideProductHover);
})();
</script>
@if (!isAdminPage)
{
    <script src="~/js/header.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/js/chatbox.js" asp-append-version="true"></script>
}
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
