                {
                    <span class="admin-nav-label">Tổng quan</span>
                    <a class="@(controllerName == "AdminDashboard" ? "active" : "")" asp-controller="AdminDashboard" asp-action="Index"><i class="bi bi-grid-1x2"></i><span>Dashboard</span></a>
                    <span class="admin-nav-label">Bán hàng</span>
                    <a class="@(controllerName == "AdminOrders" ? "active" : "")" asp-controller="AdminOrders" asp-action="Index"><i class="bi bi-bag-check"></i><span>Đơn hàng</span></a>
                    <a class="@(controllerName == "AdminInvoices" ? "active" : "")" asp-controller="AdminInvoices" asp-action="Index"><i class="bi bi-receipt-cutoff"></i><span>Hóa đơn</span></a>
