@using Microsoft.EntityFrameworkCore
@using Datn.PcStore.Data
@inject ApplicationDbContext DbContext
@{
    var menuCategories = await DbContext.Categories.OrderBy(c => c.CreatedAt).ToListAsync();
    var siteLogoUrl = await DbContext.SiteSettings.OrderBy(x => x.Id).Select(x => x.LogoUrl).FirstOrDefaultAsync();
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var actionName = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var isAdminPage = controllerName.StartsWith("Admin") ||
                      controllerName == "Contact" && actionName == "Manage" ||
                      controllerName == "Articles" && (actionName == "Create" || actionName == "Edit");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KKSHOP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/home-redesign.css" />
    <link rel="stylesheet" href="~/css/admin.css" />
</head>
<body>
@if (isAdminPage)
{
    <div class="admin-shell">
        <aside class="admin-sidebar">
            <a class="admin-brand" asp-controller="AdminDashboard" asp-action="Index">
                <i class="bi bi-grid-1x2-fill"></i><span>KKSHOP Admin</span>
            </a>
            <nav class="admin-nav">
                <a class="@(controllerName == "AdminDashboard" ? "active" : "")" asp-controller="AdminDashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a>
                <a class="@(controllerName == "AdminProducts" ? "active" : "")" asp-controller="AdminProducts" asp-action="Index"><i class="bi bi-box-seam"></i> Sản phẩm</a>
                <a class="@(controllerName == "AdminCategories" ? "active" : "")" asp-controller="AdminCategories" asp-action="Index"><i class="bi bi-tags"></i> Danh mục</a>
                <a class="@(controllerName == "AdminOrders" ? "active" : "")" asp-controller="AdminOrders" asp-action="Index"><i class="bi bi-receipt"></i> Đơn hàng</a>
                <a class="@(controllerName == "AdminUsers" ? "active" : "")" asp-controller="AdminUsers" asp-action="Index"><i class="bi bi-people"></i> Người dùng</a>
                <a class="@(controllerName == "AdminBanners" ? "active" : "")" asp-controller="AdminBanners" asp-action="Index"><i class="bi bi-image"></i> Banner</a>
                <a class="@(controllerName == "AdminSettings" ? "active" : "")" asp-controller="AdminSettings" asp-action="Index"><i class="bi bi-gear"></i> Cài đặt</a>
            </nav>
        </aside>

        <div class="admin-main">
            <header class="admin-topbar">
                <h1>@(ViewData["Title"] ?? "Quản trị hệ thống")</h1>
                <div class="admin-topbar-actions">
                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Về trang chủ</a>
                    <form method="post" asp-controller="Account" asp-action="Logout" class="d-inline">
                        <button class="btn btn-sm btn-danger"><i class="bi bi-box-arrow-right"></i> Đăng xuất</button>
                    </form>
                </div>
            </header>
            <main class="admin-content">@RenderBody()</main>
        </div>
    </div>
}
else
{
<div class="ttg-topbar text-light py-2 small">
    <div class="container ttg-shell d-flex justify-content-between align-items-center gap-2 flex-wrap">
        <div class="d-flex gap-2 flex-wrap">
            <a href="#" class="ttg-pill"><i class="bi bi-geo-alt"></i> Hệ thống showroom</a>
            <a href="#" class="ttg-pill"><i class="bi bi-telephone"></i> Bán hàng trực tuyến</a>
            <a asp-controller="BuildPc" asp-action="Index" class="ttg-pill"><i class="bi bi-cpu"></i> Tư vấn build PC</a>
        </div>
        <div class="d-flex gap-3">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="text-light text-decoration-none" asp-controller="Orders" asp-action="MyOrders">Đơn hàng</a>
                @if (User.IsInRole("Admin"))
                {
                    <a class="text-light text-decoration-none" asp-controller="AdminDashboard" asp-action="Index">Quản trị</a>
                }
                <form method="post" asp-controller="Account" asp-action="Logout" class="d-inline"><button class="btn btn-sm btn-outline-light py-0">Đăng xuất</button></form>
            }
            else
            {
                <a class="text-light text-decoration-none" asp-controller="Account" asp-action="Register">Đăng ký</a>
                <a class="text-light text-decoration-none" asp-controller="Account" asp-action="Login">Đăng nhập</a>
            }
        </div>
    </div>
</div>
<header class="ttg-main-header shadow-sm sticky-top">
    <div class="container ttg-shell py-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
        <a asp-controller="Home" asp-action="Index" class="site-logo">
            @if (!string.IsNullOrWhiteSpace(siteLogoUrl))
            {
                <img src="@siteLogoUrl"
                     alt="KKSHOP"
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-flex';" />
                <span class="site-logo-text" style="display:none;">KKSHOP</span>
            }
            else
            {
                <span class="site-logo-text">KKSHOP</span>
            }
        </a>
        <form class="ttg-search flex-grow-1" asp-controller="Products" asp-action="Index" method="get">
            <div class="input-group">
                <select class="form-select" style="max-width:180px"><option>Tất cả danh mục</option></select>
                <input class="form-control" name="Keyword" placeholder="Tìm kiếm sản phẩm..." />
                <button class="btn text-white" type="submit"><i class="bi bi-search"></i></button>
            </div>
        </form>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <a class="ttg-cta d-inline-flex align-items-center gap-2" href="tel:19006868"><span class="icon"><i class="bi bi-telephone"></i></span><span>Hotline<br><b>1900 6868</b></span></a>
            <a class="ttg-cta d-inline-flex align-items-center gap-2" asp-controller="BuildPc" asp-action="Index"><span class="icon"><i class="bi bi-tools"></i></span><span>Xây dựng<br><b>Cấu hình PC</b></span></a>
            <a class="ttg-cta d-inline-flex align-items-center gap-2 position-relative" asp-controller="Cart" asp-action="Index"><span class="icon"><i class="bi bi-cart3"></i></span><span>Giỏ hàng</span><span id="cart-count-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill text-bg-danger">@await Component.InvokeAsync("CartCount")</span></a>
        </div>
    </div>
    <div class="ttg-cat-nav-wrap">
        <div class="container ttg-shell py-2 ttg-cat-nav">
            @foreach (var c in menuCategories)
            {
                <a class="ttg-cat-link" asp-controller="Products" asp-action="Index" asp-route-CategoryId="@c.Id"><i class="@c.IconClass"></i>@c.Name</a>
            }
            <a class="ttg-cat-link" asp-controller="Articles" asp-action="Index"><i class="bi bi-newspaper"></i>Tin tức</a>
            <a class="ttg-cat-link" asp-controller="Contact" asp-action="Index"><i class="bi bi-telephone-inbound"></i>Liên hệ</a>
        </div>
    </div>
</header>

<div class="container ttg-shell py-3">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @await Html.PartialAsync("_GlobalNotifications")
    @RenderBody()
</div>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function(){
const t=document.createElement('div');t.id='cart-toast';t.className='cart-toast';document.body.appendChild(t);
window.showGlobalToast=function(message,isError){t.textContent=message;t.classList.toggle('error',!!isError);t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2200);};
function u(c){const b=document.getElementById('cart-count-badge');if(!b)return;b.textContent=c}
document.querySelectorAll('form[action*="/Cart/Add"]').forEach(function(f){f.addEventListener('submit',async function(e){e.preventDefault();const d=new FormData(f);try{const r=await fetch(f.action,{method:'POST',headers:{'X-Requested-With':'XMLHttpRequest','Accept':'application/json'},body:d});const j=await r.json();if(!r.ok||!j.success){window.showGlobalToast(j.message||'Có lỗi khi thêm vào giỏ.',true);return;}window.showGlobalToast(j.message||'Đã thêm vào giỏ hàng thành công');u(j.cartCount??0);}catch{window.showGlobalToast('Không thể kết nối máy chủ.',true);}});});
})();
</script>
<script src="~/js/tawk-chat.js"></script>
</body>
</html>
