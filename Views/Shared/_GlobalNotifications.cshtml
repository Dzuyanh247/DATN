@{
    var success = TempData["SuccessMessage"] as string ?? TempData["CartSuccess"] as string ?? TempData["OrderSuccess"] as string;
    var error = TempData["ErrorMessage"] as string ?? TempData["CartError"] as string;
    var warning = TempData["WarningMessage"] as string;
}

@if (!string.IsNullOrWhiteSpace(success) || !string.IsNullOrWhiteSpace(error) || !string.IsNullOrWhiteSpace(warning))
{
    <div class="position-fixed top-0 end-0 p-3" style="z-index:1080;">
        @if (!string.IsNullOrWhiteSpace(success))
        {
            <div class="toast align-items-center text-bg-success border-0 mb-2 auto-toast" role="alert">
                <div class="d-flex"><div class="toast-body">@success</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="toast align-items-center text-bg-danger border-0 mb-2 auto-toast" role="alert">
                <div class="d-flex"><div class="toast-body">@error</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(warning))
        {
            <div class="toast align-items-center text-bg-warning border-0 mb-2 auto-toast" role="alert">
                <div class="d-flex"><div class="toast-body">@warning</div><button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast"></button></div>
            </div>
        }
    </div>
    <script>
        document.querySelectorAll('.auto-toast').forEach(el => new bootstrap.Toast(el, { delay: 3000 }).show());
    </script>
}
