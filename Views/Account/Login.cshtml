@model LoginVm
@{
    ViewData["Title"] = "Đăng nhập";
}

<section class="account-page" aria-labelledby="login-title">
    <div class="account-card">
        <header class="account-header">
            <div class="account-icon" aria-hidden="true">
                <i class="bi bi-person-lock"></i>
            </div>
            <h1 id="login-title" class="account-title">Đăng nhập</h1>
            <p class="account-description">Đăng nhập để tiếp tục mua sắm tại KKSHOP</p>
        </header>

        @if (TempData["Ok"] is string okMessage)
        {
            <div class="alert alert-success account-alert" role="alert">
                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                <span>@okMessage</span>
            </div>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger account-alert" role="alert">
                <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
                <span>@errorMessage</span>
            </div>
        }

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="account-validation" role="alert"></div>

            <div class="account-form-grid">
                <div class="account-field">
                    <label asp-for="Email" class="account-label">Email</label>
                    <div class="account-input-wrap">
                        <i class="bi bi-envelope" aria-hidden="true"></i>
                        <input asp-for="Email"
                               class="account-input"
                               placeholder="Nhập email của bạn"
                               autocomplete="email"
                               inputmode="email" />
                    </div>
                    <span asp-validation-for="Email" class="account-field-validation"></span>
                </div>

                <div class="account-field">
                    <label asp-for="Password" class="account-label">Mật khẩu</label>
                    <div class="account-input-wrap">
                        <i class="bi bi-lock" aria-hidden="true"></i>
                        <input asp-for="Password"
                               type="password"
                               class="account-input"
                               placeholder="Nhập mật khẩu"
                               autocomplete="current-password" />
                    </div>
                    <span asp-validation-for="Password" class="account-field-validation"></span>
                    <div class="account-field-meta">
                        <a asp-controller="Account" asp-action="ForgotPassword" class="account-link">Quên mật khẩu?</a>
                    </div>
                </div>
            </div>

            <div class="account-actions">
                <button type="submit" class="account-btn">Đăng nhập</button>
            </div>
        </form>

        <p class="account-card-footer">
            Chưa có tài khoản?
            <a asp-controller="Account" asp-action="Register" class="account-link">Đăng ký ngay</a>
        </p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
