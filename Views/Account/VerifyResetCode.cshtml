@model VerifyResetCodeViewModel
@{
    ViewData["Title"] = "Xác minh mã đặt lại mật khẩu";
    var hasEmail = !string.IsNullOrWhiteSpace(Model?.Email);
    var maskedEmail = !string.IsNullOrWhiteSpace(Model?.MaskedEmail) ? Model.MaskedEmail : Model?.Email;
    var resendCooldownSeconds = Model?.ResendCooldownSeconds ?? 0;
}

<section class="account-page" aria-labelledby="verify-reset-code-title">
    <div class="account-card">
        <header class="account-header">
            <div class="account-icon" aria-hidden="true">
                <i class="bi bi-shield-lock"></i>
            </div>
            <h1 id="verify-reset-code-title" class="account-title">Xác minh mã đặt lại mật khẩu</h1>
            <p class="account-description">Nhập mã xác nhận đã được gửi đến email của bạn để tạo mật khẩu mới.</p>
        </header>

        @if (TempData["Ok"] is string okMessage)
        {
            <div class="account-notice" role="status">
                <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
                <span>@okMessage</span>
            </div>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger account-alert" role="alert">
                <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
                <span>@errorMessage</span>
            </div>
        }

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="account-validation" role="alert"></div>

            <div class="account-form-grid">
                <div class="account-field">
                    <label asp-for="Email" class="account-label">Email</label>
                    <div class="account-input-wrap">
                        <i class="bi bi-envelope" aria-hidden="true"></i>
                        @if (hasEmail)
                        {
                            <input asp-for="Email"
                                   class="account-input"
                                   placeholder="Email đã yêu cầu đặt lại mật khẩu"
                                   autocomplete="email"
                                   inputmode="email"
                                   readonly />
                        }
                        else
                        {
                            <input asp-for="Email"
                                   class="account-input"
                                   placeholder="Email đã yêu cầu đặt lại mật khẩu"
                                   autocomplete="email"
                                   inputmode="email" />
                        }
                    </div>
                    @if (hasEmail)
                    {
                        <p class="account-helper-text">Email: @maskedEmail</p>
                    }
                    <span asp-validation-for="Email" class="account-field-validation"></span>
                </div>

                <div class="account-field">
                    <label asp-for="Code" class="account-label">Mã xác nhận</label>
                    <div class="account-input-wrap">
                        <i class="bi bi-123" aria-hidden="true"></i>
                        <input asp-for="Code"
                               class="account-input"
                               placeholder="Nhập mã 6 số"
                               inputmode="numeric"
                               maxlength="6"
                               autocomplete="one-time-code" />
                    </div>
                    <span asp-validation-for="Code" class="account-field-validation"></span>
                </div>

                <div class="account-field">
                    <label asp-for="NewPassword" class="account-label">Mật khẩu mới</label>
                    <div class="account-input-wrap account-input-wrap--password">
                        <i class="bi bi-lock" aria-hidden="true"></i>
                        <input asp-for="NewPassword"
                               type="password"
                               class="account-input"
                               placeholder="Nhập mật khẩu mới"
                               autocomplete="new-password" />
                        <button type="button" class="account-password-toggle" data-password-toggle="NewPassword" aria-label="Hiện mật khẩu mới">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="account-field-validation"></span>
                </div>

                <div class="account-field">
                    <label asp-for="ConfirmPassword" class="account-label">Nhập lại mật khẩu mới</label>
                    <div class="account-input-wrap account-input-wrap--password">
                        <i class="bi bi-lock-fill" aria-hidden="true"></i>
                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="account-input"
                               placeholder="Nhập lại mật khẩu mới"
                               autocomplete="new-password" />
                        <button type="button" class="account-password-toggle" data-password-toggle="ConfirmPassword" aria-label="Hiện mật khẩu nhập lại">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="account-field-validation"></span>
                </div>
            </div>

            <div class="account-actions">
                <button type="submit" class="account-btn">Xác nhận &amp; đổi mật khẩu</button>
            </div>
        </form>

        <div id="resendResetCodeMessage" class="account-resend-message" role="status" aria-live="polite" hidden></div>

        <div class="account-card-footer account-card-footer--links">
            <form id="resendResetCodeForm" asp-controller="Account" asp-action="ResendResetCode" method="post" class="account-resend-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="email" value="@(Model?.Email ?? string.Empty)" />
                <button type="submit"
                        id="resendResetCodeButton"
                        class="account-link account-resend-button"
                        data-default-text="Gửi lại mã"
                        data-cooldown-seconds="@resendCooldownSeconds"
                        @(resendCooldownSeconds > 0 ? "disabled" : null)>Gửi lại mã</button>
            </form>
            <span aria-hidden="true">•</span>
            <a asp-controller="Account" asp-action="Login" class="account-link">Quay lại đăng nhập</a>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const resendForm = document.getElementById('resendResetCodeForm');
        const resendButton = document.getElementById('resendResetCodeButton');
        const resendMessage = document.getElementById('resendResetCodeMessage');
        let resendTimerId;

        const showResendMessage = (message, isError = false) => {
            if (!resendMessage) return;
            resendMessage.hidden = false;
            resendMessage.textContent = message;
            resendMessage.classList.toggle('account-resend-message--error', isError);
        };

        const startResendCooldown = (seconds) => {
            if (!resendButton) return;
            let remaining = Number(seconds) || 0;
            clearInterval(resendTimerId);

            const render = () => {
                if (remaining <= 0) {
                    resendButton.disabled = false;
                    resendButton.textContent = resendButton.dataset.defaultText || 'Gửi lại mã';
                    clearInterval(resendTimerId);
                    return;
                }

                resendButton.disabled = true;
                resendButton.textContent = `Gửi lại mã sau ${remaining}s`;
                remaining -= 1;
            };

            render();
            resendTimerId = setInterval(render, 1000);
        };

        if (resendButton?.dataset.cooldownSeconds) {
            startResendCooldown(resendButton.dataset.cooldownSeconds);
        }

        resendForm?.addEventListener('submit', async (event) => {
            event.preventDefault();
            if (!resendButton || resendButton.disabled) return;

            resendButton.disabled = true;
            resendButton.textContent = 'Đang gửi...';

            try {
                const response = await fetch(resendForm.action, {
                    method: 'POST',
                    body: new FormData(resendForm),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const data = await response.json();
                showResendMessage(data.message || 'Không thể gửi lại mã lúc này.', !response.ok || data.success === false);
                startResendCooldown(data.cooldownSeconds || 0);
            } catch {
                showResendMessage('Không thể gửi email OTP lúc này. Vui lòng thử lại sau.', true);
                resendButton.disabled = false;
                resendButton.textContent = resendButton.dataset.defaultText || 'Gửi lại mã';
            }
        });

        document.querySelectorAll('[data-password-toggle]').forEach((button) => {
            button.addEventListener('click', () => {
                const input = document.getElementById(button.dataset.passwordToggle);
                if (!input) return;

                const shouldShow = input.type === 'password';
                input.type = shouldShow ? 'text' : 'password';
                button.setAttribute('aria-label', shouldShow ? 'Ẩn mật khẩu' : 'Hiện mật khẩu');
                const icon = button.querySelector('i');
                if (icon) {
                    icon.classList.toggle('bi-eye', !shouldShow);
                    icon.classList.toggle('bi-eye-slash', shouldShow);
                }
            });
        });
    </script>
}
