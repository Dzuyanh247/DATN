@model Datn.PcStore.ViewModels.AccountSettingsViewModel
@{
    ViewData["Title"] = "Thông tin tài khoản";
}

<section class="profile-page" aria-labelledby="profile-title">
    <div class="profile-shell">
        <header class="profile-hero-card profile-surface">
            <div>
                <p class="profile-eyebrow">Tài khoản KKSHOP</p>
                <h1 id="profile-title" class="profile-hero-name">@Model.Profile.FullName</h1>
                <p class="profile-hero-email">@Model.Profile.Email</p>
            </div>
            <span class="profile-status-badge @(Model.IsActive ? "profile-status-badge--active" : "profile-status-badge--locked")">
                @(Model.IsActive ? "Đang hoạt động" : "Đã khóa")
            </span>
        </header>

        @if (TempData["ProfileMessage"] is string profileMessage)
        {
            <div class="alert alert-success profile-alert" role="alert">@profileMessage</div>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger profile-alert" role="alert">@errorMessage</div>
        }

        <form asp-action="UpdateProfile" method="post" class="profile-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="profile-info-grid">
                <section class="profile-surface profile-info-card profile-info-card--personal" aria-labelledby="personal-info-title">
                    <h2 id="personal-info-title" class="profile-section-title">Thông tin cá nhân</h2>
                    <div class="profile-field-grid">
                        <div class="profile-field">
                            <label asp-for="Profile.FullName" class="form-label profile-label">Họ tên</label>
                            <input asp-for="Profile.FullName" class="form-control profile-control" />
                            <span asp-validation-for="Profile.FullName" class="text-danger profile-validation"></span>
                        </div>
                        <div class="profile-field">
                            <label asp-for="Profile.PhoneNumber" class="form-label profile-label">Số điện thoại</label>
                            <input asp-for="Profile.PhoneNumber" class="form-control profile-control" />
                            <span asp-validation-for="Profile.PhoneNumber" class="text-danger profile-validation"></span>
                        </div>
                        <div class="profile-field profile-field--full">
                            <label asp-for="Profile.Email" class="form-label profile-label">Email</label>
                            <input asp-for="Profile.Email" class="form-control profile-control" />
                            <span asp-validation-for="Profile.Email" class="text-danger profile-validation"></span>
                        </div>
                        <div class="profile-field profile-field--full">
                            <label asp-for="Profile.Address" class="form-label profile-label">Địa chỉ</label>
                            <textarea asp-for="Profile.Address" class="form-control profile-control profile-control--textarea" rows="3"></textarea>
                            <span asp-validation-for="Profile.Address" class="text-danger profile-validation"></span>
                        </div>
                    </div>
                </section>

                <aside class="profile-surface profile-info-card profile-info-card--account" aria-labelledby="account-info-title">
                    <h2 id="account-info-title" class="profile-section-title">Thông tin tài khoản</h2>
                    <div class="profile-meta-list">
                        <div class="profile-meta-item">
                            <div class="profile-meta-label">Username</div>
                            <div class="profile-meta-value">@Model.Username</div>
                        </div>
                        <div class="profile-meta-item">
                            <div class="profile-meta-label">Ngày tạo</div>
                            <div class="profile-meta-value">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                        <div class="profile-meta-item">
                            <div class="profile-meta-label">Trạng thái</div>
                            <span class="profile-status-badge @(Model.IsActive ? "profile-status-badge--active" : "profile-status-badge--locked")">
                                @(Model.IsActive ? "Đang hoạt động" : "Đã khóa")
                            </span>
                        </div>
                    </div>
                </aside>
            </div>

            <div class="profile-actions">
                <button type="submit" class="profile-btn profile-btn--primary">Lưu thông tin</button>
                <a class="profile-btn profile-btn--outline" asp-controller="Home" asp-action="Index">Về trang chủ</a>
            </div>
        </form>

        <section class="profile-surface profile-password-card" aria-labelledby="change-password-title">
            <div class="profile-password-heading">
                <h2 id="change-password-title" class="profile-section-title">Đổi mật khẩu</h2>
                <p class="profile-section-description">Cập nhật mật khẩu định kỳ để bảo vệ đơn hàng và thông tin mua sắm.</p>
            </div>
            @if (TempData["PasswordMessage"] is string passwordMessage)
            {
                <div class="alert alert-success profile-alert" role="alert">@passwordMessage</div>
            }
            <form asp-action="ChangePassword" method="post" class="profile-password-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger profile-password-summary"></div>
                <div class="profile-password-grid">
                    <div class="profile-field">
                        <label asp-for="ChangePassword.CurrentPassword" class="form-label profile-label">Mật khẩu hiện tại</label>
                        <input asp-for="ChangePassword.CurrentPassword" class="form-control profile-control" />
                        <span asp-validation-for="ChangePassword.CurrentPassword" class="text-danger profile-validation"></span>
                    </div>
                    <div class="profile-field">
                        <label asp-for="ChangePassword.NewPassword" class="form-label profile-label">Mật khẩu mới</label>
                        <input asp-for="ChangePassword.NewPassword" class="form-control profile-control" />
                        <span asp-validation-for="ChangePassword.NewPassword" class="text-danger profile-validation"></span>
                    </div>
                    <div class="profile-field">
                        <label asp-for="ChangePassword.ConfirmPassword" class="form-label profile-label">Nhập lại mật khẩu mới</label>
                        <input asp-for="ChangePassword.ConfirmPassword" class="form-control profile-control" />
                        <span asp-validation-for="ChangePassword.ConfirmPassword" class="text-danger profile-validation"></span>
                    </div>
                </div>
                <button type="submit" class="profile-btn profile-btn--accent">Đổi mật khẩu</button>
            </form>
        </section>
    </div>
</section>
