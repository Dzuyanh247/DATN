@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<section class="account-page" aria-labelledby="forgot-password-title">
    <div class="account-page__decor account-page__decor--primary" aria-hidden="true"></div>
    <div class="account-page__decor account-page__decor--accent" aria-hidden="true"></div>

    <div class="account-card">
        <header class="account-header">
            <div class="account-icon" aria-hidden="true">
                <i class="bi bi-key"></i>
            </div>
            <h1 id="forgot-password-title" class="account-title">Quên mật khẩu</h1>
            <p class="account-description">Nhập email để nhận mã xác nhận đặt lại mật khẩu.</p>
        </header>

        @if (TempData["Ok"] is string okMessage)
        {
            <div class="alert alert-success account-alert" role="alert">
                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                <span>@okMessage</span>
            </div>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger account-alert" role="alert">
                <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
                <span>@errorMessage</span>
            </div>
        }

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="account-validation" role="alert"></div>

            <div class="account-field">
                <label asp-for="Email" class="account-label">Email</label>
                <div class="account-input-wrap">
                    <i class="bi bi-envelope" aria-hidden="true"></i>
                    <input asp-for="Email"
                           class="account-input"
                           placeholder="Nhập email đã đăng ký"
                           autocomplete="email"
                           inputmode="email" />
                </div>
                <span asp-validation-for="Email" class="account-field-validation"></span>
            </div>

            <div class="account-actions">
                <button type="submit" class="account-btn">Gửi mã xác nhận</button>
            </div>
        </form>

        <p class="account-card-footer">
            <a asp-controller="Account" asp-action="Login" class="account-link">Quay lại đăng nhập</a>
        </p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
