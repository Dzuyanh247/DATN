@model ForgotPasswordViewModel

<h3>Quên mật khẩu</h3>
@if (TempData["Ok"] is string okMessage)
{
    <div class="alert alert-success" role="alert">@okMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
<form method="post" class="card p-3">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="d-flex justify-content-between align-items-center gap-3">
        <button class="btn btn-primary">Gửi mã xác nhận</button>
        <a asp-controller="Account" asp-action="Login" class="small">Quay lại đăng nhập</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
