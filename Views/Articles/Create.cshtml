@model Article
<h3>Tạo bài viết</h3>
<form method="post" class="row g-3">
    <div class="col-md-8"><label class="form-label">Tiêu đề</label><input asp-for="Title" class="form-control" /></div>
    <div class="col-md-4"><label class="form-label">Loại</label><input asp-for="Type" class="form-control" /></div>
    <div class="col-md-6"><label class="form-label">Slug</label><input asp-for="Slug" class="form-control" /></div>
    <div class="col-12"><label class="form-label">Nội dung</label><textarea asp-for="Content" rows="5" class="form-control"></textarea></div>
    <div class="col-12"><button class="btn btn-primary">Lưu</button></div>
</form>
