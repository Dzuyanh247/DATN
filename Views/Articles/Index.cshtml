@model List<Article>
@{
    ViewData["Title"] = "Tin công nghệ KKSHOP";
    var selectedType = ViewBag.SelectedType as string;
    var pinnedArticles = Model.Where(a => a.IsPinned).OrderByDescending(a => a.PinnedAt ?? a.CreatedAt).ThenByDescending(a => a.CreatedAt).ToList();
    var hotArticles = Model.Where(a => a.IsFeatured && !pinnedArticles.Any(p => p.Id == a.Id)).OrderByDescending(a => a.CreatedAt).Take(4).ToList();
    var latestArticles = Model.Where(a => !pinnedArticles.Any(p => p.Id == a.Id) && !hotArticles.Any(h => h.Id == a.Id)).OrderByDescending(a => a.CreatedAt).ToList();
    var heroArticle = pinnedArticles.FirstOrDefault() ?? hotArticles.FirstOrDefault() ?? Model.OrderByDescending(a => a.CreatedAt).FirstOrDefault();
    var sidebarLatest = ViewBag.LatestArticles as List<Article> ?? new List<Article>();
    var categories = ViewBag.Categories as List<ArticleCategorySummary> ?? new List<ArticleCategorySummary>();
    var canCreateArticle = User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Employee");
    string Label(string? type) => type != null && ArticleTypes.Labels.TryGetValue(type, out var label) ? label : (type ?? "Tin tức");
    string Image(Article article) => string.IsNullOrWhiteSpace(article.CoverImageUrl) ? "https://placehold.co/900x520/061737/36d7ff?text=KKSHOP+TECH" : article.CoverImageUrl!;
    string Excerpt(Article article, int max = 150)
    {
        var text = string.IsNullOrWhiteSpace(article.Excerpt) ? article.Content : article.Excerpt;
        if (string.IsNullOrWhiteSpace(text)) return "Cập nhật xu hướng phần cứng, kinh nghiệm build PC và kiến thức công nghệ từ KKSHOP.";
        return text.Length > max ? text[..max] + "..." : text;
    }
    bool IsNew(Article article) => article.CreatedAt >= DateTime.UtcNow.AddDays(-7);
}
<section class="kk-article-page kk-tech-news-page">
    <div class="kk-tech-hero">
        <div class="kk-tech-hero__content">
            <span class="kk-kicker"><i class="bi bi-cpu"></i> KKSHOP Tech Hub</span>
            <h1>TIN CÔNG NGHỆ &amp; KIẾN THỨC PC</h1>
            <p>Cập nhật tin phần cứng, kinh nghiệm build PC, thủ thuật tối ưu và các xu hướng gaming gear mới nhất theo phong cách KKSHOP.</p>
            <div class="kk-tech-hero__chips"><span>CPU / GPU</span><span>Build PC</span><span>Gaming Gear</span><span>Khuyến mãi</span></div>
        </div>
        @if (canCreateArticle)
        {
            <a class="btn kk-post-btn" asp-controller="AdminArticles" asp-action="Create"><i class="bi bi-pencil-square"></i> Đăng bài</a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="kk-article-empty">
            <i class="bi bi-journal-richtext"></i>
            <h3>Chưa có bài viết phù hợp</h3>
            <p>KKSHOP đang chuẩn bị nội dung mới. Vui lòng quay lại sau hoặc chọn chuyên mục khác.</p>
        </div>
    }
    else
    {
        <div class="kk-news-layout">
            <main>
                @if (pinnedArticles.Any())
                {
                    <section class="kk-news-section">
                        <div class="kk-section-heading"><span><i class="bi bi-pin-angle-fill"></i> Bài ghim nổi bật</span></div>
                        <div class="kk-pinned-grid">
                            @foreach (var article in pinnedArticles.Take(3))
                            {
                                @await Html.PartialAsync("_ArticleCard", article, new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { { "CardClass", "kk-article-card--large" }, { "Badge", "Ghim" } })
                            }
                        </div>
                    </section>
                }

                @if (hotArticles.Any())
                {
                    <section class="kk-news-section">
                        <div class="kk-section-heading"><span><i class="bi bi-fire"></i> Tin nổi bật</span></div>
                        <div class="kk-hot-grid">
                            @foreach (var article in hotArticles)
                            {
                                @await Html.PartialAsync("_ArticleCard", article, new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { { "Badge", "Hot" } })
                            }
                        </div>
                    </section>
                }

                <section class="kk-news-section">
                    <div class="kk-section-heading"><span><i class="bi bi-clock-history"></i> Bài viết mới nhất</span></div>
                    <div class="kk-article-grid kk-latest-grid">
                        @foreach (var article in latestArticles)
                        {
                            @await Html.PartialAsync("_ArticleCard", article, new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { { "Badge", IsNew(article) ? "Mới" : "" } })
                        }
                    </div>
                </section>
            </main>
            <aside class="kk-news-sidebar">
                @if (heroArticle != null)
                {
                    <a class="kk-editor-pick" asp-action="Detail" asp-route-slug="@heroArticle.Slug">
                        <img src="@Image(heroArticle)" alt="@heroArticle.Title" />
                        <span>@(heroArticle.IsPinned ? "Bài ghim đáng chú ý" : "Đọc nhiều trên KKSHOP")</span>
                        <strong>@heroArticle.Title</strong>
                    </a>
                }
                <div class="kk-sidebar-box">
                    <h5>Chuyên mục</h5>
                    <a class="kk-side-link @(string.IsNullOrWhiteSpace(selectedType) ? "active" : "")" asp-action="Index">Tất cả bài viết</a>
                    @foreach (var c in categories)
                    {
                        <a class="kk-side-link @(selectedType == c.Type ? "active" : "")" asp-action="Index" asp-route-type="@c.Type"><span>@Label(c.Type)</span><small>@c.Count</small></a>
                    }
                </div>
                <div class="kk-sidebar-box">
                    <h5>Tin mới nhất</h5>
                    @foreach (var item in sidebarLatest)
                    {
                        <a class="kk-latest-link" asp-action="Detail" asp-route-slug="@item.Slug"><strong>@item.Title</strong><span><i class="bi bi-calendar3"></i> @item.CreatedAt.ToString("dd/MM/yyyy") · <i class="bi bi-eye"></i> @item.ViewCount</span></a>
                    }
                </div>
            </aside>
        </div>
    }
</section>
