@model Article
<article class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <span class="badge bg-info mb-2">@Model.Type</span>
        <h2>@Model.Title</h2>
        <p class="text-muted">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
        <div style="white-space: pre-line">@Model.Content</div>
    </div>
</article>
