@model List<Order>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
}
<h3>Đơn hàng của tôi</h3>
<table class="table table-bordered">
    <thead><tr><th>Mã</th><th>Ngày</th><th>Trạng thái</th><th>Thanh toán</th><th>Hạn TT</th><th>Tổng tiền</th><th></th></tr></thead>
    <tbody>
    @foreach (var o in Model)
    {
        <tr>
            <td>@($"DH{o.Id:D6}")</td>
            <td>@DateTimeHelper.FormatVietnam(o.CreatedAt, "dd/MM/yyyy HH:mm")</td>
            <td>@OrderStatusHelper.Label(o.Status)</td>
            <td>@OrderStatusHelper.PaymentLabel(o.PaymentStatus, o.Status)</td>
            <td>@(o.PaymentExpireAt.HasValue ? DateTimeHelper.FormatVietnam(o.PaymentExpireAt, "dd/MM/yyyy HH:mm") : "-")</td>
            <td>@o.TotalAmount.ToString("N0") đ</td>
            <td><a class="btn btn-sm btn-outline-primary" asp-action="Tracking" asp-route-id="@o.Id">Xem chi tiết</a></td>
        </tr>
    }
    </tbody>
</table>
