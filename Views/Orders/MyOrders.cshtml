@model List<Order>
<h3>Đơn hàng của tôi</h3>
<table class="table table-bordered">
    <thead><tr><th>Mã</th><th>Ngày</th><th>Trạng thái</th><th>Tổng tiền</th></tr></thead>
    <tbody>
    @foreach (var o in Model)
    {
        <tr>
            <td>#@o.Id</td>
            <td>@o.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
            <td>@o.Status</td>
            <td>@o.TotalAmount.ToString("N0") đ</td>
        </tr>
    }
    </tbody>
</table>
