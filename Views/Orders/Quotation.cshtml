@model QuotationViewModel
@using System.Globalization
@{
    ViewData["Title"] = $"Hóa đơn {Model.OrderCode}";
    var viCulture = CultureInfo.GetCultureInfo("vi-VN");
    string Money(decimal value) => $"{value.ToString("N0", viCulture)} đ";
}
<link rel="stylesheet" href="~/css/quotation.css" asp-append-version="true" />

<div class="invoice-preview">
    <div class="invoice-toolbar print-hidden">
        <a class="invoice-back" asp-action="Tracking" asp-route-id="@Model.OrderId"><i class="bi bi-arrow-left"></i> Quay lại đơn hàng</a>
        <button class="invoice-print" type="button" onclick="window.print()"><i class="bi bi-printer"></i> In hóa đơn</button>
    </div>

    <article class="invoice-sheet" aria-label="Hóa đơn bán hàng @Model.OrderCode">
        <header class="invoice-header">
            <div class="invoice-brand">
                <div class="invoice-logo">KK</div>
                <div>
                    <strong>@Model.ShopName</strong>
                    <span>PC STORE</span>
                </div>
            </div>
            <address class="invoice-shop-info">
                <strong>@Model.ShopName</strong>
                <span>Địa chỉ: @(string.IsNullOrWhiteSpace(Model.ShopAddress) ? "—" : Model.ShopAddress)</span>
                <span>SĐT: @(string.IsNullOrWhiteSpace(Model.ShopPhone) ? "—" : Model.ShopPhone)</span>
                <span>Email: @(string.IsNullOrWhiteSpace(Model.ShopEmail) ? "—" : Model.ShopEmail)</span>
            </address>
        </header>

        <section class="invoice-title-block">
            <h1>HÓA ĐƠN BÁN HÀNG</h1>
            <p>Mã hóa đơn: <strong>@Model.OrderCode</strong></p>
            <p>Ngày lập: @DateTimeHelper.FormatVietnam(Model.QuotationDate, "dd/MM/yyyy HH:mm")</p>
        </section>

        @if (Model.IsCancelledOrExpired)
        {
            <div class="invoice-status-warning"><strong>Lưu ý:</strong> Đơn hàng đang ở trạng thái “@Model.OrderStatus” và không được ghi nhận là hóa đơn đã thanh toán.</div>
        }

        <div class="invoice-info-grid">
            <section class="invoice-info-card">
                <h2>Thông tin khách hàng</h2>
                <dl>
                    <div><dt>Họ tên</dt><dd>@Model.CustomerName</dd></div>
                    <div><dt>Số điện thoại</dt><dd>@Model.CustomerPhone</dd></div>
                    <div><dt>Email</dt><dd>@(string.IsNullOrWhiteSpace(Model.CustomerEmail) ? "—" : Model.CustomerEmail)</dd></div>
                    <div><dt>Địa chỉ</dt><dd>@Model.CustomerAddress</dd></div>
                </dl>
            </section>
            <section class="invoice-info-card">
                <h2>Thông tin thanh toán</h2>
                <dl>
                    <div><dt>Ngày đặt</dt><dd>@DateTimeHelper.FormatVietnam(Model.OrderDate, "dd/MM/yyyy HH:mm")</dd></div>
                    <div><dt>Phương thức</dt><dd>@Model.PaymentMethod</dd></div>
                    <div><dt>Thanh toán</dt><dd><strong>@Model.PaymentStatus</strong></dd></div>
                    <div><dt>Đơn hàng</dt><dd><strong>@Model.OrderStatus</strong></dd></div>
                </dl>
            </section>
        </div>

        <div class="invoice-table-wrap">
            <table class="invoice-table">
                <thead><tr><th class="col-index">STT</th><th>Tên sản phẩm</th><th class="col-warranty">Bảo hành</th><th class="col-quantity">SL</th><th class="col-money">Đơn giá</th><th class="col-money">Thành tiền</th></tr></thead>
                <tbody>
                @for (var index = 0; index < Model.Items.Count; index++)
                {
                    var item = Model.Items[index];
                    <tr>
                        <td class="text-center">@(index + 1)</td>
                        <td class="invoice-product"><strong>@item.ProductName</strong><small>@item.ProductCode</small></td>
                        <td class="text-center">@(string.IsNullOrWhiteSpace(item.Warranty) ? "—" : item.Warranty)</td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-right">@Money(item.UnitPrice)</td>
                        <td class="text-right"><strong>@Money(item.LineTotal)</strong></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <section class="invoice-summary">
            <div><span>Tạm tính</span><strong>@Money(Model.SubtotalAmount)</strong></div>
            @if (Model.DiscountAmount > 0)
            {
                <div><span>Giảm giá Voucher@(string.IsNullOrWhiteSpace(Model.VoucherCode) ? "" : $" ({Model.VoucherCode})")</span><strong>-@Money(Model.DiscountAmount)</strong></div>
            }
            <div><span>Phí vận chuyển</span><strong>@(Model.ShippingFee > 0 ? Money(Model.ShippingFee) : "—")</strong></div>
            <div class="invoice-grand-total"><span>TỔNG THANH TOÁN</span><strong>@Money(Model.TotalAmount)</strong></div>
        </section>

        @if (!string.IsNullOrWhiteSpace(Model.Note))
        {
            <div class="invoice-note"><strong>Ghi chú đơn hàng:</strong> @Model.Note</div>
        }

        <footer class="invoice-footer">
            <div class="invoice-thanks"><strong>Cảm ơn quý khách đã mua hàng tại @Model.ShopName.</strong><span>Vui lòng giữ hóa đơn để được hỗ trợ bảo hành.</span></div>
            <div class="invoice-signatures">
                <div><strong>Người mua hàng</strong><span>(Ký, ghi rõ họ tên)</span></div>
                <div><strong>Người bán hàng</strong><span>(Ký, ghi rõ họ tên)</span></div>
            </div>
        </footer>
    </article>
</div>
