@model Order
@{
    ViewData["Title"] = $"Chi tiết đơn hàng DH{Model.Id:D6}";
    string StatusLabel(OrderStatus status) => status switch
    {
        OrderStatus.Pending => "Chờ xác nhận",
        OrderStatus.Processing => "Đã xác nhận",
        OrderStatus.Delivering => "Đang giao hàng",
        OrderStatus.Completed => "Đã giao hàng",
        OrderStatus.Cancelled => "Đã hủy",
        OrderStatus.PendingConfirmation => "Chờ xác nhận",
        OrderStatus.PendingPayment => "Chờ thanh toán",
        _ => status.ToString()
    };
}
@{
    var nowUtc = DateTime.UtcNow;
    var isCod = Model.PaymentMethod == "COD";
    var isBankTransfer = Model.PaymentMethod == "BANK_TRANSFER";
    var isPendingPayment = Model.Status == OrderStatus.PendingPayment;
    var isAwaitingConfirmation = Model.Status == OrderStatus.PendingConfirmation;
    var isExpiredPayment = !isCod && isPendingPayment && Model.PaymentExpireAt.HasValue && Model.PaymentExpireAt.Value <= nowUtc;
    var canShowCountdown = !isCod && isPendingPayment && Model.PaymentExpireAt.HasValue && Model.PaymentExpireAt.Value > nowUtc;
    var isPaid = Model.PaymentStatus == "PAID";
}
<h3>Chi tiết đơn hàng @($"DH{Model.Id:D6}")</h3>
<p><strong>Ngày đặt:</strong> @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
<p><strong>Trạng thái:</strong> @StatusLabel(Model.Status)</p>
<p><strong>Người nhận:</strong> @Model.ReceiverName - @Model.ReceiverPhone</p>
<p><strong>Địa chỉ giao hàng:</strong> @Model.ShippingAddress</p>
<p><strong>Phương thức thanh toán:</strong> @Model.PaymentMethod</p>
<p><strong>Tổng tiền:</strong> @Model.TotalAmount.ToString("N0") đ</p>

@if (isAwaitingConfirmation)
{
    <div class="alert alert-warning">
        Bạn đã gửi xác nhận thanh toán. Đơn hàng đang chờ admin kiểm tra.
    </div>
}
else if (isExpiredPayment)
{
    <div class="alert alert-danger">Đơn hàng đã hết hạn thanh toán.</div>
}
else if (isPendingPayment)
{
    <div class="alert alert-info">
        <div><strong>Trạng thái thanh toán:</strong> Chờ thanh toán</div>
        <div><strong>Hạn thanh toán:</strong> @(Model.PaymentExpireAt.HasValue ? Model.PaymentExpireAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") : "-")</div>
        @if (canShowCountdown)
        {
            <div><strong>Thời gian còn lại:</strong> <span id="payment-countdown" data-expire-utc="@Model.PaymentExpireAt!.Value.ToString("O")">--:--:--</span></div>
            @if (isBankTransfer)
            {
                <form asp-action="ConfirmTransferred" asp-route-id="@Model.Id" method="post" class="mt-2">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-warning text-dark">Tôi đã thanh toán</button>
                </form>
            }
            else if (!isCod)
            {
                <form asp-action="PayNow" asp-route-id="@Model.Id" method="post" class="mt-2">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-warning text-dark">Thanh toán ngay</button>
                </form>
            }
        }
    </div>
}
@if (isBankTransfer)
{
    <div class="small text-muted mb-2">Vui lòng chuyển khoản đúng nội dung để admin kiểm tra nhanh hơn.</div>
}
<table class="table table-bordered">
    <thead><tr><th>Sản phẩm</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th></tr></thead>
    <tbody>
    @foreach (var d in Model.Details)
    {
        var img = ImageUrlHelper.ResolveImageUrl(d.ProductImage, "/images/placeholders/product-placeholder.png");
        <tr>
            <td><img src="@img" style="width:56px;height:56px;object-fit:cover;" class="me-2" onerror="this.onerror=null;this.src='/images/placeholders/product-placeholder.png';"/>@d.ProductName</td>
            <td>@d.UnitPrice.ToString("N0") đ</td>
            <td>@d.Quantity</td>
            <td>@d.TotalPrice.ToString("N0") đ</td>
        </tr>
    }
    </tbody>
</table>

@if (canShowCountdown)
{
    <script>
        (() => {
            const el = document.getElementById('payment-countdown');
            if (!el) return;
            const expire = new Date(el.dataset.expireUtc).getTime();
            const pad = n => String(n).padStart(2, '0');
            const tick = () => {
                const diff = Math.max(0, expire - Date.now());
                const totalSec = Math.floor(diff / 1000);
                const h = Math.floor(totalSec / 3600);
                const m = Math.floor((totalSec % 3600) / 60);
                const s = totalSec % 60;
                el.textContent = `${pad(h)}:${pad(m)}:${pad(s)}`;
                if (diff <= 0) {
                    location.reload();
                }
            };
            tick();
            setInterval(tick, 1000);
        })();
    </script>
}
