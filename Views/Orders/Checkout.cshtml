@model Datn.PcStore.ViewModels.CheckoutRequestVm
@{
    ViewData["Title"] = "Checkout";
}

<h3 class="mb-3">Thông tin đặt hàng</h3>
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
<form method="post" action="/Checkout" class="card p-3" id="checkoutForm">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3"><label class="form-label">Họ tên*</label><input class="form-control" name="CustomerName" value="@Model.CustomerName" required /></div>
    <div class="mb-3"><label class="form-label">Số điện thoại*</label><input class="form-control" name="CustomerPhone" value="@Model.CustomerPhone" required /></div>
    <div class="mb-3"><label class="form-label">Email</label><input class="form-control" name="CustomerEmail" value="@Model.CustomerEmail" /></div>
    <div class="mb-3">
        <label class="form-label">Phương thức thanh toán*</label>
        <select class="form-select" name="PaymentMethod" required>
            <option value="COD" selected="@(Model.PaymentMethod == "COD")">Thanh toán khi nhận hàng (COD)</option>
            <option value="BANK_TRANSFER" selected="@(Model.PaymentMethod == "BANK_TRANSFER")">Chuyển khoản ngân hàng</option>
        </select>
    </div>

    <input type="hidden" name="CustomerAddress" id="customerAddress" />
    <input type="hidden" name="FullAddress" id="fullAddress" />
    <input type="hidden" name="ProvinceCode" id="provinceCode" />
    <input type="hidden" name="DistrictCode" id="districtCode" />
    <input type="hidden" name="DistrictName" id="districtName" />
    <input type="hidden" name="ProvinceName" id="provinceName" />
    <input type="hidden" name="WardCode" id="wardCode" />
    <input type="hidden" name="WardName" id="wardName" />

    <input type="hidden" name="ShippingDistanceKm" id="shippingDistanceKm" />
    <input type="hidden" name="ShippingDurationMinutes" id="shippingDurationMinutes" />
    <input type="hidden" name="ShippingFee" id="shippingFeeInput" />
    <input type="hidden" name="ShippingProvider" id="shippingProvider" />
    <input type="hidden" name="ShippingFormulaSnapshot" id="shippingFormulaSnapshot" />

    <div class="mb-3">
        <label class="form-label">Tỉnh/Thành phố*</label>
        <select class="form-select" id="provinceSelect" required>
            <option value="">Chọn Tỉnh/Thành phố</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Quận/Huyện*</label>
        <select class="form-select" id="districtSelect" required disabled>
            <option value="">Chọn Quận/Huyện</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Phường/Xã*</label>
        <select class="form-select" id="wardSelect" required disabled>
            <option value="">Chọn Phường/Xã</option>
        </select>
    </div>
    <div class="mb-3 d-none" id="manualProvinceWrap"><label class="form-label">Tỉnh/Thành phố*</label><input class="form-control" name="ManualProvince" value="@Model.ManualProvince" /></div>
    <div class="mb-3 d-none" id="manualWardWrap"><label class="form-label">Phường/Xã*</label><input class="form-control" name="ManualWard" value="@Model.ManualWard" /></div>
    <div class="mb-3"><label class="form-label">Địa chỉ chi tiết*</label><input class="form-control" id="addressDetail" name="AddressDetail" value="@Model.AddressDetail" placeholder="Nhập số nhà, tên đường, ngõ/ngách..." required /></div>
    <div class="mb-3"><label class="form-label">Ghi chú</label><textarea class="form-control" rows="3" name="Note">@Model.Note</textarea></div>
    <small class="text-danger d-none" id="addressError">Không tải được danh sách địa chỉ hoặc thiếu thông tin địa chỉ.</small>

    <div class="alert alert-info">
        <div><strong>Chính sách phí ship:</strong> Miễn phí giao hàng trong phạm vi 10km • 15.000đ cho 3km đầu • Từ km tiếp theo cộng 5.000đ/km • Tối đa hỗ trợ 15km.</div>
        <div id="shippingCalcText" class="mt-2 text-muted">Chưa tính phí giao hàng</div>
    </div>

    <button class="btn btn-danger mt-3">Đặt hàng</button>
</form>

<script>
const provinceSelect=document.getElementById('provinceSelect');const districtSelect=document.getElementById('districtSelect');const wardSelect=document.getElementById('wardSelect');const addressDetail=document.getElementById('addressDetail');
const provinceCodeInput=document.getElementById('provinceCode');const provinceNameInput=document.getElementById('provinceName');const districtCodeInput=document.getElementById('districtCode');const districtNameInput=document.getElementById('districtName');const wardCodeInput=document.getElementById('wardCode');const wardNameInput=document.getElementById('wardName');
const fullAddressInput=document.getElementById('fullAddress');const customerAddressInput=document.getElementById('customerAddress');const checkoutForm=document.getElementById('checkoutForm');
const shippingDistanceKmInput=document.getElementById('shippingDistanceKm');const shippingDurationMinutesInput=document.getElementById('shippingDurationMinutes');const shippingFeeInput=document.getElementById('shippingFeeInput');const shippingProviderInput=document.getElementById('shippingProvider');const shippingFormulaSnapshotInput=document.getElementById('shippingFormulaSnapshot');const shippingCalcText=document.getElementById('shippingCalcText');shippingFeeInput.value='';
async function api(url){const r=await fetch(url);const p=await r.json();if(!p.success)throw new Error(p.message||'Lỗi');return p.data||[];}
function setLoading(el,msg){el.innerHTML=`<option value="">${msg}</option>`;el.disabled=true;}
function buildAddress(){return [addressDetail.value.trim(),wardNameInput.value,districtNameInput.value,provinceNameInput.value,'Vietnam'].filter(Boolean).join(', ')}
async function loadProvinces(){setLoading(provinceSelect,'Đang tải...');const data=await api('/api/shipping/provinces');provinceSelect.innerHTML='<option value="">Chọn Tỉnh/Thành phố</option>';data.forEach(x=>provinceSelect.insertAdjacentHTML('beforeend',`<option value="${x.id}" data-name="${x.name}">${x.name}</option>`));provinceSelect.disabled=false;}
provinceSelect.onchange=async()=>{const o=provinceSelect.options[provinceSelect.selectedIndex];provinceCodeInput.value=o.value||'';provinceNameInput.value=o.dataset.name||'';districtCodeInput.value='';districtNameInput.value='';wardCodeInput.value='';wardNameInput.value='';setLoading(districtSelect,'Đang tải...');setLoading(wardSelect,'Chọn Phường/Xã');if(!provinceCodeInput.value)return;const data=await api(`/api/shipping/districts?provinceId=${provinceCodeInput.value}`);districtSelect.innerHTML='<option value="">Chọn Quận/Huyện</option>';data.forEach(x=>districtSelect.insertAdjacentHTML('beforeend',`<option value="${x.id}" data-name="${x.name}">${x.name}</option>`));districtSelect.disabled=false;};
districtSelect.onchange=async()=>{const o=districtSelect.options[districtSelect.selectedIndex];districtCodeInput.value=o.value||'';districtNameInput.value=o.dataset.name||'';wardCodeInput.value='';wardNameInput.value='';setLoading(wardSelect,'Đang tải...');if(!districtCodeInput.value)return;const data=await api(`/api/shipping/wards?districtId=${districtCodeInput.value}`);wardSelect.innerHTML='<option value="">Chọn Phường/Xã</option>';data.forEach(x=>wardSelect.insertAdjacentHTML('beforeend',`<option value="${x.code}" data-name="${x.name}">${x.name}</option>`));wardSelect.disabled=false;};
wardSelect.onchange=()=>{const o=wardSelect.options[wardSelect.selectedIndex];wardCodeInput.value=o.value||'';wardNameInput.value=o.dataset.name||'';};
async function calculateShipping(){if(!provinceCodeInput.value||!districtCodeInput.value||!wardCodeInput.value||!addressDetail.value.trim()){shippingCalcText.textContent='Chưa tính phí giao hàng';shippingFeeInput.value='';return;}const payload={fullName:document.querySelector('input[name="CustomerName"]').value,phone:document.querySelector('input[name="CustomerPhone"]').value,email:document.querySelector('input[name="CustomerEmail"]').value,provinceId:Number(provinceCodeInput.value),provinceName:provinceNameInput.value,districtId:Number(districtCodeInput.value),districtName:districtNameInput.value,wardCode:wardCodeInput.value,wardName:wardNameInput.value,addressDetail:addressDetail.value};const res=await fetch('/api/shipping/calculate',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});const p=await res.json();if(!p.success){shippingCalcText.textContent=p.message||'Không thể tính phí giao hàng lúc này';shippingFeeInput.value='';shippingProviderInput.value='';return;}shippingDistanceKmInput.value=p.distanceKm??0;shippingDurationMinutesInput.value=p.durationMinutes??0;shippingFeeInput.value=p.shippingFee??0;shippingProviderInput.value=p.shippingProvider??'';shippingFormulaSnapshotInput.value=p.formula??'';shippingCalcText.textContent=p.isFreeShipping?'Phí giao hàng: Miễn phí':`Phí giao hàng: ${Number(p.shippingFee).toLocaleString('vi-VN')}đ`;}
addressDetail.onchange=calculateShipping;wardSelect.onchange=()=>{const o=wardSelect.options[wardSelect.selectedIndex];wardCodeInput.value=o.value||'';wardNameInput.value=o.dataset.name||'';calculateShipping();};
checkoutForm.addEventListener('submit',e=>{if(!provinceCodeInput.value||!districtCodeInput.value||!wardCodeInput.value||!addressDetail.value.trim()){e.preventDefault();return;}const full=buildAddress();fullAddressInput.value=full;customerAddressInput.value=full;});
loadProvinces();
</script>
