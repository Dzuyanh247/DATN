@model Datn.PcStore.ViewModels.CheckoutRequestVm
@{
    ViewData["Title"] = "Checkout";
}

<h3 class="mb-3">Thông tin đặt hàng</h3>
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
<form method="post" action="/Checkout" class="card p-3" id="checkoutForm">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3"><label class="form-label">Họ tên*</label><input class="form-control" name="CustomerName" value="@Model.CustomerName" required /></div>
    <div class="mb-3"><label class="form-label">Số điện thoại*</label><input class="form-control" name="CustomerPhone" value="@Model.CustomerPhone" required /></div>
    <div class="mb-3"><label class="form-label">Email</label><input class="form-control" name="CustomerEmail" value="@Model.CustomerEmail" /></div>

    <input type="hidden" name="CustomerAddress" id="customerAddress" />
    <input type="hidden" name="FullAddress" id="fullAddress" />
    <input type="hidden" name="ProvinceCode" id="provinceCode" />
    <input type="hidden" name="ProvinceName" id="provinceName" />
    <input type="hidden" name="WardCode" id="wardCode" />
    <input type="hidden" name="WardName" id="wardName" />

    <input type="hidden" name="ShippingDistanceKm" id="shippingDistanceKm" />
    <input type="hidden" name="ShippingDurationMinutes" id="shippingDurationMinutes" />
    <input type="hidden" name="ShippingFee" id="shippingFeeInput" />
    <input type="hidden" name="ShippingProvider" id="shippingProvider" />
    <input type="hidden" name="ShippingFormulaSnapshot" id="shippingFormulaSnapshot" />

    <div class="mb-3">
        <label class="form-label">Tỉnh/Thành phố*</label>
        <select class="form-select" id="provinceSelect" required>
            <option value="">Chọn Tỉnh/Thành phố</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Phường/Xã*</label>
        <select class="form-select" id="wardSelect" required disabled>
            <option value="">Chọn Phường/Xã</option>
        </select>
    </div>
    <div class="mb-3 d-none" id="manualProvinceWrap"><label class="form-label">Tỉnh/Thành phố*</label><input class="form-control" name="ManualProvince" value="@Model.ManualProvince" /></div>
    <div class="mb-3 d-none" id="manualWardWrap"><label class="form-label">Phường/Xã*</label><input class="form-control" name="ManualWard" value="@Model.ManualWard" /></div>
    <div class="mb-3"><label class="form-label">Địa chỉ chi tiết*</label><input class="form-control" id="addressDetail" name="AddressDetail" value="@Model.AddressDetail" placeholder="Nhập số nhà, tên đường, ngõ/ngách..." required /></div>
    <div class="mb-3"><label class="form-label">Ghi chú</label><textarea class="form-control" rows="3" name="Note">@Model.Note</textarea></div>
    <small class="text-danger d-none" id="addressError">Không tải được danh sách địa chỉ hoặc thiếu thông tin địa chỉ.</small>

    <div class="alert alert-info">
        <div><strong>Chính sách phí ship:</strong> Miễn phí giao hàng trong phạm vi 2km • 15.000đ cho 3km đầu • Từ km tiếp theo cộng 5.000đ/km • Tối đa hỗ trợ 15km.</div>
        <div id="shippingCalcText" class="mt-2 text-muted">Giao hàng từ cửa hàng 83-85 Thái Hà, Đống Đa, Hà Nội. Nhập địa chỉ đầy đủ để tính phí ship.</div>
    </div>

    <button class="btn btn-danger mt-3">Đặt hàng</button>
</form>

<script>
const provinceSelect = document.getElementById('provinceSelect');
const wardSelect = document.getElementById('wardSelect');
const addressDetail = document.getElementById('addressDetail');
const addressError = document.getElementById('addressError');
const provinceCodeInput = document.getElementById('provinceCode');
const provinceNameInput = document.getElementById('provinceName');
const wardCodeInput = document.getElementById('wardCode');
const wardNameInput = document.getElementById('wardName');
const fullAddressInput = document.getElementById('fullAddress');
const customerAddressInput = document.getElementById('customerAddress');
const checkoutForm = document.getElementById('checkoutForm');
const manualProvinceWrap = document.getElementById('manualProvinceWrap');
const manualWardWrap = document.getElementById('manualWardWrap');
const API_BASE = 'https://provinces.open-api.vn/api/v2';

const shippingDistanceKmInput = document.getElementById('shippingDistanceKm');
const shippingDurationMinutesInput = document.getElementById('shippingDurationMinutes');
const shippingFeeInput = document.getElementById('shippingFeeInput');
const shippingProviderInput = document.getElementById('shippingProvider');
const shippingFormulaSnapshotInput = document.getElementById('shippingFormulaSnapshot');
const shippingCalcText = document.getElementById('shippingCalcText');

addressDetail.insertAdjacentHTML('afterend', '<input type="hidden" id="shippingLatitude" name="ShippingLatitude" /><input type="hidden" id="shippingLongitude" name="ShippingLongitude" /><input type="hidden" id="shippingFullAddress" name="ShippingFullAddress" /><input type="hidden" id="isAddressConfirmed" name="IsAddressConfirmed" value="false" /><div id="addressAutocompleteState" class="small text-muted mt-1"></div><div id="addressAutocompleteList" class="list-group mt-1"></div>');
const shippingLatitudeInput = document.getElementById('shippingLatitude');
const shippingLongitudeInput = document.getElementById('shippingLongitude');
const shippingFullAddressInput = document.getElementById('shippingFullAddress');
const isAddressConfirmedInput = document.getElementById('isAddressConfirmed');
const autocompleteState = document.getElementById('addressAutocompleteState');
const autocompleteList = document.getElementById('addressAutocompleteList');

let shippingTimer;
let autocompleteTimer;

function buildAddressQuery(){
  const city = (provinceNameInput.value || '').trim();
  const ward = wardNameInput.value?.trim() || '';
  const detail = addressDetail.value || '';
  return [detail, ward, city || provinceNameInput.value, 'Vietnam'].filter(Boolean).join(', ');
}
function resetShippingState(msg){shippingDistanceKmInput.value='';shippingDurationMinutesInput.value='';shippingFeeInput.value='';shippingProviderInput.value='';shippingFormulaSnapshotInput.value='';shippingCalcText.textContent=msg||'Giao hàng từ cửa hàng 83-85 Thái Hà, Đống Đa, Hà Nội. Nhập địa chỉ đầy đủ để tính phí ship.';checkoutForm.querySelector('button[type=submit],button:not([type])').disabled=true;}
function setAddressConfirmed(confirmed){isAddressConfirmedInput.value=confirmed?'true':'false'; if(confirmed){autocompleteState.textContent='Đã xác định vị trí giao hàng.';autocompleteState.className='small text-success mt-1';}}
function parseCoordinate(value){if(value===null||value===undefined||value===''){return null;}const parsed=parseFloat(value);return Number.isFinite(parsed)?parsed:null;}
function getBackendErrorMessage(payload){if(!payload){return 'Không thể tính phí giao hàng.';}if(payload.message){return payload.message;}if(payload.errors){const firstKey=Object.keys(payload.errors)[0];if(firstKey&&Array.isArray(payload.errors[firstKey])&&payload.errors[firstKey].length){return payload.errors[firstKey][0];}}return 'Không thể tính phí giao hàng.';}
async function calculateShipping(){const rawAddressInput=addressDetail.value||'';const query=buildAddressQuery();if(!provinceNameInput.value||!wardNameInput.value||!rawAddressInput.trim()){resetShippingState();return;}fullAddressInput.value=query;customerAddressInput.value=query;shippingCalcText.textContent='Đang tính phí giao hàng...';const lat=parseCoordinate(shippingLatitudeInput.value);const lng=parseCoordinate(shippingLongitudeInput.value);const requestPayload={address:query,addressDetail:rawAddressInput,ward:wardNameInput.value,provinceCity:provinceNameInput.value,fullAddress:shippingFullAddressInput.value||query,latitude:lat,longitude:lng};console.log('[shipping] calculate payload',requestPayload);try{const response=await fetch('/api/shipping/calculate',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(requestPayload)});const payload=await response.json();if(payload.success===false){resetShippingState(getBackendErrorMessage(payload));return;}shippingLatitudeInput.value=payload.destinationLatitude??'';shippingLongitudeInput.value=payload.destinationLongitude??'';shippingDistanceKmInput.value=payload.distanceKm??'';shippingDurationMinutesInput.value=payload.durationMinutes??'';shippingFeeInput.value=payload.shippingFee??'';shippingProviderInput.value=payload.shippingProvider??'';shippingFormulaSnapshotInput.value=payload.formula??'';setAddressConfirmed(true);checkoutForm.querySelector('button[type=submit],button:not([type])').disabled=false;shippingCalcText.textContent=`Khoảng cách: ${payload.distanceKm}km • Thời gian dự kiến: ${payload.durationMinutes} phút • Phí giao hàng: ${Number(payload.shippingFee).toLocaleString('vi-VN')}đ • ${payload.formula} • Chính sách free ship áp dụng theo cấu hình hiện tại.`;}catch{resetShippingState('Không thể tính phí giao hàng lúc này. Vui lòng thử lại.');}}
function queueShippingCalc(){clearTimeout(shippingTimer);shippingTimer=setTimeout(calculateShipping,500);} 
function setSelectLoading(selectEl, label){selectEl.innerHTML=`<option value="">${label}</option>`;selectEl.disabled=true;}
function showAddressError(show){addressError.classList.toggle('d-none',!show);manualProvinceWrap.classList.toggle('d-none',!show);manualWardWrap.classList.toggle('d-none',!show);}
function renderSuggestions(items){autocompleteList.innerHTML='';if(!items.length){autocompleteState.textContent='Không tìm thấy địa chỉ phù hợp.';autocompleteState.className='small text-warning mt-1';return;}autocompleteState.textContent='';items.forEach((item)=>{const button=document.createElement('button');button.type='button';button.className='list-group-item list-group-item-action';button.textContent=item.label;button.addEventListener('click',()=>{const lat=parseCoordinate(item.latitude);const lng=parseCoordinate(item.longitude);addressDetail.value=item.label;shippingLatitudeInput.value=lat??'';shippingLongitudeInput.value=lng??'';shippingFullAddressInput.value=item.label||'';console.log('[shipping] selected suggestion',{label:item.label,latitude:shippingLatitudeInput.value,longitude:shippingLongitudeInput.value,fullAddress:shippingFullAddressInput.value});setAddressConfirmed(lat!==null&&lng!==null);autocompleteList.innerHTML='';queueShippingCalc();});autocompleteList.appendChild(button);});}
async function fetchAutocomplete(){const rawAddressInput=addressDetail.value||'';const detail=rawAddressInput.trim().replace(/\s+/g,' ');if(detail.length<3){autocompleteList.innerHTML='';autocompleteState.textContent='';return;}autocompleteState.textContent='Đang tìm địa chỉ...';autocompleteState.className='small text-muted mt-1';const frontendQuery=detail;console.log('[shipping] autocomplete query frontend',{rawAddressInput,query:frontendQuery,ward:wardNameInput.value,province:provinceNameInput.value});try{const response=await fetch(`/api/shipping/autocomplete?query=${encodeURIComponent(frontendQuery)}&wardName=${encodeURIComponent((wardNameInput.value||'').trim())}&provinceName=${encodeURIComponent((provinceNameInput.value||'').trim())}`);const payload=await response.json();console.log('[shipping] autocomplete raw response',payload);if(payload?.success===false){throw new Error(payload?.message||'autocomplete_failed');}const suggestions=Array.isArray(payload?.suggestions)?payload.suggestions:[];renderSuggestions(suggestions);}catch{autocompleteList.innerHTML='';autocompleteState.textContent='Không thể tìm địa chỉ lúc này. Vui lòng thử lại.';autocompleteState.className='small text-warning mt-1';}}
function queueAutocomplete(){clearTimeout(autocompleteTimer);setAddressConfirmed(false);shippingLatitudeInput.value='';shippingLongitudeInput.value='';shippingFullAddressInput.value='';autocompleteTimer=setTimeout(fetchAutocomplete,500);} 

async function loadProvinces(){try{showAddressError(false);setSelectLoading(provinceSelect,'Đang tải Tỉnh/Thành phố...');const response=await fetch(`${API_BASE}/p`);if(!response.ok) throw new Error();const provinces=await response.json();provinceSelect.innerHTML='<option value="">Chọn Tỉnh/Thành phố</option>';provinces.forEach((p)=>provinceSelect.insertAdjacentHTML('beforeend',`<option value="${p.code}" data-name="${p.name}">${p.name}</option>`));provinceSelect.disabled=false;}catch{showAddressError(true);setSelectLoading(provinceSelect,'Không tải được Tỉnh/Thành phố');}}
provinceSelect.addEventListener('change',async function(){const o=provinceSelect.options[provinceSelect.selectedIndex];provinceCodeInput.value=o.value||'';provinceNameInput.value=o.dataset.name||'';wardCodeInput.value='';wardNameInput.value='';wardSelect.innerHTML='<option value="">Chọn Phường/Xã</option>';if(!provinceCodeInput.value){wardSelect.disabled=true;return;}try{setSelectLoading(wardSelect,'Đang tải Phường/Xã...');const response=await fetch(`${API_BASE}/p/${provinceCodeInput.value}?depth=2`);if(!response.ok) throw new Error();const provinceDetail=await response.json();wardSelect.innerHTML='<option value="">Chọn Phường/Xã</option>';(provinceDetail.wards??[]).forEach((w)=>wardSelect.insertAdjacentHTML('beforeend',`<option value="${w.code}" data-name="${w.name}">${w.name}</option>`));wardSelect.disabled=false;}catch{showAddressError(true);wardSelect.disabled=true;}});
wardSelect.addEventListener('change',function(){const o=wardSelect.options[wardSelect.selectedIndex];wardCodeInput.value=o.value||'';wardNameInput.value=o.dataset.name||'';queueAutocomplete();queueShippingCalc();});
addressDetail.addEventListener('input',()=>{queueAutocomplete();queueShippingCalc();});
checkoutForm.addEventListener('submit',function(e){if(!provinceCodeInput.value||!wardCodeInput.value||!addressDetail.value.trim()){e.preventDefault();showAddressError(true);return;}if(!shippingFeeInput.value||!shippingLatitudeInput.value||!shippingLongitudeInput.value){e.preventDefault();shippingCalcText.textContent='Vui lòng chờ hệ thống tính phí ship hoặc kiểm tra lại địa chỉ.';return;}const fullAddress=buildAddressQuery();fullAddressInput.value=fullAddress;customerAddressInput.value=fullAddress;});
loadProvinces();
</script>
