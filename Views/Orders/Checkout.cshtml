@model Datn.PcStore.ViewModels.CheckoutRequestVm
@using Datn.PcStore.ViewModels
@{
    ViewData["Title"] = "Thanh toán";
    var cart = ViewBag.Cart as CartViewVm;
    var hasCart = cart?.Items?.Any() == true;
    decimal subtotal = cart?.TotalAmount ?? 0;
}
<link rel="stylesheet" href="~/css/cart.css" />

<div class="checkout-page">
    <div class="checkout-container">
        <div class="checkout-breadcrumb">Trang chủ &gt; <strong>Thông tin giỏ hàng</strong></div>

        <section class="panel mb-3">
            <div class="panel-header d-flex justify-content-between align-items-center">
                <h1 class="m-0">Giỏ hàng</h1>
                @if (hasCart)
                {
                    <form method="post" asp-controller="Cart" asp-action="Clear">
                        @Html.AntiForgeryToken()
                        <button class="btn-clear-all" type="submit">Xóa toàn bộ giỏ hàng</button>
                    </form>
                }
            </div>

            @if (!hasCart)
            {
                <div class="p-3">Giỏ hàng của bạn đang trống. <a asp-controller="Products" asp-action="Index">Quay lại mua hàng</a></div>
            }
            else
            {
                @foreach (var i in cart!.Items)
                {
                    var img = ImageUrlHelper.ResolveImageUrl(i.ProductImage, "/images/placeholders/product-placeholder.png");
                    <div class="cart-row">
                        <div class="product-col">
                            <img src="@img" class="cart-product-image" onerror="this.onerror=null;this.src='/images/placeholders/product-placeholder.png';" />
                            <div>
                                <div class="name">@i.ProductName</div>
                                <div class="warranty">Bảo hành: @i.Warranty</div>
                            </div>
                        </div>
                        <div class="price-col">@i.UnitPrice.ToString("N0") VNĐ</div>
                        <div class="qty-col">
                            <form method="post" asp-controller="Cart" asp-action="Update" class="qty-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="cartItemId" value="@i.CartItemId" />
                                <div class="qty-box">
                                    <button type="button" onclick="stepQty(this,-1)">-</button>
                                    <input name="quantity" value="@i.Quantity" min="1" max="@i.StockQuantity" />
                                    <button type="button" onclick="stepQty(this,1)">+</button>
                                </div>
                                <button class="btn-update">Cập nhật</button>
                            </form>
                        </div>
                        <div class="line-col">@i.LineTotal.ToString("N0") VNĐ</div>
                        <div class="remove-col">
                            <form method="post" asp-controller="Cart" asp-action="Remove">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="cartItemId" value="@i.CartItemId" />
                                <button class="btn-remove" type="submit">✕</button>
                            </form>
                        </div>
                    </div>
                }
                <div class="cart-total">Tổng tiền: <span>@subtotal.ToString("N0") VNĐ</span></div>
            }
        </section>

        @if (hasCart)
        {
            <form method="post" action="/Checkout" id="checkoutForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="checkout-grid">
                    <section class="panel">
                        <div class="panel-header">THÔNG TIN NGƯỜI MUA</div>
                        <div class="panel-body">
                            <label>Họ tên*</label><input class="ui-input" name="CustomerName" value="@Model.CustomerName" required />
                            <label>SĐT*</label><input class="ui-input" name="CustomerPhone" value="@Model.CustomerPhone" required />
                            <label>Email*</label><input class="ui-input" type="email" name="CustomerEmail" value="@Model.CustomerEmail" required />
                            <label>Địa chỉ*</label><textarea class="ui-input" id="addressDetail" name="AddressDetail" required>@Model.AddressDetail</textarea>
                            <label>Tỉnh/Thành phố*</label><select class="ui-input" id="provinceSelect" required><option value="">Chọn Tỉnh/Thành phố</option></select>
                            <label>Quận/Huyện*</label><select class="ui-input" id="districtSelect" required disabled><option value="">Chọn Quận/Huyện</option></select>
                            <label>Phường/Xã*</label><select class="ui-input" id="wardSelect" required disabled><option value="">Chọn Phường/Xã</option></select>
                            <label>Ghi chú</label><textarea class="ui-input" rows="3" name="Note">@Model.Note</textarea>
                        </div>
                    </section>

                    <section class="panel">
                        <div class="panel-header">TỔNG TIỀN</div>
                        <div class="panel-body">
                            <div class="voucher-row"><input class="ui-input" name="VoucherCode" placeholder="Mã voucher" value="@Model.VoucherCode" /><button type="button" class="voucher-btn">Chọn mã voucher</button></div>
                            <div class="sum-row"><span>Tổng cộng</span><strong>@subtotal.ToString("N0") VNĐ</strong></div>
                            <div class="sum-row"><span>Giảm giá Voucher</span><strong>0 VNĐ</strong></div>
                            <div class="sum-row final"><span>Thành tiền</span><strong>@subtotal.ToString("N0") VNĐ</strong></div>
                            <small>(Giá đã bao gồm VAT)</small>
                            <div class="mt-3"><input type="checkbox" id="termsCheck" required /> <label for="termsCheck">Tôi đã đọc và đồng ý với các Điều kiện giao dịch chung của website</label></div>
                            <div class="mt-3"><label>Phương thức thanh toán*</label><select class="ui-input" name="PaymentMethod" required><option value="COD" selected="@(Model.PaymentMethod == "COD")">Thanh toán khi nhận hàng (COD)</option><option value="BANK_TRANSFER" selected="@(Model.PaymentMethod == "BANK_TRANSFER")">Chuyển khoản ngân hàng</option></select></div>

                            <div class="action-grid">
                                <button type="button" class="action-btn dark" disabled>TẢI FILE EXCEL</button>
                                <button type="submit" class="action-btn red">ĐẶT HÀNG</button>
                                <button type="button" class="action-btn navy">TRẢ GÓP QUA HỒ SƠ</button>
                                <button type="submit" class="action-btn red">MUA NGAY</button>
                                <button type="button" class="action-btn blue">TRẢ GÓP QUA THẺ</button>
                            </div>
                        </div>
                    </section>
                </div>

                <input type="hidden" name="CustomerAddress" id="customerAddress" />
                <input type="hidden" name="FullAddress" id="fullAddress" />
                <input type="hidden" name="ProvinceCode" id="provinceCode" />
                <input type="hidden" name="DistrictCode" id="districtCode" />
                <input type="hidden" name="DistrictName" id="districtName" />
                <input type="hidden" name="ProvinceName" id="provinceName" />
                <input type="hidden" name="WardCode" id="wardCode" />
                <input type="hidden" name="WardName" id="wardName" />
                <input type="hidden" name="ShippingDistanceKm" id="shippingDistanceKm" />
                <input type="hidden" name="ShippingDurationMinutes" id="shippingDurationMinutes" />
                <input type="hidden" name="ShippingFee" id="shippingFeeInput" />
                <input type="hidden" name="ShippingProvider" id="shippingProvider" />
                <input type="hidden" name="ShippingFormulaSnapshot" id="shippingFormulaSnapshot" />
                <input type="hidden" name="ManualProvince" value="@Model.ManualProvince" />
                <input type="hidden" name="ManualWard" value="@Model.ManualWard" />
            </form>
        }

        <section class="service-cards">
            <div class="service-grid">
                <div class="service-item"><i class="bi bi-shield-check"></i><div><div class="title">Cam kết chính hãng</div><div class="sub">Sản phẩm đảm bảo nguồn gốc rõ ràng</div></div></div>
                <div class="service-item"><i class="bi bi-truck"></i><div><div class="title">Giao hàng nhanh</div><div class="sub">Hỗ trợ giao hỏa tốc nội thành</div></div></div>
                <div class="service-item"><i class="bi bi-arrow-repeat"></i><div><div class="title">Đổi trả linh hoạt</div><div class="sub">Hỗ trợ đổi trả theo chính sách</div></div></div>
                <div class="service-item"><i class="bi bi-headset"></i><div><div class="title">Hỗ trợ tận tâm</div><div class="sub">Tư vấn kỹ thuật 24/7</div></div></div>
            </div>
        </section>
    </div>
</div>
<script>
function stepQty(btn, step){const input=btn.parentElement.querySelector('input[name="quantity"]');const min=parseInt(input.min||'1');const max=parseInt(input.max||'9999');const next=Math.max(min,Math.min(max,(parseInt(input.value||'1')+step)));input.value=next;btn.closest('form').submit();}
</script>
<script src="~/js/checkout.js"></script>
