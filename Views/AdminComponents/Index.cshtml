@model Datn.PcStore.ViewModels.AdminComponentIndexVm
@{
    ViewData["Title"] = "Quản lý linh kiện";
}

<style>
.admin-component-toolbar{background:#fff;border:1px solid #e5e7eb;border-radius:18px;padding:1rem;box-shadow:0 10px 24px rgba(15,23,42,.045)}
.admin-component-filter{display:grid;grid-template-columns:minmax(220px,1.6fr) minmax(170px,1fr) minmax(160px,1fr) repeat(2,minmax(110px,.6fr)) repeat(2,minmax(120px,.7fr)) auto;gap:.75rem;align-items:end}
.admin-components-table .admin-col-image{width:76px}.admin-components-table .admin-col-name{min-width:280px}.admin-components-table .admin-col-type{width:150px}.admin-components-table .admin-col-brand{width:140px}.admin-components-table .admin-col-price{width:140px}.admin-components-table .admin-col-stock{width:90px}.admin-components-table .admin-col-status{width:110px}.admin-components-table .admin-col-actions{width:170px}.admin-component-thumb{width:54px;height:54px;object-fit:cover}.admin-component-name{font-weight:700;color:#111827}.admin-components-table td{vertical-align:middle}.admin-components-table .admin-action-buttons{justify-content:center}
@@media(max-width:1199.98px){.admin-component-filter{grid-template-columns:repeat(4,minmax(0,1fr))}.admin-component-filter .filter-keyword{grid-column:span 2}}
@@media(max-width:767.98px){.admin-component-filter{grid-template-columns:1fr}.admin-component-filter .filter-keyword{grid-column:auto}.admin-components-table .admin-col-name{min-width:220px}}
</style>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h3 class="mb-1">Quản lý linh kiện</h3>
        <div class="text-muted">Theo dõi nhanh loại linh kiện, giá bán, tồn kho và trạng thái hiển thị.</div>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Thêm linh kiện</a>
</div>

@if (TempData["Ok"] != null) { <div class="alert alert-success">@TempData["Ok"]</div> }

<form method="get" class="admin-component-toolbar mb-3">
    <div class="admin-component-filter">
        <div class="filter-keyword"><label class="form-label small text-muted">Từ khóa</label><input name="keyword" value="@Model.Keyword" class="form-control" placeholder="Tìm theo tên linh kiện" /></div>
        <div><label class="form-label small text-muted">Loại</label><select name="componentType" class="form-select"><option value="">-- Loại linh kiện --</option>@foreach (var t in Model.ComponentTypeOptions) { <option value="@t" selected="@(Model.ComponentType == t)">@Datn.PcStore.Models.ComponentTypes.GetLabel(t)</option> }</select></div>
        <div><label class="form-label small text-muted">Thương hiệu</label><select name="brand" class="form-select"><option value="">-- Thương hiệu --</option>@foreach (var b in Model.BrandOptions) { <option value="@b" selected="@(Model.Brand == b)">@b</option> }</select></div>
        <div><label class="form-label small text-muted">Giá từ</label><input name="minPrice" value="@Model.MinPrice" class="form-control" placeholder="Từ" /></div>
        <div><label class="form-label small text-muted">Giá đến</label><input name="maxPrice" value="@Model.MaxPrice" class="form-control" placeholder="Đến" /></div>
        <div><label class="form-label small text-muted">Trạng thái</label><select name="isActive" class="form-select"><option value="">Tất cả</option><option value="true" selected="@(Model.IsActive == true)">Đang KD</option><option value="false" selected="@(Model.IsActive == false)">Ẩn</option></select></div>
        <div><label class="form-label small text-muted">Kho</label><select name="inStock" class="form-select"><option value="">Tất cả</option><option value="true" selected="@(Model.InStock == true)">Còn</option><option value="false" selected="@(Model.InStock == false)">Hết</option></select></div>
        <div><button class="btn btn-outline-primary w-100"><i class="bi bi-funnel"></i> Lọc</button></div>
    </div>
</form>

<div class="table-responsive">
<table class="table table-hover align-middle admin-products-table admin-components-table">
    <thead><tr><th class="admin-col-image text-center">Ảnh</th><th class="admin-col-name">Tên linh kiện</th><th class="admin-col-type">Loại</th><th class="admin-col-brand">Thương hiệu</th><th class="admin-col-price text-end">Giá</th><th class="admin-col-stock text-center">Tồn kho</th><th class="admin-col-status text-center">Trạng thái</th><th class="admin-col-actions text-center">Thao tác</th></tr></thead>
    <tbody>
    @foreach (var p in Model.Components)
    {
        var thumb = ImageUrlHelper.ResolveImageUrl(p.ProductImages.FirstOrDefault(x => x.IsPrimary)?.ImageUrl ?? p.ProductImages.OrderBy(x => x.SortOrder).FirstOrDefault()?.ImageUrl ?? p.ThumbnailImage, "/images/no-image.png");
        <tr>
            <td class="text-center"><img src="@thumb" class="rounded admin-component-thumb" alt="@p.Name" onerror="this.onerror=null;this.src='/images/no-image.png';" /></td>
            <td><span class="admin-component-name">@p.Name</span><div class="small text-muted">@p.Category?.Name</div></td>
            <td><span class="badge text-bg-info">@Datn.PcStore.Models.ComponentTypes.GetLabel(p.ComponentType)</span></td>
            <td>@(string.IsNullOrWhiteSpace(p.Brand) ? "—" : p.Brand)</td>
            <td class="text-end fw-semibold">@((p.DiscountPrice ?? p.SalePrice ?? p.Price).ToString("N0")) đ</td>
            <td class="text-center">@p.StockQuantity</td>
            <td class="text-center">@(p.IsActive ? Html.Raw("<span class='badge bg-success'>Đang KD</span>") : Html.Raw("<span class='badge bg-secondary'>Ẩn</span>"))</td>
            <td><div class="admin-action-buttons"><a class="btn btn-sm btn-outline-info" asp-controller="Products" asp-action="Detail" asp-route-id="@p.Id">Xem</a><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.Id">Sửa</a><form method="post" asp-action="Delete" data-confirm-message="Bạn có chắc muốn xóa linh kiện này không?" data-confirm-title="Xóa linh kiện" data-confirm-text="Xóa" data-cancel-text="Hủy" data-confirm-type="danger">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id" /><button class="btn btn-sm btn-outline-danger">Xóa</button></form></div></td>
        </tr>
    }
    </tbody>
</table>
</div>
