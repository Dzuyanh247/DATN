@model Datn.PcStore.ViewModels.AdminComponentIndexVm
@{
    ViewData["Title"] = "Quản lý linh kiện";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Quản lý linh kiện</h3>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Thêm linh kiện</a>
</div>

@if (TempData["Ok"] != null) { <div class="alert alert-success">@TempData["Ok"]</div> }

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3"><input name="keyword" value="@Model.Keyword" class="form-control" placeholder="Tìm theo tên linh kiện" /></div>
    <div class="col-md-2"><select name="componentType" class="form-select"><option value="">-- Loại linh kiện --</option>@foreach (var t in Model.ComponentTypeOptions) { <option value="@t" selected="@(Model.ComponentType == t)">@Datn.PcStore.Models.ComponentTypes.GetLabel(t)</option> }</select></div>
    <div class="col-md-2"><select name="brand" class="form-select"><option value="">-- Thương hiệu --</option>@foreach (var b in Model.BrandOptions) { <option value="@b" selected="@(Model.Brand == b)">@b</option> }</select></div>
    <div class="col-md-1"><input name="minPrice" value="@Model.MinPrice" class="form-control" placeholder="Giá từ" /></div>
    <div class="col-md-1"><input name="maxPrice" value="@Model.MaxPrice" class="form-control" placeholder="Đến" /></div>
    <div class="col-md-1"><select name="isActive" class="form-select"><option value="">KD?</option><option value="true" selected="@(Model.IsActive == true)">Đang KD</option><option value="false" selected="@(Model.IsActive == false)">Ẩn</option></select></div>
    <div class="col-md-1"><select name="inStock" class="form-select"><option value="">Kho?</option><option value="true" selected="@(Model.InStock == true)">Còn</option><option value="false" selected="@(Model.InStock == false)">Hết</option></select></div>
    <div class="col-md-1"><button class="btn btn-outline-primary w-100">Lọc</button></div>
</form>

<table class="table table-striped align-middle admin-products-table">
    <thead><tr><th>Ảnh</th><th>Tên</th><th>Loại</th><th>Thương hiệu</th><th class="text-center">Giá</th><th class="text-center">Tồn kho</th><th class="text-center">Trạng thái</th><th>Thao tác</th></tr></thead>
    <tbody>
    @foreach (var p in Model.Components)
    {
        var thumb = ImageUrlHelper.ResolveImageUrl(p.ProductImages.FirstOrDefault(x => x.IsPrimary)?.ImageUrl ?? p.ProductImages.OrderBy(x => x.SortOrder).FirstOrDefault()?.ImageUrl ?? p.ThumbnailImage, "/images/no-image.png");
        <tr>
            <td><img src="@thumb" class="rounded admin-product-thumb" alt="@p.Name" onerror="this.onerror=null;this.src='/images/no-image.png';" /></td>
            <td><span class="admin-product-name">@p.Name</span><div class="small text-muted">@p.Category?.Name</div></td>
            <td><span class="badge text-bg-info">@Datn.PcStore.Models.ComponentTypes.GetLabel(p.ComponentType)</span></td>
            <td>@(string.IsNullOrWhiteSpace(p.Brand) ? "—" : p.Brand)</td>
            <td class="text-center">@((p.DiscountPrice ?? p.SalePrice ?? p.Price).ToString("N0")) đ</td>
            <td class="text-center">@p.StockQuantity</td>
            <td class="text-center">@(p.IsActive ? Html.Raw("<span class='badge bg-success'>Đang KD</span>") : Html.Raw("<span class='badge bg-secondary'>Ẩn</span>"))</td>
            <td><div class="admin-action-buttons"><a class="btn btn-sm btn-outline-info" asp-controller="Products" asp-action="Detail" asp-route-id="@p.Id">Xem</a><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.Id">Sửa</a><form method="post" asp-action="Delete" onsubmit="return confirm('Xác nhận xóa linh kiện?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id" /><button class="btn btn-sm btn-outline-danger">Xóa</button></form></div></td>
        </tr>
    }
    </tbody>
</table>
