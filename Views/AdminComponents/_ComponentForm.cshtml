@model Datn.PcStore.ViewModels.AdminComponentUpsertVm
@{
    var isEdit = Model.Id > 0;
    var orderedImages = Model.ExistingImages.OrderBy(x => x.SortOrder).ToList();
    var hasErrors = ViewData.ModelState.Values.Any(v => v.Errors.Any());
    var componentTypeLabels = new Dictionary<string, string>
    {
        ["CPU"] = "CPU - Bộ vi xử lý",
        ["Mainboard"] = "Mainboard - Bo mạch chủ",
        ["RAM"] = "RAM - Bộ nhớ trong",
        ["VGA"] = "VGA - Card màn hình",
        ["Storage"] = "Storage - SSD/HDD",
        ["PSU"] = "PSU - Nguồn máy tính",
        ["Case"] = "Case - Vỏ case",
        ["Cooler"] = "Cooler - Tản nhiệt",
        ["Monitor"] = "Monitor - Màn hình",
        ["Keyboard"] = "Keyboard - Bàn phím",
        ["Mouse"] = "Mouse - Chuột",
        ["Headphone"] = "Headphone - Tai nghe",
        ["MonitorArm"] = "MonitorArm - Giá treo màn hình",
        ["Other"] = "Other - Khác"
    };
    var orderedTypes = new[] { "CPU", "Mainboard", "RAM", "VGA", "Storage", "PSU", "Case", "Cooler", "Monitor", "Keyboard", "Mouse", "Headphone", "MonitorArm", "Other" };
}

<style>
.admin-product-form .validation-summary-valid{display:none}
.component-page-header{background:linear-gradient(135deg,#0f172a,#2563eb);color:#fff;border-radius:22px;padding:1.4rem 1.5rem;margin-bottom:1.25rem;box-shadow:0 14px 30px rgba(37,99,235,.18)}
.component-page-header h2{font-weight:800;margin:0}
.component-page-header .btn{border-color:rgba(255,255,255,.5)}
.component-stepper{display:grid;grid-template-columns:repeat(5,1fr);gap:.6rem;margin-bottom:1rem}
.component-stepper .step{background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:.65rem .75rem;font-size:.82rem;color:#475569}
.component-stepper .num{display:inline-flex;width:24px;height:24px;border-radius:999px;align-items:center;justify-content:center;background:#2563eb;color:#fff;font-weight:700;margin-right:.35rem}
.ux-card{background:#fff;border:1px solid #e5e7eb;border-radius:18px;padding:1.15rem;box-shadow:0 10px 24px rgba(15,23,42,.05)}
.ux-card-title{display:flex;align-items:center;gap:.65rem;font-weight:800;color:#0f172a;margin-bottom:.25rem}
.ux-card-title .num{width:30px;height:30px;border-radius:999px;background:#eff6ff;color:#2563eb;display:inline-flex;align-items:center;justify-content:center}
.ux-help{color:#64748b;font-size:.9rem}
.required-mark{color:#dc2626}
.actual-price-box{background:#f8fafc;border:1px dashed #94a3b8;border-radius:12px;padding:.85rem}
.image-preview-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(92px,1fr));gap:.75rem}
.image-preview-grid img,.preview-thumb{width:100%;height:92px;object-fit:cover;border-radius:10px;border:1px solid #e5e7eb}
.preview-thumb{height:190px;background:#f1f5f9}
.spec-kv-table th{font-size:.8rem;color:#475569}
.spec-kv-table td{vertical-align:middle}
.sticky-preview{position:sticky;top:90px}
.sticky-actions{position:sticky;bottom:0;z-index:10;background:rgba(255,255,255,.96);backdrop-filter:blur(8px);border:1px solid #e5e7eb;border-radius:16px;padding:.85rem;margin-top:1rem;box-shadow:0 -8px 20px rgba(15,23,42,.06)}
.quick-chip{border-radius:999px}
.comp-use-badge{display:inline-flex;align-items:center;gap:.35rem;border-radius:999px;padding:.35rem .65rem;background:#ecfdf5;color:#047857;font-weight:700}
.preview-spec-table td{font-size:.85rem;padding:.35rem .25rem}
.example-spec-box{display:none;background:#f8fafc;border:1px solid #e2e8f0;border-radius:14px;padding:.75rem}
.auto-spec-feedback{display:none}
.field-validation-error{display:block;margin-top:.25rem;font-size:.875rem}
.input-validation-error{border-color:#dc3545}
.apf-image-list{display:grid;gap:.75rem}
.apf-image-item{display:flex;gap:.75rem;align-items:center;border:1px solid #e5e7eb;border-radius:12px;padding:.5rem}
.apf-image-item img{width:76px;height:76px;object-fit:cover;border-radius:10px}

@@media (max-width: 991.98px){
    .component-stepper{grid-template-columns:1fr 1fr}
    .sticky-preview{position:static}
    .component-page-header .actions{margin-top:1rem}
}

@@media (max-width: 575.98px){
    .component-stepper{grid-template-columns:1fr}
    .component-page-header{padding:1rem}
    .sticky-actions .btn{width:100%;}
    .sticky-actions{position:static}
}
</style>

<div class="component-page-header">
    <div class="d-lg-flex justify-content-between align-items-start gap-3">
        <div>
            <span class="text-uppercase small opacity-75">Quản trị linh kiện</span>
            <h2>@(isEdit ? "Cập nhật linh kiện" : "Thêm linh kiện")</h2>
            <p class="mb-0 opacity-75">Tạo sản phẩm thuộc nhóm Linh kiện máy tính. Các linh kiện như Màn hình, Bàn phím, Chuột, Tai nghe có thể dùng làm sản phẩm mua kèm cho PC.</p>
        </div>
        <div class="actions d-flex flex-wrap gap-2">
            <a asp-action="Index" class="btn btn-light"><i class="bi bi-arrow-left"></i> Quay lại danh sách</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light"><i class="bi bi-house"></i> Xem trang chủ</a>
        </div>
    </div>
</div>

<div class="component-stepper" aria-label="Các bước nhập linh kiện">
    <div class="step"><span class="num">1</span>Chọn loại</div><div class="step"><span class="num">2</span>Bán hàng</div><div class="step"><span class="num">3</span>Giá & bảo hành</div><div class="step"><span class="num">4</span>Ảnh & mô tả</div><div class="step"><span class="num">5</span>Thông số</div>
</div>

<form asp-controller="AdminComponents" asp-action="@(isEdit ? "Edit" : "Create")" method="post" class="admin-product-form" id="component-form" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" /><input type="hidden" asp-for="ProductType" value="Component" /><input type="hidden" asp-for="Specifications" id="Specifications" />
    @if (hasErrors) { <div asp-validation-summary="All" class="alert alert-danger mb-3" role="alert"></div> }
    @if (TempData["ErrorMessage"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage)) { <div class="alert alert-warning mb-3" role="alert">@errorMessage</div> }

    <div class="row g-4 align-items-start">
        <div class="col-xl-8">
            <div class="ux-card mb-4"><h5 class="ux-card-title"><span class="num">1</span>Chọn loại linh kiện</h5><p class="ux-help">Loại linh kiện quyết định sản phẩm này sẽ xuất hiện ở đâu. Ví dụ Monitor sẽ xuất hiện trong mục Màn hình mua kèm.</p><div class="row g-3">
                <div class="col-md-6"><label asp-for="CategoryId" class="form-label">Danh mục linh kiện <span class="required-mark">*</span></label><select asp-for="CategoryId" class="form-select" asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Model.Categories, "Id", "Name"))"><option value="">-- Chọn danh mục --</option></select><span asp-validation-for="CategoryId" class="text-danger"></span><div class="form-text">Danh mục dùng để gom nhóm trong trang quản trị và bộ lọc.</div></div>
                <div class="col-md-6"><label asp-for="ComponentType" class="form-label">Loại / nhánh linh kiện <span class="required-mark">*</span></label><select asp-for="ComponentType" class="form-select" id="component-type-select"><option value="">-- Chọn loại linh kiện --</option>@foreach (var value in orderedTypes){<option value="@value" selected="@(Model.ComponentType == value)">@componentTypeLabels[value]</option>}</select><span asp-validation-for="ComponentType" class="text-danger"></span><div class="mt-2"><span class="comp-use-badge" id="component-use-hint">Dùng cho: Danh mục linh kiện máy tính</span></div></div>
            </div></div>

            <div class="ux-card mb-4"><h5 class="ux-card-title"><span class="num">2</span>Thông tin bán hàng</h5><p class="ux-help">Các trường có dấu * là bắt buộc. Thương hiệu và mã sản phẩm có thể bỏ trống nếu chưa có dữ liệu.</p><div class="row g-3">
                <div class="col-12"><label asp-for="Name" class="form-label">Tên linh kiện <span class="required-mark">*</span></label><input asp-for="Name" class="form-control" id="component-name" placeholder="VD: Card màn hình Colorful GeForce RTX 3060 12GB" /><span asp-validation-for="Name" class="text-danger"></span></div>
                <div class="col-md-6"><label asp-for="Brand" class="form-label">Thương hiệu <span class="text-muted">(không bắt buộc)</span></label><input asp-for="Brand" class="form-control" id="component-brand" placeholder="ASUS, Samsung, Logitech..." /><span asp-validation-for="Brand" class="text-danger"></span></div>
                <div class="col-md-3"><label asp-for="ProductCode" class="form-label">Mã sản phẩm <span class="text-muted">(không bắt buộc)</span></label><input asp-for="ProductCode" class="form-control" placeholder="Tự tạo nếu trống" /><span asp-validation-for="ProductCode" class="text-danger"></span></div>
                <div class="col-md-3"><label asp-for="StockQuantity" class="form-label">Tồn kho <span class="required-mark">*</span></label><input asp-for="StockQuantity" class="form-control" id="stock-input" min="0" placeholder="0" /><span asp-validation-for="StockQuantity" class="text-danger"></span></div>
                <div class="col-12"><div class="form-check form-switch"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Trạng thái đang kinh doanh</label></div><div class="form-text">Tắt trạng thái nếu muốn lưu nháp hoặc tạm ngừng bán.</div></div>
            </div></div>

            <div class="ux-card mb-4"><h5 class="ux-card-title"><span class="num">3</span>Giá & bảo hành</h5><div class="row g-3">
                <div class="col-md-4"><label asp-for="Price" class="form-label">Giá gốc <span class="required-mark">*</span></label><input asp-for="Price" class="form-control js-price" min="1000" placeholder="VD: 3500000" /><span asp-validation-for="Price" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="DiscountPrice" class="form-label">Giá khuyến mãi <span class="text-muted">(không bắt buộc)</span></label><input asp-for="DiscountPrice" class="form-control js-sale-price" min="0" placeholder="Nhỏ hơn giá gốc" /><span asp-validation-for="DiscountPrice" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="WarrantyMonths" class="form-label">Bảo hành (tháng) <span class="required-mark">*</span></label><input asp-for="WarrantyMonths" class="form-control" min="0" placeholder="VD: 36" /><span asp-validation-for="WarrantyMonths" class="text-danger"></span></div>
                <div class="col-12"><div class="actual-price-box"><span class="text-muted">Giá bán thực tế tự tính:</span> <strong id="actual-price-preview">--</strong><div class="form-text">Nếu có giá khuyến mãi, website dùng giá khuyến mãi làm giá bán.</div></div></div>
            </div></div>

            <div class="ux-card mb-4"><h5 class="ux-card-title"><span class="num">4</span>Hình ảnh & mô tả</h5><div class="row g-3">
                <div class="col-lg-6">
                    @if (orderedImages.Any()) { <label class="form-label">Ảnh hiện có</label><div class="apf-image-list mb-3" id="existing-image-list">@foreach (var image in orderedImages) { <div class="apf-image-item" data-image-id="@image.Id"><img src="@image.ImageUrl" alt="Ảnh linh kiện" onerror="this.onerror=null;this.src='/images/no-image.png';" /><div><span class="badge text-bg-warning apf-primary-badge">Ảnh đại diện</span><label class="form-check-label text-danger small d-block mt-2"><input class="form-check-input" type="checkbox" name="RemoveImageIds" value="@image.Id" /> Xóa</label></div></div> }</div> }
                    <label asp-for="ThumbnailImageUrl" class="form-label">Ảnh đại diện <span class="required-mark">*</span></label><input asp-for="ThumbnailImageUrl" class="form-control js-image-url" placeholder="https://..." /><span asp-validation-for="ThumbnailImageUrl" class="text-danger"></span>
                    <label asp-for="ProductImageUrlsText" class="form-label mt-3">Thư viện ảnh <span class="text-muted">(không bắt buộc)</span></label><textarea asp-for="ProductImageUrlsText" rows="5" class="form-control js-gallery-urls" placeholder="Mỗi URL ảnh trên một dòng"></textarea><span asp-validation-for="ProductImageUrlsText" class="text-danger"></span><div class="mt-3"><label class="form-label">Preview ảnh</label><div class="image-preview-grid" id="image-preview-grid"></div></div><div id="existing-image-order-container"></div>
                </div>
                <div class="col-lg-6"><label class="form-label">Mô tả ngắn / mô tả chi tiết</label><textarea asp-for="Description" rows="12" class="form-control" id="component-description" placeholder="Tóm tắt ưu điểm, tình trạng, nội dung nổi bật của linh kiện"></textarea><div class="form-text">Dòng đầu tiên sẽ được dùng làm mô tả ngắn.</div><span asp-validation-for="Description" class="text-danger"></span></div>
            </div></div>

            <div class="ux-card"><h5 class="ux-card-title"><span class="num">5</span>Thông số kỹ thuật</h5><p class="ux-help">Thông số nhập ở đây sẽ hiển thị thành bảng ở trang chi tiết sản phẩm.</p><div class="d-flex flex-wrap gap-2 mb-3"><button type="button" class="btn btn-outline-primary" id="apply-spec-template"><i class="bi bi-magic"></i> Gợi ý theo loại</button><button type="button" class="btn btn-outline-success" id="open-auto-spec-import"><i class="bi bi-clipboard-data"></i> Nhập thông số tự động</button><button type="button" class="btn btn-outline-secondary" id="add-spec-row">Thêm thông số</button><button type="button" class="btn btn-outline-danger" id="clear-empty-specs">Xóa dòng trống</button><button type="button" class="btn btn-outline-info" id="toggle-example-specs">Xem ví dụ</button></div><div class="alert alert-success auto-spec-feedback mb-3" id="auto-spec-feedback" role="alert"></div><div class="d-flex flex-wrap gap-2 mb-3"><button type="button" class="btn btn-sm btn-light border quick-chip" data-chip="Hãng sản xuất">+ Hãng sản xuất</button><button type="button" class="btn btn-sm btn-light border quick-chip" data-chip="Kích thước">+ Kích thước</button><button type="button" class="btn btn-sm btn-light border quick-chip" data-chip="Bộ nhớ">+ Bộ nhớ</button><button type="button" class="btn btn-sm btn-light border quick-chip" data-chip="Kết nối">+ Kết nối</button><button type="button" class="btn btn-sm btn-light border quick-chip" data-chip="Bảo hành">+ Bảo hành</button></div><div class="example-spec-box mb-3" id="example-spec-box"><strong>Ví dụ hiển thị ngoài trang chi tiết</strong><table class="table table-sm mt-2 mb-0"><tbody><tr><td>Sản phẩm</td><td>Card màn hình RTX 3060 12GB</td></tr><tr><td>Bộ nhớ</td><td>12GB GDDR6</td></tr><tr><td>Kết nối</td><td>HDMI, DisplayPort</td></tr></tbody></table></div><div class="table-responsive"><table class="table table-sm spec-kv-table" id="spec-kv-table"><thead><tr><th style="width:35%">Tên thông số</th><th>Giá trị</th><th class="text-center" style="width:90px">Xóa</th></tr></thead><tbody>@for (var i = 0; i < Model.SpecificationItems.Count; i++){<tr><td><input class="form-control form-control-sm js-spec-name" name="SpecificationItems[@i].Name" value="@Model.SpecificationItems[i].Name" placeholder="VD: Bộ nhớ" /></td><td><input class="form-control form-control-sm js-spec-value" name="SpecificationItems[@i].Value" value="@Model.SpecificationItems[i].Value" placeholder="VD: 12GB GDDR6" /></td><td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger js-remove-spec-row">Xóa</button></td></tr>}</tbody></table></div><span asp-validation-for="Specifications" class="text-danger"></span></div>
        </div>
        <div class="col-xl-4"><div class="ux-card sticky-preview"><h5 class="ux-card-title"><span class="num"><i class="bi bi-eye"></i></span>Xem trước dữ liệu</h5><p class="ux-help" id="side-help">Chọn loại linh kiện để xem gợi ý nhập liệu và nơi hiển thị.</p><img class="preview-thumb mb-3" id="preview-image" src="/images/no-image.png" alt="Preview ảnh đại diện" onerror="this.onerror=null;this.src='/images/no-image.png';" /><h5 id="preview-name" class="mb-1">Tên linh kiện</h5><div class="fw-bold text-danger fs-5" id="preview-price">--</div><div class="mt-2"><span class="badge text-bg-primary" id="preview-type">Other - Khác</span></div><div class="mt-2" id="bundle-badge" style="display:none"><span class="badge text-bg-success">Có thể dùng làm sản phẩm mua kèm</span></div><hr /><strong>Thông số preview</strong><table class="table preview-spec-table mt-2"><tbody id="preview-specs"><tr><td class="text-muted">Chưa có thông số</td></tr></tbody></table></div></div>
    </div>
    <div class="sticky-actions d-flex flex-wrap gap-2 justify-content-between align-items-center"><div class="text-muted small">Kiểm tra preview và lỗi dưới từng ô trước khi lưu.</div><div class="d-flex flex-wrap gap-2"><button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Lưu linh kiện</button><button type="submit" class="btn btn-outline-primary" disabled title="Sẽ bổ sung khi luồng lưu tiếp được tách riêng">Lưu & thêm tiếp</button><a asp-action="Index" class="btn btn-outline-secondary">Hủy</a><a asp-action="Index" class="btn btn-link">Quay lại danh sách</a></div></div>
</form>
<div class="modal fade" id="autoSpecModal" tabindex="-1" aria-labelledby="autoSpecModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title" id="autoSpecModalLabel">Nhập thông số sản phẩm</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
            <div class="modal-body">
                <textarea id="auto-spec-text" rows="16" class="form-control" placeholder="Dán toàn bộ thông số kỹ thuật từ website nhà sản xuất hoặc cửa hàng.&#10;&#10;Ví dụ:&#10;&#10;Thương hiệu&#10;Intel&#10;&#10;Loại CPU&#10;Dành cho máy bàn&#10;&#10;Thế hệ&#10;Core i3 Thế hệ thứ 12&#10;&#10;Tên gọi&#10;Core i3-12100&#10;&#10;Socket&#10;FCLGA 1700&#10;&#10;Tên thế hệ&#10;Alder Lake&#10;&#10;Số nhân&#10;4&#10;&#10;Số luồng&#10;8&#10;&#10;Tốc độ cơ bản&#10;Performance-core Max Turbo Frequency: 4.3 GHz&#10;&#10;Performance-core Base Frequency: 3.30 GHz&#10;&#10;Cache&#10;12MB&#10;&#10;TDP&#10;58W&#10;&#10;Tản nhiệt&#10;Mặc định đi kèm"></textarea>
                <div class="form-text">Dữ liệu chỉ được đưa vào bảng thông số hiện có; chưa lưu DB cho đến khi bấm “Lưu linh kiện”.</div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button><button type="button" class="btn btn-primary" id="import-auto-specs">Nhập vào bảng</button></div>
        </div>
    </div>
</div>
<partial name="_ValidationScriptsPartial" />
<script>
(function(){
const templates={VGA:['Sản phẩm','Hãng sản xuất','Engine đồ họa','Chuẩn Bus','Bộ nhớ','Engine Clock','Lõi CUDA','Clock bộ nhớ','Giao diện bộ nhớ','Kết nối','Kích thước','PSU đề nghị','Power Connectors','DirectX'],RAM:['Sản phẩm','Hãng sản xuất','Dung lượng','Chuẩn RAM','Bus','Điện áp','Tản nhiệt','Bảo hành'],Monitor:['Sản phẩm','Hãng sản xuất','Kích thước','Độ phân giải','Tấm nền','Tần số quét','Thời gian đáp ứng','Độ sáng','Cổng kết nối','Bảo hành'],CPU:['Sản phẩm','Hãng sản xuất','Socket','Số nhân','Số luồng','Xung nhịp','Cache','TDP'],Mainboard:['Sản phẩm','Hãng sản xuất','Socket','Chipset','Kích thước','RAM hỗ trợ','Khe mở rộng','Cổng kết nối'],Storage:['Sản phẩm','Hãng sản xuất','Dung lượng','Chuẩn kết nối','Tốc độ đọc','Tốc độ ghi','Bảo hành'],PSU:['Sản phẩm','Hãng sản xuất','Công suất','Chuẩn hiệu suất','Modular','Bảo hành'],Case:['Sản phẩm','Hãng sản xuất','Kích thước','Mainboard hỗ trợ','Quạt hỗ trợ','Radiator hỗ trợ','Cổng I/O'],Cooler:['Sản phẩm','Hãng sản xuất','Loại tản nhiệt','Socket hỗ trợ','Kích thước','Tốc độ quạt'],Keyboard:['Sản phẩm','Hãng sản xuất','Layout','Switch','Kết nối','LED','Keycap'],Mouse:['Sản phẩm','Hãng sản xuất','DPI','Kết nối','Cảm biến','Số nút','Trọng lượng'],Headphone:['Sản phẩm','Hãng sản xuất','Kiểu tai nghe','Kết nối','Driver','Micro','Âm thanh'],MonitorArm:['Sản phẩm','Hãng sản xuất','Tải trọng','Kích thước màn hình hỗ trợ','Chuẩn VESA','Chất liệu'],Other:['Sản phẩm','Hãng sản xuất','Bảo hành']};
const placeholders={VGA:'VD: Card màn hình Colorful GeForce RTX 3060 12GB',RAM:'VD: RAM Samsung 16GB DDR4 2133MHz',Monitor:'VD: Màn hình ASUS TUF Gaming 24.5 inch 240Hz',CPU:'VD: CPU Intel Core i5-12400F',Mainboard:'VD: Mainboard ASUS PRIME B660M-K D4',Storage:'VD: SSD Samsung 980 500GB NVMe',PSU:'VD: Nguồn Corsair CV650 650W 80 Plus Bronze',Case:'VD: Vỏ case Xigmatek Gaming X 3FX',Cooler:'VD: Tản nhiệt khí DeepCool AK400',Keyboard:'VD: Bàn phím cơ Akko 3098B Multi-modes',Mouse:'VD: Chuột Logitech G Pro X Superlight',Headphone:'VD: Tai nghe HyperX Cloud II',MonitorArm:'VD: Giá treo màn hình North Bayou F80',Other:'VD: Phụ kiện linh kiện máy tính'};
const labels={CPU:'CPU - Bộ vi xử lý',Mainboard:'Mainboard - Bo mạch chủ',RAM:'RAM - Bộ nhớ trong',VGA:'VGA - Card màn hình',Storage:'Storage - SSD/HDD',PSU:'PSU - Nguồn máy tính',Case:'Case - Vỏ case',Cooler:'Cooler - Tản nhiệt',Monitor:'Monitor - Màn hình',Keyboard:'Keyboard - Bàn phím',Mouse:'Mouse - Chuột',Headphone:'Headphone - Tai nghe',MonitorArm:'MonitorArm - Giá treo màn hình',Other:'Other - Khác'};
const usage={Monitor:'Dùng cho: Sản phẩm mua kèm > Màn hình',Keyboard:'Dùng cho: Sản phẩm mua kèm > Bàn phím',Mouse:'Dùng cho: Sản phẩm mua kèm > Chuột',Headphone:'Dùng cho: Sản phẩm mua kèm > Tai nghe'};
const tbody=document.querySelector('#spec-kv-table tbody'), type=document.getElementById('component-type-select'), nameInput=document.getElementById('component-name');
function esc(v){return (v||'').replaceAll('&','&amp;').replaceAll('"','&quot;').replaceAll('<','&lt;').replaceAll('>','&gt;')}function row(name='',value=''){const tr=document.createElement('tr');tr.innerHTML=`<td><input class="form-control form-control-sm js-spec-name" placeholder="VD: Bộ nhớ" value="${esc(name)}"></td><td><input class="form-control form-control-sm js-spec-value" placeholder="VD: 12GB GDDR6" value="${esc(value)}"></td><td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger js-remove-spec-row">Xóa</button></td>`;tbody.appendChild(tr); reindex();}
function reindex(){[...tbody.querySelectorAll('tr')].forEach((tr,i)=>{tr.querySelector('.js-spec-name').name=`SpecificationItems[${i}].Name`;tr.querySelector('.js-spec-value').name=`SpecificationItems[${i}].Value`;}); syncHidden(); updatePreview();}
function syncHidden(){const items=getSpecs().filter(x=>x.name||x.value);document.getElementById('Specifications').value=JSON.stringify(items);}function getSpecs(){return [...tbody.querySelectorAll('tr')].map(tr=>({name:tr.querySelector('.js-spec-name').value.trim(),value:tr.querySelector('.js-spec-value').value.trim()}));}
function applyTemplate(){const keys=templates[type.value]||templates.Other; const existing=new Set([...tbody.querySelectorAll('.js-spec-name')].map(x=>x.value.trim().toLowerCase())); keys.forEach(k=>{if(!existing.has(k.toLowerCase())) row(k,'');});}
const sectionHeadingPattern=/^(chi tiết|thông tin chung|đặc điểm nổi bật|mô tả|thông số kỹ thuật|thông số|tính năng|tổng quan|overview|specifications?)$/i;
const valueHintPattern=/(\d|gb|mb|tb|ghz|mhz|w\b|v\b|hz|rpm|mm|cm|inch|core|thread|ddr|pcie|nvme|sata|usb|hdmi|displayport|wi-?fi|bluetooth|lga|am\d|atx|itx|ips|oled|va|tn|gddr|cuda|rgb|pwm|yes|no|có|không)/i;
function cleanSpecLine(line){return (line||'').replace(/^[\s•\-–—*]+/,'').replace(/\s+/g,' ').trim();}
function isNoiseLine(line){const cleaned=cleanSpecLine(line).replace(/[:：\-–—]+$/,'').trim();return !cleaned||sectionHeadingPattern.test(cleaned);}
function looksLikeName(line,nextLine){const cleaned=cleanSpecLine(line);if(!cleaned||isNoiseLine(cleaned)||/[.!?]$/.test(cleaned)||cleaned.length>80)return false;if(/[:：]\s*\S|(?:\s[-–—]\s)\S/.test(cleaned))return false;if(valueHintPattern.test(cleaned)&&!nextLine)return false;return true;}
function pushParsedSpec(items,name,value){name=cleanSpecLine(name).replace(/[:：\-–—]+$/,'').trim();value=cleanSpecLine(value);if(!name||!value||isNoiseLine(name)||isNoiseLine(value))return;const existing=items.find(x=>x.name.toLocaleLowerCase('vi-VN')===name.toLocaleLowerCase('vi-VN'));if(existing)existing.value=value;else items.push({name,value});}
window.parseSpecsFromText=function(text){const lines=(text||'').split(/\r?\n/).map(cleanSpecLine).filter(x=>!isNoiseLine(x));const items=[];let pendingName='',pendingValues=[];function flush(){if(pendingName&&pendingValues.length)pushParsedSpec(items,pendingName,pendingValues.join('; '));pendingName='';pendingValues=[];}for(let i=0;i<lines.length;i++){const line=lines[i];const inline=line.match(/^(.{1,80}?)[\s]*[:：][\s]*(.+)$/)||line.match(/^(.{1,80}?)[\s]+[-–—][\s]+(.+)$/);if(inline&&!isNoiseLine(inline[1])){flush();pushParsedSpec(items,inline[1],inline[2]);continue;}const next=lines[i+1]||'';if(looksLikeName(line,next)){if(pendingName&&pendingValues.length)flush();pendingName=line;continue;}if(pendingName)pendingValues.push(line);}flush();return items;};
function upsertParsedSpecs(items){const existingRows=[...tbody.querySelectorAll('tr')];items.forEach(item=>{const normalized=item.name.toLocaleLowerCase('vi-VN');let matched=existingRows.find(tr=>tr.querySelector('.js-spec-name').value.trim().toLocaleLowerCase('vi-VN')===normalized);if(matched){matched.querySelector('.js-spec-value').value=item.value;}else{row(item.name,item.value);existingRows.push(tbody.lastElementChild);}});reindex();}
document.getElementById('add-spec-row')?.addEventListener('click',()=>row());document.getElementById('apply-spec-template')?.addEventListener('click',applyTemplate);document.getElementById('clear-empty-specs')?.addEventListener('click',()=>{[...tbody.querySelectorAll('tr')].forEach(tr=>{if(!tr.querySelector('.js-spec-name').value.trim()&&!tr.querySelector('.js-spec-value').value.trim())tr.remove();});reindex();});document.getElementById('toggle-example-specs')?.addEventListener('click',()=>{const box=document.getElementById('example-spec-box');box.style.display=box.style.display==='block'?'none':'block';});document.querySelectorAll('[data-chip]').forEach(btn=>btn.addEventListener('click',()=>row(btn.dataset.chip,'')));tbody?.addEventListener('click',e=>{if(e.target.closest('.js-remove-spec-row')){e.target.closest('tr').remove();reindex();}});tbody?.addEventListener('input',()=>{syncHidden();updatePreview();});if(tbody&&tbody.children.length===0) row('Sản phẩm','');
document.getElementById('open-auto-spec-import')?.addEventListener('click',()=>{const modalEl=document.getElementById('autoSpecModal');if(window.bootstrap?.Modal)bootstrap.Modal.getOrCreateInstance(modalEl).show();else modalEl.style.display='block';});
document.getElementById('import-auto-specs')?.addEventListener('click',()=>{const parsed=window.parseSpecsFromText(document.getElementById('auto-spec-text')?.value||'');upsertParsedSpecs(parsed);const feedback=document.getElementById('auto-spec-feedback');feedback.textContent=parsed.length?`Đã nhận diện ${parsed.length} thông số kỹ thuật.`:'Chưa nhận diện được thông số kỹ thuật nào.';feedback.className=`alert ${parsed.length?'alert-success':'alert-warning'} auto-spec-feedback mb-3`;feedback.style.display='block';const modalEl=document.getElementById('autoSpecModal');if(window.bootstrap?.Modal)bootstrap.Modal.getOrCreateInstance(modalEl).hide();else modalEl.style.display='none';});
function numeric(v){return Number((v||'').toString().replace(/[^0-9.]/g,''));}function money(v){const n=numeric(v);return n>0?n.toLocaleString('vi-VN')+' đ':'--';}function updatePrice(){const p=document.querySelector('.js-price')?.value; const s=document.querySelector('.js-sale-price')?.value; const actual=(numeric(s)>0?s:p); document.getElementById('actual-price-preview').textContent=money(actual); document.getElementById('preview-price').textContent=money(actual);}document.querySelectorAll('.js-price,.js-sale-price').forEach(x=>x.addEventListener('input',updatePrice));
function previews(){const urls=[];const thumb=document.querySelector('.js-image-url')?.value.trim(); if(thumb) urls.push(thumb); (document.querySelector('.js-gallery-urls')?.value||'').split(/\r?\n|,|;/).map(x=>x.trim()).filter(Boolean).forEach(x=>urls.push(x)); const box=document.getElementById('image-preview-grid'); box.innerHTML=''; [...new Set(urls)].slice(0,8).forEach(u=>{const img=document.createElement('img');img.src=u;img.onerror=function(){this.remove()};box.appendChild(img);});document.getElementById('preview-image').src=thumb||'/images/no-image.png';}document.querySelectorAll('.js-image-url,.js-gallery-urls').forEach(x=>x.addEventListener('input',previews));
function updateTypeUi(){const val=type.value||'Other'; const hint=usage[val]||'Dùng cho: Danh mục linh kiện máy tính'; document.getElementById('component-use-hint').textContent=hint; document.getElementById('side-help').textContent=hint+'. Thông số gợi ý sẽ được dùng để tạo bảng ở trang chi tiết.'; document.getElementById('preview-type').textContent=labels[val]||val; document.getElementById('bundle-badge').style.display=['Monitor','Keyboard','Mouse','Headphone'].includes(val)?'block':'none'; if(nameInput&&!nameInput.value.trim()) nameInput.placeholder=placeholders[val]||placeholders.Other;}type?.addEventListener('change',()=>{updateTypeUi();updatePreview();});
function updatePreview(){document.getElementById('preview-name').textContent=nameInput?.value.trim()||'Tên linh kiện'; const specs=getSpecs().filter(x=>x.name||x.value).slice(0,6); const box=document.getElementById('preview-specs'); box.innerHTML=specs.length?specs.map(x=>`<tr><td class="text-muted">${esc(x.name||'Thông số')}</td><td>${esc(x.value||'...')}</td></tr>`).join(''):'<tr><td class="text-muted">Chưa có thông số</td></tr>';}
[nameInput,document.getElementById('component-brand'),document.getElementById('component-description')].forEach(x=>x?.addEventListener('input',updatePreview));
const form=document.getElementById('component-form');form?.addEventListener('submit',e=>{let ok=true;function setErr(sel,msg){const el=document.querySelector(sel); if(!el)return; const span=el.parentElement.querySelector('.text-danger'); if(span&&!span.textContent.trim()) span.textContent=msg; el.classList.add('input-validation-error'); ok=false;}document.querySelectorAll('.input-validation-error').forEach(x=>x.classList.remove('input-validation-error')); if(!nameInput.value.trim()) setErr('#component-name','Vui lòng nhập tên linh kiện'); if(!document.querySelector('[name="CategoryId"]').value) setErr('[name="CategoryId"]','Vui lòng chọn danh mục'); if(numeric(document.querySelector('.js-price').value)<=0) setErr('.js-price','Vui lòng nhập giá gốc'); if(numeric(document.querySelector('.js-sale-price').value)>numeric(document.querySelector('.js-price').value)) setErr('.js-sale-price','Giá khuyến mãi không được lớn hơn giá gốc'); if(numeric(document.getElementById('stock-input').value)<0) setErr('#stock-input','Tồn kho không được âm'); if(!ok){e.preventDefault(); window.scrollTo({top:form.offsetTop-80,behavior:'smooth'});}});
const list=document.getElementById('existing-image-list'), order=document.getElementById('existing-image-order-container'); if(list&&order){[...list.querySelectorAll('.apf-image-item')].forEach(item=>{const input=document.createElement('input');input.type='hidden';input.name='ExistingImageOrder';input.value=item.dataset.imageId;order.appendChild(input);});}
updateTypeUi();updatePrice();previews();reindex();
})();
</script>
