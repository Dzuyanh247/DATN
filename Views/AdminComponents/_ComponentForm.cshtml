function renderAutoSpecPreview(items){const body=document.querySelector('#auto-spec-preview tbody');if(!body)return;body.innerHTML=items.length?items.map((x,i)=>`<tr><td><input class="form-control form-control-sm js-preview-name" value="${esc(x.name)}"></td><td><textarea class="form-control form-control-sm js-preview-value" rows="3">${esc(x.value)}</textarea></td><td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger js-preview-remove" data-index="${i}">Xóa</button></td></tr>`).join(''):'<tr><td colspan="3" class="text-muted">Chưa nhận diện được thông số hợp lệ.</td></tr>';}function getPreviewSpecs(){return [...document.querySelectorAll('#auto-spec-preview tbody tr')].map(tr=>({name:tr.querySelector('.js-preview-name')?.value.trim()||'',value:tr.querySelector('.js-preview-value')?.value.trim()||''})).filter(x=>x.name&&x.value);}document.getElementById('detect-auto-specs')?.addEventListener('click',()=>{try{renderAutoSpecPreview(window.parseSpecsFromText(document.getElementById('auto-spec-text')?.value||''));}catch(err){console.error('Lỗi nhận diện thông số:',err);renderAutoSpecPreview([]);}});document.getElementById('auto-spec-text')?.addEventListener('paste',()=>setTimeout(()=>{try{renderAutoSpecPreview(window.parseSpecsFromText(document.getElementById('auto-spec-text')?.value||''));}catch(err){console.error('Lỗi nhận diện thông số:',err);renderAutoSpecPreview([]);}},0));document.getElementById('auto-spec-preview')?.addEventListener('click',e=>{if(e.target.closest('.js-preview-remove')){e.target.closest('tr').remove();}});document.getElementById('import-auto-specs')?.addEventListener('click',()=>{const feedback=document.getElementById('auto-spec-feedback');try{const parsed=getPreviewSpecs().length?getPreviewSpecs():window.parseSpecsFromText(document.getElementById('auto-spec-text')?.value||'');const result=parsed.length?replaceSpecsFromPreview(parsed):{mapped:0};feedback.textContent=parsed.length?`Đã áp dụng ${result.mapped} thông số đúng theo preview.`:'Chưa nhận diện được thông số. Vui lòng kiểm tra nội dung đã dán.';feedback.className=`alert ${parsed.length?'alert-success':'alert-warning'} auto-spec-feedback mb-3`;feedback.style.display='block';const modalEl=document.getElementById('autoSpecModal');if(parsed.length){hideModalSafely(modalEl);}}catch(err){console.error('Lỗi áp dụng thông số:',err);if(feedback){feedback.textContent='Không thể áp dụng thông số. Vui lòng kiểm tra nội dung và thử lại.';feedback.className='alert alert-warning auto-spec-feedback mb-3';feedback.style.display='block';}}});
function numeric(v){return Number((v||'').toString().replace(/[^0-9.]/g,''));}function money(v){const n=numeric(v);return n>0?n.toLocaleString('vi-VN')+' đ':'--';}function updatePrice(){const p=document.querySelector('.js-price')?.value; const s=document.querySelector('.js-sale-price')?.value; const actual=(numeric(s)>0?s:p); const actualEl=document.getElementById('actual-price-preview'); if(actualEl)actualEl.textContent=money(actual);}document.querySelectorAll('.js-price,.js-sale-price').forEach(x=>x.addEventListener('input',updatePrice));
function previews(){const urls=[];const thumb=document.querySelector('.js-image-url')?.value.trim(); if(thumb) urls.push(thumb); (document.querySelector('.js-gallery-urls')?.value||'').split(/\r?\n|,|;/).map(x=>x.trim()).filter(Boolean).forEach(x=>urls.push(x)); const box=document.getElementById('image-preview-grid'); if(!box) return; box.innerHTML=''; [...new Set(urls)].slice(0,8).forEach(u=>{const img=document.createElement('img');img.src=u;img.onerror=function(){this.remove()};box.appendChild(img);});}document.querySelectorAll('.js-image-url,.js-gallery-urls').forEach(x=>x.addEventListener('input',previews));
function appendAddBrandOption(brandSelect){const option=document.createElement('option');option.value='__add_new_brand__';option.textContent='+ Thêm thương hiệu mới';brandSelect.appendChild(option);}
function selectBrandValue(value){const brandSelect=document.getElementById('component-brand');if(!brandSelect)return;const existing=[...brandSelect.options].find(o=>o.value.toLocaleLowerCase('vi-VN')===value.toLocaleLowerCase('vi-VN'));if(existing){existing.selected=true;}else{const addOption=[...brandSelect.options].find(o=>o.value==='__add_new_brand__');const option=document.createElement('option');option.value=value;option.textContent=value;option.selected=true;brandSelect.insertBefore(option,addOption||null);}updatePreview();}
async function loadBrandsForType(){const brandSelect=document.getElementById('component-brand'); if(!brandSelect)return; const current=brandSelect.value==='__add_new_brand__'?'':brandSelect.value; brandSelect.innerHTML='<option value="">Đang tải thương hiệu...</option>'; try{const response=await fetch(`/api/brands?componentType=${encodeURIComponent(type.value||'')}`,{headers:{'Accept':'application/json'}}); if(!response.ok)throw new Error('Không thể tải thương hiệu'); const brands=await response.json(); brandSelect.innerHTML='<option value="">-- Chọn thương hiệu --</option>'; brands.forEach(brand=>{const option=document.createElement('option'); option.value=brand; option.textContent=brand; option.selected=brand.toLocaleLowerCase('vi-VN')===current.toLocaleLowerCase('vi-VN'); brandSelect.appendChild(option);}); if(current&&!brands.some(brand=>brand.toLocaleLowerCase('vi-VN')===current.toLocaleLowerCase('vi-VN'))){const option=document.createElement('option'); option.value=current; option.textContent=current; option.selected=true; brandSelect.appendChild(option);}appendAddBrandOption(brandSelect);}catch{brandSelect.innerHTML='<option value="">-- Không tải được thương hiệu --</option>';appendAddBrandOption(brandSelect);}}

const brandSelect=document.getElementById('component-brand'), brandModalEl=document.getElementById('brandModal'), newBrandInput=document.getElementById('new-brand-name'), newBrandError=document.getElementById('new-brand-error'), brandInlineError=document.getElementById('brand-inline-error');
let previousBrandValue=brandSelect?.value||'';
brandSelect?.addEventListener('focus',()=>{if(brandSelect.value!=='__add_new_brand__')previousBrandValue=brandSelect.value;});
brandSelect?.addEventListener('change',()=>{brandInlineError.textContent='';if(brandSelect.value==='__add_new_brand__'){brandSelect.value=previousBrandValue;newBrandInput.value='';newBrandError.textContent='';showModalSafely(brandModalEl);}else{previousBrandValue=brandSelect.value;updatePreview();}});
document.getElementById('save-new-brand')?.addEventListener('click',async()=>{const name=newBrandInput.value.trim();newBrandError.textContent='';if(!name){newBrandError.textContent='Vui lòng nhập tên thương hiệu.';newBrandInput.focus();return;}const duplicate=[...brandSelect.options].some(o=>o.value&&o.value!=='__add_new_brand__'&&o.value.toLocaleLowerCase('vi-VN')===name.toLocaleLowerCase('vi-VN'));if(duplicate){newBrandError.textContent='Thương hiệu này đã tồn tại.';return;}try{const token=document.querySelector('input[name="__RequestVerificationToken"]')?.value||'';const response=await fetch('/api/brands',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json','RequestVerificationToken':token},body:JSON.stringify({name,componentType:type.value||'OTHER'})});const payload=await response.json().catch(()=>({message:'Không thể lưu thương hiệu. Vui lòng thử lại.'}));if(!response.ok){newBrandError.textContent=payload.message||'Không thể lưu thương hiệu. Vui lòng thử lại.';return;}selectBrandValue(payload.name||name);previousBrandValue=payload.name||name;hideModalSafely(brandModalEl);}catch{newBrandError.textContent='Không thể lưu thương hiệu. Vui lòng thử lại.';}});

function updateTypeUi(){const val=type.value||'OTHER'; const hint=usage[val]||'Dùng cho: Danh mục linh kiện máy tính'; const hintEl=document.getElementById('component-use-hint'); if(hintEl)hintEl.textContent=hint; if(nameInput&&!nameInput.value.trim()) nameInput.placeholder=placeholders[val]||placeholders.OTHER;}type?.addEventListener('change',()=>{updateTypeUi();loadBrandsForType();updatePreview();});
function updatePreview(){syncHidden();}
[nameInput,document.getElementById('component-brand'),document.getElementById('component-description')].forEach(x=>x?.addEventListener('input',updatePreview));
const form=document.getElementById('component-form');form?.addEventListener('submit',e=>{let ok=true;function setErr(sel,msg){const el=document.querySelector(sel); if(!el)return; const span=el.parentElement.querySelector('.text-danger'); if(span&&!span.textContent.trim()) span.textContent=msg; el.classList.add('input-validation-error'); ok=false;}document.querySelectorAll('.input-validation-error').forEach(x=>x.classList.remove('input-validation-error')); if(!nameInput.value.trim()) setErr('#component-name','Vui lòng nhập tên linh kiện'); if(numeric(document.querySelector('.js-price').value)<=0) setErr('.js-price','Vui lòng nhập giá gốc'); if(numeric(document.querySelector('.js-sale-price').value)>numeric(document.querySelector('.js-price').value)) setErr('.js-sale-price','Giá khuyến mãi không được lớn hơn giá gốc'); if(numeric(document.getElementById('stock-input').value)<0) setErr('#stock-input','Tồn kho không được âm'); if(!ok){e.preventDefault();}});
const list=document.getElementById('existing-image-list'), order=document.getElementById('existing-image-order-container'); if(list&&order){[...list.querySelectorAll('.apf-image-item')].forEach(item=>{const input=document.createElement('input');input.type='hidden';input.name='ExistingImageOrder';input.value=item.dataset.imageId;order.appendChild(input);});}
updateTypeUi();updatePrice();previews();reindex();
})();
</script>

