@model Datn.PcStore.ViewModels.AdminComponentUpsertVm
@{
    var isEdit = Model.Id > 0;
    var orderedImages = Model.ExistingImages.OrderBy(x => x.SortOrder).ToList();
    var hasErrors = ViewData.ModelState.Values.Any(v => v.Errors.Any());
    var orderedTypes = Datn.PcStore.Models.ComponentTypes.All;
}

<style>
.admin-product-form .validation-summary-valid{display:none}
.component-form-header{background:#fff;border:1px solid #e5e7eb;border-radius:16px;padding:1rem 1.25rem;margin-bottom:1rem;box-shadow:0 8px 22px rgba(15,23,42,.04)}
.component-form-header h2{font-weight:750;color:#0f172a;margin:0}
.component-form-header p{color:#64748b;margin:.25rem 0 0}
.admin-component-form-layout{align-items:flex-start;gap:1rem}
.admin-component-form-layout .admin-form-card,.admin-component-form-layout .admin-actions-card{background:#fff;border:1px solid #e5e7eb;border-radius:16px;padding:1rem;box-shadow:0 8px 20px rgba(15,23,42,.04)}
.admin-component-form-layout .admin-card-title{font-size:1rem;font-weight:700;color:#0f172a;margin-bottom:.75rem;display:flex;align-items:center}
.ux-help{color:#64748b;font-size:.9rem}
.required-mark{color:#dc2626}
.actual-price-box{background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:.75rem}
.image-preview-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(86px,1fr));gap:.6rem}
.image-preview-grid img{width:100%;height:86px;object-fit:cover;border-radius:10px;border:1px solid #e5e7eb;background:#f8fafc}
.spec-kv-table th{font-size:.8rem;color:#475569;font-weight:700;background:#f8fafc}
.spec-kv-table td{vertical-align:middle}
.sticky-actions{position:sticky;bottom:0;z-index:10;background:#fff;border:1px solid #e5e7eb;border-radius:16px;padding:1rem;margin-top:1rem;box-shadow:0 -6px 18px rgba(15,23,42,.05)}
.admin-component-side-sticky{position:sticky;top:1rem}
.quick-chip{border-radius:999px}
.comp-use-badge{display:inline-flex;align-items:center;border-radius:999px;padding:.3rem .55rem;background:#f8fafc;color:#475569;border:1px solid #e2e8f0;font-weight:600;font-size:.85rem}
.example-spec-box{display:none;background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:.75rem}
.auto-spec-feedback{display:none}
.field-validation-error{display:block;margin-top:.25rem;font-size:.875rem}
.input-validation-error{border-color:#dc3545}
.apf-image-list{display:grid;gap:.65rem}
.apf-image-item{display:flex;gap:.75rem;align-items:center;border:1px solid #e5e7eb;border-radius:12px;padding:.5rem;background:#fff}
.apf-image-item img{width:72px;height:72px;object-fit:cover;border-radius:10px}
.auto-spec-preview-wrap{max-height:320px;overflow:auto;border:1px solid #e5e7eb;border-radius:12px}
.modal-backdrop{z-index:1050}
.modal{z-index:1060}
.modal-dialog{position:relative;z-index:1061}
@@media (max-width: 991.98px){.admin-component-side-sticky{position:static}.sticky-actions{position:static}}
@@media (max-width: 575.98px){.component-form-header{padding:1rem}.sticky-actions .btn{width:100%}}
</style>

<div class="component-form-header d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <h2>@(isEdit ? "Cập nhật linh kiện" : "Thêm linh kiện")</h2>
        <p>Nhập thông tin cơ bản, phân loại, giá bán và thông số kỹ thuật của linh kiện.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại danh sách</a>
</div>

<form asp-controller="AdminComponents" asp-action="@(isEdit ? "Edit" : "Create")" method="post" class="admin-product-form" id="component-form" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" /><input type="hidden" asp-for="ProductType" value="Component" /><input type="hidden" asp-for="CategoryId" /><input type="hidden" asp-for="Specifications" id="Specifications" />
    @if (hasErrors) { <div asp-validation-summary="All" class="alert alert-danger mb-3" role="alert"></div> }
    @if (TempData["ErrorMessage"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage)) { <div class="alert alert-warning mb-3" role="alert">@errorMessage</div> }

    <div class="admin-two-column-form admin-component-form-layout">
        <div class="admin-main-column">
            <div class="admin-form-card mb-4">
                <h5 class="admin-card-title"><i class="bi bi-box-seam me-2"></i>Thông tin linh kiện</h5>
                <p class="ux-help mb-3">Các trường có dấu * là bắt buộc. Mã sản phẩm có thể bỏ trống để hệ thống tự tạo.</p>
                <div class="admin-form-grid">
                    <div class="admin-field-full"><label asp-for="Name" class="form-label">Tên linh kiện <span class="required-mark">*</span></label><input asp-for="Name" class="form-control" id="component-name" placeholder="VD: Card màn hình Colorful GeForce RTX 3060 12GB" /><span asp-validation-for="Name" class="text-danger"></span></div>
                    <div class="admin-field-sm"><label asp-for="ProductCode" class="form-label">Mã sản phẩm <span class="text-muted">(không bắt buộc)</span></label><input asp-for="ProductCode" class="form-control" placeholder="Tự tạo nếu trống" /><span asp-validation-for="ProductCode" class="text-danger"></span></div>
                    <div class="admin-field-full"><div class="form-check admin-status-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Trạng thái đang kinh doanh</label></div><div class="form-text">Tắt trạng thái nếu muốn lưu nháp hoặc tạm ngừng bán.</div></div>
                </div>
            </div>

            <div class="admin-form-card mb-4">
                <h5 class="admin-card-title"><i class="bi bi-images me-2"></i>Hình ảnh</h5>
                <div class="admin-form-grid">
                    @if (orderedImages.Any()) { <div class="admin-field-full"><label class="form-label">Ảnh hiện có</label><div class="apf-image-list mb-3" id="existing-image-list">@foreach (var image in orderedImages) { <div class="apf-image-item" data-image-id="@image.Id"><img src="@image.ImageUrl" alt="Ảnh linh kiện" onerror="this.onerror=null;this.src='/images/no-image.png';" /><div><span class="badge text-bg-warning apf-primary-badge">Ảnh đại diện</span><label class="form-check-label text-danger small d-block mt-2"><input class="form-check-input" type="checkbox" name="RemoveImageIds" value="@image.Id" /> Xóa</label></div></div> }</div></div> }
                    <div class="admin-field-full">
                        <div class="admin-image-manager-grid">
                            <div class="admin-image-pane"><h6 class="fw-bold mb-3">Ảnh bằng URL</h6><label asp-for="ThumbnailImageUrl" class="form-label">URL ảnh đại diện <span class="required-mark">*</span></label><input asp-for="ThumbnailImageUrl" class="form-control js-image-url" placeholder="https://..." /><span asp-validation-for="ThumbnailImageUrl" class="text-danger"></span><label asp-for="ProductImageUrlsText" class="form-label mt-3">Thư viện ảnh</label><textarea asp-for="ProductImageUrlsText" rows="5" class="form-control js-gallery-urls" placeholder="Mỗi URL ảnh trên một dòng"></textarea><span asp-validation-for="ProductImageUrlsText" class="text-danger"></span><div id="existing-image-order-container"></div></div>
                            <div class="admin-image-pane admin-image-preview-section" data-admin-image-manager="product" data-primary-target="#ThumbnailImageUrl" data-gallery-target="#ProductImageUrlsText"><h6 class="fw-bold mb-3">Quản lý ảnh</h6><div class="admin-image-preview-title">Ảnh đại diện</div><div data-aim-primary></div><div class="admin-image-preview-title mt-3">Thư viện ảnh sản phẩm</div><div class="admin-image-gallery-grid" data-aim-gallery></div>@await Html.PartialAsync("_AdminImageUploader", new AdminImageUploaderViewModel { FieldName = "#ThumbnailImageUrl", GalleryFieldName = "#ProductImageUrlsText", Multiple = true, Value = Model.ThumbnailImageUrl, Hidden = true, Label = "Ảnh linh kiện" })</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="admin-form-card mb-4">
                <h5 class="admin-card-title"><i class="bi bi-card-text me-2"></i>Mô tả</h5>
                <label class="form-label">Mô tả ngắn / mô tả chi tiết</label><textarea asp-for="Description" rows="8" class="form-control" id="component-description" placeholder="Tóm tắt ưu điểm, tình trạng, nội dung nổi bật của linh kiện"></textarea><div class="form-text">Dòng đầu tiên sẽ được dùng làm mô tả ngắn.</div><span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="admin-form-card mb-4"><h5 class="admin-card-title"><i class="bi bi-cpu me-2"></i>Thông số kỹ thuật</h5><p class="ux-help">Thông số nhập ở đây sẽ hiển thị thành bảng ở trang chi tiết sản phẩm.</p><div class="d-flex flex-wrap gap-2 mb-3"><button type="button" class="btn btn-outline-primary" id="apply-spec-template"><i class="bi bi-magic"></i> Gợi ý theo loại</button><button type="button" class="btn btn-outline-success" id="open-auto-spec-import"><i class="bi bi-clipboard-data"></i> Dán & tự nhận diện thông số</button><button type="button" class="btn btn-outline-secondary" id="add-spec-row">Thêm thông số</button><button type="button" class="btn btn-outline-danger" id="clear-empty-specs">Xóa dòng trống</button><button type="button" class="btn btn-outline-info" id="toggle-example-specs">Xem ví dụ</button></div><div class="alert alert-success auto-spec-feedback mb-3" id="auto-spec-feedback" role="alert"></div><div class="d-flex flex-wrap gap-2 mb-3"><button type="button" class="btn btn-sm btn-light border quick-chip" data-chip="Thương hiệu">+ Thương hiệu</button><button type="button" class="btn btn-sm btn-light border quick-chip" data-chip="Kích thước">+ Kích thước</button><button type="button" class="btn btn-sm btn-light border quick-chip" data-chip="Bộ nhớ">+ Bộ nhớ</button><button type="button" class="btn btn-sm btn-light border quick-chip" data-chip="Kết nối">+ Kết nối</button><button type="button" class="btn btn-sm btn-light border quick-chip" data-chip="Bảo hành">+ Bảo hành</button></div><div class="example-spec-box mb-3" id="example-spec-box"><strong>Ví dụ hiển thị ngoài trang chi tiết</strong><table class="table table-sm mt-2 mb-0"><tbody><tr><td>Sản phẩm</td><td>Card màn hình RTX 3060 12GB</td></tr><tr><td>Bộ nhớ</td><td>12GB GDDR6</td></tr><tr><td>Kết nối</td><td>HDMI, DisplayPort</td></tr></tbody></table></div><div class="table-responsive"><table class="table table-sm spec-kv-table" id="spec-kv-table"><thead><tr><th style="width:30%">Tên thông số</th><th>Giá trị</th><th class="text-center" style="width:110px">Filterable</th><th class="text-center" style="width:90px">Xóa</th></tr></thead><tbody>@for (var i = 0; i < Model.SpecificationItems.Count; i++){<tr><td><input class="form-control form-control-sm js-spec-name" name="SpecificationItems[@i].Name" value="@Model.SpecificationItems[i].Name" placeholder="VD: Bộ nhớ" /></td><td><textarea class="form-control form-control-sm js-spec-value" name="SpecificationItems[@i].Value" rows="2" placeholder="VD: 12GB GDDR6">@Model.SpecificationItems[i].Value</textarea></td><td class="text-center"><input class="form-check-input js-spec-filterable" type="checkbox" name="SpecificationItems[@i].IsFilterable" value="true" @(Model.SpecificationItems[i].IsFilterable ? "checked" : null) /><input type="hidden" name="SpecificationItems[@i].IsFilterable" value="false" /></td><td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger js-remove-spec-row">Xóa</button></td></tr>}</tbody></table></div><span asp-validation-for="Specifications" class="text-danger"></span></div>
        </div>

        <aside class="admin-side-column">
            <div class="admin-component-side-sticky">
                <div class="admin-form-card mb-4"><h5 class="admin-card-title"><i class="bi bi-diagram-3 me-2"></i>Phân loại</h5><p class="ux-help">Sản phẩm tạo tại trang này tự thuộc danh mục “Linh kiện”.</p><div class="admin-form-grid"><div class="admin-field-full"><label asp-for="ComponentType" class="form-label">Loại / nhánh linh kiện <span class="required-mark">*</span></label><select asp-for="ComponentType" class="form-select" id="component-type-select"><option value="">-- Chọn loại linh kiện --</option>@foreach (var value in orderedTypes){<option value="@value" selected="@(Model.ComponentType == value)">@Datn.PcStore.Models.ComponentTypes.GetLabel(value)</option>}</select><span asp-validation-for="ComponentType" class="text-danger"></span><div class="mt-2"><span class="comp-use-badge" id="component-use-hint">Dùng cho: Danh mục linh kiện máy tính</span></div></div><div class="admin-field-full"><label asp-for="Brand" class="form-label">Thương hiệu</label><select asp-for="Brand" class="form-select" id="component-brand"><option value="">-- Chọn thương hiệu --</option>@foreach (var brand in Model.BrandOptions){<option value="@brand" selected="@(string.Equals(Model.Brand, brand, StringComparison.OrdinalIgnoreCase))">@brand</option>}@if (!string.IsNullOrWhiteSpace(Model.Brand) && !Model.BrandOptions.Contains(Model.Brand, StringComparer.OrdinalIgnoreCase)){<option value="@Model.Brand" selected>@Model.Brand</option>}<option value="__add_new_brand__">+ Thêm thương hiệu mới</option></select><div class="form-text">Có thể bỏ trống hoặc bấm “+ Thêm thương hiệu mới”.</div><div class="text-danger small mt-1" id="brand-inline-error"></div><span asp-validation-for="Brand" class="text-danger"></span></div></div></div>
                <div class="admin-form-card mb-4"><h5 class="admin-card-title"><i class="bi bi-cash-coin me-2"></i>Giá bán & kho</h5><div class="admin-form-grid"><div class="admin-field-full"><label asp-for="Price" class="form-label">Giá gốc <span class="required-mark">*</span></label><input asp-for="Price" class="form-control js-price" min="1000" placeholder="VD: 3500000" /><span asp-validation-for="Price" class="text-danger"></span></div><div class="admin-field-full"><label asp-for="DiscountPrice" class="form-label">Giá khuyến mãi <span class="text-muted">(không bắt buộc)</span></label><input asp-for="DiscountPrice" class="form-control js-sale-price" min="0" placeholder="Nhỏ hơn giá gốc" /><span asp-validation-for="DiscountPrice" class="text-danger"></span></div><div class="admin-field-sm admin-field-number"><label asp-for="StockQuantity" class="form-label">Tồn kho <span class="required-mark">*</span></label><input asp-for="StockQuantity" class="form-control" type="number" id="stock-input" min="0" placeholder="0" /><span asp-validation-for="StockQuantity" class="text-danger"></span></div><div class="admin-field-sm admin-field-number"><label asp-for="WarrantyMonths" class="form-label">Bảo hành (tháng) <span class="required-mark">*</span></label><input asp-for="WarrantyMonths" class="form-control" type="number" min="0" placeholder="VD: 36" /><span asp-validation-for="WarrantyMonths" class="text-danger"></span></div><div class="admin-field-full"><div class="actual-price-box"><span class="text-muted">Giá bán thực tế tự tính:</span> <strong id="actual-price-preview">--</strong><div class="form-text">Nếu có giá khuyến mãi, website dùng giá khuyến mãi làm giá bán.</div></div></div></div></div>
                <div class="admin-actions-card sticky-actions d-flex flex-column gap-3"><div class="text-muted small">Kiểm tra các trường bắt buộc trước khi lưu.</div><div class="d-grid gap-2"><button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Lưu linh kiện</button><button type="submit" class="btn btn-outline-primary" disabled title="Chức năng sẽ được tách ở luồng lưu riêng">Lưu & thêm tiếp</button><a asp-action="Index" class="btn btn-outline-secondary">Hủy</a></div></div>
            </div>
        </aside>
    </div>
</form>
<div class="modal fade" id="autoSpecModal" tabindex="-1" aria-labelledby="autoSpecModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title" id="autoSpecModalLabel">Dán & tự nhận diện thông số</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
            <div class="modal-body">
                <textarea id="auto-spec-text" rows="16" class="form-control" placeholder="Dán toàn bộ thông số kỹ thuật từ website nhà sản xuất hoặc cửa hàng.&#10;&#10;Ví dụ:&#10;&#10;Thương hiệu&#10;Intel&#10;&#10;Loại CPU&#10;Dành cho máy bàn&#10;&#10;Thế hệ&#10;Core i3 Thế hệ thứ 12&#10;&#10;Tên gọi&#10;Core i3-12100&#10;&#10;Socket&#10;FCLGA 1700&#10;&#10;Tên thế hệ&#10;Alder Lake&#10;&#10;Số nhân&#10;4&#10;&#10;Số luồng&#10;8&#10;&#10;Tốc độ cơ bản&#10;Performance-core Max Turbo Frequency: 4.3 GHz&#10;&#10;Performance-core Base Frequency: 3.30 GHz&#10;&#10;Cache&#10;12MB&#10;&#10;TDP&#10;58W&#10;&#10;Tản nhiệt&#10;Mặc định đi kèm"></textarea>
                <div class="form-text">Bấm “Tự nhận diện” để chuẩn hóa dòng trống, bỏ heading và xem trước dạng key-value trước khi áp dụng.</div>
                <div class="d-flex justify-content-between align-items-center mt-3 mb-2"><strong>Preview thông số nhận diện</strong><button type="button" class="btn btn-sm btn-outline-primary" id="detect-auto-specs">Tự nhận diện</button></div>
                <div class="table-responsive auto-spec-preview-wrap"><table class="table table-sm table-bordered mb-0" id="auto-spec-preview"><thead><tr><th style="width:35%">Thông số</th><th>Giá trị</th><th class="text-center" style="width:80px">Xóa</th></tr></thead><tbody><tr><td colspan="3" class="text-muted">Chưa có dữ liệu preview.</td></tr></tbody></table></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button><button type="button" class="btn btn-primary" id="import-auto-specs">Áp dụng</button></div>
        </div>
    </div>
</div>

<div class="modal fade" id="brandModal" tabindex="-1" aria-labelledby="brandModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title" id="brandModalLabel">Thêm thương hiệu mới</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
            <div class="modal-body">
                <label class="form-label" for="new-brand-name">Tên thương hiệu <span class="required-mark">*</span></label>
                <input class="form-control" id="new-brand-name" maxlength="80" placeholder="VD: ASUS, Corsair, Logitech" />
                <div class="text-danger small mt-2" id="new-brand-error"></div>
                <div class="form-text">Thương hiệu sẽ được lưu theo loại linh kiện đang chọn.</div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button><button type="button" class="btn btn-primary" id="save-new-brand">Lưu</button></div>
        </div>
    </div>
</div>
<partial name="_ValidationScriptsPartial" />
<script>
(function(){
const templates={
CPU:['Thương hiệu','Model','Socket','Thế hệ','Số nhân','Số luồng','Xung nhịp cơ bản','Xung nhịp tối đa','Cache','Hỗ trợ RAM','Nhân đồ họa tích hợp','PCI Express','TDP','Tản nhiệt đi kèm'],
VGA:['Thương hiệu','Model GPU','Bộ nhớ','Loại bộ nhớ','Bus bộ nhớ','CUDA Core','Engine Clock','Kết nối xuất hình','Kích thước','PSU đề nghị','Power Connector','DirectX'],
MAINBOARD:['Thương hiệu','Socket','Chipset','Kích thước','Khe RAM','Loại RAM hỗ trợ','Số khe PCIe','Khe M.2','SATA','Cổng xuất hình','LAN','WiFi/Bluetooth','Cổng kết nối sau'],
RAM:['Thương hiệu','Dung lượng','Loại RAM','Bus','Số thanh','Độ trễ','Điện áp','Tản nhiệt','RGB'],
STORAGE:['Thương hiệu','Dung lượng','Chuẩn kết nối','Form Factor','Tốc độ đọc','Tốc độ ghi','NAND','TBW','Tốc độ vòng quay','Cache','Bảo hành'],
PSU:['Thương hiệu','Công suất','Chuẩn hiệu suất','Chuẩn nguồn','Modular','Kích thước quạt','Cổng cấp nguồn','Bảo hành'],
CASE:['Thương hiệu','Kích thước case','Hỗ trợ mainboard','Khe ổ cứng','Cổng I/O','Hỗ trợ VGA tối đa','Hỗ trợ tản CPU tối đa','Fan đi kèm','Hỗ trợ radiator'],
MONITOR:['Thương hiệu','Kích thước','Độ phân giải','Tấm nền','Tần số quét','Thời gian phản hồi','Độ sáng','Cổng kết nối','Công nghệ đồng bộ','Bảo hành'],
KEYBOARD:['Thương hiệu','Loại bàn phím','Switch','Layout','Kết nối','Keycap','Đèn nền','Bảo hành'],
MOUSE:['Thương hiệu','Cảm biến','DPI','Kết nối','Số nút','Trọng lượng','Đèn RGB','Bảo hành'],
HEADPHONE:['Thương hiệu','Kiểu tai nghe','Kết nối','Driver','Microphone','Âm thanh vòm','Trọng lượng','Bảo hành'],
COOLER:['Thương hiệu','Loại tản nhiệt','Socket hỗ trợ','Kích thước','Tốc độ quạt','TDP hỗ trợ','Đèn RGB','Bảo hành'],
MONITOR_ARM:['Thương hiệu','Tải trọng','Kích thước màn hình hỗ trợ','Chuẩn VESA','Chất liệu','Bảo hành'],
OTHER:['Thương hiệu','Model','Bảo hành']};
const aliasMap={
