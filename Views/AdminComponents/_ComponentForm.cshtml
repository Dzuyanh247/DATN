brandSelect?.addEventListener('change',()=>{brandInlineError.textContent='';if(brandSelect.value==='__add_new_brand__'){brandSelect.value=previousBrandValue;newBrandInput.value='';newBrandError.textContent='';if(window.bootstrap?.Modal)bootstrap.Modal.getOrCreateInstance(brandModalEl).show();else brandModalEl.style.display='block';}else{previousBrandValue=brandSelect.value;updatePreview();}});
document.getElementById('save-new-brand')?.addEventListener('click',async()=>{const name=newBrandInput.value.trim();newBrandError.textContent='';if(!name){newBrandError.textContent='Vui lòng nhập tên thương hiệu.';newBrandInput.focus();return;}const duplicate=[...brandSelect.options].some(o=>o.value&&o.value!=='__add_new_brand__'&&o.value.toLocaleLowerCase('vi-VN')===name.toLocaleLowerCase('vi-VN'));if(duplicate){newBrandError.textContent='Thương hiệu này đã tồn tại.';return;}try{const token=document.querySelector('input[name="__RequestVerificationToken"]')?.value||'';const response=await fetch('/api/brands',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json','RequestVerificationToken':token},body:JSON.stringify({name,componentType:type.value||'Other'})});const payload=await response.json().catch(()=>({message:'Không thể lưu thương hiệu. Vui lòng thử lại.'}));if(!response.ok){newBrandError.textContent=payload.message||'Không thể lưu thương hiệu. Vui lòng thử lại.';return;}selectBrandValue(payload.name||name);previousBrandValue=payload.name||name;if(window.bootstrap?.Modal)bootstrap.Modal.getOrCreateInstance(brandModalEl).hide();else brandModalEl.style.display='none';}catch{newBrandError.textContent='Không thể lưu thương hiệu. Vui lòng thử lại.';}});

function updateTypeUi(){const val=type.value||'Other'; const hint=usage[val]||'Dùng cho: Danh mục linh kiện máy tính'; document.getElementById('component-use-hint').textContent=hint; document.getElementById('side-help').textContent=hint+'. Thông số gợi ý sẽ được dùng để tạo bảng ở trang chi tiết.'; document.getElementById('preview-type').textContent=labels[val]||val; document.getElementById('bundle-badge').style.display=['Monitor','Keyboard','Mouse','Headphone'].includes(val)?'block':'none'; if(nameInput&&!nameInput.value.trim()) nameInput.placeholder=placeholders[val]||placeholders.Other;}type?.addEventListener('change',()=>{updateTypeUi();loadBrandsForType();applyTemplate();updatePreview();});
function updatePreview(){document.getElementById('preview-name').textContent=nameInput?.value.trim()||'Tên linh kiện'; const specs=getSpecs().filter(x=>x.name||x.value).slice(0,6); const box=document.getElementById('preview-specs'); box.innerHTML=specs.length?specs.map(x=>`<tr><td class="text-muted">${esc(x.name||'Thông số')}</td><td>${esc(x.value||'...')}</td></tr>`).join(''):'<tr><td class="text-muted">Chưa có thông số</td></tr>';}
[nameInput,document.getElementById('component-brand'),document.getElementById('component-description')].forEach(x=>x?.addEventListener('input',updatePreview));
const form=document.getElementById('component-form');form?.addEventListener('submit',e=>{let ok=true;function setErr(sel,msg){const el=document.querySelector(sel); if(!el)return; const span=el.parentElement.querySelector('.text-danger'); if(span&&!span.textContent.trim()) span.textContent=msg; el.classList.add('input-validation-error'); ok=false;}document.querySelectorAll('.input-validation-error').forEach(x=>x.classList.remove('input-validation-error')); if(!nameInput.value.trim()) setErr('#component-name','Vui lòng nhập tên linh kiện'); if(numeric(document.querySelector('.js-price').value)<=0) setErr('.js-price','Vui lòng nhập giá gốc'); if(numeric(document.querySelector('.js-sale-price').value)>numeric(document.querySelector('.js-price').value)) setErr('.js-sale-price','Giá khuyến mãi không được lớn hơn giá gốc'); if(numeric(document.getElementById('stock-input').value)<0) setErr('#stock-input','Tồn kho không được âm'); if(!ok){e.preventDefault(); window.scrollTo({top:form.offsetTop-80,behavior:'smooth'});}});
const list=document.getElementById('existing-image-list'), order=document.getElementById('existing-image-order-container'); if(list&&order){[...list.querySelectorAll('.apf-image-item')].forEach(item=>{const input=document.createElement('input');input.type='hidden';input.name='ExistingImageOrder';input.value=item.dataset.imageId;order.appendChild(input);});}
updateTypeUi();updatePrice();previews();reindex();
})();
</script>
