const tbody=document.querySelector('#spec-kv-table tbody'), type=document.getElementById('component-type-select'), nameInput=document.getElementById('component-name');
function esc(v){return (v||'').replaceAll('&','&amp;').replaceAll('\"','&quot;').replaceAll('<','&lt;').replaceAll('>','&gt;')}function isFilterableByDefault(name){const allowed={CPU:['thương hiệu','socket','số nhân','số luồng','tdp'],MAINBOARD:['tên hãng','cpu hỗ trợ','chipset','ram hỗ trợ','kích cỡ'],VGA:['hãng sản xuất','engine đồ họa','bộ nhớ','kết nối','psu đề nghị'],STORAGE:['dung lượng ổ cứng','form factor','chuẩn kết nối','nand'],PSU:['thương hiệu','công suất','hiệu suất','chuẩn nguồn','công suất cpu hỗ trợ']};const list=allowed[type?.value]||[];const n=(name||'').trim().toLocaleLowerCase('vi-VN');return list.some(k=>n===k);}function row(name='',value='',isFilterable=null){const checked=(isFilterable??isFilterableByDefault(name))?'checked':'';const tr=document.createElement('tr');tr.innerHTML=`<td><input class="form-control form-control-sm js-spec-name" placeholder="VD: Bộ nhớ" value="${esc(name)}"></td><td><textarea class="form-control form-control-sm js-spec-value" rows="2" placeholder="VD: 12GB GDDR6">${esc(value)}</textarea></td><td class="text-center"><input class="form-check-input js-spec-filterable" type="checkbox" value="true" ${checked}><input type="hidden" value="false"></td><td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger js-remove-spec-row">Xóa</button></td>`;tbody.appendChild(tr); reindex();}
function reindex(){[...tbody.querySelectorAll('tr')].forEach((tr,i)=>{tr.querySelector('.js-spec-name').name=`SpecificationItems[${i}].Name`;tr.querySelector('.js-spec-value').name=`SpecificationItems[${i}].Value`;const cb=tr.querySelector('.js-spec-filterable');const hidden=cb?.nextElementSibling;if(cb)cb.name=`SpecificationItems[${i}].IsFilterable`;if(hidden)hidden.name=`SpecificationItems[${i}].IsFilterable`;}); syncHidden(); updatePreview();}
function syncHidden(){const items=getSpecs().filter(x=>x.name||x.value);document.getElementById('Specifications').value=JSON.stringify(items);}function getSpecs(){return [...tbody.querySelectorAll('tr')].map(tr=>({name:tr.querySelector('.js-spec-name').value.trim(),value:tr.querySelector('.js-spec-value').value.trim(),isFilterable:tr.querySelector('.js-spec-filterable')?.checked||false}));}
function applyTemplate(){const keys=templates[type.value]||templates.OTHER; const existing=new Set([...tbody.querySelectorAll('.js-spec-name')].map(x=>x.value.trim().toLocaleLowerCase('vi-VN'))); keys.forEach(k=>{if(!existing.has(k.toLocaleLowerCase('vi-VN'))) row(k,'');});}
const specStartPattern=/^(thông\s*số\s*kỹ\s*thuật|specifications?|technical\s+specifications)$/i;
const stopHeadingPattern=/^(xem\s*thêm|sản phẩm tương tự|giao hàng toàn quốc|đổi trả dễ dàng|thanh toán tiện lợi|hỗ trợ nhiệt tình|trải nghiệm mua sắm|hệ thống showroom|về ttg shop|thông tin liên hệ|chính sách|copyright|danh mục sản phẩm|trang chủ|hotline|giỏ hàng|đặt hàng|thêm vào giỏ)$/i;
const groupHeadingPattern=/^(điều kiện vận hành|cấu hình khuyến nghị|thông số nguồn điện|thông số hỗ trợ bộ xử lý|thông tin chung|general|details)$/i;
const noisePattern=/(tìm kiếm sản phẩm|tất cả danh mục|hotline mua hàng|mô tả sản phẩm|số lượng|đặt hàng|thêm vào giỏ|sản phẩm tương tự|footer|showroom|copyright|giỏ hàng|trang chủ)/i;
const valueHintPattern=/(\d|gb|mb|tb|ghz|mhz|w\b|v\b|hz|rpm|mm|cm|inch|core|thread|ddr|pcie|nvme|sata|usb|hdmi|displayport|wi-?fi|bluetooth|lga|am\d|atx|itx|ips|oled|va|tn|gddr|cuda|rgb|pwm|iops|tbw|hmb|qlc|mlc|tlc|yes|no|có|không|®|™|≥|°)/i;
function cleanSpecLine(line){return (line||'').replace(/^[\s•\-–—*]+/,'').replace(/[ \t]+/g,' ').trim();}
function normalizeSpecText(text){return (text||'').replace(/\r/g,'');}
function isStopLine(line){const cleaned=cleanSpecLine(line).replace(/[:：\-–—]+$/,'').trim();return stopHeadingPattern.test(cleaned)||noisePattern.test(cleaned);}
function isNoiseLine(line){const cleaned=cleanSpecLine(line).replace(/[:：\-–—]+$/,'').trim();return !cleaned||isStopLine(cleaned)||specStartPattern.test(cleaned)||groupHeadingPattern.test(cleaned);}
function isGroupHeading(line){const cleaned=cleanSpecLine(line).replace(/[:：\-–—]+$/,'').trim();return groupHeadingPattern.test(cleaned)||(/^[A-ZÀ-Ỹ0-9\s\/()\-]{8,}$/.test(cleaned)&&!valueHintPattern.test(cleaned));}
function looksLikeName(line,nextLine){const cleaned=cleanSpecLine(line);if(!cleaned||isNoiseLine(cleaned)||isGroupHeading(cleaned)||/^\d/.test(cleaned)||/[.!?]$/.test(cleaned)||cleaned.length>=80)return false;if(/[:：]\s*\S|(?:\s[-–—]\s)\S/.test(cleaned))return false;if(valueHintPattern.test(cleaned)&&!/^(sản phẩm|tên hãng|hãng sản xuất|model|socket|chipset|cpu hỗ trợ|ram hỗ trợ|form factor|chuẩn kết nối|dung lượng ổ cứng|dram|nand|bảo hành|kích thước|kết nối|directx|mtbf|hiệu suất|tần số)$/i.test(cleaned))return false;return true;}
function mergeSpecValues(current,next){const values=(current||'').split(/\s*;\s*|\n+/).map(cleanSpecLine).filter(Boolean);String(next||'').split(/\n+/).map(cleanSpecLine).filter(Boolean).forEach(v=>{if(!values.some(x=>x.toLocaleLowerCase('vi-VN')===v.toLocaleLowerCase('vi-VN')))values.push(v);});return values.join('; ');}
function pushParsedSpec(items,name,value){name=cleanSpecLine(name).replace(/[:：\-–—]+$/,'').trim();value=(value||'').split(/\n+/).map(cleanSpecLine).filter(Boolean).join('\n');if(!name||!value||isNoiseLine(name)||isNoiseLine(value)||isGroupHeading(name))return;const existing=items.find(x=>x.name.toLocaleLowerCase('vi-VN')===name.toLocaleLowerCase('vi-VN'));if(existing)existing.value=mergeSpecValues(existing.value,value);else items.push({name,value});}
function splitSpecRegions(text){const all=(text||'').replace(/\r/g,'').split('\n').map(x=>x.trimEnd());const starts=[];all.forEach((line,i)=>{if(specStartPattern.test(cleanSpecLine(line).replace(/[:：\-–—]+$/,'')))starts.push(i+1);});if(!starts.length)return [all.join('\n')];return starts.map(start=>{const out=[];for(let i=start;i<all.length;i++){if(i>start&&specStartPattern.test(cleanSpecLine(all[i]).replace(/[:：\-–—]+$/,'')))break;if(isStopLine(all[i]))break;out.push(all[i]);}return out.join('\n');}).filter(Boolean);}
function parseSpecRegion(text){const rawLines=normalizeSpecText(text).split(/\n+/).map(x=>x.trim()).filter(Boolean);const items=[];let pendingName='',pendingValues=[];function flush(){if(pendingName&&pendingValues.length)pushParsedSpec(items,pendingName,pendingValues.join('\n'));pendingName='';pendingValues=[];}for(let i=0;i<rawLines.length;i++){const raw=rawLines[i];const line=cleanSpecLine(raw);if(isStopLine(line))break;if(isNoiseLine(line)||isGroupHeading(line)){flush();continue;}const multi=raw.match(/^(.{1,80}?)(?:\t|\s{2,})(\S.+)$/);const inline=multi||line.match(/^(.{1,80}?)[\s]*[:：][\s]*(.+)$/)||line.match(/^(.{1,80}?)[\s]+[-–—][\s]+(.+)$/);if(inline&&!isNoiseLine(inline[1])&&!isGroupHeading(inline[1])){flush();pushParsedSpec(items,inline[1],inline[2]);continue;}const next=cleanSpecLine(rawLines[i+1]||'');if(looksLikeName(line,next)){flush();pendingName=line;continue;}if(pendingName)pendingValues.push(line);}flush();return items;}
window.parseSpecsFromText=function(text){const regions=splitSpecRegions(text);const scored=regions.map(region=>{const items=parseSpecRegion(region);return {items,score:items.length*10+(region.match(/\t|\s{2,}/g)||[]).length};}).sort((a,b)=>b.score-a.score);const merged=[];scored.forEach(r=>r.items.forEach(x=>pushParsedSpec(merged,x.name,x.value)));return merged;};
function canonicalName(rawName){const current=type.value||'OTHER';const cleaned=cleanSpecLine(rawName).replace(/[:：\-–—]+$/,'').trim();const lowered=cleaned.toLocaleLowerCase('vi-VN');const exact=(templates[current]||[]).find(x=>x.toLocaleLowerCase('vi-VN')===lowered)||(templates.OTHER||[]).find(x=>x.toLocaleLowerCase('vi-VN')===lowered);if(exact)return exact;return (aliasMap[current]&&aliasMap[current][lowered])||null;}
function findOrCreateRowByName(name){const normalized=name.toLocaleLowerCase('vi-VN');let matched=[...tbody.querySelectorAll('tr')].find(tr=>tr.querySelector('.js-spec-name').value.trim().toLocaleLowerCase('vi-VN')===normalized);if(!matched){row(name,'');matched=tbody.lastElementChild;}return matched;}
function replaceSpecsFromPreview(items){tbody.innerHTML='';let mapped=0;items.forEach(item=>{const canonical=canonicalName(item.name)||cleanSpecLine(item.name);const value=cleanSpecLine(item.value);if(!canonical||!value)return;row(canonical,value,item.isFilterable??isFilterableByDefault(canonical));mapped++;});reindex();return {mapped,other:0};}
function upsertParsedSpecs(items){let mapped=0;items.forEach(item=>{const canonical=canonicalName(item.name)||cleanSpecLine(item.name);if(!canonical||!item.value)return;const input=findOrCreateRowByName(canonical).querySelector('.js-spec-value');input.value=mergeSpecValues(input.value,item.value);const cb=input.closest('tr').querySelector('.js-spec-filterable');if(cb)cb.checked=item.isFilterable??isFilterableByDefault(canonical);mapped++;});reindex();return {mapped,other:0};}
document.getElementById('add-spec-row')?.addEventListener('click',()=>row());document.getElementById('apply-spec-template')?.addEventListener('click',applyTemplate);document.getElementById('clear-empty-specs')?.addEventListener('click',()=>{[...tbody.querySelectorAll('tr')].forEach(tr=>{if(!tr.querySelector('.js-spec-name').value.trim()&&!tr.querySelector('.js-spec-value').value.trim())tr.remove();});reindex();});document.getElementById('toggle-example-specs')?.addEventListener('click',()=>{const box=document.getElementById('example-spec-box');box.style.display=box.style.display==='block'?'none':'block';});document.querySelectorAll('[data-chip]').forEach(btn=>btn.addEventListener('click',()=>row(btn.dataset.chip,'')));tbody?.addEventListener('click',e=>{if(e.target.closest('.js-remove-spec-row')){e.target.closest('tr').remove();reindex();}});tbody?.addEventListener('input',()=>{syncHidden();updatePreview();});tbody?.addEventListener('paste',e=>{const input=e.target.closest('.js-spec-name,.js-spec-value');const text=e.clipboardData?.getData('text')||'';if(!input||!text.includes('\n'))return;const parsed=window.parseSpecsFromText(text);if(parsed.length>1){e.preventDefault();upsertParsedSpecs(parsed);const feedback=document.getElementById('auto-spec-feedback');feedback.textContent=`Đã tự làm sạch và nhận diện ${parsed.length} thông số từ nội dung dán trực tiếp.`;feedback.className='alert alert-success auto-spec-feedback mb-3';feedback.style.display='block';}else{setTimeout(()=>{input.value=cleanSpecLine(input.value);reindex();},0);}});
function cleanupModalState(force=false){const hasOpenModal=!!document.querySelector('.modal.show');if(force||!hasOpenModal){document.querySelectorAll('.modal-backdrop').forEach(x=>x.remove());document.body.classList.remove('modal-open');document.body.style.removeProperty('overflow');document.body.style.removeProperty('padding-right');}}
function moveModalToBody(modalEl){if(modalEl&&modalEl.parentElement!==document.body)document.body.appendChild(modalEl);}
function showModalSafely(modalEl){try{if(!modalEl){cleanupModalState(true);return;}moveModalToBody(modalEl);if(window.bootstrap?.Modal){bootstrap.Modal.getOrCreateInstance(modalEl,{backdrop:true,keyboard:true,focus:true}).show();}else{modalEl.style.display='block';modalEl.classList.add('show');modalEl.removeAttribute('aria-hidden');document.body.classList.add('modal-open');}}catch(err){console.error('Không thể mở modal:',err);cleanupModalState(true);}}
function hideModalSafely(modalEl){try{if(window.bootstrap?.Modal&&modalEl){bootstrap.Modal.getOrCreateInstance(modalEl).hide();}else if(modalEl){modalEl.style.display='none';modalEl.classList.remove('show');modalEl.setAttribute('aria-hidden','true');}}catch(err){console.error('Không thể đóng modal:',err);}finally{setTimeout(()=>cleanupModalState(false),150);}}
