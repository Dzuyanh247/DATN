function esc(v){return (v||'').replaceAll('&','&amp;').replaceAll('\"','&quot;').replaceAll('<','&lt;').replaceAll('>','&gt;')}function isFilterableByDefault(name){const allowed={Mainboard:['socket','chipset','ram hỗ trợ','cpu hỗ trợ','kích cỡ','form factor'],CPU:['thương hiệu','socket','số nhân','số luồng','tdp','cpu hỗ trợ'],RAM:['dung lượng','bus ram','loại ram'],VGA:['chipset','vram','dung lượng vram'],PSU:['công suất','chuẩn nguồn','80 plus'],Monitor:['kích thước','tần số quét','độ phân giải','tấm nền']};const list=allowed[type?.value]||[];const n=(name||'').toLocaleLowerCase('vi-VN');return list.some(k=>n.includes(k));}function row(name='',value='',isFilterable=null){const checked=(isFilterable??isFilterableByDefault(name))?'checked':'';const tr=document.createElement('tr');tr.innerHTML=`<td><input class="form-control form-control-sm js-spec-name" placeholder="VD: Bộ nhớ" value="${esc(name)}"></td><td><textarea class="form-control form-control-sm js-spec-value" rows="2" placeholder="VD: 12GB GDDR6">${esc(value)}</textarea></td><td class="text-center"><input class="form-check-input js-spec-filterable" type="checkbox" value="true" ${checked}><input type="hidden" value="false"></td><td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger js-remove-spec-row">Xóa</button></td>`;tbody.appendChild(tr); reindex();}
function reindex(){[...tbody.querySelectorAll('tr')].forEach((tr,i)=>{tr.querySelector('.js-spec-name').name=`SpecificationItems[${i}].Name`;tr.querySelector('.js-spec-value').name=`SpecificationItems[${i}].Value`;const cb=tr.querySelector('.js-spec-filterable');const hidden=cb?.nextElementSibling;if(cb)cb.name=`SpecificationItems[${i}].IsFilterable`;if(hidden)hidden.name=`SpecificationItems[${i}].IsFilterable`;}); syncHidden(); updatePreview();}
function syncHidden(){const items=getSpecs().filter(x=>x.name||x.value);document.getElementById('Specifications').value=JSON.stringify(items);}function getSpecs(){return [...tbody.querySelectorAll('tr')].map(tr=>({name:tr.querySelector('.js-spec-name').value.trim(),value:tr.querySelector('.js-spec-value').value.trim(),isFilterable:tr.querySelector('.js-spec-filterable')?.checked||false}));}
function applyTemplate(){const keys=templates[type.value]||templates.Other; const existing=new Set([...tbody.querySelectorAll('.js-spec-name')].map(x=>x.value.trim().toLowerCase())); keys.forEach(k=>{if(!existing.has(k.toLowerCase())) row(k,'');});}
const sectionHeadingPattern=/^(chi tiết|thông tin chung|đặc điểm nổi bật|mô tả|thông số kỹ thuật|thông số|tính năng|tổng quan|overview|specifications?|general|details)$/i;
const valueHintPattern=/(\d|gb|mb|tb|ghz|mhz|w\b|v\b|hz|rpm|mm|cm|inch|core|thread|ddr|pcie|nvme|sata|usb|hdmi|displayport|wi-?fi|bluetooth|lga|am\d|atx|itx|ips|oled|va|tn|gddr|cuda|rgb|pwm|yes|no|có|không)/i;
function cleanSpecLine(line){return (line||'').replace(/^[\s•\-–—*]+/,'').replace(/\s+/g,' ').trim();}
function isNoiseLine(line){const cleaned=cleanSpecLine(line).replace(/[:：\-–—]+$/,'').trim();return !cleaned||sectionHeadingPattern.test(cleaned);}
function looksLikeName(line,nextLine){const cleaned=cleanSpecLine(line);if(!cleaned||isNoiseLine(cleaned)||/^\d/.test(cleaned)||/[.!?]$/.test(cleaned)||cleaned.length>=60)return false;const punct=(cleaned.match(/[,:;\/\\|()\[\]{}]/g)||[]).length;if(punct>3)return false;if(/[:：]\s*\S|(?:\s[-–—]\s)\S/.test(cleaned))return false;if(valueHintPattern.test(cleaned)&&!/^(sản phẩm|tên hãng|model|socket|chipset|cpu hỗ trợ|ram hỗ trợ|khe cắm mở rộng|ổ cứng hỗ trợ|cổng kết nối( \(internal\)| \(back panel\))?|lan \/ wireless|kích cỡ)$/i.test(cleaned))return false;return true;}
function mergeSpecValues(current,next){const values=(current||'').split(/\s*;\s*/).map(cleanSpecLine).filter(Boolean);String(next||'').split(/\n+/).map(cleanSpecLine).filter(Boolean).forEach(v=>{if(!values.some(x=>x.toLocaleLowerCase('vi-VN')===v.toLocaleLowerCase('vi-VN')))values.push(v);});return values.join('\n');}function pushParsedSpec(items,name,value){name=cleanSpecLine(name).replace(/[:：\-–—]+$/,'').trim();value=(value||'').split(/\n+/).map(cleanSpecLine).filter(Boolean).join('\n');if(!name||!value||isNoiseLine(name)||isNoiseLine(value))return;const existing=items.find(x=>x.name.toLocaleLowerCase('vi-VN')===name.toLocaleLowerCase('vi-VN'));if(existing)existing.value=mergeSpecValues(existing.value,value);else items.push({name,value});}
window.parseSpecsFromText=function(text){const rawLines=(text||'').split(/\r?\n/).map(cleanSpecLine);const lines=rawLines.filter(x=>!isNoiseLine(x));const items=[];let pendingName='',pendingValues=[];function flush(){if(pendingName&&pendingValues.length)pushParsedSpec(items,pendingName,pendingValues.join('\n'));pendingName='';pendingValues=[];}for(let i=0;i<lines.length;i++){const line=lines[i];const inline=line.match(/^(.{1,80}?)[\s]*[:：][\s]*(.+)$/)||line.match(/^(.{1,80}?)[\s]+[-–—][\s]+(.+)$/);if(inline&&!isNoiseLine(inline[1])){flush();pushParsedSpec(items,inline[1],inline[2]);continue;}const next=lines[i+1]||'';if(pendingName&&!pendingValues.length&&(valueHintPattern.test(line)||looksLikeName(next,lines[i+2]||''))){pendingValues.push(line);continue;}if(looksLikeName(line,next)){if(pendingName&&pendingValues.length)flush();pendingName=line;continue;}if(pendingName)pendingValues.push(line);}flush();return items;};
function canonicalName(rawName){const current=type.value||'Other';const cleaned=cleanSpecLine(rawName).replace(/[:：\-–—]+$/,'').trim();const lowered=cleaned.toLocaleLowerCase('vi-VN');const exact=(templates[current]||[]).find(x=>x.toLocaleLowerCase('vi-VN')===lowered)||(templates.Other||[]).find(x=>x.toLocaleLowerCase('vi-VN')===lowered);if(exact)return exact;return (aliasMap[current]&&aliasMap[current][lowered])||null;}
function findOrCreateRowByName(name){const normalized=name.toLocaleLowerCase('vi-VN');let matched=[...tbody.querySelectorAll('tr')].find(tr=>tr.querySelector('.js-spec-name').value.trim().toLocaleLowerCase('vi-VN')===normalized);if(!matched){row(name,'');matched=tbody.lastElementChild;}return matched;}
function upsertParsedSpecs(items){applyTemplate();let mapped=0;items.forEach(item=>{const canonical=canonicalName(item.name)||cleanSpecLine(item.name);if(!canonical||!item.value)return;const input=findOrCreateRowByName(canonical).querySelector('.js-spec-value');input.value=mergeSpecValues(input.value,item.value);const cb=input.closest('tr').querySelector('.js-spec-filterable');if(cb)cb.checked=item.isFilterable??isFilterableByDefault(canonical);mapped++;});reindex();return {mapped,other:0};}
document.getElementById('add-spec-row')?.addEventListener('click',()=>row());document.getElementById('apply-spec-template')?.addEventListener('click',applyTemplate);document.getElementById('clear-empty-specs')?.addEventListener('click',()=>{[...tbody.querySelectorAll('tr')].forEach(tr=>{if(!tr.querySelector('.js-spec-name').value.trim()&&!tr.querySelector('.js-spec-value').value.trim())tr.remove();});reindex();});document.getElementById('toggle-example-specs')?.addEventListener('click',()=>{const box=document.getElementById('example-spec-box');box.style.display=box.style.display==='block'?'none':'block';});document.querySelectorAll('[data-chip]').forEach(btn=>btn.addEventListener('click',()=>row(btn.dataset.chip,'')));tbody?.addEventListener('click',e=>{if(e.target.closest('.js-remove-spec-row')){e.target.closest('tr').remove();reindex();}});tbody?.addEventListener('input',()=>{syncHidden();updatePreview();});tbody?.addEventListener('paste',e=>{const input=e.target.closest('.js-spec-name,.js-spec-value');const text=e.clipboardData?.getData('text')||'';if(!input||!text.includes('\n'))return;const parsed=window.parseSpecsFromText(text);if(parsed.length>1){e.preventDefault();upsertParsedSpecs(parsed);const feedback=document.getElementById('auto-spec-feedback');feedback.textContent=`Đã tự làm sạch và nhận diện ${parsed.length} thông số từ nội dung dán trực tiếp.`;feedback.className='alert alert-success auto-spec-feedback mb-3';feedback.style.display='block';}else{setTimeout(()=>{input.value=cleanSpecLine(input.value);reindex();},0);}});if(tbody&&tbody.children.length===0) applyTemplate();
document.getElementById('open-auto-spec-import')?.addEventListener('click',()=>{const modalEl=document.getElementById('autoSpecModal');if(window.bootstrap?.Modal)bootstrap.Modal.getOrCreateInstance(modalEl).show();else modalEl.style.display='block';});
function renderAutoSpecPreview(items){const body=document.querySelector('#auto-spec-preview tbody');if(!body)return;body.innerHTML=items.length?items.map((x,i)=>`<tr><td><input class="form-control form-control-sm js-preview-name" value="${esc(x.name)}"></td><td><textarea class="form-control form-control-sm js-preview-value" rows="3">${esc(x.value)}</textarea></td><td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger js-preview-remove" data-index="${i}">Xóa</button></td></tr>`).join(''):'<tr><td colspan="3" class="text-muted">Chưa nhận diện được thông số hợp lệ.</td></tr>';}function getPreviewSpecs(){return [...document.querySelectorAll('#auto-spec-preview tbody tr')].map(tr=>({name:tr.querySelector('.js-preview-name')?.value.trim()||'',value:tr.querySelector('.js-preview-value')?.value.trim()||''})).filter(x=>x.name&&x.value);}document.getElementById('detect-auto-specs')?.addEventListener('click',()=>renderAutoSpecPreview(window.parseSpecsFromText(document.getElementById('auto-spec-text')?.value||'')));document.getElementById('auto-spec-text')?.addEventListener('paste',()=>setTimeout(()=>renderAutoSpecPreview(window.parseSpecsFromText(document.getElementById('auto-spec-text')?.value||'')),0));document.getElementById('auto-spec-preview')?.addEventListener('click',e=>{if(e.target.closest('.js-preview-remove')){e.target.closest('tr').remove();}});document.getElementById('import-auto-specs')?.addEventListener('click',()=>{const parsed=getPreviewSpecs().length?getPreviewSpecs():window.parseSpecsFromText(document.getElementById('auto-spec-text')?.value||'');const result=upsertParsedSpecs(parsed);const feedback=document.getElementById('auto-spec-feedback');feedback.textContent=parsed.length?`Đã áp dụng ${result.mapped} thông số. Thông số trùng được gộp bằng “; ”.`:'Chưa nhận diện được thông số kỹ thuật nào.';feedback.className=`alert ${parsed.length?'alert-success':'alert-warning'} auto-spec-feedback mb-3`;feedback.style.display='block';const modalEl=document.getElementById('autoSpecModal');if(parsed.length){if(window.bootstrap?.Modal)bootstrap.Modal.getOrCreateInstance(modalEl).hide();else modalEl.style.display='none';}});
function numeric(v){return Number((v||'').toString().replace(/[^0-9.]/g,''));}function money(v){const n=numeric(v);return n>0?n.toLocaleString('vi-VN')+' đ':'--';}function updatePrice(){const p=document.querySelector('.js-price')?.value; const s=document.querySelector('.js-sale-price')?.value; const actual=(numeric(s)>0?s:p); document.getElementById('actual-price-preview').textContent=money(actual); document.getElementById('preview-price').textContent=money(actual);}document.querySelectorAll('.js-price,.js-sale-price').forEach(x=>x.addEventListener('input',updatePrice));
function previews(){const urls=[];const thumb=document.querySelector('.js-image-url')?.value.trim(); if(thumb) urls.push(thumb); (document.querySelector('.js-gallery-urls')?.value||'').split(/\r?\n|,|;/).map(x=>x.trim()).filter(Boolean).forEach(x=>urls.push(x)); const box=document.getElementById('image-preview-grid'); box.innerHTML=''; [...new Set(urls)].slice(0,8).forEach(u=>{const img=document.createElement('img');img.src=u;img.onerror=function(){this.remove()};box.appendChild(img);});document.getElementById('preview-image').src=thumb||'/images/no-image.png';}document.querySelectorAll('.js-image-url,.js-gallery-urls').forEach(x=>x.addEventListener('input',previews));
function appendAddBrandOption(brandSelect){const option=document.createElement('option');option.value='__add_new_brand__';option.textContent='+ Thêm thương hiệu mới';brandSelect.appendChild(option);}
function selectBrandValue(value){const brandSelect=document.getElementById('component-brand');if(!brandSelect)return;const existing=[...brandSelect.options].find(o=>o.value.toLocaleLowerCase('vi-VN')===value.toLocaleLowerCase('vi-VN'));if(existing){existing.selected=true;}else{const addOption=[...brandSelect.options].find(o=>o.value==='__add_new_brand__');const option=document.createElement('option');option.value=value;option.textContent=value;option.selected=true;brandSelect.insertBefore(option,addOption||null);}updatePreview();}
async function loadBrandsForType(){const brandSelect=document.getElementById('component-brand'); if(!brandSelect)return; const current=brandSelect.value==='__add_new_brand__'?'':brandSelect.value; brandSelect.innerHTML='<option value="">Đang tải thương hiệu...</option>'; try{const response=await fetch(`/api/brands?componentType=${encodeURIComponent(type.value||'')}`,{headers:{'Accept':'application/json'}}); if(!response.ok)throw new Error('Không thể tải thương hiệu'); const brands=await response.json(); brandSelect.innerHTML='<option value="">-- Chọn thương hiệu --</option>'; brands.forEach(brand=>{const option=document.createElement('option'); option.value=brand; option.textContent=brand; option.selected=brand.toLocaleLowerCase('vi-VN')===current.toLocaleLowerCase('vi-VN'); brandSelect.appendChild(option);}); if(current&&!brands.some(brand=>brand.toLocaleLowerCase('vi-VN')===current.toLocaleLowerCase('vi-VN'))){const option=document.createElement('option'); option.value=current; option.textContent=current; option.selected=true; brandSelect.appendChild(option);}appendAddBrandOption(brandSelect);}catch{brandSelect.innerHTML='<option value="">-- Không tải được thương hiệu --</option>';appendAddBrandOption(brandSelect);}}

