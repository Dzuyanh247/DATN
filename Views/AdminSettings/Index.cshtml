@model Datn.PcStore.ViewModels.AdminSiteSettingsVm
@{
    ViewData["Title"] = "Cấu hình website";
}

<div class="container py-3">
    <h1 class="h3 mb-3">Cấu hình website</h1>

    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="h5 mb-3">Logo website</h2>

            @if (!string.IsNullOrWhiteSpace(Model.Message))
            {
                <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger")" role="alert">@Model.Message</div>
            }

            <div class="mb-3">
                <label class="form-label fw-semibold">Logo hiện tại</label>
                <div class="site-logo-preview-wrap">
                    @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
                    {
                        <img id="logo-preview-image" src="@Model.LogoUrl" alt="KKSHOP" class="site-logo-preview-image" />
                        <span id="logo-preview-text" class="site-logo-text" style="display:none;">KKSHOP</span>
                    }
                    else
                    {
                        <img id="logo-preview-image" src="" alt="KKSHOP" class="site-logo-preview-image" style="display:none;" />
                        <span id="logo-preview-text" class="site-logo-text">KKSHOP</span>
                    }
                </div>
            </div>

            <form method="post" class="admin-form-grid">
                @Html.AntiForgeryToken()
                <div class="admin-field-full mb-3">
                    <label asp-for="LogoUrl" class="form-label">Logo URL (Cloudinary)</label>
                    <input asp-for="LogoUrl" class="form-control" id="logo-url-input" placeholder="https://res.cloudinary.com/..." />
                    <span asp-validation-for="LogoUrl" class="text-danger"></span>
                </div>

                <p class="text-muted mb-3">Dán URL ảnh động/tĩnh từ Cloudinary. Hệ thống sẽ lưu URL vào DB và dùng trực tiếp trên mọi máy sau khi pull code + DB.</p>

                <hr />
                <h2 class="h5 mb-3">Background section khuyến mãi</h2>
                <div class="admin-form-grid admin-field-full mb-3">
                    <div class="admin-field-medium">
                        <label asp-for="DealSectionBackgroundUrl" class="form-label fw-semibold">URL ảnh nền Deal Hot</label>
                        <img src="@ImageUrlHelper.ResolveImageUrl(Model.DealSectionBackgroundUrl, "/images/defaults/deal-bg.jpg")" class="img-fluid rounded border" alt="Deal background" onerror="this.style.display='none';" />
                        <input asp-for="DealSectionBackgroundUrl" class="form-control mt-2" placeholder="https://..." />
                    </div>
                    <div class="admin-field-medium">
                        <label asp-for="HotPromotionBackgroundUrl" class="form-label fw-semibold">URL ảnh nền Khuyến mãi Hot</label>
                        <img src="@ImageUrlHelper.ResolveImageUrl(Model.HotPromotionBackgroundUrl, "/images/defaults/hot-promotion-bg.jpg")" class="img-fluid rounded border" alt="Hot promotion background" onerror="this.style.display='none';" />
                        <input asp-for="HotPromotionBackgroundUrl" class="form-control mt-2" placeholder="https://..." />
                    </div>
                </div>

                <div class="admin-field-full"><button type="submit" class="btn btn-primary">Lưu cấu hình</button></div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
(() => {
    const input = document.getElementById('logo-url-input');
    const previewImg = document.getElementById('logo-preview-image');
    const previewText = document.getElementById('logo-preview-text');

    if (!input || !previewImg || !previewText) return;

    const updatePreview = () => {
        const url = input.value?.trim();
        if (!url) {
            previewImg.removeAttribute('src');
            previewImg.style.display = 'none';
            previewText.style.display = 'inline-flex';
            return;
        }

        previewImg.src = url;
        previewImg.style.display = 'block';
        previewText.style.display = 'none';
    };

    input.addEventListener('input', updatePreview);

    previewImg.addEventListener('error', () => {
        previewImg.style.display = 'none';
        previewText.style.display = 'inline-flex';
    });
})();
</script>
}
