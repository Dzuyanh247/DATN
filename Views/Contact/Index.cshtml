@model Feedback
<h3>Liên hệ / Feedback</h3>
@if (TempData["Ok"] != null) { <div class="alert alert-success">@TempData["Ok"]</div> }
<form method="post" class="row g-3">
    <div class="col-md-6"><input asp-for="Name" class="form-control" placeholder="Họ tên" /></div>
    <div class="col-md-6"><input asp-for="Email" class="form-control" placeholder="Email" /></div>
    <div class="col-12"><textarea asp-for="Message" class="form-control" rows="4" placeholder="Nội dung"></textarea></div>
    <div class="col-12"><button class="btn btn-primary">Gửi phản hồi</button></div>
</form>
