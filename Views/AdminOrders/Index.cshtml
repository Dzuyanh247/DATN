@model IEnumerable<Order>
@{
    ViewData["Title"] = "Quản lý đơn hàng";
    var nowUtc = DateTimeHelper.UtcNow();
}
<h3>Quản lý đơn hàng</h3>
<table class="table table-striped align-middle">
    <thead><tr><th>Mã</th><th>Khách</th><th>Tổng tiền</th><th>Trạng thái đơn</th><th>Thanh toán</th><th>Hạn TT</th><th>Còn lại</th><th>Cập nhật</th><th></th></tr></thead>
    <tbody>
    @foreach (var o in Model)
    {
        var canPayNow = OrderStatusHelper.CanPayNow(o, nowUtc);
        var remaining = TimeSpan.FromSeconds(OrderStatusHelper.RemainingSeconds(o, nowUtc));
        <tr>
            <td>@($"DH{o.Id:D6}")</td>
            <td>@o.ReceiverName</td>
            <td>@o.TotalAmount.ToString("N0") đ</td>
            <td>@OrderStatusHelper.Label(o.Status)</td>
            <td>@OrderStatusHelper.PaymentLabel(o.PaymentStatus, o.Status)</td>
            <td>@(o.PaymentExpireAt.HasValue ? DateTimeHelper.FormatVietnam(o.PaymentExpireAt, "dd/MM/yyyy HH:mm") : "-")</td>
            <td>
                @if (canPayNow)
                {
                    <span>@remaining.ToString(@"hh\:mm\:ss")</span>
                }
                else if (OrderStatusHelper.IsExpiredPayment(o, nowUtc))
                {
                    <span class="text-danger">Hết hạn thanh toán</span>
                }
                else
                {
                    <span>-</span>
                }
            </td>
            <td>
                <form method="post" asp-action="UpdateStatus" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@o.Id" />
                    <select name="status" class="form-select form-select-sm">
                        @foreach (var s in Enum.GetValues<OrderStatus>())
                        {
                            if (s == o.Status)
                            {
                                <option value="@s" selected>@OrderStatusHelper.Label(s)</option>
                            }
                            else
                            {
                                <option value="@s">@OrderStatusHelper.Label(s)</option>
                            }
                        }
                    </select>
                    <button class="btn btn-sm btn-primary">Lưu</button>
                </form>
            </td>
            <td><a class="btn btn-sm btn-outline-secondary" asp-action="Detail" asp-route-id="@o.Id">Chi tiết</a></td>
        </tr>
    }
    </tbody>
</table>
