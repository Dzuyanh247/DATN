@model AdminOrdersIndexVm
@{
    ViewData["Title"] = "Quản lý đơn hàng";
    var nowUtc = DateTimeHelper.UtcNow();
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var paymentFilters = new[]
    {
        PaymentStatuses.Pending,
        PaymentStatuses.PendingConfirmation,
        PaymentStatuses.Paid,
        PaymentStatuses.Expired,
        PaymentStatuses.Failed,
        PaymentStatuses.Refunded
    };
}

<div class="admin-order-header">
    <div>
        <h2>Quản lý đơn hàng</h2>
        <p>Theo dõi sản phẩm, thanh toán và tiến độ xử lý đơn hàng.</p>
    </div>
    <span class="admin-order-result"><i class="bi bi-receipt-cutoff"></i> @Model.Orders.Count kết quả</span>
</div>

<div class="admin-order-stats">
    <div class="admin-stat-card admin-order-stat">
        <div><span>Tổng đơn</span><strong>@Model.Stats.TotalOrders</strong></div>
        <i class="bi bi-bag-check admin-order-stat-icon stat-neutral"></i>
    </div>
    <div class="admin-stat-card admin-order-stat">
        <div><span>Chờ thanh toán</span><strong>@Model.Stats.PendingPaymentOrders</strong></div>
        <i class="bi bi-hourglass-split admin-order-stat-icon stat-warning"></i>
    </div>
    <div class="admin-stat-card admin-order-stat">
        <div><span>Đã thanh toán</span><strong>@Model.Stats.PaidOrders</strong></div>
        <i class="bi bi-credit-card-2-front admin-order-stat-icon stat-success"></i>
    </div>
    <div class="admin-stat-card admin-order-stat">
        <div><span>Hết hạn thanh toán</span><strong>@Model.Stats.ExpiredPaymentOrders</strong></div>
        <i class="bi bi-exclamation-octagon admin-order-stat-icon stat-danger"></i>
    </div>
</div>

<div class="admin-order-panel">
    <form method="get" asp-action="Index" class="admin-order-filters">
        <div class="admin-order-search">
            <label for="orderSearch">Tìm kiếm</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input id="orderSearch" name="search" value="@Model.Search" class="form-control" placeholder="Mã đơn, tên khách, số điện thoại" />
            </div>
        </div>
        <div>
            <label for="orderStatus">Trạng thái đơn</label>
            <select id="orderStatus" name="status" class="form-select">
                <option value="">Tất cả trạng thái</option>
                @foreach (var item in Enum.GetValues<OrderStatus>())
                {
                    <option value="@item" selected="@(Model.Status == item)">@OrderStatusHelper.Label(item)</option>
                }
            </select>
        </div>
        <div>
            <label for="paymentStatus">Thanh toán</label>
            <select id="paymentStatus" name="paymentStatus" class="form-select">
                <option value="">Tất cả thanh toán</option>
                @foreach (var item in paymentFilters)
                {
                    <option value="@item" selected="@(Model.PaymentStatus == item)">@OrderStatusHelper.PaymentLabel(item)</option>
                }
            </select>
        </div>
        <div>
            <label for="fromDate">Từ ngày</label>
            <input id="fromDate" type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div>
            <label for="toDate">Đến ngày</label>
            <input id="toDate" type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="admin-order-filter-actions">
            <button class="btn btn-primary" type="submit"><i class="bi bi-funnel"></i> Lọc</button>
            <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-counterclockwise"></i> Reset</a>
        </div>
    </form>

    @if (!Model.Orders.Any())
    {
        <div class="admin-order-empty">
            <i class="bi bi-inbox"></i>
            <strong>Không tìm thấy đơn hàng</strong>
            <span>Hãy thay đổi bộ lọc hoặc từ khóa tìm kiếm.</span>
        </div>
    }
    else
    {
        <div class="table-responsive admin-orders-table-wrap">
            <table class="table align-middle admin-orders-table">
                <thead>
                    <tr>
                        <th>Đơn hàng</th>
                        <th>Khách hàng</th>
                        <th>Sản phẩm</th>
                        <th class="text-end">Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Cập nhật</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var order in Model.Orders)
                {
                    var canCountDown = order.Status == OrderStatus.PendingPayment
                        && order.PaymentDeadline.HasValue
                        && order.PaymentDeadline.Value > nowUtc;
                    var deadlineUnix = order.PaymentDeadline.HasValue
                        ? new DateTimeOffset(DateTime.SpecifyKind(order.PaymentDeadline.Value, DateTimeKind.Utc)).ToUnixTimeSeconds()
                        : 0;
                    <tr>
                        <td class="admin-order-code-cell">
                            <a asp-action="Detail" asp-route-id="@order.Id">@order.OrderCode</a>
                            <small><i class="bi bi-calendar3"></i> @DateTimeHelper.FormatVietnam(order.CreatedAt, "dd/MM/yyyy HH:mm")</small>
                        </td>
                        <td class="admin-order-customer">
                            <strong title="@order.CustomerName">@order.CustomerName</strong>
                            <small><i class="bi bi-telephone"></i> @order.CustomerPhone</small>
                        </td>
                        <td class="admin-order-products-cell">
                            @if (!order.Products.Any())
                            {
                                <span class="admin-order-products-empty">Không có dữ liệu sản phẩm</span>
                            }
                            @foreach (var product in order.Products.Take(2))
                            {
                                var imageUrl = ImageUrlHelper.ResolveImageUrl(product.ImageUrl, string.Empty);
                                <div class="admin-order-product-mini">
                                    <div class="admin-order-thumb-wrap">
                                        @if (!string.IsNullOrWhiteSpace(imageUrl))
                                        {
                                            <img src="@imageUrl" alt="@product.Name" loading="lazy" onerror="this.hidden=true;this.nextElementSibling.hidden=false;" />
                                            <span class="admin-order-no-image" hidden><i class="bi bi-image"></i></span>
                                        }
                                        else
                                        {
                                            <span class="admin-order-no-image"><i class="bi bi-image"></i></span>
                                        }
                                    </div>
                                    <div class="admin-order-product-copy">
                                        <span class="admin-order-product-name" title="@product.Name">@product.Name</span>
                                        <small>SL: @product.Quantity · @product.UnitPrice.ToString("N0") đ</small>
                                    </div>
                                </div>
                            }
                            @if (order.Products.Count > 2)
                            {
                                <a class="admin-order-more-products" asp-action="Detail" asp-route-id="@order.Id">+@(order.Products.Count - 2) sản phẩm khác</a>
                            }
                        </td>
                        <td class="text-end admin-order-total">@order.TotalAmount.ToString("N0") đ</td>
                        <td class="admin-order-status-cell">
                            <span class="order-status-badge @OrderStatusHelper.BadgeClass(order.Status)">@OrderStatusHelper.Label(order.Status)</span>
                            @if (canCountDown)
                            {
                                <span class="admin-order-countdown" data-payment-countdown data-deadline="@deadlineUnix">--:--:--</span>
                            }
                        </td>
                        <td class="admin-order-update-cell">
                            <form method="post" asp-action="UpdateStatus" class="admin-order-update-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@order.Id" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <select name="status" class="form-select form-select-sm" aria-label="Trạng thái đơn @order.OrderCode">
                                    @foreach (var item in Enum.GetValues<OrderStatus>())
                                    {
                                        <option value="@item" selected="@(item == order.Status)">@OrderStatusHelper.Label(item)</option>
                                    }
                                </select>
                                <button class="btn btn-sm btn-primary" type="submit" title="Lưu trạng thái"><i class="bi bi-check2"></i><span>Lưu</span></button>
                            </form>
                        </td>
                        <td class="admin-order-actions-cell">
                            <div class="admin-order-actions">
                                <a class="btn btn-sm btn-outline-primary admin-order-action-button" asp-action="Detail" asp-route-id="@order.Id"><i class="bi bi-eye"></i> Chi tiết</a>
                                @if (order.Status is not OrderStatus.Cancelled and not OrderStatus.Expired)
                                {
                                    <a class="btn btn-sm btn-outline-secondary admin-order-action-button" asp-controller="Orders" asp-action="Quotation" asp-route-orderId="@order.Id" target="_blank"><i class="bi bi-printer"></i> In hóa đơn</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
<script>
(() => {
    const nodes = document.querySelectorAll('[data-payment-countdown]');
    if (!nodes.length) return;

    const updateCountdowns = () => {
        const now = Math.floor(Date.now() / 1000);
        nodes.forEach(node => {
            const remaining = Math.max(0, Number(node.dataset.deadline) - now);
            if (remaining <= 0) {
                node.textContent = '00:00:00';
                node.classList.add('is-expired');
                return;
            }

            const hours = Math.floor(remaining / 3600);
            const minutes = Math.floor((remaining % 3600) / 60);
            const seconds = remaining % 60;
            node.textContent = `Còn ${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
        });
    };

    updateCountdowns();
    window.setInterval(updateCountdowns, 1000);
})();
</script>
}
