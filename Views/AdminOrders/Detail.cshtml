@model Order
@{
    ViewData["Title"] = $"Chi tiết đơn DH{Model.Id:D6}";
    var nowUtc = DateTimeHelper.UtcNow();
    var canPayNow = OrderStatusHelper.CanPayNow(Model, nowUtc);
    var remaining = TimeSpan.FromSeconds(OrderStatusHelper.RemainingSeconds(Model, nowUtc));
}
<h3>Chi tiết đơn @($"DH{Model.Id:D6}")</h3>
<div class="card mb-3">
    <div class="card-body">
        <div><b>Trạng thái:</b> @OrderStatusHelper.Label(Model.Status)</div>
        <div><b>Khách:</b> @Model.ReceiverName (@Model.ReceiverPhone)</div>
        <div><b>Địa chỉ:</b> @Model.ShippingAddress</div>
        <div><b>Thanh toán:</b> @PaymentMethods.Label(Model.PaymentMethod)</div>
        <div><b>Trạng thái thanh toán:</b> @OrderStatusHelper.PaymentLabel(Model.PaymentStatus, Model.Status)</div>
        <div><b>Hạn thanh toán:</b> @(Model.PaymentExpireAt.HasValue ? DateTimeHelper.FormatVietnam(Model.PaymentExpireAt, "dd/MM/yyyy HH:mm") : "-")</div>
        <div>
            <b>Còn lại:</b>
            @if (canPayNow)
            {
                <span>@remaining.ToString(@"hh\:mm\:ss")</span>
            }
            else if (OrderStatusHelper.IsExpiredPayment(Model, nowUtc))
            {
                <span class="text-danger">Hết hạn thanh toán</span>
            }
            else
            {
                <span>-</span>
            }
        </div>
        <div><b>Tổng tiền:</b> <span class="text-danger fw-bold">@Model.TotalAmount.ToString("N0") đ</span></div>
    </div>
</div>
<table class="table table-bordered">
    <thead><tr><th>Sản phẩm</th><th>SL</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead>
    <tbody>
    @foreach (var d in Model.Details)
    {
        <tr>
            <td>@(d.Product?.Name ?? d.ProductName)</td>
            <td>@d.Quantity</td>
            <td>@d.UnitPrice.ToString("N0") đ</td>
            <td>@((d.UnitPrice * d.Quantity).ToString("N0")) đ</td>
        </tr>
    }
    </tbody>
</table>

@if (Model.PaymentMethod == PaymentMethods.BankTransfer && Model.PaymentStatus == PaymentStatuses.PendingConfirmation)
{
    <form asp-action="ConfirmBankTransfer" method="post" class="mb-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <button class="btn btn-success">Xác nhận đã nhận tiền</button>
    </form>
}

<a class="btn btn-outline-secondary" asp-action="Index">Quay lại danh sách</a>
