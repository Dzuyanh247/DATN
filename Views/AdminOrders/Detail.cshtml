@model Order
@{
    string StatusLabel(OrderStatus status) => status switch
    {
        OrderStatus.Pending => "Chờ xác nhận",
        OrderStatus.Processing => "Đã xác nhận",
        OrderStatus.Delivering => "Đang giao hàng",
        OrderStatus.Completed => "Đã giao hàng",
        OrderStatus.Cancelled => "Đã hủy",
        OrderStatus.PendingConfirmation => "Chờ xác nhận",
        OrderStatus.PendingPayment => "Chờ thanh toán",
        OrderStatus.Expired => "Hết hạn",
        _ => status.ToString()
    };

    string PaymentLabel(Order o)
    {
        if (o.PaymentStatus == "PAID") return "Đã thanh toán";
        if (o.PaymentStatus == "EXPIRED" || o.Status == OrderStatus.Expired) return "Hết hạn";
        if (o.Status == OrderStatus.Cancelled) return "Đã hủy";
        if (o.PaymentStatus == "WAITING_PAYMENT") return "Chờ thanh toán";
        if (o.PaymentStatus == "WAITING_CONFIRMATION") return "Chờ admin xác nhận";
        return "Chưa thanh toán";
    }
}
<h3>Chi tiết đơn @($"DH{Model.Id:D6}")</h3>
<div class="card mb-3">
    <div class="card-body">
        <div><b>Trạng thái:</b> @StatusLabel(Model.Status)</div>
        <div><b>Khách:</b> @Model.ReceiverName (@Model.ReceiverPhone)</div>
        <div><b>Địa chỉ:</b> @Model.ShippingAddress</div>
        <div><b>Thanh toán:</b> @Model.PaymentMethod</div>
        <div><b>Trạng thái thanh toán:</b> @PaymentLabel(Model)</div>
        <div><b>Hạn thanh toán:</b> @(Model.PaymentExpireAt.HasValue ? Model.PaymentExpireAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "-")</div>
        <div><b>Tổng tiền:</b> <span class="text-danger fw-bold">@Model.TotalAmount.ToString("N0") đ</span></div>
    </div>
</div>
<table class="table table-bordered">
    <thead><tr><th>Sản phẩm</th><th>SL</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead>
    <tbody>
    @foreach (var d in Model.Details)
    {
        <tr>
            <td>@d.Product?.Name</td>
            <td>@d.Quantity</td>
            <td>@d.UnitPrice.ToString("N0") đ</td>
            <td>@((d.UnitPrice * d.Quantity).ToString("N0")) đ</td>
        </tr>
    }
    </tbody>
</table>

@if (Model.PaymentMethod == "BANK_TRANSFER" && Model.PaymentStatus == "WAITING_CONFIRMATION")
{
    <form asp-action="ConfirmBankTransfer" method="post" class="mb-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <button class="btn btn-success">Xác nhận đã nhận tiền</button>
    </form>
}

<a class="btn btn-outline-secondary" asp-action="Index">Quay lại danh sách</a>
