@model Datn.PcStore.ViewModels.HomeIndexVm
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="ttg-home">
@{
    var mainBanners = Model.Banners.Where(b => b.Position == "MainBanner" && !string.IsNullOrWhiteSpace(b.ImageUrl)).OrderBy(b => b.SortOrder).ToList();
    var subBanners = Model.Banners.Where(b => b.Position == "SubBanner" && !string.IsNullOrWhiteSpace(b.ImageUrl)).OrderBy(b => b.SortOrder).Take(3).ToList();
}
@if (mainBanners.Any())
{
    <div id="homeBanner" class="carousel slide ttg-main-banner" data-bs-ride="carousel">
        <div class="carousel-indicators">
            @for (var i = 0; i < mainBanners.Count; i++)
            {
                <button type="button" data-bs-target="#homeBanner" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")"></button>
            }
        </div>
        <div class="carousel-inner">
            @for (var i = 0; i < mainBanners.Count; i++)
            {
                var b = mainBanners[i];
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <img src="@b.ImageUrl" class="d-block w-100 banner-image" alt="@b.Title" onerror="this.onerror=null;this.src='/images/placeholders/banner-placeholder.png';">
                </div>
            }
        </div>
    </div>
    <div class="ttg-sub-banners">
        @foreach (var b in subBanners)
        {
            <a class="ttg-sub-banner-item" href="@b.LinkUrl"><img src="@b.ImageUrl" alt="@b.Title" onerror="this.onerror=null;this.src='/images/placeholders/banner-placeholder.png';" /></a>
        }
    </div>
}

<partial name="_ProductSection" model='Tuple.Create("Sản phẩm nổi bật", Model.FeaturedProducts)' />
<partial name="_ProductSection" model='Tuple.Create("Khuyến mãi hot", Model.PromotionProducts)' />
<partial name="_ProductSection" model='Tuple.Create("PC GAMING", Model.PcGamingProducts)' />
<partial name="_ProductSection" model='Tuple.Create("LAPTOP", Model.LaptopProducts)' />
<partial name="_ProductSection" model='Tuple.Create("MÀN HÌNH", Model.MonitorProducts)' />
<partial name="_ProductSection" model='Tuple.Create("LINH KIỆN", Model.ComponentProducts)' />
</div>
