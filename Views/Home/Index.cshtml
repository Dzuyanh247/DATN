@model Datn.PcStore.ViewModels.HomeIndexVm
@{
    ViewData["Title"] = "Trang chủ";
    
var dealSectionBackground = Model.SiteSettings?.DealSectionBackgroundUrl ?? string.Empty;
var hotPromotionBackground = Model.SiteSettings?.HotPromotionBackgroundUrl ?? string.Empty;
}

<div class="ttg-home">
@{
    var mainBanners = Model.Banners.Where(b => b.Position == "MainBanner" && !string.IsNullOrWhiteSpace(b.ImageUrl)).OrderBy(b => b.SortOrder).ToList();
    var subBanners = Model.Banners.Where(b => b.Position == "SubBanner" && !string.IsNullOrWhiteSpace(b.ImageUrl)).OrderBy(b => b.SortOrder).Take(3).ToList();
}
@if (mainBanners.Any())
{
    <div class="swiper ttg-hero-swiper ttg-main-banner">
        <div class="swiper-wrapper">
            @foreach (var b in mainBanners)
            {
                <div class="swiper-slide">
                    <img src="@b.ImageUrl" class="d-block w-100 banner-image" alt="@b.Title" onerror="this.onerror=null;this.src='/images/placeholders/banner-placeholder.png';">
                </div>
            }
        </div>
        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"></div>
        <div class="swiper-pagination"></div>
    </div>

    <div class="ttg-sub-banners">
        @foreach (var b in subBanners)
        {
            <a class="ttg-sub-banner-item" href="@b.LinkUrl"><img src="@b.ImageUrl" alt="@b.Title" onerror="this.onerror=null;this.src='/images/placeholders/banner-placeholder.png';" /></a>
        }
    </div>
}

<partial name="_ProductSection" model='Tuple.Create("Sản phẩm nổi bật", Model.FeaturedProducts, dealSectionBackground)' />
<partial name="_ProductSection" model='Tuple.Create("Khuyến mãi hot", Model.PromotionProducts, hotPromotionBackground)' />
<partial name="_ProductSection" model='Tuple.Create("PC GAMING", Model.PcGamingProducts, string.Empty)' />
<partial name="_ProductSection" model='Tuple.Create("LAPTOP", Model.LaptopProducts, string.Empty)' />
<partial name="_ProductSection" model='Tuple.Create("MÀN HÌNH", Model.MonitorProducts, string.Empty)' />
<partial name="_ProductSection" model='Tuple.Create("LINH KIỆN", Model.ComponentProducts, string.Empty)' />
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script>
        new Swiper('.ttg-hero-swiper', {
            loop: true,
            speed: 900,
            autoplay: { delay: 3500, disableOnInteraction: false },
            pagination: { el: '.swiper-pagination', clickable: true },
            navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' }
        });
    </script>
}
