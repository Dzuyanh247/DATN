@model Datn.PcStore.ViewModels.HomeIndexVm
@{
    ViewData["Title"] = "Trang chủ";
    
    var fallbackBanner = "/images/banners/banner_main1.png";
}


<div class="ttg-home">
@{
    var mainBanners = Model.Banners
        .Where(b => b.Position == "MainBanner" && !string.IsNullOrWhiteSpace(b.ImageUrl))
        .OrderBy(b => b.SortOrder)
        .ToList();
    var subBanners = Model.Banners
        .Where(b => b.Position == "SubBanner" && !string.IsNullOrWhiteSpace(b.ImageUrl))
        .OrderBy(b => b.SortOrder)
        .Take(3)
        .ToList();
}

@if (mainBanners.Any() || subBanners.Any())
{
    <div class="home-banner-stack">
        @if (mainBanners.Any())
        {
            <section class="ttg-main-banner" data-home-carousel aria-roledescription="carousel" aria-label="Banner khuyến mãi">
                <div class="ttg-banner-track">
                    @for (var index = 0; index < mainBanners.Count; index++)
                    {
                        var banner = mainBanners[index];
                        var bannerTitle = string.IsNullOrWhiteSpace(banner.Title) ? $"Banner khuyến mãi {index + 1}" : banner.Title;
                        <div class="ttg-banner-slide @(index == 0 ? "is-active" : string.Empty)"
                             data-carousel-slide
                             aria-hidden="@(index == 0 ? "false" : "true")">
                            <a href="@(string.IsNullOrWhiteSpace(banner.LinkUrl) ? "/Products" : banner.LinkUrl)"
                               aria-label="@bannerTitle"
                               tabindex="@(index == 0 ? "0" : "-1")">
                                <img src="@ImageUrlHelper.ResolveImageUrl(banner.ImageUrl, fallbackBanner)"
                                     class="banner-image"
                                     alt="@bannerTitle"
                                     fetchpriority="@(index == 0 ? "high" : "auto")"
                                     loading="@(index == 0 ? "eager" : "lazy")"
                                     onerror="this.onerror=null;this.src='@fallbackBanner';" />
                            </a>
                        </div>
                    }
                </div>

                @if (mainBanners.Count > 1)
                {
                    <button class="ttg-banner-arrow ttg-banner-arrow-prev" type="button" data-carousel-prev aria-label="Xem banner trước">
                        <i class="bi bi-chevron-left" aria-hidden="true"></i>
                    </button>
                    <button class="ttg-banner-arrow ttg-banner-arrow-next" type="button" data-carousel-next aria-label="Xem banner tiếp theo">
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </button>
                    <div class="ttg-banner-dots" role="group" aria-label="Chọn banner">
                        @for (var index = 0; index < mainBanners.Count; index++)
                        {
                            <button class="ttg-banner-dot @(index == 0 ? "is-active" : string.Empty)"
                                    type="button"
                                    data-carousel-dot="@index"
                                    aria-label="Xem banner @(index + 1)"
                                    aria-current="@(index == 0 ? "true" : "false")"></button>
                        }
                    </div>
                }
            </section>
        }

        @if (subBanners.Any())
        {
            <div class="home-secondary-banners">
                @foreach (var banner in subBanners)
                {
                    <a class="home-secondary-banner" href="@(string.IsNullOrWhiteSpace(banner.LinkUrl) ? "/Products" : banner.LinkUrl)">
                        <img src="@ImageUrlHelper.ResolveImageUrl(banner.ImageUrl, fallbackBanner)"
                             alt="@(string.IsNullOrWhiteSpace(banner.Title) ? "Banner khuyến mãi phụ" : banner.Title)"
                             loading="lazy"
                             onerror="this.onerror=null;this.src='@fallbackBanner';" />
                    </a>
                }
            </div>
        }
    </div>
}

<partial name="_ProductSection" model='Tuple.Create("PC GAMING", Model.PcGamingProducts, string.Empty)' />
<partial name="_ProductSection" model='Tuple.Create("PC WORKSTATION 2D 3D", Model.WorkstationProducts, string.Empty)' />
<partial name="_ProductSection" model='Tuple.Create("PC AMD GAMING", Model.AmdGamingProducts, string.Empty)' />
<partial name="_ProductSection" model='Tuple.Create("PC MINI", Model.PcMiniProducts, string.Empty)' />
<partial name="_ProductSection" model='Tuple.Create("PC VĂN PHÒNG", Model.OfficePcProducts, string.Empty)' />
<partial name="_ProductSection" model='Tuple.Create("LAPTOP", Model.LaptopProducts, string.Empty)' />
<partial name="_ProductSection" model='Tuple.Create("MÀN HÌNH", Model.MonitorProducts, string.Empty)' />
<partial name="_ProductSection" model='Tuple.Create("LINH KIỆN", Model.ComponentProducts, string.Empty)' />

</div>

@section Scripts {
    <script src="~/js/home-banner.js" asp-append-version="true"></script>
}
