@model List<Article>
@{
    ViewData["Title"] = "Quản lý bài viết";
    string Label(string? type) => type != null && ArticleTypes.Labels.TryGetValue(type, out var label) ? label : (type ?? "Tin tức");
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Quản lý bài viết</h3>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-circle"></i> Đăng bài</a>
</div>
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Tiêu đề</th><th>Chuyên mục</th><th>Trạng thái</th><th>Nổi bật</th><th>Lượt xem</th><th>Cập nhật</th><th></th></tr></thead>
            <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td><strong>@a.Title</strong><br /><small class="text-muted">@a.Slug</small></td>
                    <td>@Label(a.Type)</td>
                    <td><span class="badge @(a.IsPublished ? "bg-success" : "bg-secondary")">@(a.IsPublished ? "Hiển thị" : "Ẩn/Nháp")</span></td>
                    <td>@(a.IsFeatured ? "Có" : "Không")</td>
                    <td>@a.ViewCount</td>
                    <td>@a.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@a.Id">Sửa</a>
                        @if (User.IsInRole("Admin"))
                        {
                            <form method="post" asp-action="Delete" asp-route-id="@a.Id" class="d-inline" onsubmit="return confirm('Xóa bài viết này?')"><button class="btn btn-sm btn-outline-danger">Xóa</button></form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
