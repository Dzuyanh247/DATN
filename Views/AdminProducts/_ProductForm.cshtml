@model Datn.PcStore.ViewModels.AdminProductUpsertVm
@{
    var isEdit = Model.Id > 0;
    var orderedImages = Model.ExistingImages.OrderBy(x => x.SortOrder).ToList();
    var promotionPresetOptions = new[]
    {
        "Tặng kèm key Windows 10 bản quyền",
        "Hỗ trợ cài đặt phần mềm miễn phí",
        "Tặng kèm bộ vệ sinh máy",
        "Miễn phí giao hàng nội thành",
        "Hỗ trợ nâng cấp linh kiện"
    };
    var promotionLines = (Model.CustomPromotionText ?? string.Empty)
        .Split(new[] { "\r\n", "\n" }, StringSplitOptions.None)
        .Select(x => x.Trim())
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .ToList();
    var customPromotionLines = promotionLines
        .Where(line => !promotionPresetOptions.Any(option => string.Equals(line, option, StringComparison.OrdinalIgnoreCase)))
        .ToList();
}

<style>
    .admin-product-form .validation-summary-valid {
        display: none;
    }

    .admin-product-form .apf-actions {
        position: sticky;
        bottom: 0;
        z-index: 20;
        background: rgba(255, 255, 255, .96);
        border: 1px solid #e9ecef;
        border-radius: 12px;
        padding: .85rem 1rem;
        box-shadow: 0 -8px 24px rgba(15, 23, 42, .08);
    }

    .admin-product-form .apf-check-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: .75rem;
    }

    .admin-product-form .apf-check-grid .form-check,
    .admin-product-form .apf-switch {
        border: 1px solid #e9ecef;
        border-radius: .65rem;
        padding: .7rem .85rem .7rem 2.4rem;
        background: #f8fafc;
    }

    .admin-product-form .apf-sticky-side {
        position: sticky;
        top: 1rem;
    }

    .admin-product-form .apf-title {
        display: flex;
        align-items: center;
        color: #111827;
    }

    .promotion-preset-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .75rem;
    }

    .promotion-preset-option {
        position: relative;
        display: flex;
        gap: .65rem;
        align-items: center;
        min-height: 48px;
        padding: .7rem 2rem .7rem .9rem;
        border: 1px solid #e5e7eb;
        border-radius: 999px;
        background: #fff;
        color: #374151;
        cursor: pointer;
        transition: border-color .15s ease, background-color .15s ease, box-shadow .15s ease, transform .15s ease;
    }

    .promotion-preset-option:hover {
        border-color: #cbd5e1;
        background: #f8fafc;
        box-shadow: 0 8px 18px rgba(15, 23, 42, .07);
        transform: translateY(-1px);
    }

    .promotion-preset-option:has(.form-check-input:checked) {
        border-color: #93c5fd;
        background: #eff6ff;
        color: #1e3a8a;
        box-shadow: 0 8px 18px rgba(37, 99, 235, .10);
    }

    .promotion-preset-option .form-check-input {
        margin-top: 0;
        flex: 0 0 auto;
    }

    .promotion-preset-option .form-check-label {
        cursor: pointer;
        font-weight: 600;
        line-height: 1.3;
    }

    .promotion-remove-option {
        position: absolute;
        top: 50%;
        right: .55rem;
        width: 1.35rem;
        height: 1.35rem;
        transform: translateY(-50%);
        border: 0;
        border-radius: 999px;
        background: rgba(100, 116, 139, .10);
        color: #64748b;
        font-size: 1rem;
        line-height: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        opacity: .78;
        transition: background-color .15s ease, color .15s ease, opacity .15s ease;
    }

    .promotion-remove-option:hover {
        background: rgba(220, 38, 38, .14);
        color: #dc2626;
        opacity: 1;
    }

    .promotion-quick-add {
        border: 1px solid #e5e7eb;
        border-radius: .85rem;
        background: #f8fafc;
        padding: .85rem;
    }

    .promotion-quick-add .input-group .form-control,
    .promotion-quick-add .input-group .btn {
        min-height: 42px;
    }

    .promotion-confirm-overlay {
        position: fixed;
        inset: 0;
        z-index: 1060;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        background: rgba(15, 23, 42, .38);
    }

    .promotion-confirm-overlay.is-visible {
        display: flex;
    }

    .promotion-confirm-modal {
        width: min(420px, 100%);
        border-radius: 1rem;
        background: #fff;
        padding: 1.25rem;
        box-shadow: 0 24px 60px rgba(15, 23, 42, .22);
    }

    .promotion-confirm-icon {
        width: 40px;
        height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        background: #fee2e2;
        color: #dc2626;
    }

    @@media (max-width: 767.98px) {
        .promotion-preset-grid,
        .admin-product-form .apf-check-grid { grid-template-columns: 1fr; }
        .admin-product-form .apf-sticky-side,
        .admin-product-form .apf-actions { position: static; }
    }
</style>

<form asp-controller="AdminProducts" asp-action="@(isEdit ? "Edit" : "Create")" method="post" class="admin-product-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ProductType" />
    <input type="hidden" asp-for="ComponentType" value="PC" />
    <input type="hidden" asp-for="Brand" value="" />
    <div asp-validation-summary="All" class="alert alert-danger mb-3" role="alert"></div>

    <div class="admin-two-column-form">
        <div class="admin-main-column">
            <div class="apf-card admin-form-card mb-4">
                <h5 class="admin-card-title apf-title"><i class="bi bi-box-seam me-2"></i>Thông tin sản phẩm</h5>
                <div class="admin-form-grid">
                    <div class="admin-field-full"><label asp-for="Name" class="form-label">Tên sản phẩm</label><input asp-for="Name" class="form-control" placeholder="VD: PC Gaming i5 RTX 4060" /><span asp-validation-for="Name" class="text-danger"></span></div>
                </div>
            </div>

            <div class="apf-card admin-form-card mb-4">
                <h5 class="admin-card-title apf-title"><i class="bi bi-images me-2"></i>Hình ảnh sản phẩm</h5>
                @if (isEdit) { <div class="form-text text-muted mb-3">Không chỉnh textarea nếu muốn giữ nguyên thư viện ảnh hiện tại.</div> }
                @if (orderedImages.Any())
                {
                    <label class="form-label">Ảnh hiện có</label>
                    <div id="existing-image-list" class="apf-image-list mb-3">
                        @foreach (var image in orderedImages)
                        {
                            <div class="apf-image-item" data-image-id="@image.Id"><img src="@image.ImageUrl" alt="Ảnh sản phẩm" onerror="this.onerror=null;this.src='/images/placeholders/product-placeholder.png';" /><div class="apf-image-meta"><div class="d-flex justify-content-between align-items-center mb-2"><span class="badge text-bg-warning apf-primary-badge">Ảnh đại diện</span><label class="form-check-label text-danger small"><input class="form-check-input" type="checkbox" name="RemoveImageIds" value="@image.Id" /> Xóa</label></div><div class="d-flex gap-2"><button type="button" class="btn btn-sm btn-outline-secondary js-move-up">Lên</button><button type="button" class="btn btn-sm btn-outline-secondary js-move-down">Xuống</button></div></div></div>
                        }
                    </div>
                }
                <div class="admin-form-grid">
                    <div class="admin-field-md"><label asp-for="ThumbnailImageUrl" class="form-label">Ảnh đại diện</label><input asp-for="ThumbnailImageUrl" class="form-control" placeholder="https://..." /><div class="form-text text-muted">URL ảnh đại diện hoặc ảnh đầu danh sách hiện có.</div><span asp-validation-for="ThumbnailImageUrl" class="text-danger"></span></div>
                    <div class="admin-field-full"><label asp-for="ProductImageUrlsText" class="form-label mt-3">Thư viện ảnh sản phẩm</label><textarea asp-for="ProductImageUrlsText" rows="6" class="form-control" placeholder="Mỗi URL ảnh trên một dòng"></textarea><div class="form-text text-muted">Mỗi dòng là một URL ảnh. Tick Xóa ở ảnh hiện có nếu cần bỏ ảnh.</div><span asp-validation-for="ProductImageUrlsText" class="text-danger"></span></div>
                </div>
                <div id="existing-image-order-container"></div>
            </div>

            <div class="apf-card admin-form-card mb-4">
                <h5 class="admin-card-title apf-title"><i class="bi bi-card-text me-2"></i>Mô tả sản phẩm</h5>
                <label asp-for="Description" class="form-label">Mô tả ngắn / chi tiết</label><textarea asp-for="Description" rows="7" class="form-control" placeholder="Nhập mô tả nổi bật, ưu điểm và thông tin cần hiển thị"></textarea><div class="form-text text-muted">Dòng đầu tiên sẽ được dùng làm mô tả ngắn.</div><span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="apf-card admin-form-card mb-4" id="promotion-gift-card">
                <h5 class="admin-card-title apf-title"><i class="bi bi-gift me-2"></i>Khuyến mãi / quà tặng</h5>
                <div class="mb-3">
                    <div class="fw-semibold mb-1">Chọn ưu đãi có sẵn</div>
                    <div class="form-text text-muted mb-3">Có thể chọn nhiều ưu đãi. Nội dung được hiển thị ở trang chi tiết sản phẩm.</div>
                    <div class="promotion-preset-grid js-promotion-preset-grid">
                        @{
                            var promotionDisplayOptions = promotionPresetOptions.Concat(customPromotionLines).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
                        }
                        @for (var i = 0; i < promotionDisplayOptions.Count; i++)
                        {
                            var option = promotionDisplayOptions[i];
                            var checkboxId = $"promotion-preset-{i}";
                            var isChecked = promotionLines.Any(line => string.Equals(line, option, StringComparison.OrdinalIgnoreCase));
                            <label class="promotion-preset-option" for="@checkboxId">
                                <input class="form-check-input js-promotion-preset" type="checkbox" id="@checkboxId" value="@option" checked="@isChecked" />
                                <span class="form-check-label">@option</span>
                                <button type="button" class="promotion-remove-option js-promotion-remove-option" aria-label="Xóa option @option" title="Xóa option">×</button>
                            </label>
                        }
                    </div>
                    <div class="promotion-quick-add mt-3">
                        <label for="promotion-new-option" class="form-label mb-2">Thêm option khuyến mãi mới</label>
                        <div class="input-group">
                            <input id="promotion-new-option" type="text" class="form-control js-promotion-new-option" placeholder="Nhập tên option mới" />
                            <button type="button" class="btn btn-outline-primary js-promotion-add-option"><i class="bi bi-plus-lg me-1"></i>Thêm option</button>
                        </div>
                        <div class="form-text text-muted">Option thêm nhanh sẽ được tick sẵn và được lưu trên trình duyệt này để lần sau mở form vẫn còn.</div>
                    </div>
                </div>
                <textarea asp-for="CustomPromotionText" class="d-none js-promotion-bound-field" aria-hidden="true" tabindex="-1"></textarea>
                <div class="promotion-confirm-overlay js-promotion-confirm" aria-hidden="true">
                    <div class="promotion-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="promotion-confirm-title">
                        <div class="d-flex gap-3 align-items-start mb-3">
                            <span class="promotion-confirm-icon"><i class="bi bi-trash3"></i></span>
                            <div>
                                <h6 id="promotion-confirm-title" class="mb-1 fw-bold">Xóa option khuyến mãi</h6>
                                <div class="text-muted">Xóa option khuyến mãi này khỏi form hiện tại?</div>
                            </div>
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-outline-secondary js-promotion-cancel-remove">Hủy</button>
                            <button type="button" class="btn btn-danger js-promotion-confirm-remove">Xóa</button>
                        </div>
                    </div>
                </div>
                <span asp-validation-for="CustomPromotionText" class="text-danger"></span>
            </div>

            <div class="apf-card admin-form-card mb-4">
                <h5 class="admin-card-title apf-title"><i class="bi bi-cpu me-2"></i>Cấu hình / Thông số sản phẩm</h5>
                <input type="hidden" asp-for="Specifications" />
                <label for="component-spec-paste" class="form-label">Nhập nhanh cấu hình</label><textarea id="component-spec-paste" rows="5" class="form-control" placeholder="Dán cấu hình, mỗi dòng một linh kiện/thông số"></textarea>
                <div class="d-flex flex-wrap gap-2 mt-3 mb-3"><button type="button" class="btn btn-outline-primary" id="parse-component-specs"><i class="bi bi-magic me-1"></i>Nhận diện cấu hình</button><button type="button" class="btn btn-outline-secondary" id="add-component-spec-row"><i class="bi bi-plus-lg me-1"></i>Thêm dòng</button></div>
                <div class="table-responsive"><table class="table table-sm align-middle" id="component-spec-table"><thead><tr><th class="text-center" style="width:80px;">Thứ tự</th><th>Linh kiện / thông số</th><th class="text-center" style="width:90px;">Số lượng</th><th class="text-center" style="width:120px;">Bảo hành</th><th class="text-center" style="width:100px;">Xóa</th></tr></thead><tbody>@for (var i = 0; i < Model.ComponentSpecs.Count; i++) { <tr><td><input class="form-control form-control-sm text-center js-spec-stt admin-field-number" type="number" min="1" name="ComponentSpecs[@i].Stt" value="@Model.ComponentSpecs[i].Stt" /><span asp-validation-for="ComponentSpecs[i].Stt" class="text-danger small"></span></td><td><input class="form-control form-control-sm js-spec-description" name="ComponentSpecs[@i].Description" value="@Model.ComponentSpecs[i].Description" /><span asp-validation-for="ComponentSpecs[i].Description" class="text-danger small"></span></td><td><input class="form-control form-control-sm text-center js-spec-quantity admin-field-number" type="number" min="1" name="ComponentSpecs[@i].Quantity" value="@Model.ComponentSpecs[i].Quantity" /><span asp-validation-for="ComponentSpecs[i].Quantity" class="text-danger small"></span></td><td><input class="form-control form-control-sm text-center js-spec-warranty" name="ComponentSpecs[@i].Warranty" value="@Model.ComponentSpecs[i].Warranty" /><span asp-validation-for="ComponentSpecs[i].Warranty" class="text-danger small"></span></td><td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger js-remove-component-spec">Xóa</button></td></tr> }</tbody></table></div>
            </div>
        </div>

        <aside class="admin-side-column">
            <div class="apf-sticky-side">
                <div class="apf-card admin-form-card mb-4">
                    <h5 class="admin-card-title apf-title"><i class="bi bi-diagram-3 me-2"></i>Phân loại</h5>
                    <div class="admin-form-grid">
                        <div class="admin-field-full"><label asp-for="CategoryId" class="form-label">Danh mục</label><select asp-for="CategoryId" class="form-select" asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Model.Categories, "Id", "Name"))"><option value="">-- Chọn danh mục --</option></select><span asp-validation-for="CategoryId" class="text-danger"></span></div>
                        <div class="admin-field-sm admin-field-number"><label asp-for="StockQuantity" class="form-label">Tồn kho</label><input asp-for="StockQuantity" class="form-control" type="number" min="0" /><span asp-validation-for="StockQuantity" class="text-danger"></span></div>
                        <div class="admin-field-full"><div class="form-check form-switch apf-switch mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Đang kinh doanh</label></div></div>
                    </div>
                </div>

                <div class="apf-card admin-form-card mb-4">
                    <h5 class="admin-card-title apf-title"><i class="bi bi-cash-coin me-2"></i>Giá bán & khuyến mãi</h5>
                    <div class="admin-form-grid">
                        <div class="admin-field-full"><label asp-for="PriceInput" class="form-label">Giá gốc</label><input asp-for="PriceInput" type="text" inputmode="decimal" class="form-control" placeholder="VD: 70990000 hoặc 70.990.000" /><span asp-validation-for="PriceInput" class="text-danger"></span></div>
                        <div class="admin-field-full"><label asp-for="DiscountPriceInput" class="form-label">Giá khuyến mãi</label><input asp-for="DiscountPriceInput" type="text" inputmode="decimal" class="form-control" placeholder="VD: 69980000 hoặc 69,980,000" /><span asp-validation-for="DiscountPriceInput" class="text-danger"></span></div>
                        <div class="admin-field-full"><label asp-for="PromotionStartDate" class="form-label">Ngày bắt đầu khuyến mãi</label><input asp-for="PromotionStartDate" type="datetime-local" class="form-control" /><span asp-validation-for="PromotionStartDate" class="text-danger"></span></div>
                        <div class="admin-field-full"><label asp-for="PromotionEndDate" class="form-label">Ngày kết thúc khuyến mãi</label><input asp-for="PromotionEndDate" type="datetime-local" class="form-control" /><span asp-validation-for="PromotionEndDate" class="text-danger"></span></div>
                        <div class="admin-field-sm admin-field-number"><label asp-for="WarrantyMonths" class="form-label">Bảo hành tháng</label><input asp-for="WarrantyMonths" class="form-control" type="number" min="0" /><span asp-validation-for="WarrantyMonths" class="text-danger"></span></div>
                    </div>
                </div>

                <div class="apf-card admin-form-card mb-4">
                    <h5 class="admin-card-title apf-title"><i class="bi bi-toggle-on me-2"></i>Tuỳ chọn hiển thị</h5>
                    <input type="hidden" asp-for="IsHotSale" />
                    <input type="hidden" asp-for="IsPromotion" />
                    <div class="apf-check-grid"><div class="form-check"><input asp-for="IsDailyDeal" class="form-check-input" /><label asp-for="IsDailyDeal" class="form-check-label">DEAL HOT MỖI NGÀY</label></div></div>
                </div>

                <div class="admin-actions-card apf-actions mt-0 d-flex flex-column gap-3"><div class="text-muted small">Kiểm tra lỗi dưới từng trường trước khi lưu.</div><div class="d-grid gap-2"><button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Lưu sản phẩm</button><a asp-action="Index" class="btn btn-outline-secondary">Hủy / Quay lại danh sách</a></div></div>
            </div>
        </aside>
    </div>
</form>

<partial name="_ValidationScriptsPartial" />

<script>
    (function () {
        const form = document.querySelector('.admin-product-form');
        const boundField = document.querySelector('.js-promotion-bound-field');
        const presetGrid = document.querySelector('.js-promotion-preset-grid');
        const newOptionInput = document.querySelector('.js-promotion-new-option');
        const addOptionButton = document.querySelector('.js-promotion-add-option');
        const confirmBox = document.querySelector('.js-promotion-confirm');
        const cancelRemoveButton = document.querySelector('.js-promotion-cancel-remove');
        const confirmRemoveButton = document.querySelector('.js-promotion-confirm-remove');
        const promotionStorageKey = 'admin-products:promotion-preset-options';
        const defaultPromotionOptions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(promotionPresetOptions));
        const currentPromotionLines = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(promotionLines));
        let pendingRemoveItem = null;
        if (!form || !boundField || !presetGrid || !newOptionInput || !addOptionButton || !confirmBox || !cancelRemoveButton || !confirmRemoveButton) return;

        function normalizeOption(value) {
            return (value || '').replace(/\s+/g, ' ').trim();
        }

        function getPresetCheckboxes() {
            return Array.from(presetGrid.querySelectorAll('.js-promotion-preset'));
        }

        function optionKey(option) {
            return normalizeOption(option).toLocaleLowerCase('vi-VN');
        }

        function uniqueOptions(options) {
            const seen = new Set();
            const result = [];
            (options || []).forEach(option => {
                const normalized = normalizeOption(option);
                const key = optionKey(normalized);
                if (!normalized || seen.has(key)) return;
                seen.add(key);
                result.push(normalized);
            });
            return result;
        }

        function findPreset(option) {
            const normalized = optionKey(option);
            return getPresetCheckboxes().find(checkbox => optionKey(checkbox.value) === normalized);
        }

        function loadStoredPromotionOptions() {
            try {
                const storedValue = window.localStorage?.getItem(promotionStorageKey);
                if (!storedValue) return uniqueOptions(defaultPromotionOptions);

                const parsedOptions = JSON.parse(storedValue);
                if (!Array.isArray(parsedOptions)) return uniqueOptions(defaultPromotionOptions);

                return uniqueOptions(parsedOptions);
            } catch {
                return uniqueOptions(defaultPromotionOptions);
            }
        }

        function savePromotionOptions() {
            try {
                const options = getPresetCheckboxes().map(checkbox => checkbox.value);
                window.localStorage?.setItem(promotionStorageKey, JSON.stringify(uniqueOptions(options)));
            } catch {
                // localStorage may be unavailable in private/restricted browsers; the form still works for this session.
            }
        }

        function renderPromotionOptions() {
            const storedOptions = loadStoredPromotionOptions();
            const displayOptions = uniqueOptions(storedOptions.concat(currentPromotionLines));
            const currentKeys = new Set(uniqueOptions(currentPromotionLines).map(optionKey));

            presetGrid.innerHTML = '';
            displayOptions.forEach(option => {
                presetGrid.appendChild(createPromotionOption(option, currentKeys.has(optionKey(option))));
            });
        }

        function createPromotionOption(option, checked) {
            const normalizedOption = normalizeOption(option);
            const checkboxId = `promotion-preset-dynamic-${Date.now()}-${Math.random().toString(36).slice(2)}`;
            const label = document.createElement('label');
            label.className = 'promotion-preset-option';
            label.setAttribute('for', checkboxId);

            const checkbox = document.createElement('input');
            checkbox.className = 'form-check-input js-promotion-preset';
            checkbox.type = 'checkbox';
            checkbox.id = checkboxId;
            checkbox.value = normalizedOption;
            checkbox.checked = checked;

            const text = document.createElement('span');
            text.className = 'form-check-label';
            text.textContent = normalizedOption;

            const removeButton = document.createElement('button');
            removeButton.type = 'button';
            removeButton.className = 'promotion-remove-option js-promotion-remove-option';
            removeButton.setAttribute('aria-label', `Xóa option ${normalizedOption}`);
            removeButton.title = 'Xóa option';
            removeButton.textContent = '×';

            label.append(checkbox, text, removeButton);
            return label;
        }

        function syncPromotionText() {
            const selectedPresetLines = getPresetCheckboxes()
                .filter(checkbox => checkbox.checked)
                .map(checkbox => normalizeOption(checkbox.value))
                .filter(Boolean);
            boundField.value = selectedPresetLines.join('\n');
        }

        function addPromotionOption() {
            const option = normalizeOption(newOptionInput.value);
            if (!option) return;

            const existing = findPreset(option);
            if (existing) {
                existing.checked = true;
                existing.closest('.promotion-preset-option')?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            } else {
                presetGrid.appendChild(createPromotionOption(option, true));
                savePromotionOptions();
            }

            newOptionInput.value = '';
            newOptionInput.focus();
            syncPromotionText();
        }

        presetGrid.addEventListener('change', function (event) {
            if (event.target.matches('.js-promotion-preset')) syncPromotionText();
        });

        presetGrid.addEventListener('click', function (event) {
            const removeButton = event.target.closest('.js-promotion-remove-option');
            if (!removeButton) return;

            event.preventDefault();
            event.stopPropagation();
            const optionItem = removeButton.closest('.promotion-preset-option');
            pendingRemoveItem = optionItem;
            confirmBox.classList.add('is-visible');
            confirmBox.setAttribute('aria-hidden', 'false');
            confirmRemoveButton.focus();
        });

        function closeRemoveConfirm() {
            pendingRemoveItem = null;
            confirmBox.classList.remove('is-visible');
            confirmBox.setAttribute('aria-hidden', 'true');
        }

        cancelRemoveButton.addEventListener('click', closeRemoveConfirm);
        confirmBox.addEventListener('click', function (event) {
            if (event.target === confirmBox) closeRemoveConfirm();
        });
        confirmRemoveButton.addEventListener('click', function () {
            pendingRemoveItem?.remove();
            savePromotionOptions();
            closeRemoveConfirm();
            syncPromotionText();
        });
        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape' && confirmBox.classList.contains('is-visible')) closeRemoveConfirm();
        });

        addOptionButton.addEventListener('click', addPromotionOption);
        newOptionInput.addEventListener('keydown', function (event) {
            if (event.key !== 'Enter') return;
            event.preventDefault();
            addPromotionOption();
        });
        form.addEventListener('submit', syncPromotionText);
        renderPromotionOptions();
        syncPromotionText();
    })();

    (function () {
        const pasteBox = document.getElementById('component-spec-paste');
        const parseButton = document.getElementById('parse-component-specs');
        const addButton = document.getElementById('add-component-spec-row');
        const tableBody = document.querySelector('#component-spec-table tbody');
        if (!pasteBox || !parseButton || !addButton || !tableBody) return;

        function trimField(value) {
            return (value || '').replace(/\s+/g, ' ').trim();
        }

        function isHeaderLine(line) {
            const normalized = trimField(line).toLowerCase();
            return normalized === 'stt mô tả thiết bị sl bh'
                || normalized === 'stt mo ta thiet bi sl bh'
                || (normalized.startsWith('stt ') && normalized.includes('mô tả') && normalized.includes(' sl') && normalized.endsWith('bh'));
        }

        window.parsePastedSpecs = function parsePastedSpecs(rawText) {
            const result = [];
            const lines = (rawText || '').split(/\r?\n/);
            const fallbackRegex = /^\s*(\d+)\s+(.+?)\s+(\d+)\s+([0-9]+th|[0-9]+\s*tháng|[0-9]+)\s*$/i;

            lines.forEach(line => {
                if (!trimField(line) || isHeaderLine(line)) return;

                let spec = null;
                const separator = line.includes('	') ? '	' : (line.includes('|') ? '|' : null);
                if (separator) {
                    const columns = line.split(separator).map(trimField).filter(Boolean);
                    if (columns.length >= 4 && !isHeaderLine(columns.join(' '))) {
                        spec = {
                            stt: parseInt(columns[0], 10) || result.length + 1,
                            description: columns[1],
                            quantity: parseInt(columns[2], 10) || 1,
                            warranty: columns[3]
                        };
                    } else if (columns.length > 0) {
                        const description = trimField(columns.slice(1).join(' ') || columns.join(' '));
                        spec = { stt: result.length + 1, description, quantity: 1, warranty: '' };
                    }
                } else {
                    const match = line.match(fallbackRegex);
                    if (match) {
                        spec = {
                            stt: parseInt(match[1], 10) || result.length + 1,
                            description: trimField(match[2]),
                            quantity: parseInt(match[3], 10) || 1,
                            warranty: trimField(match[4])
                        };
                    } else {
                        const description = trimField(line.replace(/^\s*\d+\s+/, ''));
                        if (description) spec = { stt: result.length + 1, description, quantity: 1, warranty: '' };
                    }
                }

                if (spec && spec.description && !isHeaderLine(spec.description)) {
                    result.push(spec);
                }
            });

            return result;
        };

        function createInput(className, value, type) {
            const input = document.createElement('input');
            input.className = className;
            input.value = value || '';
            if (type) input.type = type;
            if (type === 'number') input.min = '1';
            return input;
        }

        function addRow(spec) {
            const row = document.createElement('tr');
            const sttCell = document.createElement('td');
            const descriptionCell = document.createElement('td');
            const quantityCell = document.createElement('td');
            const warrantyCell = document.createElement('td');
            const removeCell = document.createElement('td');

            sttCell.appendChild(createInput('form-control form-control-sm text-center js-spec-stt', spec?.stt || tableBody.children.length + 1, 'number'));
            descriptionCell.appendChild(createInput('form-control form-control-sm js-spec-description', spec?.description || '', 'text'));
            quantityCell.appendChild(createInput('form-control form-control-sm text-center js-spec-quantity', spec?.quantity || 1, 'number'));
            warrantyCell.appendChild(createInput('form-control form-control-sm text-center js-spec-warranty', spec?.warranty || '', 'text'));

            removeCell.className = 'text-center';
            const removeButton = document.createElement('button');
            removeButton.type = 'button';
            removeButton.className = 'btn btn-sm btn-outline-danger js-remove-component-spec';
            removeButton.textContent = 'Xóa';
            removeCell.appendChild(removeButton);

            row.append(sttCell, descriptionCell, quantityCell, warrantyCell, removeCell);
            tableBody.appendChild(row);
            reindexRows();
        }

        function reindexRows() {
            Array.from(tableBody.querySelectorAll('tr')).forEach((row, index) => {
                row.querySelector('.js-spec-stt').name = `ComponentSpecs[${index}].Stt`;
                row.querySelector('.js-spec-description').name = `ComponentSpecs[${index}].Description`;
                row.querySelector('.js-spec-quantity').name = `ComponentSpecs[${index}].Quantity`;
                row.querySelector('.js-spec-warranty').name = `ComponentSpecs[${index}].Warranty`;
            });
        }

        function renderRows(specs) {
            tableBody.innerHTML = '';
            specs.forEach(addRow);
            reindexRows();
        }

        parseButton.addEventListener('click', function () {
            renderRows(window.parsePastedSpecs(pasteBox.value));
        });

        addButton.addEventListener('click', function () {
            addRow({ stt: tableBody.children.length + 1, description: '', quantity: 1, warranty: '' });
        });

        tableBody.addEventListener('click', function (event) {
            const button = event.target.closest('.js-remove-component-spec');
            if (!button) return;
            button.closest('tr')?.remove();
            reindexRows();
        });

        reindexRows();
    })();

    (function () {
        const list = document.getElementById('existing-image-list');
        const orderContainer = document.getElementById('existing-image-order-container');
        if (!list || !orderContainer) return;

        const refresh = () => {
            const items = Array.from(list.querySelectorAll('.apf-image-item'));
            items.forEach((item, idx) => {
                const badge = item.querySelector('.apf-primary-badge');
                if (badge) {
                    badge.style.visibility = idx === 0 ? 'visible' : 'hidden';
                }
            });

            orderContainer.innerHTML = '';
            items.forEach(item => {
                const imageId = item.dataset.imageId;
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'ExistingImageOrder';
                input.value = imageId;
                orderContainer.appendChild(input);
            });
        };

        list.addEventListener('click', function (event) {
            const button = event.target.closest('button');
            if (!button) return;

            const item = button.closest('.apf-image-item');
            if (!item) return;

            if (button.classList.contains('js-move-up') && item.previousElementSibling) {
                list.insertBefore(item, item.previousElementSibling);
                refresh();
            }

            if (button.classList.contains('js-move-down') && item.nextElementSibling) {
                list.insertBefore(item.nextElementSibling, item);
                refresh();
            }
        });

        refresh();
    })();
</script>
