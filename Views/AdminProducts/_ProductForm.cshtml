@model Datn.PcStore.ViewModels.AdminProductUpsertVm
@{
    var isEdit = Model.Id > 0;
    var orderedImages = Model.ExistingImages.OrderBy(x => x.SortOrder).ToList();
}

<style>
    .admin-product-form .validation-summary-valid {
        display: none;
    }

    .promotion-preset-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .75rem;
    }

    .promotion-preset-option {
        display: flex;
        gap: .65rem;
        align-items: flex-start;
        padding: .8rem;
        border: 1px solid #fed7aa;
        border-radius: .65rem;
        background: #fff7ed;
        cursor: pointer;
    }

    .promotion-preset-option:hover {
        border-color: #fb923c;
        background: #ffedd5;
    }

    @@media (max-width: 767.98px) {
        .promotion-preset-grid { grid-template-columns: 1fr; }
    }
</style>

<form asp-controller="AdminProducts" asp-action="@(isEdit ? "Edit" : "Create")" method="post" class="admin-product-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="All" class="alert alert-danger mb-3" role="alert"></div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="apf-card mb-4">
                <h5 class="apf-title">Thông tin cơ bản</h5>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Name" class="form-label">Tên sản phẩm</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label">Danh mục</label>
                        <select asp-for="CategoryId" class="form-select" asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Model.Categories, "Id", "Name"))">
                            <option value="">-- Chọn danh mục --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="StockQuantity" class="form-label">Tồn kho</label>
                        <input asp-for="StockQuantity" class="form-control" min="0" />
                        <span asp-validation-for="StockQuantity" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label">Giá gốc</label>
                        <input asp-for="Price" class="form-control" min="1000" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DiscountPrice" class="form-label">Giá khuyến mãi</label>
                        <input asp-for="DiscountPrice" class="form-control" min="0" />
                        <span asp-validation-for="DiscountPrice" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PromotionStartDate" class="form-label">Ngày bắt đầu khuyến mãi</label>
                        <input asp-for="PromotionStartDate" type="datetime-local" class="form-control" />
                        <span asp-validation-for="PromotionStartDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PromotionEndDate" class="form-label">Ngày kết thúc khuyến mãi</label>
                        <input asp-for="PromotionEndDate" type="datetime-local" class="form-control" />
                        <span asp-validation-for="PromotionEndDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="WarrantyMonths" class="form-label">Bảo hành (tháng)</label>
                        <input asp-for="WarrantyMonths" class="form-control" min="0" />
                        <span asp-validation-for="WarrantyMonths" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label">Trạng thái đang kinh doanh</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label d-block mb-2">Hiển thị trang chủ</label>
                        <div class="d-flex flex-column gap-2">
                            <div class="form-check">
                                <input asp-for="IsHotSale" class="form-check-input" />
                                <label asp-for="IsHotSale" class="form-check-label">Hiển thị ở HOT SALE</label>
                            </div>
                            <div class="form-check">
                                <input asp-for="IsDailyDeal" class="form-check-input" />
                                <label asp-for="IsDailyDeal" class="form-check-label">Hiển thị ở Deal hot mỗi ngày</label>
                            </div>
                            <div class="form-check">
                                <input asp-for="IsPromotion" class="form-check-input" />
                                <label asp-for="IsPromotion" class="form-check-label">Hiển thị ở Khuyến mãi hot</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="apf-card mb-4">
                <h5 class="apf-title">Khuyến mại / Quà tặng kèm</h5>
                <p class="text-muted small mb-3">Chọn nhanh một hoặc nhiều mẫu bên dưới. Nếu không chọn hoặc nhập nội dung, website sẽ dùng hai khuyến mại mặc định.</p>

                <div class="promotion-preset-grid mb-3">
                    @foreach (var promotion in ProductPromotionHelper.PresetTexts)
                    {
                        var isSelected = Model.SelectedPromotionTexts.Contains(promotion, StringComparer.Ordinal);
                        <label class="promotion-preset-option">
                            @if (isSelected)
                            {
                                <input class="form-check-input mt-1" type="checkbox" name="SelectedPromotionTexts" value="@promotion" checked />
                            }
                            else
                            {
                                <input class="form-check-input mt-1" type="checkbox" name="SelectedPromotionTexts" value="@promotion" />
                            }
                            <span><span aria-hidden="true">🎁</span> @promotion</span>
                        </label>
                    }
                </div>

                <label asp-for="CustomPromotionText" class="form-label fw-semibold">Khuyến mại tùy chỉnh</label>
                <textarea asp-for="CustomPromotionText" rows="4" class="form-control" placeholder="Mỗi khuyến mại trên một dòng"></textarea>
                <div class="form-text text-muted">Nội dung tùy chỉnh sẽ được nối sau các mẫu đã chọn, mỗi dòng là một khuyến mại.</div>
                <span asp-validation-for="CustomPromotionText" class="text-danger"></span>
            </div>

            <div class="apf-card mb-4">
                <h5 class="apf-title">Mô tả sản phẩm</h5>
                <textarea asp-for="Description" rows="8" class="form-control" placeholder="Nhập mô tả đầy đủ của sản phẩm"></textarea>
                <div class="form-text text-muted">Nội dung này được lưu vào Description và hiển thị tại mục “Mô tả sản phẩm” trên trang chi tiết. Các dòng xuống hàng sẽ được giữ nguyên.</div>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="apf-card">
                <h5 class="apf-title">Thông số kỹ thuật</h5>
                <input type="hidden" asp-for="Specifications" />

                <label for="component-spec-paste" class="form-label">Cấu hình sản phẩm</label>
                <textarea id="component-spec-paste" rows="6" class="form-control" placeholder="Nhập hoặc dán cấu hình sản phẩm"></textarea>
                <div class="form-text text-muted">Hệ thống hỗ trợ nhận diện cấu hình tự động.</div>
                <div class="d-flex flex-wrap gap-2 mt-3 mb-3">
                    <button type="button" class="btn btn-outline-primary" id="parse-component-specs">Nhận diện cấu hình</button>
                    <button type="button" class="btn btn-outline-secondary" id="add-component-spec-row">Thêm dòng</button>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm align-middle" id="component-spec-table">
                        <thead>
                            <tr>
                                <th class="text-center" style="width:80px;">Thứ tự</th>
                                <th>Linh kiện / thông số</th>
                                <th class="text-center" style="width:90px;">Số lượng</th>
                                <th class="text-center" style="width:120px;">Bảo hành</th>
                                <th class="text-center" style="width:100px;">Xóa dòng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.ComponentSpecs.Count; i++)
                            {
                                <tr>
                                    <td>
                                        <input class="form-control form-control-sm text-center js-spec-stt" type="number" min="1" name="ComponentSpecs[@i].Stt" value="@Model.ComponentSpecs[i].Stt" />
                                        <span asp-validation-for="ComponentSpecs[i].Stt" class="text-danger small"></span>
                                    </td>
                                    <td>
                                        <input class="form-control form-control-sm js-spec-description" name="ComponentSpecs[@i].Description" value="@Model.ComponentSpecs[i].Description" />
                                        <span asp-validation-for="ComponentSpecs[i].Description" class="text-danger small"></span>
                                    </td>
                                    <td>
                                        <input class="form-control form-control-sm text-center js-spec-quantity" type="number" min="1" name="ComponentSpecs[@i].Quantity" value="@Model.ComponentSpecs[i].Quantity" />
                                        <span asp-validation-for="ComponentSpecs[i].Quantity" class="text-danger small"></span>
                                    </td>
                                    <td>
                                        <input class="form-control form-control-sm text-center js-spec-warranty" name="ComponentSpecs[@i].Warranty" value="@Model.ComponentSpecs[i].Warranty" />
                                        <span asp-validation-for="ComponentSpecs[i].Warranty" class="text-danger small"></span>
                                    </td>
                                    <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger js-remove-component-spec">Xóa</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="form-text text-muted">Kiểm tra và điều chỉnh thông tin cấu hình trước khi lưu.</div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="apf-card">
                <h5 class="apf-title">Hình ảnh sản phẩm</h5>

                @if (isEdit)
                {
                    <div class="form-text text-muted mb-3">Nếu không chọn ảnh mới, hệ thống sẽ giữ nguyên ảnh hiện tại.</div>
                }

                @if (orderedImages.Any())
                {
                    <label class="form-label">Ảnh hiện có</label>
                    <div id="existing-image-list" class="apf-image-list mb-3">
                        @foreach (var image in orderedImages)
                        {
                            <div class="apf-image-item" data-image-id="@image.Id">
                                <img src="@image.ImageUrl" alt="Ảnh sản phẩm" onerror="this.onerror=null;this.src='/images/placeholders/product-placeholder.png';" />
                                <div class="apf-image-meta">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge text-bg-warning apf-primary-badge">Ảnh đại diện</span>
                                        <label class="form-check-label text-danger small">
                                            <input class="form-check-input" type="checkbox" name="RemoveImageIds" value="@image.Id" /> Xóa
                                        </label>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-secondary js-move-up">Lên</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary js-move-down">Xuống</button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <label asp-for="ThumbnailImageUrl" class="form-label">Ảnh đại diện</label>
                <input asp-for="ThumbnailImageUrl" class="form-control" placeholder="Nhập đường dẫn hình ảnh đại diện" />
                <div class="form-text text-muted">Sử dụng hình ảnh rõ nét, đúng với sản phẩm.</div>
                <span asp-validation-for="ThumbnailImageUrl" class="text-danger"></span>

                <label asp-for="ProductImageUrlsText" class="form-label mt-3">Thư viện ảnh sản phẩm</label>
                <textarea asp-for="ProductImageUrlsText" rows="4" class="form-control" placeholder="Thêm hình ảnh sản phẩm"></textarea>
                <div class="form-text text-muted">Mỗi hình ảnh trên một dòng.</div>
                <span asp-validation-for="ProductImageUrlsText" class="text-danger"></span>

                <div id="existing-image-order-container"></div>
            </div>
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Lưu sản phẩm</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
    </div>
</form>

<partial name="_ValidationScriptsPartial" />

<script>
    (function () {
        const pasteBox = document.getElementById('component-spec-paste');
        const parseButton = document.getElementById('parse-component-specs');
        const addButton = document.getElementById('add-component-spec-row');
        const tableBody = document.querySelector('#component-spec-table tbody');
        if (!pasteBox || !parseButton || !addButton || !tableBody) return;

        function trimField(value) {
            return (value || '').replace(/\s+/g, ' ').trim();
        }

        function isHeaderLine(line) {
            const normalized = trimField(line).toLowerCase();
            return normalized === 'stt mô tả thiết bị sl bh'
                || normalized === 'stt mo ta thiet bi sl bh'
                || (normalized.startsWith('stt ') && normalized.includes('mô tả') && normalized.includes(' sl') && normalized.endsWith('bh'));
        }

        window.parsePastedSpecs = function parsePastedSpecs(rawText) {
            const result = [];
            const lines = (rawText || '').split(/\r?\n/);
            const fallbackRegex = /^\s*(\d+)\s+(.+?)\s+(\d+)\s+([0-9]+th|[0-9]+\s*tháng|[0-9]+)\s*$/i;

            lines.forEach(line => {
                if (!trimField(line) || isHeaderLine(line)) return;

                let spec = null;
                const separator = line.includes('	') ? '	' : (line.includes('|') ? '|' : null);
                if (separator) {
                    const columns = line.split(separator).map(trimField).filter(Boolean);
                    if (columns.length >= 4 && !isHeaderLine(columns.join(' '))) {
                        spec = {
                            stt: parseInt(columns[0], 10) || result.length + 1,
                            description: columns[1],
                            quantity: parseInt(columns[2], 10) || 1,
                            warranty: columns[3]
                        };
                    } else if (columns.length > 0) {
                        const description = trimField(columns.slice(1).join(' ') || columns.join(' '));
                        spec = { stt: result.length + 1, description, quantity: 1, warranty: '' };
                    }
                } else {
                    const match = line.match(fallbackRegex);
                    if (match) {
                        spec = {
                            stt: parseInt(match[1], 10) || result.length + 1,
                            description: trimField(match[2]),
                            quantity: parseInt(match[3], 10) || 1,
                            warranty: trimField(match[4])
                        };
                    } else {
                        const description = trimField(line.replace(/^\s*\d+\s+/, ''));
                        if (description) spec = { stt: result.length + 1, description, quantity: 1, warranty: '' };
                    }
                }

                if (spec && spec.description && !isHeaderLine(spec.description)) {
                    result.push(spec);
                }
            });

            return result;
        };

        function createInput(className, value, type) {
            const input = document.createElement('input');
            input.className = className;
            input.value = value || '';
            if (type) input.type = type;
            if (type === 'number') input.min = '1';
            return input;
        }

        function addRow(spec) {
            const row = document.createElement('tr');
            const sttCell = document.createElement('td');
            const descriptionCell = document.createElement('td');
            const quantityCell = document.createElement('td');
            const warrantyCell = document.createElement('td');
            const removeCell = document.createElement('td');

            sttCell.appendChild(createInput('form-control form-control-sm text-center js-spec-stt', spec?.stt || tableBody.children.length + 1, 'number'));
            descriptionCell.appendChild(createInput('form-control form-control-sm js-spec-description', spec?.description || '', 'text'));
            quantityCell.appendChild(createInput('form-control form-control-sm text-center js-spec-quantity', spec?.quantity || 1, 'number'));
            warrantyCell.appendChild(createInput('form-control form-control-sm text-center js-spec-warranty', spec?.warranty || '', 'text'));

            removeCell.className = 'text-center';
            const removeButton = document.createElement('button');
            removeButton.type = 'button';
            removeButton.className = 'btn btn-sm btn-outline-danger js-remove-component-spec';
            removeButton.textContent = 'Xóa';
            removeCell.appendChild(removeButton);

            row.append(sttCell, descriptionCell, quantityCell, warrantyCell, removeCell);
            tableBody.appendChild(row);
            reindexRows();
        }

        function reindexRows() {
            Array.from(tableBody.querySelectorAll('tr')).forEach((row, index) => {
                row.querySelector('.js-spec-stt').name = `ComponentSpecs[${index}].Stt`;
                row.querySelector('.js-spec-description').name = `ComponentSpecs[${index}].Description`;
                row.querySelector('.js-spec-quantity').name = `ComponentSpecs[${index}].Quantity`;
                row.querySelector('.js-spec-warranty').name = `ComponentSpecs[${index}].Warranty`;
            });
        }

        function renderRows(specs) {
            tableBody.innerHTML = '';
            specs.forEach(addRow);
            reindexRows();
        }

        parseButton.addEventListener('click', function () {
            renderRows(window.parsePastedSpecs(pasteBox.value));
        });

        addButton.addEventListener('click', function () {
            addRow({ stt: tableBody.children.length + 1, description: '', quantity: 1, warranty: '' });
        });

        tableBody.addEventListener('click', function (event) {
            const button = event.target.closest('.js-remove-component-spec');
            if (!button) return;
            button.closest('tr')?.remove();
            reindexRows();
        });

        reindexRows();
    })();

    (function () {
        const list = document.getElementById('existing-image-list');
        const orderContainer = document.getElementById('existing-image-order-container');
        if (!list || !orderContainer) return;

        const refresh = () => {
            const items = Array.from(list.querySelectorAll('.apf-image-item'));
            items.forEach((item, idx) => {
                const badge = item.querySelector('.apf-primary-badge');
                if (badge) {
                    badge.style.visibility = idx === 0 ? 'visible' : 'hidden';
                }
            });

            orderContainer.innerHTML = '';
            items.forEach(item => {
                const imageId = item.dataset.imageId;
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'ExistingImageOrder';
                input.value = imageId;
                orderContainer.appendChild(input);
            });
        };

        list.addEventListener('click', function (event) {
            const button = event.target.closest('button');
            if (!button) return;

            const item = button.closest('.apf-image-item');
            if (!item) return;

            if (button.classList.contains('js-move-up') && item.previousElementSibling) {
                list.insertBefore(item, item.previousElementSibling);
                refresh();
            }

            if (button.classList.contains('js-move-down') && item.nextElementSibling) {
                list.insertBefore(item.nextElementSibling, item);
                refresh();
            }
        });

        refresh();
    })();
</script>
