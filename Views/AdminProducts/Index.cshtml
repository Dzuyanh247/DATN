@model List<Product>
@{
    var categories = ViewBag.Categories as List<Category> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Quản lý sản phẩm</h3>
    <a class="btn btn-primary" asp-action="Create">Thêm sản phẩm</a>
</div>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">@TempData["Ok"]</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Tìm theo tên sản phẩm" />
    </div>
    <div class="col-md-4">
        <select name="categoryId" class="form-select">
            <option value="">-- Tất cả danh mục --</option>
            @foreach (var c in categories)
            {
                @if (ViewBag.CategoryId != null && (int)ViewBag.CategoryId == c.Id)
                {
                    <option value="@c.Id" selected>@c.Name</option>
                }
                else
                {
                    <option value="@c.Id">@c.Name</option>
                }
            }
        </select>
    </div>
    <div class="col-md-3">
        <button class="btn btn-outline-primary w-100">Lọc</button>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead><tr><th>Ảnh</th><th>Tên</th><th>Danh mục</th><th>Giá</th><th>Tồn kho</th><th>Trạng thái</th><th></th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        var thumb = p.ProductImages.FirstOrDefault(x => x.IsPrimary)?.ImageUrl
                    ?? p.ProductImages.OrderBy(x => x.SortOrder).FirstOrDefault()?.ImageUrl
                    ?? p.ThumbnailImage;
        <tr>
            <td><img src="@Url.Content(thumb)" style="width:72px; height:72px; object-fit:cover;" class="rounded" onerror="this.onerror=null;this.src='/images/no-image.png';" /></td>
            <td>@p.Name</td>
            <td>@p.Category?.Name</td>
            <td>@((p.DiscountPrice ?? p.SalePrice ?? p.Price).ToString("N0")) đ</td>
            <td>@p.StockQuantity</td>
            <td>
                @if (p.IsActive)
                {
                    <span class="badge bg-success">Hiển thị</span>
                }
                else
                {
                    <span class="badge bg-secondary">Ẩn</span>
                }
            </td>
            <td class="d-flex gap-2">
                <a class="btn btn-sm btn-outline-info" asp-controller="Products" asp-action="Detail" asp-route-id="@p.Id">Xem</a>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.Id">Sửa</a>
                <form method="post" asp-action="Delete" onsubmit="return confirm('Xác nhận xóa sản phẩm?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@p.Id" />
                    <button class="btn btn-sm btn-outline-danger">Xóa</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
